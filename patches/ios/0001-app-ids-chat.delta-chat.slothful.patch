--- /dev/null
+++ b/DcTests/AppIdentifierTests.swift
@@ -0,0 +1,17 @@
+import Testing
+import Foundation
+
+/// slothfulchat: guards the app identifier rename (chat.delta -> chat.slothful),
+/// so a rebase that silently reintroduces an upstream ID fails here.
+struct AppIdentifierTests {
+    @Test func bundleIdentifierIsOurs() {
+        #expect(Bundle.main.bundleIdentifier == "chat.slothful")
+    }
+
+    @Test func deeplinkSchemeIsOurs() {
+        let types = Bundle.main.object(forInfoDictionaryKey: "CFBundleURLTypes") as? [[String: Any]] ?? []
+        let schemes = types.flatMap { $0["CFBundleURLSchemes"] as? [String] ?? [] }
+        #expect(schemes.contains("chat.slothful.deeplink"))
+        #expect(!schemes.contains("chat.delta.deeplink"))
+    }
+}
