+/**
+ * Put the text of `messageIds` on the clipboard, one message per line. Pass
+ * them in display order. Shared by the multiselect context menu and
+ * Ctrl/Cmd + C.
+ *
+ * The selection can span messages the list never loaded — a Shift + click
+ * range covers the whole chat, not just the rendered window — so the text has
+ * to come from the backend.
+ *
+ * ponytail: one `getMessages` call for the whole selection; ceiling is a
+ * multi-thousand-message range turning into one big RPC and a multi-MB
+ * clipboard write. Upgrade path = chunk the fetch if it ever janks.
+ */
+function copyMessagesText(
+  accountId: number,
+  messageIds: Array<T.Message['id']>
+) {
+  const text = BackendRemote.rpc
+    .getMessages(accountId, messageIds)
+    .then(loaded =>
+      formatMessagesForClipboard(messageIds.map(id => loaded[id]))
+    )
+    // Nothing in the selection has text (only stickers/attachments). That
+    // can't be known before the fetch, so instead of hiding the menu entry,
+    // fail the write and leave the clipboard as it was.
+    .then(text => text || Promise.reject(new Error('no text to copy')))
+  // Deliberately not awaited before handing it over: browsers only honour a
+  // clipboard write inside the gesture that triggered it.
+  runtime
+    .writeClipboardText(text)
+    .catch(err => log.warn('failed to copy messages:', err))
+}
