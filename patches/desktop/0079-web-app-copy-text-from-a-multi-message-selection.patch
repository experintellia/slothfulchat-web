@@ -0,0 +1,43 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import { formatMessagesForClipboard } from '../utils/copyMessages.js'
+
+import type { T } from '@deltachat/jsonrpc-client'
+
+const msg = (text: string, downloadState = 'Done') =>
+  ({ kind: 'message', text, downloadState }) as unknown as T.MessageLoadResult
+
+describe('formatMessagesForClipboard', () => {
+  it('joins the bodies in the order given (display order, not click order)', () => {
+    // The caller filters the list's chronological ids, so a bottom-up
+    // Ctrl + click selection still arrives here oldest-first.
+    expect(formatMessagesForClipboard([msg('one'), msg('two')])).to.equal(
+      'one\ntwo'
+    )
+  })
+
+  it('drops messages without text, and unloaded ones', () => {
+    expect(
+      formatMessagesForClipboard([
+        msg('caption'),
+        msg(''),
+        undefined,
+        { kind: 'loadingError', error: 'nope' } as T.MessageLoadResult,
+        msg('tail'),
+      ])
+    ).to.equal('caption\ntail')
+  })
+
+  it('copies the on-screen caption of a not-yet-downloaded message', () => {
+    expect(
+      formatMessagesForClipboard([
+        msg('hello [Image – 228.45 KiB]', 'Available'),
+      ])
+    ).to.equal('hello')
+  })
+
+  it('returns empty when nothing in the selection has text', () => {
+    expect(formatMessagesForClipboard([msg(''), msg('')])).to.equal('')
+  })
+})
diff --git a/packages/frontend/src/utils/copyMessages.ts b/packages/frontend/src/utils/copyMessages.ts
