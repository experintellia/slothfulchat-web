+
+/** One line for the settings row: which server the drafts go to. */
+export function languageToolServerLabel(s: DesktopSettingsType): string {
+  if (s.languageToolServer) {
+    return s.languageToolServer
+  }
+  return s.languageToolUsername && s.languageToolApiKey
+    ? 'languagetool.org (Premium)'
+    : 'languagetool.org'
+}
+
+const isHttpUrl = (url: string) => {
+  try {
+    return /^https?:$/.test(new URL(url).protocol)
+  } catch {
+    return false
+  }
+}
+
+/** Pick languagetool.org (optionally with a Premium account) or a
+ * self-hosted server, like the Obsidian LanguageTool plugin. */
+export default function LanguageToolDialog({ onClose }: DialogProps) {
+  const tx = useTranslationFunction()
+  const settings = useSettingsStore()[0]?.desktopSettings
+  const [mode, setMode] = useState(
+    settings?.languageToolServer ? 'server' : 'account'
+  )
+  const [server, setServer] = useState(settings?.languageToolServer ?? '')
+  const [username, setUsername] = useState(settings?.languageToolUsername ?? '')
+  const [apiKey, setApiKey] = useState(settings?.languageToolApiKey ?? '')
+  const [status, setStatus] = useState('')
+
+  const config: LtConfig =
+    mode === 'server'
+      ? { server: server.trim() }
+      : { username: username.trim(), apiKey: apiKey.trim() }
+  const valid = mode !== 'server' || isHttpUrl(server.trim())
+
+  const save = async () => {
+    const set = SettingsStoreInstance.effect.setDesktopSetting
+    await set('languageToolServer', config.server || undefined)
+    await set('languageToolUsername', username.trim() || undefined)
+    await set('languageToolApiKey', apiKey.trim() || undefined)
+    onClose()
+  }
+
+  const check = () => {
+    setStatus('Checking…')
+    ltCheck(config, 'This are a test.').then(
+      matches =>
+        setStatus(
+          `Works: found ${matches.length} issue(s) in a test sentence.`
+        ),
+      (err: Error) =>
+        setStatus(
+          `Failed: ${err.message}. Check the address, and that a self-hosted ` +
+            'server allows this app (LanguageTool --allow-origin).'
+        )
+    )
+  }
+
+  return (
+    <Dialog onClose={onClose}>
+      <DialogHeader title='LanguageTool' onClose={onClose} />
+      <DialogBody>
+        <DialogContent>
+          <RadioGroup
+            name='language-tool-mode'
+            selectedValue={mode}
+            onChange={value => {
+              setMode(value)
+              setStatus('')
+            }}
+          >
+            <Radio
+              value='account'
+              label='languagetool.org'
+              subtitle='Free, or with your Premium account'
+            />
+            <Radio
+              value='server'
+              label='Own server'
+              subtitle='A LanguageTool server you run yourself'
+            />
+          </RadioGroup>
+          <br />
+          {mode === 'account' ? (
+            <>
+              <DeltaInput
+                label='Username (email), optional'
+                value={username}
+                type='email'
+                onChange={e => setUsername(e.target.value)}
+              />
+              <DeltaInput
+                label='API key, optional'
+                value={apiKey}
+                type='password'
+                onChange={e => setApiKey(e.target.value)}
+              />
+              <p>
+                Premium users find the API key on languagetool.org under Account
+                → Access tokens. Leave both empty for the free service.
+              </p>
+            </>
+          ) : (
+            <>
+              <DeltaInput
+                label='Server address'
+                value={server}
+                type='url'
+                placeholder='http://localhost:8081'
+                onChange={e => setServer(e.target.value)}
+              />
+              <p>
+                Start the server with <code>--allow-origin</code> so this app
+                may use it. Use https unless the server runs on this computer.
+              </p>
+            </>
+          )}
+          <Button onClick={check} disabled={!valid}>
+            Check connection
+          </Button>
+          {status && <p role='status'>{status}</p>}
+        </DialogContent>
+      </DialogBody>
+      <OkCancelFooterAction
+        onCancel={onClose}
+        onOk={save}
+        disableOK={!valid}
+        confirmLabel={tx('save')}
+      />
+    </Dialog>
+  )
+}
