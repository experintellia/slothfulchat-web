diff --git a/packages/frontend/src/components/composer/LanguageTool.tsx b/packages/frontend/src/components/composer/LanguageTool.tsx
new file mode 100644
index 0000000..ac45578b
--- /dev/null
+++ b/packages/frontend/src/components/composer/LanguageTool.tsx
@@ -0,0 +1,238 @@
+import React, {
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from 'react'
+
+import { getLogger } from '@deltachat-desktop/shared/logger'
+import Button from '../Button'
+import {
+  ltCheck,
+  remapMatches,
+  type LtConfig,
+  type LtMatch,
+} from './languageToolCheck'
+
+const log = getLogger('renderer/composer/LanguageTool')
+
+const CHECK_DELAY_MS = 1000
+
+type Props = LtConfig & {
+  text: string
+  /** the textarea's dir attribute */
+  dir: string
+  textareaRef: React.RefObject<HTMLTextAreaElement | null>
+  /** keep the suggestion card closed, e.g. while the completion menu is open */
+  hideCard: boolean
+  onReplace: (start: number, end: number, value: string) => void
+}
+
+/** Copy of the textarea's text box, so the overlay wraps lines identically. */
+function measure(el: HTMLTextAreaElement): React.CSSProperties {
+  const cs = getComputedStyle(el)
+  return {
+    top: el.offsetTop + el.clientTop,
+    left: el.offsetLeft + el.clientLeft,
+    width: el.clientWidth,
+    height: el.clientHeight,
+    fontFamily: cs.fontFamily,
+    fontSize: cs.fontSize,
+    fontWeight: cs.fontWeight,
+    fontStyle: cs.fontStyle,
+    lineHeight: cs.lineHeight,
+    letterSpacing: cs.letterSpacing,
+    wordSpacing: cs.wordSpacing,
+    tabSize: cs.tabSize,
+    textAlign: cs.textAlign as React.CSSProperties['textAlign'],
+    paddingTop: cs.paddingTop,
+    paddingRight: cs.paddingRight,
+    paddingBottom: cs.paddingBottom,
+    paddingLeft: cs.paddingLeft,
+  }
+}
+
+/**
+ * LanguageTool underlines for the composer textarea, plus a suggestion card
+ * while the caret sits in a flagged span. The underlines live in a
+ * transparent, click-through copy of the text laid exactly over the textarea
+ * (a textarea can't style parts of its own text, and the CSS Highlight API
+ * can't reach inside one).
+ */
+export function LanguageTool({
+  server,
+  username,
+  apiKey,
+  text,
+  dir,
+  textareaRef,
+  hideCard,
+  onReplace,
+}: Props) {
+  const [checked, setChecked] = useState<{ text: string; matches: LtMatch[] }>({
+    text: '',
+    matches: [],
+  })
+  const [box, setBox] = useState<React.CSSProperties | null>(null)
+  const [caret, setCaret] = useState<number | null>(null)
+  // ponytail: per-session ignore list; persist it if people ask
+  const [ignored, setIgnored] = useState<Set<string>>(() => new Set())
+  const layerRef = useRef<HTMLDivElement>(null)
+  const cardRef = useRef<HTMLDivElement>(null)
+
+  useEffect(() => {
+    if (!text.trim()) {
+      return
+    }
+    const abort = new AbortController()
+    const timer = setTimeout(() => {
+      ltCheck({ server, username, apiKey }, text, abort.signal).then(
+        matches => setChecked({ text, matches }),
+        err => abort.signal.aborted || log.warn('check failed', err)
+      )
+    }, CHECK_DELAY_MS)
+    return () => {
+      clearTimeout(timer)
+      abort.abort()
+    }
+  }, [text, server, username, apiKey])
+
+  // The card follows deliberate caret moves (click/tap, arrow keys) and closes
+  // on typing, so it never pops up mid-sentence.
+  const updateCaret = useCallback(
+    (e: Event) => {
+      const el = textareaRef.current
+      if (
+        !el ||
+        (e.type === 'keyup' &&
+          !/^(Arrow|Home|End|Page)/.test((e as KeyboardEvent).key)) ||
+        // tabbing into the card must not close it
+        (e.type === 'blur' &&
+          cardRef.current?.contains((e as FocusEvent).relatedTarget as Node))
+      ) {
+        return
+      }
+      setCaret(
+        (e.type === 'click' || e.type === 'keyup') &&
+          el.selectionStart === el.selectionEnd
+          ? el.selectionStart
+          : null
+      )
+    },
+    [textareaRef]
+  )
+
+  useEffect(() => {
+    const el = textareaRef.current
+    if (!el) {
+      return
+    }
+    const syncScroll = () => {
+      if (layerRef.current) layerRef.current.scrollTop = el.scrollTop
+    }
+    const resize = new ResizeObserver(() => setBox(measure(el)))
+    resize.observe(el)
+    const caretEvents = ['input', 'keyup', 'click', 'blur'] as const
+    caretEvents.forEach(t => el.addEventListener(t, updateCaret))
+    el.addEventListener('scroll', syncScroll)
+    return () => {
+      resize.disconnect()
+      caretEvents.forEach(t => el.removeEventListener(t, updateCaret))
+      el.removeEventListener('scroll', syncScroll)
+    }
+  }, [textareaRef, updateCaret])
+
+  useLayoutEffect(() => {
+    if (layerRef.current && textareaRef.current) {
+      layerRef.current.scrollTop = textareaRef.current.scrollTop
+    }
+  })
+
+  const matches = remapMatches(checked.matches, checked.text, text).filter(
+    m => !ignored.has(m.key)
+  )
+
+  const parts: React.ReactNode[] = []
+  let pos = 0
+  for (const m of matches) {
+    if (m.offset < pos) continue // overlapping match, first one wins
+    parts.push(
+      text.slice(pos, m.offset),
+      <span
+        key={m.offset}
+        className={
+          'language-tool-issue' +
+          (m.issueType === 'misspelling' ? ' misspelling' : '')
+        }
+      >
+        {text.slice(m.offset, m.offset + m.length)}
+      </span>
+    )
+    pos = m.offset + m.length
+  }
+  // the trailing space gives a trailing newline its line, as in the textarea
+  parts.push(text.slice(pos) + ' ')
+
+  const active =
+    hideCard || caret === null
+      ? undefined
+      : matches.find(m => m.offset <= caret && caret <= m.offset + m.length)
+
+  return (
+    <>
+      {box && (
+        <div
+          className='language-tool-layer'
+          style={box}
+          dir={dir}
+          ref={layerRef}
+          aria-hidden
+        >
+          {parts}
+        </div>
+      )}
+      {active && (
+        <div
+          className='completion-menu language-tool-card'
+          role='group'
+          aria-label='LanguageTool suggestion'
+          ref={cardRef}
+          // mousedown (not click) keeps the textarea focused, as in CompletionMenu
+          onMouseDown={e => e.preventDefault()}
+          onBlur={e => {
+            const to = e.relatedTarget as Node | null
+            if (!cardRef.current?.contains(to) && to !== textareaRef.current) {
+              setCaret(null)
+            }
+          }}
+        >
+          <div className='language-tool-message'>{active.message}</div>
+          <div className='language-tool-actions'>
+            {active.replacements.map(r => (
+              <Button
+                key={r}
+                styling='primary'
+                onClick={() => {
+                  onReplace(active.offset, active.offset + active.length, r)
+                  textareaRef.current?.focus()
+                  setCaret(null) // the old caret offset is stale now
+                }}
+              >
+                {r || '(remove)'}
+              </Button>
+            ))}
+            <Button
+              onClick={() => {
+                setIgnored(prev => new Set(prev).add(active.key))
+                textareaRef.current?.focus()
+              }}
+            >
+              Ignore
+            </Button>
+          </div>
+        </div>
+      )}
+    </>
+  )
+}
