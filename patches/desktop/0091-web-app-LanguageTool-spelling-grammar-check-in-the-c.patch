+// LanguageTool (https://languagetool.org) spelling/grammar check for the
+// composer: the HTTP API call and remapping results onto edited text. Plain
+// fetch, so it works the same on browser, Electron and Tauri — the desktop
+// targets ship with Chromium spellcheck off (no local hunspell dictionary).
+
+export type LtConfig = {
+  /** self-hosted server base URL; unset = languagetool.org */
+  server?: string
+  /** languagetool.org Premium: account email + API key; unset = free API */
+  username?: string
+  apiKey?: string
+}
+
+export type LtMatch = {
+  offset: number
+  length: number
+  message: string
+  replacements: string[]
+  /** LanguageTool's rule.issueType, e.g. 'misspelling', 'grammar', 'style' */
+  issueType: string
+  /** rule id + flagged text, what "Ignore" remembers */
+  key: string
+}
+
+export function ltCheckUrl(cfg: LtConfig): string {
+  if (cfg.server) {
+    // accept http://host:8081, …/v2 and …/v2/check alike
+    return (
+      cfg.server.replace(/\/+$/, '').replace(/\/v2(\/check)?$/, '') +
+      '/v2/check'
+    )
+  }
+  return cfg.username && cfg.apiKey
+    ? 'https://api.languagetoolplus.com/v2/check'
+    : 'https://api.languagetool.org/v2/check'
+}
+
+// ponytail: language=auto only. Detection can misfire on very short
+// messages; add a language picker (or preferredVariants from the UI locale)
+// if that shows up in practice.
+export async function ltCheck(
+  cfg: LtConfig,
+  text: string,
+  signal?: AbortSignal
+): Promise<LtMatch[]> {
+  const body = new URLSearchParams({ text, language: 'auto' })
+  if (!cfg.server && cfg.username && cfg.apiKey) {
+    body.set('username', cfg.username)
+    body.set('apiKey', cfg.apiKey)
+  }
+  // form-encoded POST is a CORS "simple request": no preflight, so a
+  // self-hosted server only needs --allow-origin, not OPTIONS handling
+  const res = await fetch(ltCheckUrl(cfg), { method: 'POST', body, signal })
+  if (!res.ok) {
+    throw new Error(`HTTP ${res.status}: ${(await res.text()).slice(0, 200)}`)
+  }
+  const { matches } = await res.json()
+  return (matches as any[]).map(m => ({
+    offset: m.offset,
+    length: m.length,
+    message: m.message,
+    replacements: (m.replacements as { value: string }[])
+      .slice(0, 5)
+      .map(r => r.value),
+    issueType: m.rule?.issueType ?? '',
+    key: `${m.rule?.id}:${text.slice(m.offset, m.offset + m.length)}`,
+  }))
+}
+
+/** Carry matches computed for `from` over to `to`, so underlines don't flicker
+ * while typing: matches before the edited span keep their offset, matches
+ * after it shift, and a match is dropped (until the next check) once the edit
+ * reaches it or the character right next to it. */
+export function remapMatches(
+  matches: LtMatch[],
+  from: string,
+  to: string
+): LtMatch[] {
+  if (from === to) {
+    return matches
+  }
+  const max = Math.min(from.length, to.length)
+  let prefix = 0
+  while (prefix < max && from[prefix] === to[prefix]) prefix++
+  let suffix = 0
+  while (
+    suffix < max - prefix &&
+    from[from.length - 1 - suffix] === to[to.length - 1 - suffix]
+  )
+    suffix++
+  const editEnd = from.length - suffix
+  const delta = to.length - from.length
+  // the flagged text plus one character either side
+  const around = (s: string, offset: number, length: number) =>
+    s.slice(Math.max(0, offset - 1), offset + length + 1)
+  const kept: LtMatch[] = []
+  for (const m of matches) {
+    const offset =
+      m.offset + m.length <= prefix
+        ? m.offset
+        : m.offset >= editEnd
+          ? m.offset + delta
+          : -1
+    if (
+      offset >= 0 &&
+      around(from, m.offset, m.length) === around(to, offset, m.length)
+    ) {
+      kept.push({ ...m, offset })
+    }
+  }
+  return kept
+}
diff --git a/packages/frontend/src/tests/languageTool.test.ts b/packages/frontend/src/tests/languageTool.test.ts
new file mode 100644
index 0000000..3b0ee5a
--- /dev/null
+++ b/packages/frontend/src/tests/languageTool.test.ts
@@ -0,0 +1,64 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import {
+  ltCheckUrl,
+  remapMatches,
+  type LtMatch,
+} from '../components/composer/languageToolCheck.js'
+
+const match = (offset: number, length: number): LtMatch => ({
+  offset,
+  length,
+  message: '',
+  replacements: [],
+  issueType: 'misspelling',
+  key: String(offset),
+})
+const offsets = (ms: LtMatch[]) => ms.map(m => m.offset)
+
+describe('ltCheckUrl', () => {
+  it('picks the free, premium or self-hosted endpoint', () => {
+    expect(ltCheckUrl({})).to.equal('https://api.languagetool.org/v2/check')
+    expect(ltCheckUrl({ username: 'a@b.c', apiKey: 'k' })).to.equal(
+      'https://api.languagetoolplus.com/v2/check'
+    )
+    for (const server of [
+      'http://localhost:8081',
+      'http://localhost:8081/',
+      'http://localhost:8081/v2',
+      'http://localhost:8081/v2/check',
+    ]) {
+      expect(ltCheckUrl({ server, apiKey: 'ignored' })).to.equal(
+        'http://localhost:8081/v2/check'
+      )
+    }
+  })
+})
+
+describe('remapMatches', () => {
+  // "teh" at 0, "wrod" at 8
+  const from = 'teh big wrod here'
+  const ms = [match(0, 3), match(8, 4)]
+
+  it('keeps everything when the text is unchanged', () => {
+    expect(remapMatches(ms, from, from)).to.equal(ms)
+  })
+
+  it('shifts matches after an edit and keeps those before it', () => {
+    expect(offsets(remapMatches(ms, from, 'teh very big wrod here'))).to.eql([
+      0, 13,
+    ])
+    expect(offsets(remapMatches(ms, from, 'teh wrod here'))).to.eql([0, 4])
+    expect(offsets(remapMatches(ms, from, from + ' and more'))).to.eql([0, 8])
+  })
+
+  it('drops matches the edit touches', () => {
+    // typing inside, right after, or right before a flagged word changes it
+    expect(offsets(remapMatches(ms, from, 'tehx big wrod here'))).to.eql([9])
+    expect(offsets(remapMatches(ms, from, 'teh big xwrod here'))).to.eql([0])
+    expect(offsets(remapMatches(ms, from, 'teh big wrodx here'))).to.eql([0])
+    expect(offsets(remapMatches(ms, from, 'the big word here'))).to.eql([])
+    expect(remapMatches(ms, from, '')).to.eql([])
+  })
+})
