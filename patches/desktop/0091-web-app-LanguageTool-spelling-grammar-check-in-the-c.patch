diff --git a/packages/frontend/src/tests/languageTool.test.ts b/packages/frontend/src/tests/languageTool.test.ts
new file mode 100644
index 0000000..5c98ee7
--- /dev/null
+++ b/packages/frontend/src/tests/languageTool.test.ts
@@ -0,0 +1,65 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import {
+  ltCheckUrl,
+  remapMatches,
+  type LtMatch,
+} from '../components/composer/languageToolCheck.js'
+
+const match = (offset: number, length: number): LtMatch => ({
+  offset,
+  length,
+  message: '',
+  replacements: [],
+  issueType: 'misspelling',
+  category: '',
+  key: String(offset),
+})
+const offsets = (ms: LtMatch[]) => ms.map(m => m.offset)
+
+describe('ltCheckUrl', () => {
+  it('picks the free, premium or self-hosted endpoint', () => {
+    expect(ltCheckUrl({})).to.equal('https://api.languagetool.org/v2/check')
+    expect(ltCheckUrl({ username: 'a@b.c', apiKey: 'k' })).to.equal(
+      'https://api.languagetoolplus.com/v2/check'
+    )
+    for (const server of [
+      'http://localhost:8081',
+      'http://localhost:8081/',
+      'http://localhost:8081/v2',
+      'http://localhost:8081/v2/check',
+    ]) {
+      expect(ltCheckUrl({ server, apiKey: 'ignored' })).to.equal(
+        'http://localhost:8081/v2/check'
+      )
+    }
+  })
+})
+
+describe('remapMatches', () => {
+  // "teh" at 0, "wrod" at 8
+  const from = 'teh big wrod here'
+  const ms = [match(0, 3), match(8, 4)]
+
+  it('keeps everything when the text is unchanged', () => {
+    expect(remapMatches(ms, from, from)).to.equal(ms)
+  })
+
+  it('shifts matches after an edit and keeps those before it', () => {
+    expect(offsets(remapMatches(ms, from, 'teh very big wrod here'))).to.eql([
+      0, 13,
+    ])
+    expect(offsets(remapMatches(ms, from, 'teh wrod here'))).to.eql([0, 4])
+    expect(offsets(remapMatches(ms, from, from + ' and more'))).to.eql([0, 8])
+  })
+
+  it('drops matches the edit touches', () => {
+    // typing inside, right after, or right before a flagged word changes it
+    expect(offsets(remapMatches(ms, from, 'tehx big wrod here'))).to.eql([9])
+    expect(offsets(remapMatches(ms, from, 'teh big xwrod here'))).to.eql([0])
+    expect(offsets(remapMatches(ms, from, 'teh big wrodx here'))).to.eql([0])
+    expect(offsets(remapMatches(ms, from, 'the big word here'))).to.eql([])
+    expect(remapMatches(ms, from, '')).to.eql([])
+  })
+})
