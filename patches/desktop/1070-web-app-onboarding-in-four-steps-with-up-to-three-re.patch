+  gap: 2px;
+  margin: 4px 0 0;
+  padding: 4px;
+
+  &:popover-open,
+  &:not([popover]):not([hidden]) {
+    display: flex;
+  }
+
+  &:popover-open {
+    inset: auto;
+    margin: 0;
+    position: fixed;
+  }
+}
+
+.onboardingDropdownOption {
+  border-color: transparent;
+}
+
+.onboardingDropdownOptionOn {
+  border-color: var(--loginInputFocusColor);
+}
+
+.onboardingButtonRow {
+  display: flex;
+  gap: 8px;
+  margin-top: 8px;
+}
+
+.onboardingChooseRelays,
+.onboardingQrButton {
+  align-items: center;
+  appearance: none;
+  background: none;
+  border: 1px solid var(--deltaChatPrimaryFgLight);
+  border-radius: 8px;
+  color: inherit;
+  cursor: pointer;
+  display: flex;
+  font: inherit;
+  justify-content: center;
+  min-height: 44px;
+
+  &:hover:not(:disabled),
+  &:focus-visible {
+    border-color: var(--loginInputFocusColor);
+  }
+
+  &:disabled {
+    cursor: not-allowed;
+    opacity: 0.5;
+  }
+}
+
+.onboardingChooseRelays {
+  flex: 1;
+  font-weight: bold;
+}
+
+.onboardingQrButton {
+  flex: none;
+  width: 44px;
+}
+
+// a link-looking button inside running text (consent sentence, "What's
+// collected"): no padding, so the sentence doesn't break around it
+.onboardingInlineLink {
+  appearance: none;
+  background: none;
+  border: none;
+  color: var(--loginInputFocusColor);
+  cursor: pointer;
+  display: inline;
+  font: inherit;
+  padding: 0;
+  text-decoration: underline;
+}
