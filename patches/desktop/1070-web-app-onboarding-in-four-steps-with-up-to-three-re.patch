+    same(current, bridge.local)
+      ? 'local'
+      : hosted.some(option => same(option.url, current))
+        ? 'hosted'
+        : 'custom'
+  )
+  const [hostedUrl, setHostedUrl] = useState(
+    () =>
+      hosted.find(option => same(option.url, current))?.url ?? hosted[0]?.url
+  )
+  const [customUrl, setCustomUrl] = useState(() =>
+    tile === 'custom' ? current : ''
+  )
+  const [customInvalid, setCustomInvalid] = useState(false)
+  // round trip per bridge URL: a number, null = no answer, absent = testing
+  const [pings, setPings] = useState<Record<string, number | null>>({})
+  const probe = (url: string) => {
+    if (url === '' || url in pings) {
+      return
+    }
+    bridge.probe(url).then(ms => setPings(prev => ({ ...prev, [url]: ms })))
+  }
+  useEffect(() => {
+    probe(bridge.local)
+    hosted.forEach(option => probe(option.url))
+    // probe the offered bridges once, when the step opens
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [])
