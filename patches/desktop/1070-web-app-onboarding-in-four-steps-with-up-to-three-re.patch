+          {choice(
+            tx('onboarding_have_profile'),
+            tx('onboarding_import_backup_explain'),
+            onImportBackup,
+            'import-backup-button'
+          )}
+          {choice(
+            <>
+              madmail server (webimap){' '}
+              <span className={styles.onboardingTag}>
+                {tx('onboarding_experimental')}
+              </span>
+            </>,
+            tx('onboarding_madmail_explain'),
+            () =>
+              openDialog(UseWebimapServerDialog, {
+                selectedAccountId: props.selectedAccountId,
+              }),
+            'madmail-button'
+          )}
+          <hr className={styles.onboardingDivider} />
+          <Button
+            className={styles.welcomeScreenButton}
+            onClick={() =>
+              openDialog(QrCodeScanner, {
+                scanContext: SCAN_CONTEXT_TYPE.OTHER_SERVER,
+              })
+            }
+            data-testid='scan-qr-login'
+          >
+            {tx('onboarding_scan')}
+          </Button>
+          <p className={styles.onboardingNote} style={{ textAlign: 'center' }}>
+            {tx('onboarding_scan_explain')}
+          </p>
+        </DialogContent>
+      </DialogBody>
+    </>
+  )
+}
