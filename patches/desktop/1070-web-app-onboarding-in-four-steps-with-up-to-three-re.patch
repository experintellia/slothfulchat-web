+import React, { useState } from 'react'
+
+import Button from '../../Button'
+import Dialog, { DialogBody, DialogContent, DialogHeader } from '../../Dialog'
+import { DeltaInput } from '../../Login-Styles'
+import useTranslationFunction from '../../../hooks/useTranslationFunction'
+
+import styles from './styles.module.scss'
+
+import type { DialogProps } from '../../../contexts/DialogContext'
+
+type Props = {
+  onAdd: (relay: { addr: string; password: string }) => void
+}
+
+const UPSIDES = [
+  'onboarding_classic_up_kept',
+  'onboarding_classic_up_unblocked',
+  'onboarding_classic_up_other_service',
+  'onboarding_classic_up_no_expiry',
+  'onboarding_classic_up_own_domain',
+] as const
+
+const DOWNSIDES = [
+  'onboarding_classic_down_cleanup',
+  'onboarding_classic_down_push',
+  'onboarding_classic_down_limits',
+  'onboarding_classic_down_lockout',
+  'onboarding_classic_down_spam',
+  'onboarding_classic_down_metadata',
+  'onboarding_classic_down_setup',
+] as const
+
+/** A bridge on this device can reach any mail server; a hosted one usually
+ * only reaches the chatmail relays its operator allowlisted. */
+function bridgeIsLocal(): boolean {
+  const url = (window as any).__slothfulchatBridge?.url?.()
+  if (typeof url !== 'string') {
+    return true // not the browser edition: there is no bridge to warn about
+  }
+  try {
+    const host = new URL(url).hostname
+    return host === 'localhost' || host === '[::1]' || /^127\./.test(host)
+  } catch {
+    return false
+  }
+}
+
+/**
+ * slothfulchat-web: add a classic email account (IMAP/SMTP at a normal
+ * provider) as one of a new profile's relays, from the onboarding relay
+ * chooser. Says up front that it should be a dedicated account and what it
+ * trades against a chatmail relay. Server settings are autodetected by core
+ * when the profile is created; a wrong password fails there, loudly.
+ */
+export default function ClassicEmailRelayDialog({
+  onAdd,
+  onClose,
+}: Props & DialogProps) {
+  const tx = useTranslationFunction()
+  const [addr, setAddr] = useState('')
+  const [password, setPassword] = useState('')
+  const [invalid, setInvalid] = useState(false)
+
+  const onSubmit = (event: React.FormEvent) => {
+    event.preventDefault()
+    const trimmed = addr.trim()
+    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(trimmed) || password === '') {
+      setInvalid(true)
+      return
+    }
+    onAdd({ addr: trimmed, password })
+    onClose()
+  }
+
+  return (
+    <Dialog onClose={onClose} width={480} dataTestid='classic-relay-dialog'>
+      <DialogHeader
+        title={tx('onboarding_classic_email_title')}
+        onClose={onClose}
+      />
+      <DialogBody>
+        <DialogContent>
+          <p className={styles.onboardingWarning}>
+            {tx('onboarding_classic_email_new_account')}
+          </p>
+          <div className={styles.onboardingProsCons}>
+            <div>
+              <strong>{tx('onboarding_classic_upsides')}</strong>
+              <ul>
+                {UPSIDES.map(key => (
+                  <li key={key}>{tx(key)}</li>
+                ))}
+              </ul>
+            </div>
+            <div>
+              <strong>{tx('onboarding_classic_downsides')}</strong>
+              <ul>
+                {DOWNSIDES.map(key => (
+                  <li key={key}>{tx(key)}</li>
+                ))}
+              </ul>
+            </div>
+          </div>
+          {!bridgeIsLocal() && (
+            <p className={styles.onboardingWarning}>
+              {tx(
+                'onboarding_classic_bridge_warning',
+                (window as any).__slothfulchatBridge.url()
+              )}
+            </p>
+          )}
+          <form onSubmit={onSubmit}>
+            <DeltaInput
+              key='classicAddr'
+              id='classicAddr'
+              type='email'
+              placeholder={tx('onboarding_classic_addr_placeholder')}
+              value={addr}
+              onChange={event => {
+                setAddr(event.target.value)
+                setInvalid(false)
+              }}
+              autoFocus={true}
+            />
+            <DeltaInput
+              key='classicPassword'
+              id='classicPassword'
+              type='password'
+              placeholder={tx('onboarding_classic_password_placeholder')}
+              value={password}
+              onChange={event => {
+                setPassword(event.target.value)
+                setInvalid(false)
+              }}
+            />
+            {invalid && (
+              <p className={styles.inputError}>
+                {tx('onboarding_classic_invalid')}
+              </p>
+            )}
+            <Button
+              type='submit'
+              styling='primary'
+              className={styles.welcomeScreenButton}
+              data-testid='classic-relay-add'
+            >
+              {tx('onboarding_classic_add')}
+            </Button>
+          </form>
+        </DialogContent>
+      </DialogBody>
+    </Dialog>
+  )
+}
