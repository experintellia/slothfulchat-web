+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import { reorderedAccounts } from '../utils/accountOrder.js'
+
+describe('reorderedAccounts', () => {
+  it('moves a profile down, below the profile it was dropped on', () => {
+    expect(reorderedAccounts([1, 2, 3, 4], 0, 2, 'bottom')).to.deep.equal([
+      2, 3, 1, 4,
+    ])
+  })
+
+  it('moves a profile down, above the profile it was dropped on', () => {
+    expect(reorderedAccounts([1, 2, 3, 4], 0, 2, 'top')).to.deep.equal([
+      2, 1, 3, 4,
+    ])
+  })
+
+  it('moves a profile up', () => {
+    expect(reorderedAccounts([1, 2, 3, 4], 3, 1, 'top')).to.deep.equal([
+      1, 4, 2, 3,
+    ])
+    expect(reorderedAccounts([1, 2, 3, 4], 3, 1, 'bottom')).to.deep.equal([
+      1, 2, 4, 3,
+    ])
+  })
+
+  it('keeps every profile exactly once', () => {
+    const reordered = reorderedAccounts([1, 2, 3, 4], 1, 3, 'bottom')
+    expect(reordered?.slice().sort()).to.deep.equal([1, 2, 3, 4])
+  })
+
+  it('is not a move when dropped on itself or out of range', () => {
+    expect(reorderedAccounts([1, 2, 3], 1, 1, 'top')).to.equal(null)
+    expect(reorderedAccounts([1, 2, 3], -1, 1, 'top')).to.equal(null)
+    expect(reorderedAccounts([1, 2, 3], 0, 3, 'top')).to.equal(null)
+    expect(reorderedAccounts([], 0, 0, 'top')).to.equal(null)
+  })
+})
