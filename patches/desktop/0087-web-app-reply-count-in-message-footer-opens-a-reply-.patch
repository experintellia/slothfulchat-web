index 0000000..ea746d2
--- /dev/null
+++ b/packages/frontend/src/components/dialogs/ReplyThread.tsx
@@ -0,0 +1,125 @@
+import React, { useEffect, useEffectEvent } from 'react'
+
+import Dialog, { DialogBody, DialogContent, DialogHeader } from '../Dialog'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+import { BackendRemote, onDCEvent } from '../../backend-com'
+import { useFetch, useRpcFetch } from '../../hooks/useFetch'
+import { MessagesDisplayContext } from '../../contexts/MessagesDisplayContext'
+import { ReactionsBarProvider } from '../ReactionsBar'
+import Message from '../message/Message'
+
+import styles from './ReplyThread.module.scss'
+
+import type { ConversationType } from '../message/MessageList'
+import type { DialogProps } from '../../contexts/DialogContext'
+
+// getMessageReplyCount/getMessageReplyThread come from the fork's regenerated local
+// jsonrpc bindings; the published @deltachat/jsonrpc-client pinned in this workspace's
+// catalog predates them, so they're typed locally here to keep tsc green (same pattern
+// as useMessage.ts's MessageData widening).
+export const rpcWithReplies = BackendRemote.rpc as typeof BackendRemote.rpc & {
+  getMessageReplyCount(accountId: number, msgId: number): Promise<number>
+  getMessageReplyThread(accountId: number, msgId: number): Promise<number[]>
+}
+
+/** Core returns the whole reply chain (root + nested replies) sorted by timestamp. */
+async function fetchThread(accountId: number, msgId: number) {
+  const ids = await rpcWithReplies.getMessageReplyThread(accountId, msgId)
+  const messages = await BackendRemote.rpc.getMessages(accountId, ids)
+  return { ids, messages }
+}
+
+export type Props = {
+  accountId: number
+  chatId: number
+  msgId: number
+}
+
+export default function ReplyThread({
+  accountId,
+  chatId,
+  msgId,
+  onClose,
+}: Props & DialogProps) {
+  const tx = useTranslationFunction()
+
+  const chatFetch = useRpcFetch(BackendRemote.rpc.getFullChatById, [
+    accountId,
+    chatId,
+  ])
+  const threadFetch = useFetch(fetchThread, [accountId, msgId])
+
+  // Replies can arrive, get edited or get deleted while the dialog is open.
+  // They always live in this message's chat, so its events are enough.
+  const refresh = useEffectEvent(() => threadFetch.refresh())
+  useEffect(
+    () =>
+      onDCEvent(accountId, 'MsgsChanged', ({ chatId: eventChatId }) => {
+        if (eventChatId === chatId) {
+          refresh()
+        }
+      }),
+    [accountId, chatId]
+  )
+
+  const chat = chatFetch.result?.ok ? chatFetch.result.value : null
+  const thread = threadFetch.lingeringResult?.ok
+    ? threadFetch.lingeringResult.value
+    : null
+
+  const conversationType: ConversationType | null = chat && {
+    hasMultipleParticipants: chat.chatType !== 'Single',
+    isDeviceChat: chat.isDeviceChat as boolean,
+    chatType: chat.chatType,
+  }
+
+  return (
+    <Dialog onClose={onClose}>
+      <DialogHeader title={tx('reply_thread')} onClose={onClose} />
+      <DialogBody>
+        {chat && conversationType && thread ? (
+          <MessagesDisplayContext.Provider
+            value={{
+              context: 'chat_messagelist',
+              chatId,
+              isDeviceChat: chat.isDeviceChat,
+            }}
+          >
+            {/* The bubbles' hover shortcut menu offers "react", which needs
+            this provider; the message list has its own instance, but dialogs
+            render outside of it. */}
+            <ReactionsBarProvider>
+              {/* ponytail: unvirtualized; threads are short — steal
+              react-window from ChatList if someone builds a 1000-reply
+              thread */}
+              <ol
+                className={styles.threadMessageList}
+                aria-label={tx('messages')}
+              >
+                {thread.ids.map(id => {
+                  const message = thread.messages[id]
+                  if (message?.kind !== 'message') {
+                    return null
+                  }
+                  return (
+                    <li key={id} className='message-wrapper'>
+                      <Message
+                        chat={chat}
+                        message={message}
+                        conversationType={conversationType}
+                      />
+                    </li>
+                  )
+                })}
+              </ol>
+            </ReactionsBarProvider>
+          </MessagesDisplayContext.Provider>
+        ) : (
+          <DialogContent>
+            <p>{tx('loading')}</p>
+          </DialogContent>
+        )}
+      </DialogBody>
+    </Dialog>
+  )
+}
