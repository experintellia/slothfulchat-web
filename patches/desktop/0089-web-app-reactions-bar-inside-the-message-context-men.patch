new file mode 100644
index 0000000..65be824
--- /dev/null
+++ b/packages/frontend/src/components/dialogs/SelectTextDialog.tsx
@@ -0,0 +1,41 @@
+import React from 'react'
+
+import { DialogBody, DialogWithHeader } from '../Dialog'
+import MessageBody from '../message/MessageBody'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+
+import type { DialogProps } from '../../contexts/DialogContext'
+
+/**
+ * Phones: a long press on a message opens its menu, so message text can't be
+ * selected in the chat. This shows the message as it looks there, with
+ * nothing to do but select (links are plain text).
+ */
+export default function SelectTextDialog({
+  text,
+  direction,
+  onClose,
+}: { text: string; direction: 'incoming' | 'outgoing' } & DialogProps) {
+  const tx = useTranslationFunction()
+  return (
+    <DialogWithHeader
+      title={tx('select_text')}
+      onClose={onClose}
+      dataTestid='select-text-dialog'
+    >
+      <DialogBody>
+        <div className='select-text-dialog'>
+          <div className={`message ${direction}`}>
+            <div className='msg-container'>
+              <div className='msg-body'>
+                <div dir='auto' className='text'>
+                  <MessageBody text={text} nonInteractiveContent />
+                </div>
+              </div>
+            </div>
+          </div>
+        </div>
+      </DialogBody>
+    </DialogWithHeader>
+  )
+}
