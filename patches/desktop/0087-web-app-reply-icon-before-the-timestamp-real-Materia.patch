+/**
+ * Reply icon + count for messages that have direct replies (modeled after
+ * {@link ViewCount}). Clicking it opens the {@link ReplyThread} dialog.
+ * Renders nothing while loading or when there are no replies.
+ */
+function ReplyCount(props: {
+  messageId: number
+  chatId: number
+  tabindexForInteractiveContents: -1 | 0
+}) {
+  const tx = useTranslationFunction()
+  const accountId = selectedAccountId()
+  const { openDialog } = useDialog()
+
+  const replyCountFetch = useRpcFetch(
+    useMemo(
+      () =>
+        asyncThrottle(
+          (...args: Parameters<typeof rpcWithReplies.getMessageReplyCount>) =>
+            rpcWithReplies.getMessageReplyCount(...args),
+          250
+        ),
+      []
+    ),
+    [accountId, props.messageId]
+  )
+
+  const refreshReplyCount = useEffectEvent(() => replyCountFetch.refresh())
+  useEffect(() => {
+    // Replies always live in the same chat as this message,
+    // so only this chat's events can change the count.
+    const onChatEvent = ({ chatId }: { chatId: number }) => {
+      if (chatId === props.chatId) {
+        refreshReplyCount()
+      }
+    }
+    const cleanup = [
+      onDCEvent(accountId, 'MsgsChanged', onChatEvent),
+      onDCEvent(accountId, 'IncomingMsg', onChatEvent),
+    ]
+    return () => cleanup.forEach(off => off())
+  }, [accountId, props.chatId])
+
+  const count = replyCountFetch.lingeringResult?.ok
+    ? replyCountFetch.lingeringResult.value
+    : 0
+  if (count === 0) {
+    return null
+  }
+
+  const label = tx('n_replies', String(count), { quantity: count })
+  return (
+    <button
+      type='button'
+      className='replyCount'
+      title={label}
+      aria-label={label}
+      tabIndex={props.tabindexForInteractiveContents}
+      onClick={ev => {
+        // Don't let the bubble's Ctrl/Shift + Click selection handling
+        // swallow this as a message click.
+        ev.stopPropagation()
+        openDialog(ReplyThread, {
+          accountId,
+          chatId: props.chatId,
+          msgId: props.messageId,
+        })
+      }}
+    >
+      <span aria-hidden className='replyCountIcon' />
+      <span className='replyCountValue'>{count}</span>
+    </button>
+  )
+}
