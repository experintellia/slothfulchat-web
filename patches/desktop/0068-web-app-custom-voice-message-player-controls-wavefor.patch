+    src: string
+    peaks: Float32Array
+  } | null>(null)
+  const peaks = peaksState?.src === src ? peaksState.peaks : null
+
+  // Keep the local rate in sync with the global one so all bubbles agree
+  // (on mount and whenever the global rate changes). Setting it fires
+  // `ratechange`, which the mirror applies to the singleton only when this
+  // is the active src.
+  useEffect(() => {
+    const el = audioRef.current
+    if (el != null) {
+      el.playbackRate = ctx.playbackRate
+      // Loading a new `src` resets `playbackRate` to `defaultPlaybackRate`,
+      // so set both — same as setPlaybackRate does for the singleton.
+      el.defaultPlaybackRate = ctx.playbackRate
+    }
+  }, [audioRef, ctx.playbackRate])
+
+  // Peaks pipeline: kick off once per src; never blocks playback.
+  useEffect(() => {
+    let cancelled = false
+    getPeaks(src).then(p => {
+      if (!cancelled && p != null) {
+        setPeaksState({ src, peaks: p })
+      }
+    })
+    return () => {
+      cancelled = true
+    }
+  }, [src])
+
+  // Remembered position (A2): restore on metadata (and on replay from the top,
+  // via the play button), save while playing (throttled ~2s) and immediately on
+  // pause. Clear-on-ended is on the singleton (survives unmount).
+  useEffect(() => {
+    const el = audioRef.current
+    if (el == null) {
+      return
+    }
+    let lastSave = 0
+    const restore = () => {
+      // One-way only (same invariant as onPlayGlobal): never yank back a
+      // mid-play singleton — a restore-seek here would be mirrored onto it by
+      // the mutex onSeeking. If the singleton already owns this src, its own
+      // position is the truth.
+      const globalEl = ctx.audioElement
+      if (
+        !globalEl.paused &&
+        globalEl.getAttribute('src') === src &&
+        // Fresh start (<1s, e.g. auto-advance onto a half-heard message) may
+        // still be restored — same fresh-start test as the onPlayGlobal carry.
+        globalEl.currentTime >= 1
+      ) {
+        return
+      }
+      restorePosition(el, src)
+    }
+    const onTime = () => {
+      if (el.paused || el.currentTime <= 1) {
+        return
+      }
+      const t = Date.now()
+      if (t - lastSave > 2000) {
+        lastSave = t
+        positionStore.setPosition(src, el.currentTime)
+      }
+    }
+    const onPause = () => {
+      if (!el.ended && el.currentTime > 1) {
+        positionStore.setPosition(src, el.currentTime)
+      }
+    }
+    // Clear-on-ended lives on the singleton (MediaPlayerMutexProvider) so it
+    // fires even when this bubble unmounted mid-play; no local 'ended' needed.
+    if (el.readyState >= 1 /* HAVE_METADATA */) {
+      restore()
+    }
+    el.addEventListener('loadedmetadata', restore)
+    el.addEventListener('timeupdate', onTime)
+    el.addEventListener('pause', onPause)
+    return () => {
+      el.removeEventListener('loadedmetadata', restore)
+      el.removeEventListener('timeupdate', onTime)
+      el.removeEventListener('pause', onPause)
+    }
+  }, [audioRef, src, ctx.audioElement])
+
+  return (
+    <div
+      className={classNames(
+        styles.customControls,
+        compact && styles.customControlsCompact
+      )}
+    >
+      <IconButton
+        icon={paused ? 'play' : 'pause'}
+        coloring='currentColor'
+        aria-label={paused ? tx('menu_play') : tx('menu_pause')}
+        tabIndex={tabIndex}
+        onClick={() => {
+          const el = audioRef.current
+          if (el == null) {
+            return
+          }
+          // A user click is the non-programmatic path: the mirror's
+          // ignore-refs are only set when the global element drives us.
+          if (el.paused) {
+            // Re-play within the same mount: a prior mutex takeover zeroed this
+            // element (cleanup), so re-apply the saved position BEFORE play —
+            // the scrub-carryover in mutex onPlay then brings the singleton
+            // along. (No-op when resuming a same-src pause: currentTime >= 1.)
+            if (el.currentTime < 1) {
+              restorePosition(el, src)
+            }
+            el.play()
+          } else {
+            el.pause()
+          }
+        }}
+      />
+      {/* Two rows right of the play button: the seek/waveform gets the full
+          width, time and speed sit below it (the usual messenger layout). */}
+      <div className={styles.stack}>
+        <div className={styles.seekWrap}>
+          {peaks != null && (
+            <WaveformCanvas
+              peaks={peaks}
+              progress={progress}
+              className={styles.waveformCanvas}
+            />
+          )}
+          <input
+            type='range'
+            className={classNames(
+              styles.seek,
+              peaks != null && styles.seekOverWaveform
+            )}
+            min={0}
+            max={safeDuration}
+            step='any'
+            value={Math.min(currentTime, safeDuration)}
+            tabIndex={tabIndex}
+            aria-label={tx('a11y_audio_seek')}
+            aria-valuetext={`${formatAudioTime(
+              Math.min(currentTime, safeDuration)
+            )} / ${formatAudioTime(safeDuration)}`}
+            onPointerDown={() => {
+              seekingRef.current = true
+            }}
+            onPointerUp={() => {
+              seekingRef.current = false
+            }}
+            onChange={e => {
+              const v = Number(e.currentTarget.value)
+              // Update state too: with `sync()` suppressed during the drag, a
+              // skip-only fix would leave the controlled value stale and snap
+              // the thumb back on every pointermove.
+              setCurrentTime(v)
+              const el = audioRef.current
+              if (el != null) {
+                // A scrub before play is carried onto the singleton on play
+                // (see MediaPlayerMutexContext.onPlay), so it's mirrored now.
+                el.currentTime = v
+              }
+            }}
+          />
+        </div>
+        <div className={styles.metaRow}>
+          <span className={styles.time}>
+            {formatAudioTime(currentTime)} / {formatAudioTime(safeDuration)}
+          </span>
+          <button
+            type='button'
+            className={styles.speedPill}
+            tabIndex={tabIndex}
+            aria-label={tx('a11y_playback_speed', `${ctx.playbackRate}×`)}
+            onClick={() =>
+              ctx.setPlaybackRate(nextPlaybackRate(ctx.playbackRate))
+            }
+          >
+            {ctx.playbackRate}×
+          </button>
+        </div>
+      </div>
+    </div>
   )
 }
 
diff --git a/packages/frontend/src/components/AudioPlayer/peaks.ts b/packages/frontend/src/components/AudioPlayer/peaks.ts
new file mode 100644
index 0000000..3295eef
--- /dev/null
+++ b/packages/frontend/src/components/AudioPlayer/peaks.ts
@@ -0,0 +1,211 @@
+// Voice-message waveform peaks — a progressive enhancement over the plain seek
+// bar, never a dependency. On any error/timeout getPeaks resolves null and the
+// player silently keeps the A1 bar. Playback never waits on this.
+//
+// Pipeline: in-session cache → fetch(src) → arrayBuffer → decodeAudioData →
+// hand channel-0 to the shared worker for max-abs bucketing → Float32Array.
+//
+// Decode stays on the main thread on purpose: decodeAudioData is async and
+// runs the actual decode off-thread internally, but it only exists on
+// AudioContext/OfflineAudioContext, which a plain (non-AudioWorklet) Worker
+// can't construct — so a worker can't decode. Only the cheap bucketing loop is
+// offloaded.
+
+import { getLogger } from '@deltachat-desktop/shared/logger'
+
+const log = getLogger('AudioPlayer/peaks')
+
+const N_PEAKS = 64
+const TIME_BUDGET_MS = 4000
+const CACHE_MAX = 100
+
+// ponytail: bounded in-session cache, NO persistent peak cache (issue A2.5 —
+// measure first). FIFO by insertion order, ~100 entries keyed by src. The
+// in-flight PROMISE is cached (not the settled value) so two bubbles mounting
+// the same src share one pipeline; a failed src stays cached as a null-promise
+// and isn't retried every render.
+const cache = new Map<string, Promise<Float32Array | null>>()
+
+// --- User Timing (sc:waveform:*), all best-effort ------------------------
+function measure(
+  name: string,
+  start: number,
+  end: number,
+  detail: { durationSec: number; bytes: number }
+): void {
+  try {
+    performance.measure(name, { start, end, detail })
+  } catch {
+    // performance.measure can throw in exotic environments; timing is best-effort
+  }
+}
+function fallbackMark(reason: string): void {
+  try {
+    performance.mark('sc:waveform:fallback', { detail: { reason } })
+  } catch {
+    /* best-effort */
+  }
+}
+
+// --- shared bucketing worker (lazy, module-level) ------------------------
+// undefined = not yet tried, null = construction failed (fallback forever).
+let worker: Worker | null | undefined
+let nextId = 0
+const pending = new Map<number, (peaks: Float32Array | null) => void>()
+
+function getWorker(): Worker | null {
+  if (worker !== undefined) {
+    return worker
+  }
+  try {
+    // Resolve relative to the document (like the web-app's BASE convention for
+    // core/worker.js): a root-absolute '/waveform-worker.js' 404s on subpath
+    // deploys (e.g. GitHub Pages project sites).
+    worker = new Worker(new URL('waveform-worker.js', location.href), {
+      type: 'module',
+    })
+    worker.onmessage = (e: MessageEvent) => {
+      const { id, peaks } = e.data
+      const resolve = pending.get(id)
+      if (resolve) {
+        pending.delete(id)
+        resolve(peaks)
+      }
+    }
+    // A load error (targets that don't serve the file) fires asynchronously and
+    // does NOT throw above. Treat any worker error as a permanent fallback: drop
+    // the worker so getWorker() never hands out a dead one again, and settle
+    // in-flight callers now (releasing their retained AudioBuffers) instead of
+    // leaking one `pending` entry each until the 4s budget.
+    worker.onerror = () => {
+      log.debug('waveform worker failed; permanent fallback')
+      worker?.terminate()
+      worker = null
+      for (const resolve of pending.values()) {
+        resolve(null)
+      }
+      pending.clear()
+    }
+  } catch {
+    // Some environments don't serve the file / block module workers.
+    worker = null
+  }
+  return worker
+}
+
+function bucketInWorker(
+  channel: Float32Array,
+  n: number
+): Promise<Float32Array | null> {
+  const w = getWorker()
+  if (w == null) {
+    return Promise.resolve(null)
+  }
+  return new Promise(resolve => {
+    const id = nextId++
+    pending.set(id, resolve)
+    w.postMessage({ id, data: channel, n }, [channel.buffer])
+  })
+}
+
+// --- pipeline ------------------------------------------------------------
+async function computePeaks(
+  src: string,
+  signal: AbortSignal
+): Promise<Float32Array | null> {
+  // Worker known dead (load failed / unavailable): skip the pointless fetch +
+  // main-thread decode and fall back to the plain bar. Also warms the worker on
+  // the first call, in parallel with the fetch below.
+  if (getWorker() == null) {
+    fallbackMark('no-worker')
+    return null
+  }
+  try {
+    const t0 = performance.now()
+    const resp = await fetch(src, { signal })
+    const bytes = await resp.arrayBuffer()
+    // Read now: decodeAudioData detaches the buffer, after which byteLength
+    // reports 0.
+    const byteLength = bytes.byteLength
+    const t1 = performance.now()
+
+    const Ctx =
+      (window as any).OfflineAudioContext ||
+      (window as any).webkitOfflineAudioContext
+    // Length/sampleRate are irrelevant to a decode-only context.
+    const ctx: OfflineAudioContext = new Ctx(1, 1, 44100)
+    const audioBuffer = await ctx.decodeAudioData(bytes)
+    const t2 = performance.now()
+
+    // slice() so we transfer a copy and don't neuter the AudioBuffer's channel.
+    const channel = audioBuffer.getChannelData(0).slice()
+    const peaks = await bucketInWorker(channel, N_PEAKS)
+    const t3 = performance.now()
+
+    // The 4s budget already fired (result discarded, 'timeout' marked): don't
+    // pile success measures onto a run whose peaks were thrown away.
+    if (signal.aborted) {
+      return null
+    }
+    // Worker died mid-flight (onerror flushed `pending` with null): fall back
+    // instead of reporting a phantom success.
+    if (peaks == null) {
+      fallbackMark('no-worker')
+      return null
+    }
+
+    const detail = {
+      durationSec: audioBuffer.duration,
+      bytes: byteLength,
+    }
+    measure('sc:waveform:fetch', t0, t1, detail)
+    measure('sc:waveform:decode', t1, t2, detail)
+    measure('sc:waveform:bucket', t2, t3, detail)
+    return peaks
+  } catch (e) {
+    // Aborted by the budget timeout is already marked as 'timeout'.
+    if (!signal.aborted) {
+      log.debug('waveform peaks failed', e)
+      fallbackMark('error')
+    }
+    return null
+  }
+}
+
+/**
+ * Peaks for the given (already transformed) audio URL, or null to fall back to
+ * the plain seek bar. Bounded ~4s budget; the in-flight promise is cached for
+ * the session so concurrent callers for the same src share one pipeline.
+ */
+export function getPeaks(src: string): Promise<Float32Array | null> {
+  // Srcs carry a per-message #msg fragment (forward vs original of the same
+  // deduped blob must not share mirroring/positions) — but their AUDIO is
+  // identical, so peaks are cached and fetched by the fragment-less URL: one
+  // decode per blob, not per message.
+  const blobUrl = src.split('#')[0]
+  const hit = cache.get(blobUrl)
+  if (hit !== undefined) {
+    return hit
+  }
+  const ac = new AbortController()
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const timeout = new Promise<null>(resolve => {
+    timer = setTimeout(() => {
+      ac.abort()
+      fallbackMark('timeout')
+      resolve(null)
+    }, TIME_BUDGET_MS)
+  })
+  const result = Promise.race([computePeaks(blobUrl, ac.signal), timeout])
+    .catch(() => null)
+    .finally(() => clearTimeout(timer))
+
+  cache.set(blobUrl, result)
+  if (cache.size > CACHE_MAX) {
+    const oldest = cache.keys().next().value
+    if (oldest !== undefined) {
+      cache.delete(oldest)
+    }
+  }
+  return result
+}
