+/**
+ * One dumb subscription mirroring an `<audio>` element's state into React.
+ *
+ * `holdTimeRef.current === true` suspends `currentTime` updates (the seek thumb
+ * is being dragged), which is why `setCurrentTime` comes back out.
+ */
+export function useAudioElementState(
+  audioRef: React.RefObject<HTMLAudioElement | null>,
+  holdTimeRef?: React.RefObject<boolean>
+) {
+  const [paused, setPaused] = useState(true)
+  const [currentTime, setCurrentTime] = useState(0)
+  const [duration, setDuration] = useState(0)
+
+  useEffect(() => {
+    const el = audioRef.current
+    if (el == null) {
+      return
+    }
+    const sync = () => {
+      setPaused(el.paused)
+      if (holdTimeRef?.current !== true) {
+        setCurrentTime(el.currentTime)
+      }
+      setDuration(el.duration)
+    }
+    sync()
+    const events = ['timeupdate', 'durationchange', 'play', 'pause'] as const
+    events.forEach(ev => el.addEventListener(ev, sync))
+    return () => events.forEach(ev => el.removeEventListener(ev, sync))
+  }, [audioRef, holdTimeRef])
+
+  const safeDuration = Number.isFinite(duration) ? duration : 0
+  return {
+    paused,
+    currentTime,
+    safeDuration,
+    progress:
+      safeDuration > 0 ? Math.min(currentTime, safeDuration) / safeDuration : 0,
+    setCurrentTime,
+  }
+}
