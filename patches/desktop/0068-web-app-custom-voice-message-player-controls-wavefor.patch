+  audioRef,
+  src,
+  tabIndex,
+  compact,
+}: {
+  audioRef: React.RefObject<HTMLAudioElement | null>
+  src: string
+  tabIndex?: number
+  /** Drop the 300px min-width so the controls fit a narrow column (mini-player). */
