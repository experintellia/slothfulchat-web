+  // Reserve the waveform's height from first paint so the bubble geometry
+  // doesn't jump ~10px when peaks arrive (cf. #3753); peaks then only swap
+  // visuals. The plain range stays vertically centered inside it.
+  height: 32px;
+}
+.seek {
+  flex: 1;
+  min-width: 0;
+  accent-color: var(--colorPrimary);
+}
+// The canvas is the visual; the range on top stays the interaction layer.
+.waveformCanvas {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+}
+// Over a waveform the range goes fully transparent (track + thumb): the
+// played/unplayed colour split on the canvas is the position indicator, so a
+// separate thumb would just be visual noise. Interaction/keyboard/aria stay.
+.seekOverWaveform {
+  -webkit-appearance: none;
+  appearance: none;
+  background: transparent;
+  accent-color: transparent;
+  // appearance:none collapses the input's intrinsic height to 0, which also
+  // collapses .seekWrap (and with it the absolutely-positioned canvas) — give
+  // the interaction layer the waveform's height explicitly.
+  height: 32px;
+  &::-webkit-slider-runnable-track {
+    background: transparent;
+  }
+  &::-webkit-slider-thumb {
+    -webkit-appearance: none;
+    width: 0;
+    height: 0;
+  }
+  &::-moz-range-track {
+    background: transparent;
+  }
+  &::-moz-range-thumb {
+    width: 0;
+    border: none;
+    opacity: 0;
+  }
+}
+.time {
+  font-size: 0.85em;
+  font-variant-numeric: tabular-nums;
+}
+.speedPill {
+  @include mixins.button-reset;
+  border: 1px solid currentColor;
+  border-radius: 9999999px;
+  padding: 0.1rem 0.5rem;
+  font-size: 0.85em;
+  line-height: 1.2;
+}
diff --git a/packages/frontend/src/components/AudioPlayer/utils.ts b/packages/frontend/src/components/AudioPlayer/utils.ts
