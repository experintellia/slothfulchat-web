From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Sat, 17 Oct 2026 14:56:08 +0000
Subject: [PATCH] web-app: experimental switch for the server's own mail tunnel

Settings -> Experimental -> Connection -> "Use the mail server's own
tunnel" (experimentalServerTunnel, on by default while the feature is in
beta). Off, the core worker never probes mail hosts for madmail's
/mailtunnel IMAP/SMTP tunnel and every account goes through the bridge
as before. runtime.ts reads the setting when it starts the core worker,
so a change applies after a reload.
---
 .../src/components/Settings/ExperimentalFeatures.tsx       | 7 +++++++
 packages/shared/shared-types.d.ts                          | 2 ++
 packages/shared/state.ts                                   | 1 +
 3 files changed, 10 insertions(+)

diff --git a/packages/frontend/src/components/Settings/ExperimentalFeatures.tsx b/packages/frontend/src/components/Settings/ExperimentalFeatures.tsx
index cc431cfabe557c0d47b21f9049fa7caad1853fe5..dc893821ff72d79291fd41bab96bb061be64e6f0 100644
--- a/packages/frontend/src/components/Settings/ExperimentalFeatures.tsx
+++ b/packages/frontend/src/components/Settings/ExperimentalFeatures.tsx
@@ -141,6 +141,13 @@ export function ExperimentalFeatures() {
         }
       />
       <SettingsSeparator />
+      <SettingsHeading>Connection</SettingsHeading>
+      <DesktopSettingsSwitch
+        settingsKey='experimentalServerTunnel'
+        label="Use the mail server's own tunnel"
+        description='Servers that offer one (madmail) are reached directly, over WebSocket or HTTP long-polling, instead of through the bridge. On by default (beta). Reload the page after changing this.'
+      />
+      <SettingsSeparator />
       <SettingsHeading>System</SettingsHeading>
       {runtime.getRuntimeInfo().isContentProtectionSupported && (
         <DesktopSettingsSwitch
diff --git a/packages/shared/shared-types.d.ts b/packages/shared/shared-types.d.ts
index 69d2e7284980e3535086226a6af883f6d3857b5f..3c2bb1caa70d78d012c9c3f0f2897bdedb28f5ed 100644
--- a/packages/shared/shared-types.d.ts
+++ b/packages/shared/shared-types.d.ts
@@ -49,6 +49,8 @@ export interface DesktopSettingsType {
   experimentalUnreadReadTime: boolean
   /** webapp: Telegram-style reply threads (reply badge, thread mode in the message list). Off by default (experimental). */
   experimentalReplyThreads: boolean
+  /** webapp: reach mail servers that tunnel their own IMAP/SMTP (madmail /mailtunnel) through that tunnel instead of the bridge. On by default (beta); read when the core starts. */
+  experimentalServerTunnel: boolean
   /** webapp: spelling/grammar check in the composer. Off by default. */
   grammarCheck: boolean
   /** webapp: which checker: Harper (English only, runs on this device) or LanguageTool (sends the draft to the server below) */
diff --git a/packages/shared/state.ts b/packages/shared/state.ts
index efe6b51aa9c95d088f39bc49beceaf73b924dd49..1f2695647ffce1d25422790f4e23e8ddd84e2d61 100644
--- a/packages/shared/state.ts
+++ b/packages/shared/state.ts
@@ -19,6 +19,7 @@ export function getDefaultState(): DesktopSettingsType {
     experimentalCompletionMenu: true,
     experimentalUnreadReadTime: false,
     experimentalReplyThreads: false,
+    experimentalServerTunnel: true,
     grammarCheck: false,
     grammarCheckEngine: 'harper',
     languageToolServer: undefined,
