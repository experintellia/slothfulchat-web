diff --git a/packages/frontend/src/components/composer/completion/botCommandProvider.ts b/packages/frontend/src/components/composer/completion/botCommandProvider.ts
new file mode 100644
index 0000000..2a5388c
--- /dev/null
+++ b/packages/frontend/src/components/composer/completion/botCommandProvider.ts
@@ -0,0 +1,51 @@
+import * as linkify from 'linkifyjs'
+
+import '../../../utils/linkify/plugin-bot-command/index.js'
+
+import type { CompletionItem, CompletionProvider } from './types'
+
+// Bot-command completion for DM chats: if the contact's bio (status) lists
+// `/commands`, typing `/` in the composer suggests them. Reuses the same
+// linkify tokenizer that already turns `/command` into a clickable chip
+// inside a status/message (utils/linkify/plugin-bot-command), so the notion
+// of "what counts as a command" and its word-boundary rules stay in one
+// place instead of being reimplemented with a regex here.
+
+export type BotCommand = { command: string; description: string }
+
+export function parseBotCommandsFromStatus(status: string): BotCommand[] {
+  const commands: BotCommand[] = []
+  const seen = new Set<string>()
+  for (const line of status.split('\n')) {
+    for (const token of linkify.find(line, 'botcommand')) {
+      if (seen.has(token.value)) continue
+      seen.add(token.value)
+      const description = line
+        .slice(token.end)
+        .trim()
+        .replace(/^[-–:]\s*/, '')
+      commands.push({ command: token.value, description })
+    }
+  }
+  return commands
+}
+
+export function createBotCommandProvider(
+  commands: BotCommand[]
+): CompletionProvider {
+  return {
+    trigger: '/',
+    minChars: 0,
+    query(rawTerm: string): CompletionItem[] {
+      const term = rawTerm.toLowerCase()
+      return commands
+        .filter(c => c.command.slice(1).toLowerCase().startsWith(term))
+        .map(c => ({
+          id: c.command,
+          label: c.command,
+          value: c.command,
+          description: c.description || undefined,
+        }))
+    },
+  }
+}
