+
+describe('composer completion / botCommandProvider', () => {
+  it('extracts /commands and their trailing description from a bio', () => {
+    expect(
+      parseBotCommandsFromStatus(
+        'I am a bot.\n/help - Show this help\n/subscribe Subscribe to updates'
+      )
+    ).to.deep.equal([
+      { command: '/help', description: 'Show this help' },
+      { command: '/subscribe', description: 'Subscribe to updates' },
+    ])
+  })
+
+  it('ignores a bio with no bot commands', () => {
+    expect(parseBotCommandsFromStatus('Just a regular contact')).to.deep.equal(
+      []
+    )
+  })
+
+  it('dedupes repeated commands, keeping the first occurrence', () => {
+    expect(
+      parseBotCommandsFromStatus('/help - first\n/help - second')
+    ).to.deep.equal([{ command: '/help', description: 'first' }])
+  })
+
+  it('the provider lists everything on an empty term and filters by prefix', () => {
+    const provider = createBotCommandProvider([
+      { command: '/help', description: 'Show help' },
+      { command: '/status', description: '' },
+    ])
+    expect(provider.query('').map(i => i.value)).to.deep.equal([
+      '/help',
+      '/status',
+    ])
+    const matches = provider.query('he')
+    expect(matches.map(i => i.value)).to.deep.equal(['/help'])
+    expect(matches[0]?.description).to.equal('Show help')
+  })
+})
