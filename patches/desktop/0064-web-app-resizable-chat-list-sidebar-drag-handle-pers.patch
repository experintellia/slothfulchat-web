diff --git a/packages/frontend/src/components/screens/MainScreen/MainScreen.tsx b/packages/frontend/src/components/screens/MainScreen/MainScreen.tsx
index 1eb14a8..c0c8ac5 100644
--- a/packages/frontend/src/components/screens/MainScreen/MainScreen.tsx
+++ b/packages/frontend/src/components/screens/MainScreen/MainScreen.tsx
@@ -34,6 +34,13 @@ import { GlobalVoiceMessagePlayer } from '../../GlobalVoiceMessagePlayer/GlobalV
 
 const log = getLogger('MainScreen')
 
+// Keep in sync with `min-width` of `.chatListAndHeaderAndAudioPlayer`
+// in styles.module.scss.
+const CHAT_LIST_MIN_WIDTH = 295
+// Cap so the chat view keeps a usable width on narrow windows.
+const clampChatListWidth = (w: number) =>
+  Math.max(CHAT_LIST_MIN_WIDTH, Math.min(w, window.innerWidth - 400))
+
 type Props = {
   accountId?: number
 }
@@ -51,6 +58,21 @@ export default function MainScreen({ accountId }: Props) {
   const { chatId, chatWithLinger, selectChat, unselectChat } = useChat()
   const { smallScreenMode } = useContext(ScreenContext)
 
+  // Resizable chat list: an explicit width overrides the default 3:8 flex
+  // split (see styles.module.scss). null = default split.
+  // ponytail: localStorage, not DesktopSettings — UI-only per-device pref;
+  // promote to a settings key if it ever needs to sync across devices.
+  const chatListSidebarRef = useRef<HTMLDivElement>(null)
+  const [chatListWidth, setChatListWidth] = useState<number | null>(() => {
+    const w = Number(localStorage.getItem('chatListWidth'))
+    return w >= CHAT_LIST_MIN_WIDTH ? clampChatListWidth(w) : null
+  })
+  const saveChatListWidth = (w: number | null) => {
+    setChatListWidth(w)
+    if (w === null) localStorage.removeItem('chatListWidth')
+    else localStorage.setItem('chatListWidth', String(w))
+  }
+
   // Small hack/misuse of keyBindingAction to setArchivedChatsSelected from
   // other components (especially ViewProfile when selecting a shared chat/group)
   useKeyBindingAction(KeybindAction.ChatList_SwitchToArchiveView, () =>
@@ -276,7 +298,18 @@ export default function MainScreen({ accountId }: Props) {
         !messageSectionShouldBeHidden ? 'chat-view-open' : ''
       }`}
     >
-      <div className={styles.chatListAndHeaderAndAudioPlayer}>
+      <div
+        className={styles.chatListAndHeaderAndAudioPlayer}
+        ref={chatListSidebarRef}
+        style={
+          chatListWidth !== null && !smallScreenMode
+            ? // flex-shrink 1: on windows narrower than the stored width the
+              // sidebar gives way (down to its min-width) instead of
+              // squeezing the chat view to zero.
+              { flex: `0 1 ${chatListWidth}px` }
+            : undefined
+        }
+      >
         <section
           className={styles.chatListAndHeader}
           role='region'
@@ -321,6 +354,42 @@ export default function MainScreen({ accountId }: Props) {
 
         <GlobalVoiceMessagePlayer />
       </div>
+      {!smallScreenMode && (
+        <div
+          className={styles.chatListResizeHandle}
+          role='separator'
+          aria-orientation='vertical'
+          aria-label={tx('resize_chat_list')}
+          tabIndex={0}
+          data-testid='chat-list-resize-handle'
+          onPointerDown={e => e.currentTarget.setPointerCapture(e.pointerId)}
+          onPointerMove={e => {
+            const sidebar = chatListSidebarRef.current
+            if (!sidebar || !e.currentTarget.hasPointerCapture(e.pointerId)) {
+              return
+            }
+            const rect = sidebar.getBoundingClientRect()
+            const rtl = getComputedStyle(sidebar).direction === 'rtl'
+            saveChatListWidth(
+              clampChatListWidth(
+                rtl ? rect.right - e.clientX : e.clientX - rect.left
+              )
+            )
+          }}
+          // Double-click resets to the default flex split.
+          onDoubleClick={() => saveChatListWidth(null)}
+          onKeyDown={e => {
+            const sidebar = chatListSidebarRef.current
+            if (!sidebar || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) {
+              return
+            }
+            const rtl = getComputedStyle(sidebar).direction === 'rtl'
+            const grow = (e.key === 'ArrowRight') !== rtl ? 16 : -16
+            saveChatListWidth(clampChatListWidth(sidebar.offsetWidth + grow))
+            e.preventDefault()
+          }}
+        />
+      )}
       <ChatView
         className={styles.chatView}
         accountId={accountId}
