+.chatListResizeHandle {
+  flex: 0 0 5px;
+  cursor: col-resize;
+  // Overlay the chat view's edge so the panes still abut without a gap —
+  // overlaying the chat-list side instead would cover its scrollbar.
+  margin-inline-end: -5px;
+  z-index: 1;
+
+  &:hover,
+  &:focus-visible {
+    background-color: var(--scrollbarThumb);
+  }
+  &:active {
+    background-color: var(--scrollbarThumbHover);
+  }
+}
