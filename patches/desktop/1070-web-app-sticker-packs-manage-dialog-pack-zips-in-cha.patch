+// Manage Stickers dialog
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  padding: 12px 16px;
+}
+
+.toolButton {
+  flex-shrink: 0;
+  padding: 6px 12px;
+  border: 1px solid var(--separatorColor);
+  border-radius: 16px;
+  background: transparent;
+  color: var(--colorPrimary);
+  font: inherit;
+  cursor: pointer;
+
+  &:hover,
+  &:focus-visible {
+    background: var(--chatListItemBgHover);
+  }
+
+  &:disabled {
+    cursor: default;
+    opacity: 0.6;
+  }
+}
+
+.moreButton {
+  flex-shrink: 0;
+  width: 32px;
+  height: 32px;
+  border: none;
+  border-radius: 50%;
+  background: transparent;
+  color: var(--globalText);
+  font-size: 1.2em;
+  cursor: pointer;
+
+  &:hover,
+  &:focus-visible {
+    background: var(--chatListItemBgHover);
+  }
+}
+
+.pack {
+  margin: 0 8px 8px;
+  padding: 8px;
+  border: 2px solid transparent;
+  border-radius: 8px;
+}
+
+.dropTarget {
+  border-color: var(--colorPrimary);
+  border-style: dashed;
+}
+
+.packHeader {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 0 4px 6px;
+}
+
+.packName {
+  min-width: 0;
+  flex-grow: 1;
+  font-weight: bold;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.packCount {
+  color: var(--contactEmailColor);
+  font-size: 0.9em;
+}
+
+.grid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  min-height: 48px;
+}
+
+.recent {
+  flex-wrap: nowrap;
+  overflow-x: auto;
+}
+
+.sticker {
+  position: relative;
+  flex-shrink: 0;
+  padding: 4px;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  cursor: grab;
