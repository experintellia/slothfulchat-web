@@ -0,0 +1,52 @@
+import { BackendRemote } from '../backend-com'
+
+// The sticker pack RPCs come from the fork's regenerated local jsonrpc
+// bindings (core sticker packs); the published @deltachat/jsonrpc-client
+// pinned in this workspace's catalog predates them, so they're typed locally
+// here to keep tsc green (same pattern as replyThreads.ts).
+
+export type StickerObject = { id: number; path: string }
+export type StickerPackObject = {
+  id: number
+  name: string
+  stickers: StickerObject[]
+}
+
+export const rpcStickers = BackendRemote.rpc as typeof BackendRemote.rpc & {
+  getStickerPacks(accountId: number): Promise<StickerPackObject[]>
+  createStickerPack(accountId: number, name: string): Promise<number>
+  renameStickerPack(
+    accountId: number,
+    packId: number,
+    name: string
+  ): Promise<void>
+  deleteStickerPack(accountId: number, packId: number): Promise<void>
+  addStickerFromFile(
+    accountId: number,
+    packId: number,
+    path: string,
+    name: string
+  ): Promise<number>
+  addStickerFromMessage(
+    accountId: number,
+    packId: number,
+    msgId: number
+  ): Promise<number>
+  moveSticker(
+    accountId: number,
+    stickerId: number,
+    toPackId: number
+  ): Promise<void>
+  copySticker(
+    accountId: number,
+    stickerId: number,
+    toPackId: number
+  ): Promise<number>
+  removeSticker(accountId: number, stickerId: number): Promise<void>
+  copyStickerPackFromAccount(
+    accountId: number,
+    fromAccountId: number,
+    packId: number
+  ): Promise<number>
+  getUnsavedStickerMessages(accountId: number, limit: number): Promise<number[]>
+}
