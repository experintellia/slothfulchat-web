+  user-select: none;
+
+  &:hover,
+  &:focus-visible {
+    background: var(--chatListItemBgHover);
+  }
+}
+
+.emojiBadge {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  padding: 0 3px;
+  border-radius: 8px;
+  background: var(--bgPrimary);
+  font-size: 0.8em;
+  line-height: 1.4;
+  pointer-events: none;
+}
+
+.emojiChips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  min-height: 32px;
+  padding: 8px 0;
+}
+
+.emojiChip {
+  padding: 2px 8px;
+  border: 1px solid var(--separatorColor);
+  border-radius: 16px;
+  background: transparent;
+  color: var(--globalText);
+  font: inherit;
+  font-size: 1.2em;
+  cursor: pointer;
+
+  &:hover,
+  &:focus-visible {
+    background: var(--chatListItemBgHover);
+  }
+}
+
+.thumbImg {
+  display: block;
+  object-fit: contain;
+}
+
+.thumbLottie {
+  display: block;
+}
+
+.touchGhost {
+  position: fixed;
+  z-index: 10;
+  transform: translate(-50%, -50%) scale(1.15);
+  opacity: 0.85;
+  pointer-events: none;
+}
+
+.hint {
+  padding: 4px;
+  color: var(--contactEmailColor);
+  font-size: 0.9em;
+}
+
+.otherPack {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 6px 4px;
+}
+
+.otherPreview {
+  display: grid;
+  grid-template-columns: repeat(2, 32px);
+  grid-auto-rows: 32px;
+  flex-shrink: 0;
+  width: 64px;
+  height: 64px;
+}
+
+.otherText {
+  min-width: 0;
+  flex-grow: 1;
+}
+
+// Sticker pack card for a received .zip
+
+.zipCard {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 8px;
+  max-width: 320px;
+}
+
+.zipCardGrid {
+  display: grid;
+  grid-template-columns: repeat(2, 48px);
+  grid-auto-rows: 48px;
+  gap: 2px;
+  flex-shrink: 0;
+  padding: 2px;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  cursor: pointer;
+
+  &:hover,
+  &:focus-visible {
+    background: var(--chatListItemBgHover);
+  }
+
+  img {
+    width: 48px;
+    height: 48px;
+    object-fit: contain;
+  }
+}
+
+.zipCardAnimated {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 6px;
+  background: var(--chatListItemBgHover);
+}
+
+.zipCardText {
+  min-width: 0;
+}
+
+.zipCardName {
+  font-weight: bold;
+  overflow-wrap: anywhere;
+}
+
+.zipCardCount {
+  margin-bottom: 6px;
+  color: var(--messageAttachmentFileInfo);
+  font-size: 0.9em;
+}
+
+.zipCardButton {
+  @extend .toolButton;
+}
+
+.added {
+  color: var(--messageAttachmentFileInfo);
+}
+
+// Pack inspector: the whole pack of a received .zip
+
+.inspectCount {
+  @extend .packCount;
+  padding: 0 16px 8px;
+}
+
+.inspectGrid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  padding: 0 12px 12px;
+}
+
+.inspectSticker {
+  @extend .sticker;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  cursor: pointer;
+}
+
+.inspectEmojis {
+  max-width: 72px;
+  overflow: hidden;
+  font-size: 0.8em;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.bigPreviewLayer {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  // hover previews must not steal the pointer from the sticker underneath
+  pointer-events: none;
+}
+
+.bigPreview {
+  padding: 16px;
+  border-radius: 16px;
+  background: var(--bgPrimary);
+  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
+  text-align: center;
+
+  &.pinned {
+    pointer-events: auto;
+    cursor: pointer;
+  }
+
+  img {
+    max-width: 70vw;
+    height: auto;
+  }
+}
+
+.bigPreviewEmojis {
+  padding-top: 8px;
+  font-size: 1.6em;
+}
+
+// Composer sticker picker: bottom bar (like the emoji picker's categories)
+// and the empty state
+
+.pickerBar {
+  display: flex;
+  flex-shrink: 0;
+  align-items: center;
+  height: 44px;
+  padding: 0 4px;
+  border-top: 1px solid var(--separatorColor);
+  background: var(--emojiMartBg);
+}
+
+.pickerBarPacks {
+  display: flex;
+  flex-grow: 1;
+  min-width: 0;
+  height: 100%;
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.pickerBarPack {
+  position: relative;
+  display: flex;
+  flex-shrink: 0;
+  align-items: center;
+  justify-content: center;
+  width: 40px;
+  height: 100%;
+  padding: 0;
+  border: none;
+  background: transparent;
+  cursor: pointer;
+  opacity: 0.6;
+
+  &:hover,
+  &:focus-visible {
+    opacity: 1;
+  }
+
+  // the emoji picker marks its current category with a bar along the edge
+  &.selected {
+    opacity: 1;
+
+    &::after {
+      content: '';
+      position: absolute;
+      top: 0;
+      left: 6px;
+      right: 6px;
+      height: 3px;
+      border-radius: 0 0 3px 3px;
+      background: var(--colorPrimary);
+    }
+  }
+
+  &.dropTarget {
+    opacity: 1;
+    border-radius: 8px;
+    outline: 2px dashed var(--colorPrimary);
+    outline-offset: -4px;
+  }
+}
+
+.pickerBarManage {
+  flex-shrink: 0;
+  margin-inline-start: 4px;
+}
+
+.pickerActions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 8px;
+  padding: 8px;
+}
+
+.pickerNote {
+  padding: 0 16px 8px;
+  color: var(--contactEmailColor);
+  font-size: 0.85em;
+  text-align: center;
+}
