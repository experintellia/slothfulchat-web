+import React, { useEffect, useRef, useState } from 'react'
+import classNames from 'classnames'
+
+import { runtime } from '@deltachat-desktop/runtime-interface'
+import { Type } from '../../backend-com'
+import { rpcStickers } from '../../backend/stickerPacks'
+import { selectedAccountId } from '../../ScreenController'
+import LottieSticker from '../attachment/LottieSticker'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+
+import styles from './styles.module.scss'
+
+/**
+ * Sticker packs (slothfulchat). The core stores and manages packs
+ * (`getStickerPacks` & co.); what needs a zip library — recognizing a pack in
+ * a chat, previewing, importing and exporting one — lives in slothfulchat-web's
+ * packages/web-app/src/sticker-packs.ts as window.__slothfulStickers.
+ */
+type PackPreview = { name: string; count: number; previews: string[] }
+type StickersApi = {
+  inspect(
+    path: string,
+    zipName: string,
+    size: number
+  ): Promise<PackPreview | null>
+  importZip(
+    accountId: number,
+    path: string,
+    zipName: string
+  ): Promise<{ packId: number; name: string; added: number; skipped: number }>
+  exportPack(accountId: number, packId: number): Promise<void>
+}
+
+/** undefined on runtimes without the zip half (upstream Electron/Tauri) */
+export const stickersApi = (): StickersApi | undefined =>
+  (window as any).__slothfulStickers
+
+export const isZipFile = (name: string | null | undefined) =>
+  /\.zip$/i.test(name ?? '')
+
+/** Imports a zip and tells the user how it went. */
+export async function importStickerZip(
+  tx: ReturnType<typeof useTranslationFunction>,
+  path: string,
+  zipName: string
+): Promise<number | null> {
+  const api = stickersApi()
+  if (!api) return null
+  try {
+    const result = await api.importZip(selectedAccountId(), path, zipName)
+    window.__userFeedback({
+      type: 'success',
+      text:
+        result.skipped > 0
+          ? tx('sticker_packs_imported_skipped', [
+              result.name,
+              String(result.added),
+              String(result.skipped),
+            ])
+          : tx('sticker_packs_imported', result.name),
+    })
+    return result.packId
+  } catch {
+    window.__userFeedback({
+      type: 'error',
+      text: tx('sticker_packs_not_a_pack'),
+    })
+    return null
+  }
+}
+
+/** A sticker thumbnail; .tgs plays through the Lottie player. */
+export function StickerThumb({ path, size }: { path: string; size: number }) {
+  const src = runtime.transformStickerURL(path)
+  return /\.tgs$/i.test(path) ? (
+    <LottieSticker
+      key={path}
+      src={src}
+      size={size}
+      className={styles.thumbLottie}
+    />
+  ) : (
+    <img
+      src={src}
+      width={size}
+      height={size}
+      className={styles.thumbImg}
+      alt=''
+    />
+  )
+}
+
+/**
+ * A received .zip that holds a sticker pack, shown as a pack card with a few
+ * stickers and an "Add" button instead of a plain file tile. Until the zip is
+ * checked (only once it scrolls into view, one zip at a time, see
+ * sticker-packs.ts) and whenever it is not a pack, `fallback` is shown.
+ */
+export function StickerPackZipCard({
+  message,
+  fallback,
+}: {
+  message: Type.Message & { file: string }
+  fallback: React.ReactElement
+}) {
+  const tx = useTranslationFunction()
+  const ref = useRef<HTMLDivElement>(null)
+  const [pack, setPack] = useState<PackPreview | null>(null)
+  const [state, setState] = useState<'idle' | 'importing' | 'added'>('idle')
+
+  useEffect(() => {
+    const api = stickersApi()
+    const el = ref.current
+    if (!api || !el || message.downloadState !== 'Done') return
+    let cancelled = false
+    const io = new IntersectionObserver(([entry]) => {
+      if (!entry.isIntersecting) return
+      io.disconnect()
+      api
+        .inspect(message.file, message.fileName ?? '', message.fileBytes ?? 0)
+        .then(result => !cancelled && setPack(result))
+    })
+    io.observe(el)
+    return () => {
+      cancelled = true
+      io.disconnect()
+    }
+  }, [message.file, message.fileName, message.fileBytes, message.downloadState])
+
+  useEffect(() => {
+    if (!pack) return
+    // "Added" when a pack of that name and size is already installed.
+    // ponytail: name+count, not content; a renamed or edited copy shows "Add"
+    // again, and adding it twice just makes "Name (2)".
+    rpcStickers
+      .getStickerPacks(selectedAccountId())
+      .then(packs => {
+        if (
+          packs.some(
+            p => p.name === pack.name && p.stickers.length === pack.count
+          )
+        ) {
+          setState('added')
+        }
+      })
+      .catch(() => {})
+  }, [pack])
+
+  if (!pack) {
+    return <div ref={ref}>{fallback}</div>
+  }
+
+  const onAdd = async (ev: React.MouseEvent) => {
+    ev.stopPropagation()
+    setState('importing')
+    const id = await importStickerZip(tx, message.file, message.fileName ?? '')
+    setState(id == null ? 'idle' : 'added')
+  }
+
+  return (
+    <div className={styles.zipCard} data-testid='sticker-pack-card'>
+      <div className={styles.zipCardGrid}>
+        {pack.previews.map((url, i) =>
+          url ? (
+            <img key={i} src={url} alt='' />
+          ) : (
+            <div key={i} className={styles.zipCardAnimated} aria-hidden>
+              🎞️
+            </div>
+          )
+        )}
+      </div>
+      <div className={styles.zipCardText}>
+        <div className={styles.zipCardName}>{pack.name}</div>
+        <div className={styles.zipCardCount}>
+          {tx('sticker_packs_n_stickers', String(pack.count))}
+        </div>
+        <button
+          type='button'
+          className={classNames(styles.zipCardButton, {
+            [styles.added]: state === 'added',
+          })}
+          disabled={state !== 'idle'}
+          onClick={onAdd}
+        >
+          {state === 'added'
+            ? tx('sticker_packs_added')
+            : state === 'importing'
+              ? '…'
+              : tx('sticker_packs_add_pack')}
+        </button>
+      </div>
+    </div>
+  )
+}
