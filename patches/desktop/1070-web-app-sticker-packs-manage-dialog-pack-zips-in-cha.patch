+import React, { useCallback, useContext, useEffect, useState } from 'react'
+import classNames from 'classnames'
+import { basename } from 'path'
+
+import { runtime } from '@deltachat-desktop/runtime-interface'
+import { Type } from '../../backend-com'
+import { rpcStickers, type StickerPackObject } from '../../backend/stickerPacks'
+import { selectedAccountId } from '../../ScreenController'
+import Dialog, {
+  DialogBody,
+  DialogContent,
+  DialogHeader,
+  OkCancelFooterAction,
+} from '../Dialog'
+import { DeltaInput } from '../Login-Styles'
+import EmojiPicker from '../EmojiPicker'
+import { ContextMenuContext } from '../../contexts/ContextMenuContext'
+import useDialog from '../../hooks/dialog/useDialog'
+import useConfirmationDialog from '../../hooks/dialog/useConfirmationDialog'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+import { mouseEventToPosition } from '../../utils/mouseEventToPosition'
+import { StickerThumb, importStickerZip, stickersApi } from '.'
+
+import type { DialogProps } from '../../contexts/DialogContext'
+import type { ContextMenuItem } from '../ContextMenu'
+
+import styles from './styles.module.scss'
+
+type Pack = StickerPackObject
+type OtherProfile = { id: number; name: string; packs: Pack[] }
+
+const THUMB = 64
+/** A finger resting this long on a sticker picks it up; shorter than the
+ * ~500ms long press that opens its menu, like the account sidebar's reorder. */
+const TOUCH_ARM_MS = 250
+/** Movement below this is the finger being imprecise, not a gesture. */
+const TOUCH_SLOP_PX = 8
+
+type DragData = { stickerId?: number; msgId?: number }
+
+/** the pack section under a point, for touch drops */
+const packAt = (x: number, y: number) => {
+  const el = document
+    .elementFromPoint(x, y)
+    ?.closest<HTMLElement>('[data-pack-id]')
+  return el ? Number(el.dataset.packId) : null
+}
+/** how many unsaved stickers "Recently seen" offers */
+const RECENT_LIMIT = 40
+
+/** Asks for a pack name; resolves to it, or null on cancel. */
+function PackNameDialog({
+  onClose,
+  title,
+  initial,
+  onDone,
+}: DialogProps & {
+  title: string
+  initial: string
+  onDone: (name: string | null) => void
+}) {
+  const tx = useTranslationFunction()
+  const [name, setName] = useState(initial)
+  const close = (result: string | null) => {
+    onDone(result)
+    onClose()
+  }
+  return (
+    <Dialog onClose={() => close(null)} canOutsideClickClose={true}>
+      <DialogHeader title={title} />
+      <form
+        action={() => {
+          if (name.trim()) close(name.trim())
+        }}
+      >
+        <DialogBody>
+          <DialogContent>
+            <DeltaInput
+              id='sticker-pack-name'
+              placeholder={tx('sticker_packs_name')}
+              value={name}
+              onChange={(ev: React.ChangeEvent<HTMLInputElement>) =>
+                setName(ev.target.value)
+              }
+            />
+          </DialogContent>
+        </DialogBody>
+        <OkCancelFooterAction onCancel={() => close(null)} onOk='submit' />
+      </form>
+    </Dialog>
+  )
+}
+
+/** the core keeps at most this many per sticker */
+const MAX_EMOJIS = 16
+
+/** Edits the emojis a sticker stands for: removable chips plus a picker. */
+function StickerEmojisDialog({
+  onClose,
+  initial,
+  onDone,
+}: DialogProps & {
+  initial: string[]
+  onDone: (emojis: string[]) => void
+}) {
+  const tx = useTranslationFunction()
+  const [emojis, setEmojis] = useState(initial)
+  return (
+    <Dialog onClose={onClose} canOutsideClickClose={false}>
+      <DialogHeader title={tx('sticker_packs_edit_emojis')} />
+      <DialogBody>
+        <DialogContent>
+          <div className={styles.hint}>{tx('sticker_packs_emojis_hint')}</div>
+          <div className={styles.emojiChips}>
+            {emojis.map(e => (
+              <button
+                type='button'
+                key={e}
+                className={styles.emojiChip}
+                aria-label={tx('sticker_packs_remove_emoji', e)}
+                onClick={() => setEmojis(emojis.filter(x => x !== e))}
+              >
+                {e} ×
+              </button>
+            ))}
+          </div>
+          <EmojiPicker
+            role={undefined}
+            id={undefined}
+            labelledBy={undefined}
+            onSelect={({ native }) =>
+              setEmojis(list =>
+                list.includes(native) || list.length >= MAX_EMOJIS
+                  ? list
+                  : [...list, native]
+              )
+            }
+          />
+        </DialogContent>
+      </DialogBody>
+      <OkCancelFooterAction
+        onCancel={onClose}
+        confirmLabel={tx('save')}
+        onOk={() => {
+          onDone(emojis)
+          onClose()
+        }}
+      />
+    </Dialog>
+  )
+}
+
+/**
+ * Sticker pack editor: create, rename, delete and export packs, move or copy
+ * stickers between them (drag and drop, or the context menu, which a long
+ * press opens on touch), add image files, add stickers seen in chats, import
+ * zips and packs of the user's other profiles.
+ */
+export default function ManageStickersDialog({ onClose }: DialogProps) {
+  const tx = useTranslationFunction()
+  const accountId = selectedAccountId()
+  const { openDialog } = useDialog()
+  const openConfirmationDialog = useConfirmationDialog()
+  const { openContextMenu } = useContext(ContextMenuContext)
+  const rpc = rpcStickers
+
+  const [packs, setPacks] = useState<Pack[]>([])
+  const [recent, setRecent] = useState<Type.Message[]>([])
+  const [others, setOthers] = useState<OtherProfile[]>([])
+  const [dropTarget, setDropTarget] = useState<number | null>(null)
+  const [touchDrag, setTouchDrag] = useState<{
+    path: string
+    x: number
+    y: number
+  } | null>(null)
+
+  const refresh = useCallback(async () => {
+    setPacks(await rpc.getStickerPacks(accountId))
+    const ids = await rpc.getUnsavedStickerMessages(accountId, RECENT_LIMIT)
+    const msgs = await rpc.getMessages(accountId, ids)
+    const loaded: Type.Message[] = []
+    for (const id of ids) {
+      const msg = msgs[id]
+      if (msg?.kind === 'message' && msg.file) loaded.push(msg)
+    }
+    setRecent(loaded)
+  }, [accountId, rpc])
+
+  useEffect(() => {
+    refresh()
+    // Other profiles load once; their packs don't change while this is open.
+    ;(async () => {
+      const result: OtherProfile[] = []
+      for (const account of await rpc.getAllAccounts()) {
+        if (account.kind !== 'Configured' || account.id === accountId) continue
+        const packs = (await rpc.getStickerPacks(account.id)).filter(
+          p => p.stickers.length > 0
+        )
+        if (packs.length > 0) {
+          result.push({
+            id: account.id,
+            name: account.displayName || account.addr || String(account.id),
+            packs,
+          })
+        }
+      }
+      setOthers(result)
+    })().catch(() => {})
+  }, [accountId, refresh, rpc])
+
+  /** runs an action, then reloads; failures go to the user, not the console */
+  const run = (action: () => Promise<unknown>) =>
+    action()
+      .catch(error =>
+        window.__userFeedback({
+          type: 'error',
+          text: error instanceof Error ? error.message : String(error),
+        })
+      )
+      .finally(refresh)
+
+  const askName = (title: string, initial = '') =>
+    new Promise<string | null>(resolve =>
+      openDialog(PackNameDialog, { title, initial, onDone: resolve })
+    )
+
+  const newPack = async () => {
+    const name = await askName(tx('sticker_packs_new'))
+    if (name) await run(() => rpc.createStickerPack(accountId, name))
+  }
+
+  const importZip = async () => {
+    const [path] = await runtime.showOpenFileDialog({
+      filters: [{ name: 'zip', extensions: ['zip'] }],
+      properties: ['openFile'],
+    })
+    if (!path) return
+    await importStickerZip(tx, path, basename(path))
+    await runtime.removeTempFile(path).catch(() => {})
+    refresh()
+  }
+
+  const addImages = async (pack: Pack) => {
+    const paths = await runtime.showOpenFileDialog({
+      filters: [
+        { name: 'stickers', extensions: ['png', 'webp', 'gif', 'tgs'] },
+      ],
+      properties: ['openFile', 'multiSelections'],
+    })
+    let failed = 0
+    for (const path of paths) {
+      try {
+        await rpc.addStickerFromFile(accountId, pack.id, path, basename(path))
+      } catch {
+        failed++
+      }
+      await runtime.removeTempFile(path).catch(() => {})
+    }
+    if (failed > 0) {
+      window.__userFeedback({
+        type: 'error',
+        text: tx('sticker_packs_files_skipped', String(failed)),
+      })
+    }
+    refresh()
+  }
+
+  const packMenu = (ev: React.MouseEvent, pack: Pack) => {
+    openContextMenu({
+      ...mouseEventToPosition(ev),
+      items: [
+        {
+          label: tx('sticker_packs_rename'),
+          action: async () => {
+            const name = await askName(tx('sticker_packs_rename'), pack.name)
+            if (name) run(() => rpc.renameStickerPack(accountId, pack.id, name))
+          },
+        },
+        ...(stickersApi() && pack.stickers.length > 0
+          ? [
+              {
+                label: tx('sticker_packs_export'),
+                action: () =>
+                  run(() => stickersApi()!.exportPack(accountId, pack.id)),
+              },
+            ]
+          : []),
+        { type: 'separator' },
+        {
+          label: tx('delete'),
+          danger: true,
+          action: async () => {
+            const confirmed = await openConfirmationDialog({
+              message: tx('sticker_packs_delete_ask', [
+                pack.name,
+                String(pack.stickers.length),
+              ]),
+              confirmLabel: tx('delete'),
+              isConfirmDanger: true,
+            })
+            if (confirmed) run(() => rpc.deleteStickerPack(accountId, pack.id))
+          },
+        },
+      ],
+    })
+  }
+
+  /** "Move to" / "Copy to" submenu items for every pack but `exclude` */
+  const packTargets = (
+    exclude: number | null,
+    action: (packId: number) => Promise<unknown>
+  ): ContextMenuItem[] => [
+    ...packs
+      .filter(p => p.id !== exclude)
+      .map(p => ({ label: p.name, action: () => run(() => action(p.id)) })),
+    {
+      label: tx('sticker_packs_new') + '…',
+      action: async () => {
+        const name = await askName(tx('sticker_packs_new'))
+        if (name) {
+          run(async () => action(await rpc.createStickerPack(accountId, name)))
+        }
+      },
+    },
+  ]
+
+  const stickerMenu = (
+    ev: React.MouseEvent,
+    pack: Pack,
+    sticker: Pack['stickers'][number]
+  ) => {
+    ev.preventDefault()
+    openContextMenu({
+      ...mouseEventToPosition(ev),
+      items: [
+        {
+          label: tx('sticker_packs_move_to'),
+          subitems: packTargets(pack.id, to =>
+            rpc.moveSticker(accountId, sticker.id, to)
+          ),
+        },
+        {
+          label: tx('sticker_packs_copy_to'),
+          subitems: packTargets(pack.id, to =>
+            rpc.copySticker(accountId, sticker.id, to)
+          ),
+        },
+        {
+          label: tx('sticker_packs_edit_emojis'),
+          action: () =>
+            openDialog(StickerEmojisDialog, {
+              initial: sticker.emojis,
+              onDone: (emojis: string[]) =>
+                run(() => rpc.setStickerEmojis(accountId, sticker.id, emojis)),
+            }),
+        },
+        { type: 'separator' },
+        {
+          label: tx('delete'),
+          danger: true,
+          action: () => run(() => rpc.removeSticker(accountId, sticker.id)),
+        },
+      ],
+    })
+  }
+
+  const recentMenu = (ev: React.MouseEvent, msg: Type.Message) => {
+    ev.preventDefault()
+    openContextMenu({
+      ...mouseEventToPosition(ev),
+      items: [
+        {
+          label: tx('sticker_packs_add_to'),
+          subitems: packTargets(null, to =>
+            rpc.addStickerFromMessage(accountId, to, msg.id)
+          ),
+        },
+      ],
+    })
+  }
+
+  const dropSticker = (data: DragData, packId: number, copy: boolean) => {
+    if (data.stickerId != null) {
+      const id = data.stickerId
+      run(() =>
+        copy
+          ? rpc.copySticker(accountId, id, packId)
+          : rpc.moveSticker(accountId, id, packId)
+      )
+    } else if (data.msgId != null) {
+      const id = data.msgId
+      run(() => rpc.addStickerFromMessage(accountId, packId, id))
+    }
+  }
+
+  /** Images (or a pack zip) dropped in from another app. */
+  const dropFiles = async (files: File[], packId: number) => {
+    const api = stickersApi()
+    if (!api) return
+    let failed = 0
+    for (const file of files) {
+      let path: string | null = null
+      try {
+        path = await api.stage(file)
+        if (/\.zip$/i.test(file.name)) {
+          await importStickerZip(tx, path, file.name)
+        } else {
+          await rpc.addStickerFromFile(accountId, packId, path, file.name)
+        }
+      } catch {
+        failed++
+      } finally {
+        if (path) await runtime.removeTempFile(path).catch(() => {})
+      }
+    }
+    if (failed > 0) {
+      window.__userFeedback({
+        type: 'error',
+        text: tx('sticker_packs_files_skipped', String(failed)),
+      })
+    }
+    refresh()
+  }
+
+  const onDrop = (ev: React.DragEvent, pack: Pack) => {
+    ev.preventDefault()
+    // the runtime's chat drop handler must not take files meant for a pack
+    ev.stopPropagation()
+    setDropTarget(null)
+    const data = ev.dataTransfer.getData('application/x-slothful-sticker')
+    if (data) {
+      // copy with Ctrl/Alt held, like a file manager
+      dropSticker(JSON.parse(data), pack.id, ev.ctrlKey || ev.altKey)
+    } else if (ev.dataTransfer.files.length > 0) {
+      dropFiles([...ev.dataTransfer.files], pack.id)
+    }
+  }
+
+  const dragData = (data: DragData) => (ev: React.DragEvent) => {
+    ev.dataTransfer.setData(
+      'application/x-slothful-sticker',
+      JSON.stringify(data)
+    )
+    ev.dataTransfer.effectAllowed = 'copyMove'
+  }
+
+  /**
+   * HTML5 drag and drop never starts from a touch, so on touch screens a
+   * sticker is picked up by resting a finger on it, then dragged onto a pack.
+   * A finger that moves right away scrolls; one that stays put gets the
+   * context menu, which also ends the drag.
+   */
+  const touchDragStart =
+    (data: DragData, path: string) => (ev: React.TouchEvent) => {
+      const touch = ev.touches[0]
+      if (ev.touches.length !== 1 || !touch) return
+      const start = { x: touch.clientX, y: touch.clientY }
+      let pos: { x: number; y: number } | null = null
+      const arm = setTimeout(() => {
+        pos = start
+        setTouchDrag({ path, ...start })
+      }, TOUCH_ARM_MS)
+      const end = () => {
+        clearTimeout(arm)
+        document.removeEventListener('touchmove', move)
+        document.removeEventListener('touchend', up)
+        document.removeEventListener('touchcancel', end)
+        document.removeEventListener('contextmenu', end, true)
+        setTouchDrag(null)
+        setDropTarget(null)
+      }
+      const move = (e: TouchEvent) => {
+        const t = e.touches[0]
+        if (!t) return
+        if (!pos) {
+          const moved = Math.hypot(t.clientX - start.x, t.clientY - start.y)
+          if (moved > TOUCH_SLOP_PX) end() // a scroll, not a drag
+          return
+        }
+        e.preventDefault() // dragging, so don't scroll
+        pos = { x: t.clientX, y: t.clientY }
+        setTouchDrag({ path, ...pos })
+        setDropTarget(packAt(pos.x, pos.y))
+      }
+      const up = (e: TouchEvent) => {
+        if (
+          pos &&
+          Math.hypot(pos.x - start.x, pos.y - start.y) > TOUCH_SLOP_PX
+        ) {
+          e.preventDefault() // no click on the sticker
+          const to = packAt(pos.x, pos.y)
+          if (to != null) dropSticker(data, to, false)
+        }
+        end()
+      }
+      document.addEventListener('touchmove', move, { passive: false })
+      document.addEventListener('touchend', up, { passive: false })
+      document.addEventListener('touchcancel', end)
+      document.addEventListener('contextmenu', end, true)
+    }
+
+  return (
+    <Dialog
+      width={560}
+      onClose={onClose}
+      fixed
+      dataTestid='manage-stickers-dialog'
+    >
+      <DialogHeader title={tx('sticker_packs_manage')} onClose={onClose} />
+      {touchDrag && (
+        <div
+          className={styles.touchGhost}
+          style={{ left: touchDrag.x, top: touchDrag.y }}
+          aria-hidden
+        >
+          <StickerThumb path={touchDrag.path} size={THUMB} />
+        </div>
+      )}
+      <DialogBody>
+        <div className={styles.toolbar}>
+          <button type='button' className={styles.toolButton} onClick={newPack}>
+            {tx('sticker_packs_new')}
+          </button>
+          {stickersApi() && (
+            <button
+              type='button'
+              className={styles.toolButton}
+              onClick={importZip}
+            >
+              {tx('sticker_packs_import_zip')}
+            </button>
+          )}
+        </div>
+
+        {packs.map(pack => (
+          <section
+            key={pack.id}
+            className={classNames(styles.pack, {
+              [styles.dropTarget]: dropTarget === pack.id,
+            })}
+            onDragOver={ev => {
+              ev.preventDefault()
+              setDropTarget(pack.id)
+            }}
+            onDragLeave={() => setDropTarget(null)}
+            onDrop={ev => onDrop(ev, pack)}
+            data-pack-id={pack.id}
+            data-testid='sticker-pack'
+          >
+            <div className={styles.packHeader}>
+              <span className={styles.packName}>{pack.name}</span>
+              <span className={styles.packCount}>{pack.stickers.length}</span>
+              <button
+                type='button'
+                className={styles.toolButton}
+                onClick={() => addImages(pack)}
+              >
+                {tx('sticker_packs_add_images')}
+              </button>
+              <button
+                type='button'
+                className={styles.moreButton}
+                aria-label={tx('menu_more_options')}
+                aria-haspopup='menu'
+                onClick={ev => packMenu(ev, pack)}
+              >
+                ⋯
+              </button>
+            </div>
+            <div className={styles.grid}>
+              {pack.stickers.length === 0 && (
+                <div className={styles.hint}>{tx('sticker_packs_empty')}</div>
+              )}
+              {pack.stickers.map(sticker => (
+                <button
+                  type='button'
+                  key={sticker.id}
+                  className={styles.sticker}
+                  draggable
+                  onDragStart={dragData({ stickerId: sticker.id })}
+                  onTouchStart={touchDragStart(
+                    { stickerId: sticker.id },
+                    sticker.path
+                  )}
+                  onClick={ev => stickerMenu(ev, pack, sticker)}
+                  onContextMenu={ev => stickerMenu(ev, pack, sticker)}
+                  aria-haspopup='menu'
+                  aria-label={[tx('sticker'), ...sticker.emojis].join(' ')}
+                >
+                  <StickerThumb path={sticker.path} size={THUMB} />
+                  {sticker.emojis.length > 0 && (
+                    <span className={styles.emojiBadge} aria-hidden>
+                      {sticker.emojis.slice(0, 3).join('')}
+                      {sticker.emojis.length > 3 && '…'}
+                    </span>
+                  )}
+                </button>
+              ))}
+            </div>
+          </section>
+        ))}
+
+        {recent.length > 0 && (
+          <section className={styles.pack}>
+            <div className={styles.packHeader}>
+              <span className={styles.packName}>
+                {tx('sticker_packs_recent')}
+              </span>
+            </div>
+            <div className={styles.hint}>{tx('sticker_packs_recent_hint')}</div>
+            <div className={classNames(styles.grid, styles.recent)}>
+              {recent.map(msg => (
+                <button
+                  type='button'
+                  key={msg.id}
+                  className={styles.sticker}
+                  draggable
+                  onDragStart={dragData({ msgId: msg.id })}
+                  onTouchStart={touchDragStart({ msgId: msg.id }, msg.file!)}
+                  onClick={ev => recentMenu(ev, msg)}
+                  onContextMenu={ev => recentMenu(ev, msg)}
+                  aria-haspopup='menu'
+                  aria-label={tx('sticker')}
+                >
+                  <StickerThumb path={msg.file!} size={THUMB} />
+                </button>
+              ))}
+            </div>
+          </section>
+        )}
+
+        {others.length > 0 && (
+          <section className={styles.pack}>
+            <div className={styles.packHeader}>
+              <span className={styles.packName}>
+                {tx('sticker_packs_from_profiles')}
+              </span>
+            </div>
+            {others.map(profile =>
+              profile.packs.map(pack => (
+                <div
+                  key={`${profile.id}-${pack.id}`}
+                  className={styles.otherPack}
+                >
+                  <div className={styles.otherPreview}>
+                    {pack.stickers.slice(0, 4).map(s => (
+                      <StickerThumb key={s.id} path={s.path} size={32} />
+                    ))}
+                  </div>
+                  <div className={styles.otherText}>
+                    <div className={styles.packName}>{pack.name}</div>
+                    <div className={styles.packCount}>
+                      {profile.name} ·{' '}
+                      {tx(
+                        'sticker_packs_n_stickers',
+                        String(pack.stickers.length)
+                      )}
+                    </div>
+                  </div>
+                  {packs.some(
+                    // same "already there" check as the chat's pack card
+                    p =>
+                      p.name === pack.name &&
+                      p.stickers.length === pack.stickers.length
+                  ) ? (
+                    <span className={styles.packCount}>
+                      {tx('sticker_packs_added')}
+                    </span>
+                  ) : (
+                    <button
+                      type='button'
+                      className={styles.toolButton}
+                      onClick={() =>
+                        run(() =>
+                          rpc.copyStickerPackFromAccount(
+                            accountId,
+                            profile.id,
+                            pack.id
+                          )
+                        )
+                      }
+                    >
+                      {tx('sticker_packs_import')}
+                    </button>
+                  )}
+                </div>
+              ))
+            )}
+          </section>
+        )}
+      </DialogBody>
+    </Dialog>
+  )
+}
