@@ -0,0 +1,405 @@
+import React, { useEffect, useRef, useState } from 'react'
+import classNames from 'classnames'
+
+import { runtime } from '@deltachat-desktop/runtime-interface'
+import { Type } from '../../backend-com'
+import { rpcStickers } from '../../backend/stickerPacks'
+import { selectedAccountId } from '../../ScreenController'
+import LottieSticker from '../attachment/LottieSticker'
+import Dialog, {
+  DialogBody,
+  DialogFooter,
+  DialogHeader,
+  FooterActionButton,
+  FooterActions,
+} from '../Dialog'
+import useDialog from '../../hooks/dialog/useDialog'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+
+import type { DialogProps } from '../../contexts/DialogContext'
+
+import styles from './styles.module.scss'
+
+/**
+ * Sticker packs (slothfulchat). The core stores and manages packs
+ * (`getStickerPacks` & co.); what needs a zip library — recognizing a pack in
+ * a chat, previewing, importing and exporting one — lives in slothfulchat-web's
+ * packages/web-app/src/sticker-packs.ts as window.__slothfulStickers.
+ */
+type PackPreview = { name: string; count: number; previews: string[] }
+/** an image as object URL, a .tgs as temp file path (LottieSticker can't
+ * fetch object URLs under the CSP) */
+type PreviewSticker = {
+  name: string
+  emojis: string[]
+  url?: string
+  path?: string
+}
+type FullPreview = { name: string; stickers: PreviewSticker[] }
+type StickersApi = {
+  inspect(
+    path: string,
+    zipName: string,
+    size: number
+  ): Promise<PackPreview | null>
+  /** every sticker in the zip; hand the result to releasePreview when done */
+  previewAll(path: string, zipName: string): Promise<FullPreview>
+  releasePreview(preview: FullPreview): Promise<void>
+  importZip(
+    accountId: number,
+    path: string,
+    zipName: string
+  ): Promise<{ packId: number; name: string; added: number; skipped: number }>
+  exportPack(accountId: number, packId: number): Promise<void>
+  /** copies a dropped File to a temp path the core can read */
+  stage(file: File): Promise<string>
+}
+
+/** undefined on runtimes without the zip half (upstream Electron/Tauri) */
+export const stickersApi = (): StickersApi | undefined =>
+  (window as any).__slothfulStickers
+
+export const isZipFile = (name: string | null | undefined) =>
+  /\.zip$/i.test(name ?? '')
+
+/** What to tell the user when a zip can't be previewed or imported: why it
+ * is no sticker pack, or the error itself when something else failed. */
+function stickerZipError(
+  tx: ReturnType<typeof useTranslationFunction>,
+  error: unknown
+): string {
+  const message = error instanceof Error ? error.message : String(error)
+  const reason = /^not a sticker pack: (.*)$/s.exec(message)
+  return reason ? `${tx('sticker_packs_not_a_pack')}\n(${reason[1]})` : message
+}
+
+/** Imports a zip and tells the user how it went. */
+export async function importStickerZip(
+  tx: ReturnType<typeof useTranslationFunction>,
+  path: string,
+  zipName: string
+): Promise<number | null> {
+  const api = stickersApi()
+  if (!api) return null
+  try {
+    const result = await api.importZip(selectedAccountId(), path, zipName)
+    window.__userFeedback({
+      type: 'success',
+      text:
+        result.skipped > 0
+          ? tx('sticker_packs_imported_skipped', [
+              result.name,
+              String(result.added),
+              String(result.skipped),
+            ])
+          : tx('sticker_packs_imported', result.name),
+    })
+    return result.packId
+  } catch (error) {
+    window.__userFeedback({ type: 'error', text: stickerZipError(tx, error) })
+    return null
+  }
+}
+
+/** A sticker thumbnail; .tgs plays through the Lottie player. */
+export function StickerThumb({ path, size }: { path: string; size: number }) {
+  const src = runtime.transformStickerURL(path)
+  return /\.tgs$/i.test(path) ? (
+    <LottieSticker
+      key={path}
+      src={src}
+      size={size}
+      className={styles.thumbLottie}
+    />
+  ) : (
+    <img
+      src={src}
+      width={size}
+      height={size}
+      className={styles.thumbImg}
+      alt=''
+    />
+  )
+}
+
+/**
+ * A received .zip that holds a sticker pack, shown as a pack card with a few
+ * stickers and an "Add" button instead of a plain file tile. Until the zip is
+ * checked (only once it scrolls into view, one zip at a time, see
+ * sticker-packs.ts) and whenever it is not a pack, `fallback` is shown.
+ */
+export function StickerPackZipCard({
+  message,
+  fallback,
+}: {
+  message: Type.Message & { file: string }
+  fallback: React.ReactElement
+}) {
+  const tx = useTranslationFunction()
+  const ref = useRef<HTMLDivElement>(null)
+  const [pack, setPack] = useState<PackPreview | null>(null)
+  const [added, setAdded] = useState(false)
+  const { openDialog } = useDialog()
+
+  useEffect(() => {
+    const api = stickersApi()
+    const el = ref.current
+    if (!api || !el || message.downloadState !== 'Done') return
+    let cancelled = false
+    const io = new IntersectionObserver(([entry]) => {
+      if (!entry.isIntersecting) return
+      io.disconnect()
+      api
+        .inspect(message.file, message.fileName ?? '', message.fileBytes ?? 0)
+        .then(result => !cancelled && setPack(result))
+    })
+    io.observe(el)
+    return () => {
+      cancelled = true
+      io.disconnect()
+    }
+  }, [message.file, message.fileName, message.fileBytes, message.downloadState])
+
+  useEffect(() => {
+    if (!pack) return
+    // "Added" when a pack of that name and size is already installed.
+    // ponytail: name+count, not content; a renamed or edited copy shows "Add"
+    // again, and adding it twice just makes "Name (2)".
+    rpcStickers
+      .getStickerPacks(selectedAccountId())
+      .then(packs => {
+        if (
+          packs.some(
+            p => p.name === pack.name && p.stickers.length === pack.count
+          )
+        ) {
+          setAdded(true)
+        }
+      })
+      .catch(() => {})
+  }, [pack])
+
+  if (!pack) {
+    return <div ref={ref}>{fallback}</div>
+  }
+
+  const openInspector = (ev: React.MouseEvent) => {
+    ev.stopPropagation()
+    openDialog(StickerPackInspector, {
+      path: message.file,
+      zipName: message.fileName ?? '',
+      name: pack.name,
+      added,
+      onAdded: () => setAdded(true),
+    })
+  }
+
+  return (
+    <div className={styles.zipCard} data-testid='sticker-pack-card'>
+      {/* the zip itself stays reachable through the message menu
+          (Open / Export Attachment) */}
+      <button
+        type='button'
+        className={styles.zipCardGrid}
+        onClick={openInspector}
+        aria-label={tx('sticker_packs_view')}
+        title={message.fileName ?? undefined}
+      >
+        {pack.previews.map((url, i) =>
+          url ? (
+            <img key={i} src={url} alt='' />
+          ) : (
+            <div key={i} className={styles.zipCardAnimated} aria-hidden>
+              🎞️
+            </div>
+          )
+        )}
+      </button>
+      <div className={styles.zipCardText}>
+        <div className={styles.zipCardName}>{pack.name}</div>
+        <div className={styles.zipCardCount}>
+          {tx('sticker_packs_n_stickers', String(pack.count))}
+        </div>
+        <button
+          type='button'
+          className={classNames(styles.zipCardButton, {
+            [styles.added]: added,
+          })}
+          disabled={added}
+          onClick={openInspector}
+        >
+          {added ? tx('sticker_packs_added') : tx('sticker_packs_add_pack')}
+        </button>
+      </div>
+    </div>
+  )
+}
+
+const BIG = 240
+
+/**
+ * The whole pack of a received zip, before adding it: every sticker with its
+ * emojis; hovering (mouse) or clicking/Enter shows one big.
+ */
+function StickerPackInspector({
+  onClose,
+  path,
+  zipName,
+  name,
+  added: wasAdded,
+  onAdded,
+}: DialogProps & {
+  path: string
+  zipName: string
+  name: string
+  added: boolean
+  onAdded: () => void
+}) {
+  const tx = useTranslationFunction()
+  const [preview, setPreview] = useState<FullPreview | null>(null)
+  const [importing, setImporting] = useState(false)
+  const [hovered, setHovered] = useState<number | null>(null)
+  const [pinned, setPinned] = useState<number | null>(null)
+  const shown = pinned ?? hovered
+
+  useEffect(() => {
+    const api = stickersApi()
+    if (!api) return
+    let cancelled = false
+    let result: FullPreview | null = null
+    api.previewAll(path, zipName).then(
+      p => {
+        if (cancelled) api.releasePreview(p)
+        else setPreview((result = p))
+      },
+      error => {
+        if (cancelled) return
+        window.__userFeedback({
+          type: 'error',
+          text: stickerZipError(tx, error),
+        })
+        onClose()
+      }
+    )
+    return () => {
+      cancelled = true
+      if (result) api.releasePreview(result)
+    }
+  }, [path, zipName, tx, onClose])
+
+  useEffect(() => {
+    if (shown == null) return
+    const onKey = (ev: KeyboardEvent) => {
+      if (ev.key !== 'Escape') return
+      setPinned(null)
+      setHovered(null)
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [shown])
+
+  const onAdd = async () => {
+    setImporting(true)
+    const id = await importStickerZip(tx, path, zipName)
+    setImporting(false)
+    if (id == null) return
+    onAdded()
+    onClose()
+  }
+
+  const thumb = (s: PreviewSticker, size: number) =>
+    s.path ? (
+      <StickerThumb path={s.path} size={size} />
+    ) : (
+      <img
+        src={s.url}
+        width={size}
+        height={size}
+        className={styles.thumbImg}
+        alt=''
+      />
+    )
+  const big = shown != null ? preview?.stickers[shown] : undefined
+
+  return (
+    <Dialog
+      width={560}
+      onClose={onClose}
+      fixed
+      // Escape closes the big preview first
+      canEscapeKeyClose={shown == null}
+      dataTestid='sticker-pack-inspector'
+    >
+      <DialogHeader title={preview?.name ?? name} onClose={onClose} />
+      <DialogBody>
+        <div className={styles.inspectCount}>
+          {preview
+            ? tx('sticker_packs_n_stickers', String(preview.stickers.length))
+            : '…'}
+        </div>
+        {/* a click beside the stickers closes the big preview */}
+        <div className={styles.inspectGrid} onClick={() => setPinned(null)}>
+          {preview?.stickers.map((s, i) => (
+            <button
+              type='button'
+              key={i}
+              className={styles.inspectSticker}
+              aria-label={s.emojis.join(' ') || s.name}
+              onClick={ev => {
+                ev.stopPropagation()
+                setPinned(p => (p === i ? null : i))
+              }}
+              onPointerEnter={ev => ev.pointerType === 'mouse' && setHovered(i)}
+              onPointerLeave={ev =>
+                ev.pointerType === 'mouse' && setHovered(null)
+              }
+            >
+              {thumb(s, 72)}
+              {s.emojis.length > 0 && (
+                <span className={styles.inspectEmojis} aria-hidden>
+                  {s.emojis.join('')}
+                </span>
+              )}
+            </button>
+          ))}
+        </div>
+      </DialogBody>
+      {big && (
+        // ponytail: centered over the grid, so it covers the stickers around
+        // the hovered one; place it beside the pointer if that annoys people.
+        // Purely visual (the buttons carry the emojis), hence aria-hidden.
+        <div className={styles.bigPreviewLayer} aria-hidden>
+          <div
+            className={classNames(styles.bigPreview, {
+              [styles.pinned]: pinned != null,
+            })}
+            data-testid='sticker-big-preview'
+            onClick={() => setPinned(null)}
+          >
+            {thumb(big, BIG)}
+            {big.emojis.length > 0 && (
+              <div className={styles.bigPreviewEmojis}>
+                {big.emojis.join(' ')}
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+      <DialogFooter>
+        <FooterActions>
+          <FooterActionButton
+            styling='primary'
+            disabled={wasAdded || importing || !preview}
+            onClick={onAdd}
+          >
+            {wasAdded
+              ? tx('sticker_packs_added')
+              : importing
+                ? '…'
+                : tx('sticker_packs_add_pack')}
+          </FooterActionButton>
+        </FooterActions>
+      </DialogFooter>
+    </Dialog>
+  )
+}
