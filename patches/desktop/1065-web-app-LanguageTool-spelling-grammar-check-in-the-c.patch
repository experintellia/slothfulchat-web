diff --git a/packages/frontend/src/components/Settings/LanguageToolDialog.tsx b/packages/frontend/src/components/Settings/LanguageToolDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..31550af1bb0da713358f170d46d1a45aa42b6099
--- /dev/null
+++ b/packages/frontend/src/components/Settings/LanguageToolDialog.tsx
@@ -0,0 +1,188 @@
+import React, { useRef, useState } from 'react'
+
+import SettingsStoreInstance, { useSettingsStore } from '../../stores/settings'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+import Dialog, {
+  DialogBody,
+  DialogContent,
+  DialogHeader,
+  OkCancelFooterAction,
+} from '../Dialog'
+import { DeltaInput } from '../Login-Styles'
+import Radio from '../Radio'
+import RadioGroup from '../RadioGroup'
+import Button from '../Button'
+import {
+  isLtServerUrl,
+  ltCheck,
+  type LtConfig,
+} from '../composer/languageToolCheck'
+
+import type { DialogProps } from '../../contexts/DialogContext'
+import type { DesktopSettingsType } from '@deltachat-desktop/shared/shared-types'
+
+/** One line for the settings row: which checker, and where drafts go. */
+export function languageToolServerLabel(s: DesktopSettingsType): string {
+  if (s.grammarCheckEngine === 'harper') {
+    return 'Harper (on this device)'
+  }
+  if (s.languageToolServer) {
+    return s.languageToolServer
+  }
+  return s.languageToolUsername && s.languageToolApiKey
+    ? 'languagetool.org (Premium)'
+    : 'languagetool.org'
+}
+
+/** Pick the checker: Harper on this device, or LanguageTool on
+ * languagetool.org (optionally with a Premium account) or a self-hosted
+ * server, like the Obsidian LanguageTool plugin. */
+export default function LanguageToolDialog({ onClose }: DialogProps) {
+  const tx = useTranslationFunction()
+  const settings = useSettingsStore()[0]?.desktopSettings
+  const [mode, setMode] = useState(
+    settings?.grammarCheckEngine !== 'languagetool'
+      ? 'harper'
+      : settings.languageToolServer
+        ? 'server'
+        : 'account'
+  )
+  // languagetool-server's default port, so one on this computer needs no typing
+  const [server, setServer] = useState(
+    settings?.languageToolServer ?? 'http://localhost:8081'
+  )
+  const [username, setUsername] = useState(settings?.languageToolUsername ?? '')
+  const [apiKey, setApiKey] = useState(settings?.languageToolApiKey ?? '')
+  const [status, setStatus] = useState('')
+  // only the latest "Check connection" may report
+  const checkRun = useRef(0)
+
+  const config: LtConfig =
+    mode === 'harper'
+      ? { harper: true }
+      : mode === 'server'
+        ? { server: server.trim() }
+        : { username: username.trim(), apiKey: apiKey.trim() }
+  // Premium needs both; one alone would quietly fall back to the free API
+  const valid =
+    mode === 'harper' ||
+    (mode === 'server'
+      ? isLtServerUrl(server.trim())
+      : !username.trim() === !apiKey.trim())
+
+  const save = async () => {
+    const set = SettingsStoreInstance.effect.setDesktopSetting
+    await set('grammarCheckEngine', config.harper ? 'harper' : 'languagetool')
+    // Harper: keep the LanguageTool settings for switching back
+    if (!config.harper) {
+      await set('languageToolServer', config.server || undefined)
+      await set('languageToolUsername', username.trim() || undefined)
+      await set('languageToolApiKey', apiKey.trim() || undefined)
+    }
+    onClose()
+  }
+
+  const check = () => {
+    const run = ++checkRun.current
+    const report = (text: string) => run === checkRun.current && setStatus(text)
+    setStatus('Checking…')
+    ltCheck(config, 'This are a test.').then(
+      matches =>
+        report(`Works: found ${matches.length} issue(s) in a test sentence.`),
+      (err: Error) =>
+        report(
+          `Failed: ${err.message}. Check the address, and that a self-hosted ` +
+            'server allows this app (LanguageTool --allow-origin).'
+        )
+    )
+  }
+
+  return (
+    <Dialog onClose={onClose}>
+      <DialogHeader title='Grammar & spelling checker' onClose={onClose} />
+      <DialogBody>
+        <DialogContent>
+          <RadioGroup
+            name='language-tool-mode'
+            selectedValue={mode}
+            onChange={value => {
+              setMode(value)
+              checkRun.current++
+              setStatus('')
+            }}
+          >
+            <Radio
+              value='harper'
+              label='Harper'
+              subtitle='English only, runs on this device'
+            />
+            <Radio
+              value='account'
+              label='LanguageTool cloud'
+              subtitle='languagetool.org, free or with your Premium account'
+            />
+            <Radio
+              value='server'
+              label='LanguageTool self-hosted'
+              subtitle='A LanguageTool server you run yourself'
+            />
+          </RadioGroup>
+          <br />
+          {mode === 'harper' ? (
+            <p>
+              Your drafts never leave this device. Harper checks English only;
+              it is downloaded once (about 15 MB) when the check first runs.
+            </p>
+          ) : mode === 'account' ? (
+            <>
+              <DeltaInput
+                label='Username (email), optional'
+                value={username}
+                type='email'
+                onChange={e => setUsername(e.target.value)}
+              />
+              <DeltaInput
+                label='API key, optional'
+                value={apiKey}
+                type='password'
+                onChange={e => setApiKey(e.target.value)}
+              />
+              <p>
+                Premium users find the API key on languagetool.org under Account
+                → Access tokens. Fill in both for Premium, or leave both empty
+                for the free service.
+              </p>
+            </>
+          ) : (
+            <>
+              <DeltaInput
+                label='Server address'
+                value={server}
+                type='url'
+                onChange={e => setServer(e.target.value)}
+              />
+              <p>
+                The server's root address, not a sub-path. Start it with{' '}
+                <code>--allow-origin</code> so this app may use it, and use
+                https unless it runs on this computer.
+              </p>
+            </>
+          )}
+          {/* not for Harper: it only loads once the check is on */}
+          {mode !== 'harper' && (
+            <Button onClick={check} disabled={!valid}>
+              Check connection
+            </Button>
+          )}
+          {status && <p role='status'>{status}</p>}
+        </DialogContent>
+      </DialogBody>
+      <OkCancelFooterAction
+        onCancel={onClose}
+        onOk={save}
+        disableOK={!valid}
+        confirmLabel={tx('save')}
+      />
+    </Dialog>
+  )
+}
