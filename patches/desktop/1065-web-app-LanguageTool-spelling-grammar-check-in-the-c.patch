+/** slothfulchat: while the grammar checker is on, whether it (Harper, or the
+ * LanguageTool server) answers a test check, so fields that stay
+ * un-underlined have an explanation here, and a way to the checker dialog. */
+function LanguageToolInfo() {
+  const { openDialog } = useDialog()
+  const settings = useSettingsStore()[0]?.desktopSettings
+  const config = settings && languageToolConfig(settings)
+  const on = !!config
+  const { harper, server, username, apiKey } = config || {}
+  // the result of the check for one config: true when it works, else the
+  // error; a result for an older config (changed via "Change…") is stale
+  const key = JSON.stringify([harper, server, username, apiKey])
+  const [checked, setChecked] = useState<{ key: string; ok: true | string }>()
+  const status = checked?.key === key ? checked.ok : null
+
+  useEffect(() => {
+    if (!on) return
+    const abort = new AbortController()
+    ltCheck(
+      { harper, server, username, apiKey },
+      'This are a test.',
+      abort.signal
+    ).then(
+      () => setChecked({ key, ok: true }),
+      (err: Error) =>
+        abort.signal.aborted || setChecked({ key, ok: err.message })
+    )
+    return () => abort.abort()
+  }, [on, key, harper, server, username, apiKey])
+
+  if (!settings || !config) return null
+  return (
+    <div style={{ marginTop: '8px', fontSize: '13px' }}>
+      Grammar checker: <code>{languageToolServerLabel(settings)}</code>{' '}
+      {/* before the status, which can be a long error */}
+      <button type='button' onClick={() => openDialog(LanguageToolDialog)}>
+        Change…
+      </button>{' '}
+      {status === null ? (
+        'checking…'
+      ) : status === true ? (
+        '✓ working'
+      ) : (
+        <span style={{ color: '#c0392b' }}>⚠ not working: {status}</span>
+      )}
+    </div>
+  )
+}
