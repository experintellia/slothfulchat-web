@@ -0,0 +1,164 @@
+@use 'sass:map';
+@use '../variables';
+
+// LanguageTool (src/components/composer/LanguageTool.tsx).
+
+// Issue colours, shared by an underline and its card: red spelling, blue
+// style, amber everything else, as in LanguageTool's own UI.
+.language-tool-issue,
+.language-tool-card {
+  --lt-color: #f0a020;
+
+  &.misspelling {
+    --lt-color: #e53935;
+  }
+  &.style {
+    --lt-color: #3d8bfd;
+  }
+}
+
+// The draft copied into a transparent, click-through layer laid over the
+// textarea; only the underlines show.
+.language-tool-layer {
+  position: absolute;
+  box-sizing: border-box;
+  overflow: hidden;
+  pointer-events: none;
+  user-select: none;
+  white-space: pre-wrap;
+  overflow-wrap: break-word;
+  color: transparent;
+}
+
+.language-tool-issue {
+  text-decoration: underline wavy var(--lt-color);
+  text-decoration-skip-ink: none;
+}
+
+// Shown in the field's corner while checks fail; placed after every render.
+.language-tool-failed {
+  position: absolute;
+  display: flex;
+  padding: 0;
+  border: none;
+  background: none;
+  color: #e53935;
+  cursor: pointer;
+}
+
+// The suggestion card, placed above the flagged word by placeCard().
+.language-tool-card {
+  position: absolute;
+  z-index: map.get(variables.$z-index, emoji-sticker-picker);
+  box-sizing: border-box;
+  width: max-content;
+  min-width: 220px;
+  max-width: min(360px, calc(100% - 16px));
+  padding: 10px 12px 6px 16px;
+
+  background-color: var(--bgPrimary);
+  color: var(--textPrimary);
+  border: 1px solid var(--separatorColor);
+  border-radius: 10px;
+  // the accent bar in the issue's colour
+  box-shadow:
+    inset 4px 0 0 var(--lt-color),
+    0 8px 28px rgba(0, 0, 0, 0.28);
+  font-size: 14px;
+  line-height: 1.4;
+
+  .language-tool-card-head {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+  }
+
+  .language-tool-card-title {
+    flex: 1;
+    color: var(--lt-color);
+    font-size: 12px;
+    font-weight: 700;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+  }
+
+  .language-tool-card-close {
+    margin: -4px -6px -4px 0;
+    padding: 6px;
+    opacity: 0.6;
+    &:hover {
+      opacity: 1;
+    }
+  }
+
+  .language-tool-card-message {
+    margin: 4px 0 10px;
+    color: color-mix(in srgb, var(--textPrimary) 80%, transparent);
+  }
+
+  .language-tool-card-suggestions {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 6px;
+    margin-bottom: 4px;
+  }
+
+  // the first suggestion is the likely one: filled; the rest outlined
+  .language-tool-card-suggestion {
+    min-height: 32px;
+    padding: 4px 14px;
+    border: 1px solid color-mix(in srgb, var(--textPrimary) 25%, transparent);
+    border-radius: 999px;
+    background: none;
+    color: var(--textPrimary);
+    font: inherit;
+    font-weight: 600;
+    cursor: pointer;
+
+    &:hover {
+      background-color: color-mix(in srgb, var(--textPrimary) 8%, transparent);
+    }
+    &:first-child {
+      border-color: var(--buttonPrimaryBackground);
+      background-color: var(--buttonPrimaryBackground);
+      color: var(--buttonPrimaryText);
+      &:hover {
+        background-color: var(--buttonPrimaryHover);
+      }
+    }
+  }
+
+  .language-tool-card-ignore {
+    display: block;
+    margin: 2px 0 0 -6px;
+    padding: 6px;
+    border: none;
+    background: none;
+    color: color-mix(in srgb, var(--textPrimary) 60%, transparent);
+    font: inherit;
+    font-size: 13px;
+    cursor: pointer;
+    &:hover {
+      color: var(--textPrimary);
+      text-decoration: underline;
+    }
+  }
+
+  // pointer to the word: below the card, or above it when flipped
+  .language-tool-card-arrow {
+    position: absolute;
+    left: calc(var(--lt-arrow-x, 24px) - 6px);
+    bottom: -7px;
+    width: 12px;
+    height: 12px;
+    background-color: var(--bgPrimary);
+    border-right: 1px solid var(--separatorColor);
+    border-bottom: 1px solid var(--separatorColor);
+    transform: rotate(45deg);
+  }
+  &.below .language-tool-card-arrow {
+    top: -7px;
+    bottom: auto;
+    transform: rotate(225deg);
+  }
+}
