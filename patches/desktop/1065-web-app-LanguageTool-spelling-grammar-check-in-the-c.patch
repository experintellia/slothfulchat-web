diff --git a/packages/frontend/src/components/composer/LanguageTool.tsx b/packages/frontend/src/components/composer/LanguageTool.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..cb387d0fa9f778b4d26bba9d4ef15e6f2032c76b
--- /dev/null
+++ b/packages/frontend/src/components/composer/LanguageTool.tsx
@@ -0,0 +1,375 @@
+import React, {
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from 'react'
+
+import { getLogger } from '@deltachat-desktop/shared/logger'
+import { IconButton } from '../Icon'
+import useDialog from '../../hooks/dialog/useDialog'
+import LanguageToolDialog from '../Settings/LanguageToolDialog'
+import {
+  ltCheck,
+  remapMatches,
+  type LtConfig,
+  type LtMatch,
+} from './languageToolCheck'
+
+const log = getLogger('renderer/composer/LanguageTool')
+
+const CHECK_DELAY_MS = 1000
+
+type Props = LtConfig & {
+  text: string
+  /** the textarea's dir attribute */
+  dir?: string
+  textareaRef: React.RefObject<HTMLTextAreaElement | null>
+  /** keep the suggestion card closed, e.g. while the completion menu is open */
+  hideCard?: boolean
+}
+
+// Room below the box for the last line's wavy underline, which overshoots a
+// tight (line-height: normal) line box. Added to height and padding alike, so
+// the scroll range stays the textarea's.
+const UNDERLINE_ROOM_PX = 4
+
+// Room the failure icon leaves at the field's right edge for the resize grip.
+const RESIZE_GRIP_PX = 16
+
+/** Colour class shared by an underline and its card, as in LanguageTool's
+ * own UI: red spelling, blue style, amber everything else. */
+const kind = (m: LtMatch) =>
+  m.issueType === 'misspelling'
+    ? 'misspelling'
+    : m.issueType === 'style'
+      ? 'style'
+      : ''
+
+const fallbackTitle: Record<string, string> = {
+  misspelling: 'Spelling',
+  grammar: 'Grammar',
+  style: 'Style',
+}
+
+/** Put the card just above the flagged word (below it if that would leave
+ * the window), with its pointer on the word. Card and overlay share the same
+ * containing block, so the overlay's coordinates are the card's. */
+function placeCard(card: HTMLElement, layer: HTMLElement, word: HTMLElement) {
+  const box = card.offsetParent as HTMLElement | null
+  if (!box) return
+  const x = layer.offsetLeft + word.offsetLeft - layer.scrollLeft
+  const y = layer.offsetTop + word.offsetTop - layer.scrollTop
+  const left = Math.max(
+    8,
+    Math.min(x - 16, box.clientWidth - card.offsetWidth - 8)
+  )
+  // pointer at the word's middle, kept off the card's rounded corners
+  const arrow = Math.max(
+    14,
+    Math.min(x + word.offsetWidth / 2 - left, card.offsetWidth - 14)
+  )
+  card.style.left = `${left}px`
+  card.style.setProperty('--lt-arrow-x', `${arrow}px`)
+  card.style.top = `${y - card.offsetHeight - 10}px`
+  const below = card.getBoundingClientRect().top < 0
+  card.classList.toggle('below', below)
+  if (below) card.style.top = `${y + word.offsetHeight + 10}px`
+}
+
+/** Lay the overlay exactly over the textarea's text box, with its font
+ * metrics and scroll offset, so it wraps lines identically. */
+function syncLayer(el: HTMLTextAreaElement, layer: HTMLElement) {
+  const cs = getComputedStyle(el)
+  Object.assign(layer.style, {
+    top: `${el.offsetTop + el.clientTop}px`,
+    left: `${el.offsetLeft + el.clientLeft}px`,
+    width: `${el.clientWidth}px`,
+    height: `${el.clientHeight + UNDERLINE_ROOM_PX}px`,
+    fontFamily: cs.fontFamily,
+    fontSize: cs.fontSize,
+    fontWeight: cs.fontWeight,
+    fontStyle: cs.fontStyle,
+    lineHeight: cs.lineHeight,
+    letterSpacing: cs.letterSpacing,
+    wordSpacing: cs.wordSpacing,
+    tabSize: cs.tabSize,
+    textAlign: cs.textAlign,
+    paddingTop: cs.paddingTop,
+    paddingRight: cs.paddingRight,
+    paddingBottom: `calc(${cs.paddingBottom} + ${UNDERLINE_ROOM_PX}px)`,
+    paddingLeft: cs.paddingLeft,
+  })
+  layer.scrollTop = el.scrollTop
+}
+
+/**
+ * Grammar checker (Harper or LanguageTool) underlines for the composer
+ * textarea, plus a suggestion card while the caret sits in a flagged span.
+ * The underlines live in a transparent, click-through copy of the text laid
+ * exactly over the textarea (a textarea can't style parts of its own text,
+ * and the CSS Highlight API can't reach inside one).
+ */
+export function LanguageTool({
+  harper,
+  server,
+  username,
+  apiKey,
+  text,
+  dir,
+  textareaRef,
+  hideCard,
+}: Props) {
+  const [checked, setChecked] = useState<{ text: string; matches: LtMatch[] }>({
+    text: '',
+    matches: [],
+  })
+  const [caret, setCaret] = useState<number | null>(null)
+  // ponytail: per-session ignore list; persist it if people ask
+  const [ignored, setIgnored] = useState<Set<string>>(() => new Set())
+  const layerRef = useRef<HTMLDivElement>(null)
+  const cardRef = useRef<HTMLDivElement>(null)
+  const wordRef = useRef<HTMLSpanElement>(null)
+  // the last check's error, until one works again
+  const [failed, setFailed] = useState<string | null>(null)
+  const failedRef = useRef<HTMLButtonElement>(null)
+  const { openDialog } = useDialog()
+
+  useEffect(() => {
+    if (!text.trim()) {
+      return
+    }
+    const abort = new AbortController()
+    const timer = setTimeout(() => {
+      ltCheck({ harper, server, username, apiKey }, text, abort.signal).then(
+        matches => {
+          setFailed(null)
+          setChecked({ text, matches })
+        },
+        (err: Error) => {
+          if (abort.signal.aborted) return
+          log.warn('check failed', err)
+          // the field opted out of the browser's spellcheck, so show why
+          // nothing gets underlined instead of failing silently
+          setFailed(err.message)
+        }
+      )
+    }, CHECK_DELAY_MS)
+    return () => {
+      clearTimeout(timer)
+      abort.abort()
+    }
+  }, [text, harper, server, username, apiKey])
+
+  // The card follows deliberate caret moves (click/tap, arrow keys) and closes
+  // on typing, so it never pops up mid-sentence.
+  const updateCaret = useCallback(
+    (e: Event) => {
+      const el = textareaRef.current
+      if (
+        !el ||
+        (e.type === 'keyup' &&
+          !/^(Arrow|Home|End|Page)/.test((e as KeyboardEvent).key)) ||
+        // tabbing into the card must not close it
+        (e.type === 'blur' &&
+          cardRef.current?.contains((e as FocusEvent).relatedTarget as Node))
+      ) {
+        return
+      }
+      setCaret(
+        (e.type === 'click' || e.type === 'keyup') &&
+          el.selectionStart === el.selectionEnd
+          ? el.selectionStart
+          : null
+      )
+    },
+    [textareaRef]
+  )
+
+  useEffect(() => {
+    const el = textareaRef.current
+    if (!el) {
+      return
+    }
+    const syncScroll = () => {
+      if (layerRef.current) layerRef.current.scrollTop = el.scrollTop
+    }
+    const resize = new ResizeObserver(
+      () => layerRef.current && syncLayer(el, layerRef.current)
+    )
+    resize.observe(el)
+    const caretEvents = ['input', 'keyup', 'click', 'blur'] as const
+    caretEvents.forEach(t => el.addEventListener(t, updateCaret))
+    el.addEventListener('scroll', syncScroll)
+    return () => {
+      resize.disconnect()
+      caretEvents.forEach(t => el.removeEventListener(t, updateCaret))
+      el.removeEventListener('scroll', syncScroll)
+    }
+  }, [textareaRef, updateCaret])
+
+  // After every render, not just on resize: the box also moves when
+  // something above the field changes height (an error line appearing) and
+  // re-fonts on an emoji-style switch, neither of which resizes the textarea.
+  useLayoutEffect(() => {
+    const el = textareaRef.current
+    const layer = layerRef.current
+    if (el && layer) {
+      syncLayer(el, layer)
+    }
+    // the failure icon sits in the field's top right corner, clear of the
+    // textarea's resize grip
+    if (layer && failedRef.current) {
+      failedRef.current.style.top = `${layer.offsetTop + 2}px`
+      failedRef.current.style.left = `${
+        layer.offsetLeft +
+        layer.offsetWidth -
+        failedRef.current.offsetWidth -
+        RESIZE_GRIP_PX
+      }px`
+    }
+    if (cardRef.current && layerRef.current && wordRef.current) {
+      placeCard(cardRef.current, layerRef.current, wordRef.current)
+    }
+  })
+
+  // overlapping matches: the first one wins, the rest get no underline
+  const matches: LtMatch[] = []
+  for (const m of remapMatches(checked.matches, checked.text, text)) {
+    const last = matches[matches.length - 1]
+    if (
+      !ignored.has(m.key) &&
+      (!last || m.offset >= last.offset + last.length)
+    ) {
+      matches.push(m)
+    }
+  }
+
+  const active =
+    hideCard || caret === null
+      ? undefined
+      : matches.find(m => m.offset <= caret && caret <= m.offset + m.length)
+
+  const parts: React.ReactNode[] = []
+  let pos = 0
+  for (const m of matches) {
+    parts.push(
+      text.slice(pos, m.offset),
+      <span
+        key={m.offset}
+        className={`language-tool-issue ${kind(m)}`}
+        ref={m === active ? wordRef : undefined}
+      >
+        {text.slice(m.offset, m.offset + m.length)}
+      </span>
+    )
+    pos = m.offset + m.length
+  }
+  // the trailing space gives a trailing newline its line, as in the textarea
+  parts.push(text.slice(pos) + ' ')
+
+  const replace = (m: LtMatch, value: string) => {
+    const el = textareaRef.current
+    if (!el) return
+    el.focus()
+    el.setSelectionRange(m.offset, m.offset + m.length)
+    // insertText edits like typing: it lands on the undo stack (Ctrl+Z works)
+    // and fires `input`, so the field's own onChange takes it. setRangeText is
+    // the fallback where the deprecated-but-everywhere execCommand is missing.
+    if (!document.execCommand('insertText', false, value)) {
+      el.setRangeText(value, m.offset, m.offset + m.length, 'end')
+      el.dispatchEvent(new Event('input', { bubbles: true }))
+    }
+    setCaret(null) // the old caret offset is stale now
+  }
+
+  return (
+    <>
+      <div className='language-tool-layer' dir={dir} ref={layerRef} aria-hidden>
+        {parts}
+      </div>
+      {failed && (
+        <button
+          type='button'
+          ref={failedRef}
+          className='language-tool-failed'
+          aria-label={`The grammar checker couldn't check this text: ${failed}`}
+          title={`The grammar checker couldn't check this text: ${failed}. Click to check its settings.`}
+          // mousedown (not click) keeps the textarea focused
+          onMouseDown={e => e.preventDefault()}
+          onClick={() => openDialog(LanguageToolDialog)}
+        >
+          {/* Material's filled "error" icon; ../Icon only has outlined ones */}
+          <svg viewBox='0 0 24 24' width={16} height={16} aria-hidden>
+            <path
+              fill='currentColor'
+              d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z'
+            />
+          </svg>
+        </button>
+      )}
+      {active && (
+        <div
+          className={`language-tool-card ${kind(active)}`}
+          role='group'
+          aria-label='Grammar checker suggestion'
+          ref={cardRef}
+          // mousedown (not click) keeps the textarea focused, as in CompletionMenu
+          onMouseDown={e => e.preventDefault()}
+          onBlur={e => {
+            const to = e.relatedTarget as Node | null
+            if (!cardRef.current?.contains(to) && to !== textareaRef.current) {
+              setCaret(null)
+            }
+          }}
+        >
+          <div className='language-tool-card-head'>
+            <span className='language-tool-card-title'>
+              {active.category ||
+                fallbackTitle[active.issueType] ||
+                'Suggestion'}
+            </span>
+            <IconButton
+              icon='cross'
+              size={14}
+              coloring='currentColor'
+              aria-label='Close'
+              className='language-tool-card-close'
+              onClick={() => {
+                setCaret(null)
+                textareaRef.current?.focus()
+              }}
+            />
+          </div>
+          <p className='language-tool-card-message'>{active.message}</p>
+          {active.replacements.length > 0 && (
+            <div className='language-tool-card-suggestions'>
+              {active.replacements.map(r => (
+                <button
+                  type='button'
+                  key={r}
+                  className='language-tool-card-suggestion'
+                  onClick={() => replace(active, r)}
+                >
+                  {r || 'Remove'}
+                </button>
+              ))}
+            </div>
+          )}
+          <button
+            type='button'
+            className='language-tool-card-ignore'
+            onClick={() => {
+              setIgnored(prev => new Set(prev).add(active.key))
+              textareaRef.current?.focus()
+            }}
+          >
+            Ignore
+          </button>
+          <span className='language-tool-card-arrow' aria-hidden />
+        </div>
+      )}
+    </>
+  )
+}
diff --git a/packages/frontend/src/components/composer/languageToolCheck.ts b/packages/frontend/src/components/composer/languageToolCheck.ts
new file mode 100644
index 0000000000000000000000000000000000000000..da8d7098e343866719e2890e8130283bc2dcd489
--- /dev/null
+++ b/packages/frontend/src/components/composer/languageToolCheck.ts
@@ -0,0 +1,235 @@
+// Spelling/grammar check for the composer: Harper (https://writewithharper.com,
+// English only, wasm on this device) or LanguageTool (https://languagetool.org,
+// HTTP API), and remapping results onto edited text. LanguageTool is plain
+// fetch, so it works the same on browser, Electron and Tauri — the desktop
+// targets ship with Chromium spellcheck off (no local hunspell dictionary).
+
+import type { DesktopSettingsType } from '@deltachat-desktop/shared/shared-types'
+
+export type LtConfig = {
+  /** check with Harper on this device instead of a LanguageTool server */
+  harper?: boolean
+  /** self-hosted server base URL; unset = languagetool.org */
+  server?: string
+  /** languagetool.org Premium: account email + API key; unset = free API */
+  username?: string
+  apiKey?: string
+}
+
+export type LtMatch = {
+  offset: number
+  length: number
+  message: string
+  replacements: string[]
+  /** LanguageTool's rule.issueType, e.g. 'misspelling', 'grammar', 'style' */
+  issueType: string
+  /** the rule's category, e.g. "Possible Typo", "Grammar" (in the text's language) */
+  category: string
+  /** rule id + flagged text, what "Ignore" remembers */
+  key: string
+}
+
+/** The check config from the desktop settings, or null while it is off. */
+export function languageToolConfig(s: DesktopSettingsType): LtConfig | null {
+  if (!s.grammarCheck) {
+    return null
+  }
+  return s.grammarCheckEngine === 'harper'
+    ? { harper: true }
+    : {
+        server: s.languageToolServer,
+        username: s.languageToolUsername,
+        apiKey: s.languageToolApiKey,
+      }
+}
+
+/** A self-hosted server address the app can reach: http(s), at the root of
+ * its host (http://host:8081, …/v2 and …/v2/check alike). The CSPs only allow
+ * the path /v2/check, so a sub-path behind a reverse proxy can't work. */
+export function isLtServerUrl(server: string): boolean {
+  try {
+    const u = new URL(server)
+    return (
+      /^https?:$/.test(u.protocol) &&
+      /^\/(v2(\/check)?\/?)?$/.test(u.pathname) &&
+      !u.search &&
+      !u.hash
+    )
+  } catch {
+    return false
+  }
+}
+
+export function ltCheckUrl(cfg: LtConfig): string {
+  if (cfg.server) {
+    return new URL('/v2/check', cfg.server).href
+  }
+  return cfg.username && cfg.apiKey
+    ? 'https://api.languagetoolplus.com/v2/check'
+    : 'https://api.languagetool.org/v2/check'
+}
+
+// ponytail: language=auto only. Detection can misfire on very short
+// messages; add a language picker (or preferredVariants from the UI locale)
+// if that shows up in practice.
+export async function ltCheck(
+  cfg: LtConfig,
+  text: string,
+  signal?: AbortSignal
+): Promise<LtMatch[]> {
+  if (cfg.harper) {
+    const lints = await (
+      await harperLinter()
+    ).lint(text, {
+      language: 'plaintext',
+    })
+    // the worker can't be aborted; drop a result nobody waits for anymore
+    signal?.throwIfAborted()
+    return lints.map(harperMatch)
+  }
+  const body = new URLSearchParams({ text, language: 'auto' })
+  if (!cfg.server && cfg.username && cfg.apiKey) {
+    body.set('username', cfg.username)
+    body.set('apiKey', cfg.apiKey)
+  }
+  // form-encoded POST is a CORS "simple request": no preflight, so a
+  // self-hosted server only needs --allow-origin, not OPTIONS handling
+  const res = await fetch(ltCheckUrl(cfg), { method: 'POST', body, signal })
+  if (!res.ok) {
+    throw new Error(`HTTP ${res.status}: ${(await res.text()).slice(0, 200)}`)
+  }
+  const { matches } = await res.json()
+  return (matches as any[]).map(m => ({
+    offset: m.offset,
+    length: m.length,
+    message: m.message,
+    replacements: (m.replacements as { value: string }[])
+      .slice(0, 5)
+      .map(r => r.value),
+    issueType: m.rule?.issueType ?? '',
+    category: m.rule?.category?.name ?? '',
+    key: `${m.rule?.id}:${text.slice(m.offset, m.offset + m.length)}`,
+  }))
+}
+
+/** Carry matches computed for `from` over to `to`, so underlines don't flicker
+ * while typing: matches before the edited span keep their offset, matches
+ * after it shift, and a match is dropped (until the next check) once the edit
+ * reaches it or the character right next to it. */
+export function remapMatches(
+  matches: LtMatch[],
+  from: string,
+  to: string
+): LtMatch[] {
+  if (from === to) {
+    return matches
+  }
+  const max = Math.min(from.length, to.length)
+  let prefix = 0
+  while (prefix < max && from[prefix] === to[prefix]) prefix++
+  let suffix = 0
+  while (
+    suffix < max - prefix &&
+    from[from.length - 1 - suffix] === to[to.length - 1 - suffix]
+  )
+    suffix++
+  const editEnd = from.length - suffix
+  const delta = to.length - from.length
+  // the flagged text plus one character either side
+  const around = (s: string, offset: number, length: number) =>
+    s.slice(Math.max(0, offset - 1), offset + length + 1)
+  const kept: LtMatch[] = []
+  for (const m of matches) {
+    const offset =
+      m.offset + m.length <= prefix
+        ? m.offset
+        : m.offset >= editEnd
+          ? m.offset + delta
+          : -1
+    if (
+      offset >= 0 &&
+      around(from, m.offset, m.length) === around(to, offset, m.length)
+    ) {
+      kept.push({ ...m, offset })
+    }
+  }
+  return kept
+}
+
+// Minimal shape of the harper.js API used here (it's imported at runtime, so
+// its own typings aren't available).
+type HarperLint = {
+  span(): { start: number; end: number }
+  message(): string
+  lint_kind(): string
+  lint_kind_pretty(): string
+  get_problem_text(): string
+  suggestions(): { kind(): number; get_replacement_text(): string }[]
+}
+type HarperLinter = {
+  lint(text: string, options: { language: 'plaintext' }): Promise<HarperLint[]>
+}
+
+let harper: Promise<HarperLinter> | undefined
+
+/** The shared Harper linter, loaded on first use only: harper.js plus its
+ * ~15 MB wasm are fetched only once the check is on with Harper selected. The
+ * web-app serves harper.js in harper/ (like videojs-locales/); it lints in a
+ * worker, so the composer never waits on it. */
+function harperLinter(): Promise<HarperLinter> {
+  harper ??= (async () => {
+    // full URL: relative to the app (subpath deployments), not to bundle.js
+    const url = (file: string) =>
+      new URL(`harper/${file}`, document.baseURI).href
+    const [{ WorkerLinter }, { binary }] = await Promise.all([
+      import(/* runtime, not bundled */ url('index.js')),
+      import(/* runtime, not bundled */ url('binary.js')),
+    ])
+    const linter: HarperLinter = new WorkerLinter({ binary })
+    return linter
+  })()
+  // a failed load (offline, say) is retried by the next check
+  harper.catch(() => (harper = undefined))
+  return harper
+}
+
+const harperStyle = new Set([
+  'Enhancement',
+  'Readability',
+  'Redundancy',
+  'Repetition',
+  'Style',
+  'WordChoice',
+])
+
+/** A Harper lint as a match, coloured like LanguageTool's issue types. Its
+ * span is in UTF-16 units already, like a JS string's. */
+export function harperMatch(l: HarperLint): LtMatch {
+  const { start, end } = l.span()
+  const kind = l.lint_kind()
+  const problem = l.get_problem_text()
+  return {
+    offset: start,
+    length: end - start,
+    message: l.message(),
+    // SuggestionKind: 0 replace, 1 remove, 2 insert after the flagged text
+    replacements: l
+      .suggestions()
+      .slice(0, 5)
+      .map(r =>
+        r.kind() === 1
+          ? ''
+          : r.kind() === 2
+            ? problem + r.get_replacement_text()
+            : r.get_replacement_text()
+      ),
+    issueType:
+      kind === 'Spelling' || kind === 'Typo'
+        ? 'misspelling'
+        : harperStyle.has(kind)
+          ? 'style'
+          : 'grammar',
+    category: l.lint_kind_pretty(),
+    key: `harper:${kind}:${problem}`,
+  }
+}
