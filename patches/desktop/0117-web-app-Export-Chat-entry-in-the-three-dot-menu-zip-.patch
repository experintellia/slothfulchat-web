+import React, { useRef, useState } from 'react'
+import moment from 'moment'
+import { T } from '@deltachat/jsonrpc-client'
+
+import { getLogger } from '@deltachat-desktop/shared/logger'
+import { selectedAccountId } from '../../ScreenController'
+import Dialog, {
+  DialogBody,
+  DialogContent,
+  DialogFooter,
+  DialogHeader,
+  FooterActionButton,
+  FooterActions,
+} from '../Dialog'
+import { DeltaProgressBar } from '../Login-Styles'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+// unused, but it keeps esbuild's css-module order (and with it bundle.css's
+// cascade and class-name suffixes) the same as when the zip was built here
+import '../message/Message'
+
+import messageStyles from '../message/styles.module.scss'
+import reactionsStyles from '../Reactions/styles.module.scss'
+
+import type { DialogProps } from '../../contexts/DialogContext'
+
+const log = getLogger('renderer/dialogs/ExportChatToHtml')
+
+type Props = {
+  chat: T.FullChat
+} & DialogProps
+
+/**
+ * Progress dialog that exports the given chat to a Telegram-style zip
+ * download. The zip itself (viewer html, txt, json, media) is built outside
+ * this tree, by slothfulchat-web's packages/web-app/src/chat-export.ts, which
+ * registers window.__slothfulExportChat; this dialog only hands it what lives
+ * in the frontend bundle — the hashed css-module class names the viewer
+ * reuses and the user's moment locale — and shows progress. A confirm step
+ * first says what the export leaves out and takes an optional date range.
+ */
+export default function ExportChatToHtml({ chat, onClose }: Props) {
+  const tx = useTranslationFunction()
+  const accountId = selectedAccountId()
+  const [phase, setPhase] = useState<'configure' | 'running'>('configure')
+  const [progress, setProgress] = useState(0)
+  const [startDate, setStartDate] = useState('')
+  const [endDate, setEndDate] = useState('')
+  const abort = useRef(new AbortController())
+
+  const startExport = () => {
+    setPhase('running')
+    const signal = abort.current.signal
+    ;(window as any)
+      .__slothfulExportChat(chat.id, {
+        accountId,
+        // interpret both dates in the user's local timezone, inclusive
+        startTs: startDate
+          ? new Date(startDate + 'T00:00:00').getTime() / 1000
+          : null,
+        endTs: endDate
+          ? new Date(endDate + 'T23:59:59.999').getTime() / 1000
+          : null,
+        styles: {
+          message: messageStyles.message,
+          messageFooter: messageStyles.messageFooter,
+          onlyMedia: messageStyles.onlyMedia,
+          reactions: reactionsStyles.reactions,
+          emoji: reactionsStyles.emoji,
+          emojiCount: reactionsStyles.emojiCount,
+          isFromSelf: reactionsStyles.isFromSelf,
+        },
+        formatDate: (ts: number, format: string) =>
+          moment.unix(ts).format(format),
+        onProgress: setProgress,
+        signal,
+      })
+      .then((filename: string) => {
+        window.__userFeedback?.({
+          type: 'success',
+          text: tx('chat_exported_as_x', filename),
+        })
+      })
+      .catch((error: any) => {
+        if (signal.aborted) {
+          return
+        }
+        log.error('chat export failed:', error)
+        window.__userFeedback?.({
+          type: 'error',
+          text: 'Chat export failed: ' + (error?.message || String(error)),
+        })
+      })
+      .finally(onClose)
+  }
+
+  if (phase === 'configure') {
+    return (
+      <Dialog onClose={onClose} canOutsideClickClose={false} width={400}>
+        <DialogHeader title={tx('menu_export_chat')} />
+        <DialogBody>
+          <DialogContent>
+            <p className='whitespace'>{tx('export_chat_explain')}</p>
+            <label style={{ display: 'block', margin: '8px 0' }}>
+              {tx('export_chat_start_date')}{' '}
+              <input
+                type='date'
+                value={startDate}
+                onChange={event => setStartDate(event.target.value)}
+                data-testid='export-chat-start-date'
+              />
+            </label>
+            <label style={{ display: 'block', margin: '8px 0' }}>
+              {tx('export_chat_end_date')}{' '}
+              <input
+                type='date'
+                value={endDate}
+                onChange={event => setEndDate(event.target.value)}
+                data-testid='export-chat-end-date'
+              />
+            </label>
+          </DialogContent>
+          <DialogFooter>
+            <FooterActions align='end'>
+              <FooterActionButton onClick={onClose} data-testid='cancel'>
+                {tx('cancel')}
+              </FooterActionButton>
+              <FooterActionButton
+                styling='primary'
+                onClick={startExport}
+                data-testid='export-chat-start'
+              >
+                {tx('export_chat_start_button')}
+              </FooterActionButton>
+            </FooterActions>
+          </DialogFooter>
+        </DialogBody>
+      </Dialog>
+    )
+  }
+
+  return (
+    <Dialog
+      onClose={() => {}}
+      canOutsideClickClose={false}
+      canEscapeKeyClose={false}
+    >
+      <DialogHeader title={tx('menu_export_chat')} />
+      <DialogBody>
+        <DialogContent>
+          <DeltaProgressBar progress={progress} />
+        </DialogContent>
+        <DialogFooter>
+          <FooterActions align='end'>
+            <FooterActionButton onClick={() => abort.current.abort()}>
+              {tx('cancel')}
+            </FooterActionButton>
+          </FooterActions>
+        </DialogFooter>
+      </DialogBody>
+    </Dialog>
+  )
+}
