diff --git a/packages/frontend/src/tests/placeholderCaption.test.ts b/packages/frontend/src/tests/placeholderCaption.test.ts
new file mode 100644
index 0000000..783ad54
--- /dev/null
+++ b/packages/frontend/src/tests/placeholderCaption.test.ts
@@ -0,0 +1,32 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import { placeholderCaption } from '../utils/downloadPlaceholder.js'
+
+describe('placeholderCaption', () => {
+  it('strips the appended "[Label – size]" tag', () => {
+    expect(placeholderCaption('hello [Image – 228.45 KiB]')).to.equal('hello')
+    expect(placeholderCaption('hi [voice.mp3 – 566.75 KiB]')).to.equal('hi')
+  })
+
+  it('returns empty for tag-only text (caption-less placeholder)', () => {
+    expect(placeholderCaption(' [Video – 3.52 MiB]')).to.equal('')
+    expect(placeholderCaption(null)).to.equal('')
+  })
+
+  it('keeps user brackets before the tag, strips only the last group', () => {
+    expect(placeholderCaption('see [a – b] [Image – 228 KiB]')).to.equal(
+      'see [a – b]'
+    )
+  })
+
+  it('handles the unknown-size "?" core falls back to', () => {
+    expect(placeholderCaption('x [file.bin – ?]')).to.equal('x')
+  })
+
+  it('known ceiling: filename containing brackets is left as-is', () => {
+    expect(placeholderCaption('x [report[final].pdf – 977 KiB]')).to.equal(
+      'x [report[final].pdf – 977 KiB]'
+    )
+  })
+})
diff --git a/packages/frontend/src/utils/downloadPlaceholder.ts b/packages/frontend/src/utils/downloadPlaceholder.ts
new file mode 100644
index 0000000..af8be77
--- /dev/null
+++ b/packages/frontend/src/utils/downloadPlaceholder.ts
@@ -0,0 +1,33 @@
+import type { T } from '@deltachat/jsonrpc-client'
+
+/**
+ * The type the message will have *after* it is downloaded. It's a fork-only
+ * field on the pre-message placeholder that upstream's generated jsonrpc
+ * bindings don't declare yet (core regenerates them later in the build), so we
+ * read it through this one typed accessor.
+ *
+ * ponytail: single typed cast lives here instead of scattering `as any` at call
+ * sites; drop the cast once the regenerated bindings carry `postMessageViewType`.
+ */
+export function getPostMessageViewType(message: T.Message): T.Viewtype | null {
+  const viewType =
+    (message as { postMessageViewType?: T.Viewtype | null })
+      .postMessageViewType ?? null
+  // 'Unknown' would fall through to a nameless generic card; the plain-text
+  // fallback line is strictly better for it.
+  return viewType === 'Unknown' ? null : viewType
+}
+
+// Core appends " [Label – 123 KiB]" to the placeholder text (message.rs:645-674,
+// bracketed, with an en-dash before the size). Strip that trailing tag so our
+// own UI shows the size instead of duplicating it in the caption.
+//
+// ponytail: regex on the bracket/en-dash shape; known ceiling: a File tag whose
+// filename itself contains "[" or "]" is not stripped (caption then shows the
+// tag next to our size chip - cosmetic). Upgrade path = a core field carrying
+// the raw caption without the appended tag.
+const DOWNLOAD_TAG_RE = /\s*\[[^\]]*–[^\]]*\]\s*$/
+
+export function placeholderCaption(text: string | null | undefined): string {
+  return (text ?? '').replace(DOWNLOAD_TAG_RE, '').trim()
+}
