--- /dev/null
+++ b/packages/frontend/scss/message/_message-download-placeholder.scss
@@ -0,0 +1,290 @@
+// Styled download-on-demand placeholders (see DownloadOnDemandPlaceholder.tsx).
+// Reuses the .message-attachment-* / .webxdc boxes from _message-attachment.scss
+// and adds: a blurred thumbnail, a grey fallback box, and a centered overlay
+// with a circular download button plus the target file size.
+
+.download-on-demand {
+  // Media types (image / gif / sticker / video) share the media box.
+  &.message-attachment-media {
+    display: block;
+    min-height: 160px;
+    // The bubble's own 16px radius rounds the top corners; the caption /
+    // metadata strip sits below, so the preview keeps square bottom corners
+    // instead of drawing a second arc above it.
+    border-radius: 16px 16px 0 0;
+
+    // No caption: the preview IS the bubble bottom (metadata overlays it),
+    // so round all corners to match the bubble.
+    &.no-caption {
+      border-radius: 16px;
+    }
+
+    // Blur the thumbnail so it reads as "not yet downloaded".
+    & > .attachment-content {
+      width: 100%;
+      height: 100%;
+      min-height: 160px;
+      object-fit: cover;
+      filter: blur(6px);
+      // blur() samples transparent pixels past the edge; scale up to hide it.
+      transform: scale(1.1);
+    }
+
+    & > .download-on-demand-empty {
+      width: 100%;
+      // Intrinsic minimum so a thumbnail-less placeholder (e.g. video) doesn't
+      // let the bubble shrink-wrap to a sliver; matches upstream's
+      // .attachment-content min-width, and fits the download button + size.
+      min-width: 200px;
+      min-height: 160px;
+      background-color: var(--messageAttachmentIconBg);
+    }
+
+    &.video > .attachment-content,
+    &.video > .download-on-demand-empty {
+      background-color: black;
+    }
+
+    // CSS play triangle, centered behind the overlay controls.
+    & > .play-glyph {
+      position: absolute;
+      top: 50%;
+      left: 50%;
+      transform: translate(-40%, -180%);
+      width: 0;
+      height: 0;
+      border-style: solid;
+      border-width: 14px 0 14px 24px;
+      border-color: transparent transparent transparent
+        rgba(255, 255, 255, 0.85);
+    }
+  }
+
+  .download-on-demand-overlay {
+    position: absolute;
+    inset: 0;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 8px;
+
+    // Text-shadow alone doesn't give enough contrast over a light blurred
+    // thumbnail; put the controls on a translucent dark chip.
+    .download-on-demand-controls {
+      background-color: rgba(0, 0, 0, 0.4);
+      border-radius: 16px;
+      padding: 10px 16px;
+    }
+
+    .duration {
+      color: white;
+      font-size: 12px;
+      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
+    }
+  }
+
+  // Fake audio player: mirrors the native <audio controls> bar the real
+  // message shows (AudioPlayer/styles.module.scss: min-width 300px, translucent
+  // grey panel), with a download circle where the play button sits.
+  .fake-audio-player {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    min-width: 300px;
+    max-width: 100%;
+    padding: 6px 12px;
+    border-radius: 20px;
+    background-color: rgba(200, 200, 200, 0.3);
+
+    .time {
+      font-size: 12px;
+      font-variant-numeric: tabular-nums;
+    }
+
+    .fake-track {
+      flex: 1;
+      min-width: 40px;
+      height: 4px;
+      border-radius: 2px;
+      background-color: currentColor;
+      opacity: 0.35;
+    }
+
+    .size {
+      font-size: 11px;
+      color: var(--messageAttachmentFileInfo);
+    }
+  }
+
+  // Non-media rows (audio / file / webxdc) lay controls out inline.
+  &.message-attachment-audio,
+  &.message-attachment-generic,
+  &.webxdc {
+    align-items: center;
+  }
+
+  &.message-attachment-audio .failed,
+  &.message-attachment-generic .failed {
+    color: var(--errorText, #e6512c);
+    font-size: 12px;
+  }
+
+  // Shared circular download button (media overlay, audio pill, file card).
+  .circle-download-button {
+    flex-shrink: 0;
+    width: 36px;
+    height: 36px;
+    border: none;
+    border-radius: 50%;
+    background-color: var(--colorPrimary, #415e6b);
+    cursor: pointer;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+
+    // The Icon component's css-masked span; its background-color IS the
+    // icon color.
+    & > span {
+      background-color: white;
+    }
+  }
+
+  // In-row ring/button sizing for the audio pill and file card.
+  .fake-audio-player,
+  &.message-attachment-generic {
+    .download-progress-circle {
+      flex-shrink: 0;
+      width: 36px;
+      height: 36px;
+      align-self: center;
+    }
+
+    .circle-download-button {
+      align-self: center;
+    }
+  }
+
+  // File card: mirror the real generic attachment (icon | name+size column),
+  // download circle trailing; long names wrap instead of stretching the row.
+  &.message-attachment-generic {
+    display: flex;
+    gap: 10px;
+
+    .text-part {
+      flex: 1;
+      min-width: 0;
+
+      .name {
+        overflow-wrap: anywhere;
+      }
+
+      .size {
+        font-size: 11px;
+        color: var(--messageAttachmentFileInfo);
+        margin-top: 3px;
+      }
+    }
+  }
+
+  .text-part > .duration {
+    color: var(--messageAttachmentFileInfo);
+    font-size: 11px;
+    line-height: 16px;
+    margin-top: 3px;
+  }
+}
+
+.download-on-demand-controls {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+
+  .size {
+    font-size: 11px;
+    letter-spacing: 0.3px;
+    color: var(--messageAttachmentFileInfo);
+  }
+
+  // Over a blurred thumbnail the size text needs contrast.
+  .download-on-demand-overlay & .size,
+  .download-on-demand-overlay & .failed {
+    color: white;
+    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
+  }
+
+  .failed {
+    color: var(--errorText, #e6512c);
+    font-size: 12px;
+  }
+}
+
+// Telegram-style circular download indicator (ProgressCircle). Top-level so
+// every placement (media overlay chip, audio pill, file card) gets the same
+// styling — svg circles MUST get fill: none or they render as filled discs.
+.download-progress-circle {
+  position: relative;
+  width: 40px;
+  height: 40px;
+
+  svg {
+    width: 100%;
+    height: 100%;
+    // Determinate fill starts at 12 o'clock.
+    transform: rotate(-90deg);
+
+    circle {
+      fill: none;
+      stroke-width: 3.5;
+      stroke-linecap: round;
+    }
+    .track {
+      stroke: var(--colorPrimary, #415e6b);
+      opacity: 0.25;
+    }
+    .bar {
+      stroke: var(--colorPrimary, #415e6b);
+      transition: stroke-dashoffset 0.3s linear;
+    }
+
+    &.indeterminate {
+      animation: download-progress-spin 1s linear infinite;
+    }
+  }
+
+  .pct {
+    position: absolute;
+    inset: 0;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-size: 9px;
+    letter-spacing: -0.2px;
+    color: var(--colorPrimary, #415e6b);
+  }
+
+  // Over a blurred thumbnail the ring needs contrast.
+  .download-on-demand-overlay & {
+    .track {
+      stroke: rgba(255, 255, 255, 0.4);
+      opacity: 1;
+    }
+    .bar {
+      stroke: white;
+    }
+    .pct {
+      color: white;
+      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
+    }
+  }
+}
+
+@keyframes download-progress-spin {
+  from {
+    transform: rotate(-90deg);
+  }
+  to {
+    transform: rotate(270deg);
+  }
+}
