+      >
         <circle className='track' cx='20' cy='20' r={RING_R} />
         <circle
           className='bar'
@@ -54,6 +70,17 @@ function ProgressCircle({
         />
       </svg>
       {!indeterminate && <span className='pct'>{percent}%</span>}
