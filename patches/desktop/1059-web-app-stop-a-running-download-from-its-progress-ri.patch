+// `abortDownload` is fork core API (core/1015); the published
+// @deltachat/jsonrpc-client this tree type-checks against lacks it, so it is
+// typed locally (same pattern as backend/replyThreads.ts).
+export const abortDownload = (accountId: number, msgId: number) =>
+  (
+    BackendRemote.rpc as typeof BackendRemote.rpc & {
+      abortDownload(accountId: number, msgId: number): Promise<void>
+    }
+  ).abortDownload(accountId, msgId)
+
 // Telegram-style circular download indicator: spins while indeterminate
