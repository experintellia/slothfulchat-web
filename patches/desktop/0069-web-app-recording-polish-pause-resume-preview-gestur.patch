+}
+
+/**
+ * Feed (rmsValue, nowMs) once per audio frame. Any signal above the threshold
+ * resets the quiet timer; sustained near-silence accumulates and reports true
+ * after SILENCE_HOLD_MS. Paused time can't count toward silence because the
+ * recorder skips frames while paused (nothing is fed) — reset on resume so the
+ * paused gap doesn't back-date quietSince.
+ */
+export function silenceStep(
+  s: SilenceState,
+  rms: number,
+  nowMs: number
+): [SilenceState, boolean] {
+  if (rms > SILENCE_RMS_THRESHOLD) {
+    return [{ quietSinceMs: null }, false]
+  }
+  const quietSince = s.quietSinceMs ?? nowMs
+  return [{ quietSinceMs: quietSince }, nowMs - quietSince >= SILENCE_HOLD_MS]
+}
