diff --git a/packages/frontend/src/components/Dialog/styles.module.scss b/packages/frontend/src/components/Dialog/styles.module.scss
index 79151e4059f4aad49a63365a53599fe81db39bb2..f32268e6ada5d448704fa9b357985b7d9e5215a7 100644
--- a/packages/frontend/src/components/Dialog/styles.module.scss
+++ b/packages/frontend/src/components/Dialog/styles.module.scss
@@ -45,6 +45,53 @@ $paddingVertical: 20px;
   }
 }
 
+/* Big dialogs (settings, about, gallery, profiles, new chat, QR scanner…)
+   go edge-to-edge on small/mobile viewports: full screen, no rounded
+   corners, no margin or drop shadow. Keyed on each dialog's `data-testid`
+   (attribute selectors stay global in CSS modules) instead of a prop
+   threaded through <Dialog>/<DialogWithHeader>, so opting a dialog in is a
+   one-line `dataTestid` — most big dialogs already carry one. The list may
+   name dialogs added by later patches; unmatched selectors are inert. */
+@media (max-width: variables.$dialog-breakpoint) {
+  .dialog:is(
+      [data-testid='settings-dialog'],
+      [data-testid='settings-section-dialog'],
+      [data-testid='about-dialog'],
+      [data-testid='connectivity-dialog'],
+      [data-testid='create-chat-dialog'],
+      [data-testid='clone-chat-dialog'],
+      [data-testid='create-group-dialog'],
+      [data-testid='create-broadcast-dialog'],
+      [data-testid='edit-profile-dialog'],
+      [data-testid='media-view-dialog'],
+      [data-testid='public-bots-dialog'],
+      [data-testid='public-channels-dialog'],
+      [data-testid='qr-dialog'],
+      [data-testid='qrscan-dialog'],
+      [data-testid='view-group-dialog'],
+      [data-testid='view-profile-dialog']
+    ) {
+    border-radius: 0;
+    box-shadow: none;
+    margin: 0;
+    width: 100vw;
+    min-width: 100vw;
+    max-width: 100vw;
+    height: 100dvh;
+    max-height: 100dvh;
+
+    &:not(.noTopPadding) {
+      /* keep some breathing room above the header, and clear the device
+         status bar / notch on mobile */
+      padding-top: calc(#{$paddingVertical} + env(safe-area-inset-top, 0px));
+    }
+
+    .dialogBody {
+      max-height: none;
+    }
+  }
+}
+
 .dialogHeader {
   width: 100%;
   align-items: center;
diff --git a/packages/frontend/src/components/QrReader/styles.module.scss b/packages/frontend/src/components/QrReader/styles.module.scss
index c423a781c26066b9b0e1a5b59c808e68d7415cdf..d43ad0b19fbafe86b668b2bbeb99ed51a9db1249 100644
--- a/packages/frontend/src/components/QrReader/styles.module.scss
+++ b/packages/frontend/src/components/QrReader/styles.module.scss
@@ -1,7 +1,19 @@
+@use '../../../scss/variables.scss';
+
 .qrReader {
   position: relative;
   height: 375px;
   margin-bottom: 20px;
+
+  // On small/mobile viewports the QR dialog is full-screen: grow the scanner
+  // to fill the available height (and let the video/status fill it too)
+  // instead of leaving it a small box at the top.
+  @media (max-width: variables.$dialog-breakpoint) {
+    height: auto;
+    min-height: 375px;
+    // keep the 20px bottom margin so the scanner doesn't touch the footer
+    flex: 1 1 auto;
+  }
 }
 
 .qrReaderVideo {
@@ -58,6 +70,12 @@
   text-align: center;
   top: 0;
 
+  @media (max-width: variables.$dialog-breakpoint) {
+    // fill the grown scanner area rather than staying a fixed 375px box
+    height: auto;
+    bottom: 0;
+  }
+
   &.info {
     background-color: gray;
   }
