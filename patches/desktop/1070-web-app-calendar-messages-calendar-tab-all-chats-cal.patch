+  .time {
+    min-width: 9em;
+  }
+}
+
+.summary {
+  font-weight: bold;
+}
+
+.location {
+  color: var(--textSecondary);
+}
+
+.description {
+  white-space: pre-wrap;
+}
+
+.cancelledNote,
+.error {
+  color: var(--colorDanger);
+}
+
+.chatLine {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--textSecondary);
+}
+
+.dot {
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+}
+
+.form {
+  display: flex;
+  flex-direction: column;
+
+  input,
+  textarea {
+    font: inherit;
+    color: inherit;
+  }
+}
+
+.titleInput {
+  width: 100%;
+  box-sizing: border-box;
+  margin-bottom: 8px;
+  padding: 6px 0;
+  border: 0;
+  border-bottom: 2px solid var(--separatorColor);
+  background: transparent;
+  font-size: 1.4em !important;
+  font-weight: 500;
+  outline: none;
+
+  &:focus {
+    border-bottom-color: var(--colorPrimary);
+  }
+}
+
+// One row per field group: an icon column, then the controls.
+.section {
+  display: grid;
+  grid-template-columns: 36px minmax(0, 1fr);
+  align-items: start;
+  padding: 10px 0;
+  border-bottom: 1px solid var(--separatorColor);
+
+  &:last-of-type {
+    border-bottom: 0;
+  }
+}
+
+.formIcon {
+  width: 20px;
+  height: 20px;
+  margin-top: 9px;
+  color: var(--textSecondary);
+}
+
+.sectionBody {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.switchRow {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  min-height: 38px;
+}
+
+// "From [date] [time]" / "To [date] [time]"
+.when {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 6px 8px;
+
+  label {
+    color: var(--textSecondary);
+    font-size: 0.9em;
+  }
+
+  input {
+    min-height: 38px;
+    padding: 6px 10px;
+    border: 1px solid transparent;
+    border-radius: 8px;
+    background: var(--globalHoverBg);
+
+    &:focus {
+      border-color: var(--colorPrimary);
+      outline: none;
+    }
+  }
+
+  // all day: no time column
+  &.allDay {
+    grid-template-columns: auto minmax(0, 1fr);
+  }
+}
+
+.hint {
+  color: var(--textSecondary);
+  font-size: 0.85em;
+}
+
+.chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  padding-top: 2px;
+}
+
+.chipOption {
+  min-height: 34px;
+  padding: 6px 12px;
+  border: 1px solid var(--separatorColor);
+  border-radius: 17px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  font-size: 0.9em;
+  cursor: pointer;
+
+  &:hover {
+    background: var(--globalHoverBg);
+  }
+}
+
+.chipSelected {
+  border-color: var(--colorPrimary);
+  background: color-mix(in srgb, var(--colorPrimary) 15%, transparent);
+  font-weight: 500;
+}
+
+.plain {
+  width: 100%;
+  box-sizing: border-box;
+  min-height: 38px;
+  padding: 8px 0;
+  border: 0;
+  background: transparent;
+  outline: none;
+  resize: vertical;
+}
+
+// Event card (design F): date block + text, a button in chat bubbles.
+.card {
+  display: flex;
+  align-items: stretch;
+  gap: 12px;
+  min-width: 240px;
+  max-width: 100%;
+  padding: 10px;
+  border: 0;
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--colorPrimary) 6%, var(--bgPrimary));
+  color: var(--textPrimary);
+  font: inherit;
+  text-align: start;
+
+  &:is(button) {
+    cursor: pointer;
+
+    &:hover {
+      background: color-mix(in srgb, var(--colorPrimary) 12%, var(--bgPrimary));
+    }
+  }
+}
+
+.dateBlock {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  width: 52px;
+  padding: 6px 0;
+  border-radius: 8px;
+  background: var(--bgPrimary);
+  text-transform: uppercase;
+}
+
+.dateWeekday {
+  color: var(--colorPrimary);
+  font-size: 0.75em;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+}
+
+.dateDay {
+  font-size: 1.6em;
+  font-weight: 700;
+  line-height: 1.1;
+}
+
+.dateMonth {
+  color: var(--textSecondary);
+  font-size: 0.75em;
+}
+
+.cardText {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 5px;
+  min-width: 0;
+}
+
+.cardTitle {
+  font-size: 1.1em;
+  font-weight: 500;
+  overflow-wrap: anywhere;
+}
+
+.cardLine {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  color: var(--textSecondary);
+  font-size: 0.9em;
+}
+
+.lineIcon {
+  width: 14px;
+  height: 14px;
+  flex-shrink: 0;
+}
+
+.cardLocation {
+  overflow-wrap: anywhere;
+}
+
+.repeatChip {
+  padding: 1px 7px;
+  border-radius: 10px;
+  background: color-mix(in srgb, var(--colorPrimary) 15%, transparent);
+  color: var(--colorPrimary);
+  font-size: 0.85em;
+}
+
+.cardCancelled {
+  .dateBlock {
+    background: color-mix(in srgb, var(--colorDanger) 12%, var(--bgPrimary));
+  }
+
+  .dateWeekday {
+    color: var(--colorDanger);
+  }
+
+  .dateDay,
+  .cardTitle {
+    color: var(--textSecondary);
+    text-decoration: line-through;
+  }
+}
+
+.cancelledLabel {
+  color: var(--colorDanger);
+  font-size: 0.8em;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.srOnly {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+// A Calendar message: the card, then the RSVP row.
+.messageEvent {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.rsvp {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.rsvpButton {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  min-height: 32px;
+  padding: 4px 10px;
+  border: 1px solid var(--separatorColor);
+  border-radius: 16px;
+  background: var(--bgPrimary);
+  color: inherit;
+  font: inherit;
+  font-size: 0.85em;
+  cursor: pointer;
+
+  &:hover {
+    background: var(--globalHoverBg);
+  }
+}
+
+.rsvpOn {
+  border-color: var(--colorPrimary);
+  background: color-mix(in srgb, var(--colorPrimary) 15%, var(--bgPrimary));
+  font-weight: 500;
+}
+
+.rsvpCount {
+  min-width: 1.4em;
+  padding: 0 5px;
+  border-radius: 9px;
+  background: color-mix(in srgb, var(--textSecondary) 15%, transparent);
+  text-align: center;
+}
