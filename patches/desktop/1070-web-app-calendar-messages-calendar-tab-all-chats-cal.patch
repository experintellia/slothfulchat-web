+import React, { useCallback, useEffect, useMemo, useState } from 'react'
+import moment from 'moment'
+import classNames from 'classnames'
+import { C, T } from '@deltachat/jsonrpc-client'
+
+import { BackendRemote, onDCEvent } from '../../backend-com'
+import { selectedAccountId } from '../../ScreenController'
+import useDialog from '../../hooks/dialog/useDialog'
+import useMessage, { MESSAGE_DEFAULT } from '../../hooks/chat/useMessage'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+import useConfirmationDialog from '../../hooks/dialog/useConfirmationDialog'
+import { openAttachmentInShell } from '../message/messageFunctions'
+import Button from '../Button'
+import Icon from '../Icon'
+import Switch from '../Switch'
+import SelectChat from '../dialogs/SelectChat'
+import Dialog, {
+  DialogBody,
+  DialogContent,
+  DialogFooter,
+  DialogHeader,
+  FooterActionButton,
+  FooterActions,
+} from '../Dialog'
+import { getLogger } from '@deltachat-desktop/shared/logger'
+import { runtime } from '@deltachat-desktop/runtime-interface'
+
+import type { DialogProps } from '../../contexts/DialogContext'
+
+import styles from './styles.module.scss'
+
+const log = getLogger('renderer/Calendar')
+
+type View = 'month' | 'agenda'
+
+type Occurrence = T.CalendarEvent & { s: Date; e: Date }
+
+export function toOccurrence(ev: T.CalendarEvent): Occurrence {
+  return {
+    ...ev,
+    s: toDate(ev.start, ev.floating),
+    e: toDate(ev.end, ev.floating),
+  }
+}
+
+/**
+ * Answering an event in a chat is a reaction on its message: works with every Delta Chat
+ * client, which also lets people answer that only see the `.ics` as a file.
+ * ponytail: takes the reaction slot, so an RSVP replaces e.g. a 🎂; a dedicated answer
+ * message (webxdc-style status update or METHOD:REPLY) would free it.
+ */
+export const RSVP = [
+  { emoji: '👍', label: 'calendar_rsvp_yes' },
+  { emoji: '🤔', label: 'calendar_rsvp_maybe' },
+  { emoji: '👎', label: 'calendar_rsvp_no' },
+] as const
+
+/**
+ * The line appended to a Calendar message's text for clients that show the `.ics` as a
+ * plain file: what the event is and how to answer. Core strips it again for SlothfulChat
+ * (`calendar::strip_hint`, keyed on the leading "📅 ").
+ */
+export function calendarHint(
+  summary: string,
+  start: Date,
+  allDay: boolean,
+  tx: ReturnType<typeof useTranslationFunction>,
+  cancelled = false
+) {
+  const when = moment(start).format(allDay ? 'ddd, ll' : 'ddd, ll LT')
+  return `📅 ${tx(cancelled ? 'calendar_hint_cancelled' : 'calendar_hint', [
+    summary,
+    when,
+  ])}`
+}
+
+/** `text` with the hint as its last paragraph. */
+export function withHint(text: string | null | undefined, hint: string) {
+  return text?.trim() ? `${text.trim()}\n\n${hint}` : hint
+}
+
+/** Local `Date` of an event time. Floating/all-day times are wall-clock encoded as UTC. */
+function toDate(ts: number, floating: boolean): Date {
+  const d = new Date(ts * 1000)
+  return floating
+    ? new Date(
+        d.getUTCFullYear(),
+        d.getUTCMonth(),
+        d.getUTCDate(),
+        d.getUTCHours(),
+        d.getUTCMinutes()
+      )
+    : d
+}
+
+function overlapsDay(ev: Occurrence, day: moment.Moment) {
+  const dayStart = day.toDate()
+  const dayEnd = day.clone().add(1, 'day').toDate()
+  return ev.s < dayEnd && (ev.e > dayStart || +ev.s === +dayStart)
+}
+
+function formatRange(
+  ev: Occurrence,
+  tx: ReturnType<typeof useTranslationFunction>
+) {
+  if (ev.allDay) {
+    const last = moment(ev.e).subtract(1, 'day')
+    return last.isSame(ev.s, 'day')
+      ? `${moment(ev.s).format('dddd, LL')} · ${tx('calendar_all_day')}`
+      : `${moment(ev.s).format('ll')} – ${last.format('ll')}`
+  }
+  const sameDay = moment(ev.e).isSame(ev.s, 'day')
+  return `${moment(ev.s).format('dddd, LL LT')} – ${moment(ev.e).format(
+    sameDay ? 'LT' : 'dddd, LL LT'
+  )}`
+}
+
+function hiddenChatsKey(accountId: number) {
+  return `calendarHiddenChats:${accountId}`
+}
+
+function loadHiddenChats(accountId: number): Set<number> {
+  try {
+    return new Set(
+      JSON.parse(localStorage.getItem(hiddenChatsKey(accountId)) || '[]')
+    )
+  } catch {
+    return new Set()
+  }
+}
+
+/**
+ * Calendar of the events in iCalendar attachments, indexed by core.
+ * `chatId: 'all'` shows every chat, with a sidebar to toggle chats.
+ */
+export default function Calendar({ chatId }: { chatId: number | 'all' }) {
+  const tx = useTranslationFunction()
+  const { openDialog } = useDialog()
+  const accountId = selectedAccountId()
+  const all = chatId === 'all'
+
+  const [view, setView] = useState<View>('month')
+  const [cursor, setCursor] = useState(() => moment().startOf('month'))
+  const [selectedDay, setSelectedDay] = useState(() => moment().startOf('day'))
+  const [events, setEvents] = useState<Occurrence[]>([])
+  const [chatCounts, setChatCounts] = useState<T.CalendarChat[]>([])
+  const [chats, setChats] = useState<Record<number, T.BasicChat>>({})
+  const [hidden, setHidden] = useState(() => loadHiddenChats(accountId))
+  const [reload, setReload] = useState(0)
+
+  const gridStart = useMemo(() => cursor.clone().startOf('week'), [cursor])
+  const [from, to] = useMemo(
+    () =>
+      view === 'month'
+        ? [gridStart, gridStart.clone().add(42, 'days')]
+        : [cursor, cursor.clone().add(1, 'month')],
+    [view, cursor, gridStart]
+  )
+
+  useEffect(() => {
+    const bump = () => setReload(r => r + 1)
+    const cleanups = [
+      onDCEvent(accountId, 'IncomingMsg', bump),
+      onDCEvent(accountId, 'MsgDeleted', bump),
+    ]
+    return () => cleanups.forEach(f => f())
+  }, [accountId])
+
+  useEffect(() => {
+    let cancelled = false
+    BackendRemote.rpc
+      .getCalendarEvents(accountId, all ? null : chatId, from.unix(), to.unix())
+      .then(list => {
+        if (!cancelled) {
+          setEvents(list.map(toOccurrence))
+        }
+      })
+      .catch(log.error)
+    return () => {
+      cancelled = true
+    }
+  }, [accountId, all, chatId, from, to, reload])
+
+  useEffect(() => {
+    ;(all
+      ? BackendRemote.rpc.getCalendarChats(accountId)
+      : Promise.resolve([{ chatId: chatId as number, count: 0 }])
+    )
+      .then(async counts => {
+        setChatCounts(counts)
+        const infos = await Promise.all(
+          counts.map(c =>
+            BackendRemote.rpc.getBasicChatInfo(accountId, c.chatId)
+          )
+        )
+        setChats(Object.fromEntries(infos.map(c => [c.id, c])))
+      })
+      .catch(log.error)
+  }, [accountId, all, chatId, reload])
+
+  const toggleChat = (id: number) => {
+    const next = new Set(hidden)
+    next.has(id) ? next.delete(id) : next.add(id)
+    setHidden(next)
+    try {
+      localStorage.setItem(hiddenChatsKey(accountId), JSON.stringify([...next]))
+    } catch {
+      // ponytail: private mode / blocked storage, the toggle just isn't remembered
+    }
+  }
+
+  const visible = all ? events.filter(ev => !hidden.has(ev.chatId)) : events
+  const colorOf = (ev: T.CalendarEvent) => chats[ev.chatId]?.color
+
+  const openEvent = (ev: Occurrence) =>
+    openDialog(EventDetails, { event: ev, chat: chats[ev.chatId] })
+
+  const newEvent = () => {
+    const openForm = (chatId: number) =>
+      openDialog(NewEventDialog, {
+        day: selectedDay,
+        withMessage: true,
+        onCreate: async (file: string, text: string | null, hint: string) => {
+          // Not useMessage's sendMessage: it jumps to the message, which would
+          // switch chats and close the calendar.
+          await BackendRemote.rpc.sendMsg(accountId, chatId, {
+            ...MESSAGE_DEFAULT,
+            file,
+            filename: 'event.ics',
+            viewtype: 'Calendar',
+            text: withHint(text, hint),
+          })
+          if (runtime.getRuntimeInfo().target === 'browser') {
+            runtime.removeTempFile(file)
+          }
+          setReload(r => r + 1)
+        },
+      })
+    if (all) {
+      openDialog(PickChatDialog, { onPick: openForm })
+    } else {
+      openForm(chatId)
+    }
+  }
+
+  const step = (n: number) => setCursor(c => c.clone().add(n, 'month'))
+  const goToday = () => {
+    setCursor(moment().startOf('month'))
+    setSelectedDay(moment().startOf('day'))
+  }
+
+  return (
+    <div className={styles.calendar}>
+      <div className={styles.toolbar}>
+        <Button onClick={() => step(-1)} aria-label='←' styling='borderless'>
+          <Icon icon='chevron-left' size={18} />
+        </Button>
+        <Button onClick={goToday}>{tx('today')}</Button>
+        <Button onClick={() => step(1)} aria-label='→' styling='borderless'>
+          <Icon icon='chevron-right' size={18} />
+        </Button>
+        <h3 className={styles.title}>{cursor.format('MMMM YYYY')}</h3>
+        <div role='radiogroup' className={styles.viewSwitch}>
+          {(['month', 'agenda'] as const).map(v => (
+            <Button
+              key={v}
+              role='radio'
+              aria-checked={view === v}
+              active={view === v}
+              onClick={() => setView(v)}
+            >
+              {tx(`calendar_${v}`)}
+            </Button>
+          ))}
+        </div>
+        <Button styling='primary' onClick={newEvent}>
+          {tx('calendar_new_event')}
+        </Button>
+      </div>
+      <div className={styles.main}>
+        {all && (
+          <aside className={styles.sidebar} aria-label={tx('pref_chats')}>
+            {chatCounts.length === 0 && (
+              <p className={styles.hint}>{tx('calendar_no_chats')}</p>
+            )}
+            {chatCounts.map(({ chatId: id, count }) => (
+              <label key={id} className={styles.chatToggle}>
+                <input
+                  type='checkbox'
+                  checked={!hidden.has(id)}
+                  onChange={() => toggleChat(id)}
+                  style={{ accentColor: chats[id]?.color }}
+                />
+                <span className={styles.chatName}>
+                  {chats[id]?.name ?? '…'}
+                </span>
+                <span className={styles.count}>{count}</span>
+              </label>
+            ))}
+          </aside>
+        )}
+        {view === 'month' ? (
+          <MonthGrid
+            cursor={cursor}
+            gridStart={gridStart}
+            events={visible}
+            selectedDay={selectedDay}
+            onSelectDay={setSelectedDay}
+            onOpenEvent={openEvent}
+            colorOf={colorOf}
+          />
+        ) : (
+          <Agenda
+            from={from}
+            to={to}
+            events={visible}
+            onOpenEvent={openEvent}
+            colorOf={colorOf}
+          />
+        )}
+      </div>
+    </div>
+  )
+}
+
+function EventChip({
+  ev,
+  color,
+  onOpen,
+  showTime,
+}: {
+  ev: Occurrence
+  color?: string
+  onOpen: (ev: Occurrence) => void
+  showTime: boolean
+}) {
+  return (
+    <button
+      type='button'
+      className={classNames(styles.chip, ev.cancelled && styles.cancelled)}
+      style={{ '--chat-color': color } as React.CSSProperties}
+      onClick={e => {
+        e.stopPropagation()
+        onOpen(ev)
+      }}
+      title={ev.summary}
+    >
+      {showTime && !ev.allDay && (
+        <span className={styles.time}>{moment(ev.s).format('LT')}</span>
+      )}
+      {ev.summary || '…'}
+    </button>
+  )
+}
+
+function MonthGrid({
+  cursor,
+  gridStart,
+  events,
+  selectedDay,
+  onSelectDay,
+  onOpenEvent,
+  colorOf,
+}: {
+  cursor: moment.Moment
+  gridStart: moment.Moment
+  events: Occurrence[]
+  selectedDay: moment.Moment
+  onSelectDay: (day: moment.Moment) => void
+  onOpenEvent: (ev: Occurrence) => void
+  colorOf: (ev: Occurrence) => string | undefined
+}) {
+  const days = Array.from({ length: 42 }, (_, i) =>
+    gridStart.clone().add(i, 'days')
+  )
+  return (
+    <div className={styles.month} role='grid'>
+      {days.slice(0, 7).map(d => (
+        <div key={d.format('d')} className={styles.weekday} role='columnheader'>
+          {d.format('ddd')}
+        </div>
+      ))}
+      {days.map(day => (
+        <div
+          key={day.format('YYYY-MM-DD')}
+          role='gridcell'
+          aria-selected={day.isSame(selectedDay, 'day')}
+          className={classNames(styles.day, {
+            [styles.otherMonth]: !day.isSame(cursor, 'month'),
+            [styles.today]: day.isSame(moment(), 'day'),
+            [styles.selected]: day.isSame(selectedDay, 'day'),
+          })}
+          onClick={() => onSelectDay(day)}
+        >
+          <span className={styles.dayNumber}>{day.date()}</span>
+          {events
+            .filter(ev => overlapsDay(ev, day))
+            .map(ev => (
+              <EventChip
+                key={`${ev.uid}-${ev.start}`}
+                ev={ev}
+                color={colorOf(ev)}
+                onOpen={onOpenEvent}
+                showTime
+              />
+            ))}
+        </div>
+      ))}
+    </div>
+  )
+}
+
+function Agenda({
+  from,
+  to,
+  events,
+  onOpenEvent,
+  colorOf,
+}: {
+  from: moment.Moment
+  to: moment.Moment
+  events: Occurrence[]
+  onOpenEvent: (ev: Occurrence) => void
+  colorOf: (ev: Occurrence) => string | undefined
+}) {
+  const tx = useTranslationFunction()
+  const days: moment.Moment[] = []
+  for (const d = from.clone(); d.isBefore(to); d.add(1, 'day')) {
+    days.push(d.clone())
+  }
+  const groups = days
+    .map(day => ({ day, list: events.filter(ev => overlapsDay(ev, day)) }))
+    .filter(g => g.list.length > 0)
+  if (groups.length === 0) {
+    return <p className={styles.empty}>{tx('calendar_no_events')}</p>
+  }
+  return (
+    <ol className={styles.agenda}>
+      {groups.map(({ day, list }) => (
+        <li
+          key={day.format('YYYY-MM-DD')}
+          className={classNames(styles.agendaDay, {
+            [styles.today]: day.isSame(moment(), 'day'),
+          })}
+        >
+          <h4>{day.format('dddd, LL')}</h4>
+          {list.map(ev => (
+            <button
+              type='button'
+              key={`${ev.uid}-${ev.start}`}
+              className={classNames(
+                styles.agendaItem,
+                ev.cancelled && styles.cancelled
+              )}
+              style={{ '--chat-color': colorOf(ev) } as React.CSSProperties}
+              onClick={() => onOpenEvent(ev)}
+            >
+              <span className={styles.time}>
+                {ev.allDay
+                  ? tx('calendar_all_day')
+                  : `${moment(ev.s).format('LT')} – ${moment(ev.e).format('LT')}`}
+              </span>
+              <span className={styles.summary}>{ev.summary || '…'}</span>
+              {ev.location && (
+                <span className={styles.location}>{ev.location}</span>
+              )}
+            </button>
+          ))}
+        </li>
+      ))}
+    </ol>
+  )
+}
+
+export function EventDetails({
+  event: ev,
+  chat,
+  onClose,
+}: { event: Occurrence; chat?: T.BasicChat } & DialogProps) {
+  const tx = useTranslationFunction()
+  const { jumpToMessage } = useMessage()
+  const { closeAllDialogs } = useDialog()
+  const accountId = selectedAccountId()
+
+  const openConfirmation = useConfirmationDialog()
+  const [isOwn, setIsOwn] = useState(false)
+  useEffect(() => {
+    BackendRemote.rpc
+      .getMessage(accountId, ev.msgId)
+      .then(msg => setIsOwn(msg.fromId === C.DC_CONTACT_ID_SELF))
+      .catch(log.error)
+  }, [accountId, ev.msgId])
+
+  const open = async () => {
+    const msg = await BackendRemote.rpc.getMessage(accountId, ev.msgId)
+    openAttachmentInShell(msg).catch(log.error)
+  }
+
+  // Sends the same events with METHOD:CANCEL to the chat; every client that knows the
+  // event (and any calendar it was added to) marks it cancelled.
+  const cancelEvent = async () => {
+    const confirmed = await openConfirmation({
+      message: tx('calendar_cancel_confirm', ev.summary),
+      confirmLabel: tx('calendar_cancel_event'),
+      isConfirmDanger: true,
+    })
+    if (!confirmed) {
+      return
+    }
+    try {
+      const ics = await BackendRemote.rpc.makeCalendarCancelIcs(
+        accountId,
+        ev.msgId
+      )
+      const file = await runtime.writeTempFile('cancel.ics', ics)
+      await BackendRemote.rpc.sendMsg(accountId, ev.chatId, {
+        ...MESSAGE_DEFAULT,
+        file,
+        filename: 'cancel.ics',
+        viewtype: 'Calendar',
+        // a reply to the invite, so every client shows which event it cancels
+        quotedMessageId: ev.msgId,
+        text: calendarHint(ev.summary, ev.s, ev.allDay, tx, true),
+      })
+      if (runtime.getRuntimeInfo().target === 'browser') {
+        runtime.removeTempFile(file)
+      }
+      onClose()
+    } catch (err) {
+      log.error('cancelling the event failed', err)
+    }
+  }
+
+  return (
+    <Dialog onClose={onClose} width={420}>
+      <DialogHeader title={ev.summary || '…'} onClose={onClose} />
+      <DialogBody>
+        <DialogContent>
+          {ev.cancelled && (
+            <p className={styles.cancelledNote}>{tx('calendar_cancelled')}</p>
+          )}
+          <p>{formatRange(ev, tx)}</p>
+          {ev.recurring && <p>{tx('calendar_recurring')}</p>}
+          {ev.location && (
+            <p>
+              {tx('location')}: {ev.location}
+            </p>
+          )}
+          {ev.description && (
+            <p className={styles.description}>{ev.description}</p>
+          )}
+          {chat && (
+            <p className={styles.chatLine}>
+              <span className={styles.dot} style={{ background: chat.color }} />
+              {chat.name}
+            </p>
+          )}
+        </DialogContent>
+      </DialogBody>
+      <DialogFooter>
+        <FooterActions align='spaceBetween'>
+          <FooterActionButton onClick={open}>{tx('open')}</FooterActionButton>
+          {isOwn && !ev.cancelled && (
+            <FooterActionButton styling='danger' onClick={cancelEvent}>
+              {tx('calendar_cancel_event')}
+            </FooterActionButton>
+          )}
+          <FooterActionButton
+            onClick={() => {
+              closeAllDialogs()
+              jumpToMessage({
+                accountId,
+                msgId: ev.msgId,
+                msgChatId: ev.chatId,
+                focus: true,
+                scrollIntoViewArg: { block: 'center' },
+              })
+            }}
+          >
+            {tx('show_in_chat')}
+          </FooterActionButton>
+        </FooterActions>
+      </DialogFooter>
+    </Dialog>
+  )
+}
+
+/** SelectChat leaves closing to its caller (like MailtoDialog). */
+function PickChatDialog({
+  onPick,
+  onClose,
+}: { onPick: (chatId: number) => void } & DialogProps) {
+  const tx = useTranslationFunction()
+  return (
+    <SelectChat
+      headerTitle={tx('calendar_select_chat')}
+      listFlags={C.DC_GCL_FOR_FORWARDING | C.DC_GCL_NO_SPECIALS}
+      onClose={onClose}
+      onChatClick={({ chatId }) => {
+        onClose()
+        onPick(chatId)
+      }}
+    />
+  )
+}
+
+/** A section's leading icon in the event form (stroke paths, `M` starts a subpath). */
+function FormIcon({ d, className }: { d: string; className?: string }) {
+  return (
+    <svg
+      className={className ?? styles.formIcon}
+      viewBox='0 0 24 24'
+      fill='none'
+      stroke='currentColor'
+      strokeWidth={2}
+      strokeLinecap='round'
+      strokeLinejoin='round'
+      aria-hidden
+    >
+      <path d={d} />
+    </svg>
+  )
+}
+
+const REPEAT = {
+  '': 'never',
+  DAILY: 'calendar_repeat_daily',
+  WEEKLY: 'calendar_repeat_weekly',
+  MONTHLY: 'calendar_repeat_monthly',
+  YEARLY: 'calendar_repeat_yearly',
+} as const
+
+/**
+ * Form for a new event, or for editing `initial` (an unsent draft's event). Hands the
+ * written `.ics` (a temp file) and, `withMessage`, the message text to `onCreate`, which
+ * sends or drafts it.
+ */
+export function NewEventDialog({
+  day,
+  initial,
+  withMessage,
+  onCreate,
+  onClose,
+}: {
+  day: moment.Moment
+  initial?: T.CalendarEvent
+  withMessage: boolean
+  /** `hint`: see `calendarHint`; callers that send right away append it */
+  onCreate: (
+    icsFile: string,
+    text: string | null,
+    hint: string
+  ) => Promise<void> | void
+} & DialogProps) {
+  const tx = useTranslationFunction()
+  const first = initial && toOccurrence(initial)
+  const start0 = first
+    ? moment(first.s)
+    : day.clone().set({ hour: moment().hour() + 1, minute: 0 })
+  const end0 = first
+    ? // all-day ends are exclusive midnights; the form shows the last day
+      moment(first.e).subtract(first.allDay ? 1 : 0, 'day')
+    : start0.clone().add(1, 'hour')
+  const [summary, setSummary] = useState(initial?.summary ?? '')
+  const [allDay, setAllDay] = useState(initial?.allDay ?? false)
+  const [startDate, setStartDate] = useState(start0.format('YYYY-MM-DD'))
+  const [startTime, setStartTime] = useState(start0.format('HH:mm'))
+  const [endDate, setEndDate] = useState(end0.format('YYYY-MM-DD'))
+  const [endTime, setEndTime] = useState(end0.format('HH:mm'))
+  const [location, setLocation] = useState(initial?.location ?? '')
+  const [description, setDescription] = useState(initial?.description ?? '')
+  // ponytail: the form knows FREQ only; editing keeps the frequency and drops
+  // COUNT/UNTIL/BYDAY etc. of a picked-in .ics
+  const [repeat, setRepeat] = useState<keyof typeof REPEAT>(
+    (initial?.rrule?.match(/FREQ=(DAILY|WEEKLY|MONTHLY|YEARLY)/)?.[1] as
+      | keyof typeof REPEAT
+      | undefined) ?? ''
+  )
+  const [text, setText] = useState('')
+  const [error, setError] = useState<string | null>(null)
+  const [sending, setSending] = useState(false)
+
+  const send = useCallback(async () => {
+    // All-day: UTC midnights, end exclusive. Timed: local wall clock → instant.
+    const utcMidnight = (d: string) => Date.parse(`${d}T00:00:00Z`) / 1000
+    const start = allDay
+      ? utcMidnight(startDate)
+      : new Date(`${startDate}T${startTime}`).getTime() / 1000
+    const end = allDay
+      ? utcMidnight(endDate) + 86400
+      : new Date(`${endDate}T${endTime}`).getTime() / 1000
+    if (!summary.trim()) {
+      return setError(tx('calendar_title_missing'))
+    }
+    if (!(end >= start)) {
+      return setError(tx('calendar_end_before_start'))
+    }
+    setSending(true)
+    try {
+      const ics = await BackendRemote.rpc.makeCalendarIcs({
+        summary: summary.trim(),
+        location: location.trim() || null,
+        description: description.trim() || null,
+        start,
+        end,
+        allDay,
+        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || null,
+        rrule: repeat ? `FREQ=${repeat}` : null,
+      })
+      const file = await runtime.writeTempFile('event.ics', ics)
+      const hint = calendarHint(
+        summary.trim(),
+        allDay ? moment(startDate).toDate() : new Date(start * 1000),
+        allDay,
+        tx
+      )
+      await onCreate(file, text.trim() || null, hint)
+      onClose()
+    } catch (err: any) {
+      setError(err?.message ?? String(err))
+      setSending(false)
+    }
+  }, [
+    allDay,
+    description,
+    endDate,
+    endTime,
+    location,
+    onClose,
+    onCreate,
+    repeat,
+    startDate,
+    startTime,
+    summary,
+    text,
+    tx,
+  ])
+
+  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  const startMs = allDay
+    ? Date.parse(`${startDate}T00:00:00Z`)
+    : new Date(`${startDate}T${startTime}`).getTime()
+  const endMs = allDay
+    ? Date.parse(`${endDate}T00:00:00Z`) + 86400_000
+    : new Date(`${endDate}T${endTime}`).getTime()
+  // "an hour · Europe/Berlin"; nothing while the range is invalid
+  const durationHint =
+    endMs > startMs
+      ? [moment.duration(endMs - startMs).humanize(), !allDay && timezone]
+          .filter(Boolean)
+          .join(' · ')
+      : null
+
+  return (
+    <Dialog onClose={onClose} canOutsideClickClose={false} width={460}>
+      <DialogHeader
+        title={tx(initial ? 'calendar_edit_event' : 'calendar_new_event')}
+        onClose={onClose}
+      />
+      <DialogBody>
+        <DialogContent>
+          <form
+            className={styles.form}
+            onSubmit={e => {
+              e.preventDefault()
+              send()
+            }}
+          >
+            <input
+              className={styles.titleInput}
+              aria-label={tx('calendar_event_title')}
+              placeholder={tx('calendar_event_title')}
+              required
+              autoFocus
+              value={summary}
+              onChange={e => setSummary(e.target.value)}
+            />
+            <div className={styles.section}>
+              <FormIcon d='M12 7v5l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0' />
+              <div className={styles.sectionBody}>
+                <div className={styles.switchRow}>
+                  <label htmlFor='event-all-day'>
+                    {tx('calendar_all_day')}
+                  </label>
+                  <Switch
+                    id='event-all-day'
+                    checked={allDay}
+                    onChange={setAllDay}
+                  />
+                </div>
+                <div
+                  className={classNames(styles.when, allDay && styles.allDay)}
+                >
+                  <label htmlFor='event-start-date'>
+                    {tx('calendar_starts')}
+                  </label>
+                  <input
+                    id='event-start-date'
+                    type='date'
+                    required
+                    value={startDate}
+                    onChange={e => {
+                      setStartDate(e.target.value)
+                      if (endDate < e.target.value) setEndDate(e.target.value)
+                    }}
+                  />
+                  {!allDay && (
+                    <input
+                      type='time'
+                      aria-label={tx('calendar_starts')}
+                      required
+                      value={startTime}
+                      onChange={e => setStartTime(e.target.value)}
+                    />
+                  )}
+                  <label htmlFor='event-end-date'>{tx('calendar_ends')}</label>
+                  <input
+                    id='event-end-date'
+                    type='date'
+                    required
+                    value={endDate}
+                    min={startDate}
+                    onChange={e => setEndDate(e.target.value)}
+                  />
+                  {!allDay && (
+                    <input
+                      type='time'
+                      aria-label={tx('calendar_ends')}
+                      required
+                      value={endTime}
+                      onChange={e => setEndTime(e.target.value)}
+                    />
+                  )}
+                </div>
+                {durationHint && (
+                  <div className={styles.hint}>{durationHint}</div>
+                )}
+              </div>
+            </div>
+            <div className={styles.section}>
+              <FormIcon d='M17 2l3 3-3 3 M4 11V9a4 4 0 0 1 4-4h12 M7 22l-3-3 3-3 M20 13v2a4 4 0 0 1-4 4H4' />
+              <div
+                role='radiogroup'
+                aria-label={tx('calendar_repeat')}
+                className={styles.chips}
+              >
+                {Object.entries(REPEAT).map(([r, label]) => (
+                  <button
+                    key={r}
+                    type='button'
+                    role='radio'
+                    aria-checked={repeat === r}
+                    className={classNames(
+                      styles.chipOption,
+                      repeat === r && styles.chipSelected
+                    )}
+                    onClick={() => setRepeat(r as keyof typeof REPEAT)}
+                  >
+                    {tx(label)}
+                  </button>
+                ))}
+              </div>
+            </div>
+            <div className={styles.section}>
+              <FormIcon d='M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z M12 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5' />
+              <input
+                className={styles.plain}
+                aria-label={tx('location')}
+                placeholder={tx('location')}
+                value={location}
+                onChange={e => setLocation(e.target.value)}
+              />
+            </div>
+            <div className={styles.section}>
+              <FormIcon d='M4 6h16 M4 12h16 M4 18h10' />
+              <textarea
+                className={styles.plain}
+                aria-label={tx('calendar_description')}
+                placeholder={tx('calendar_description')}
+                rows={3}
+                value={description}
+                onChange={e => setDescription(e.target.value)}
+              />
+            </div>
+            {withMessage && (
+              <div className={styles.section}>
+                <FormIcon d='M4 5h16v11H8l-4 4z' />
+                <textarea
+                  className={styles.plain}
+                  aria-label={tx('calendar_message')}
+                  placeholder={tx('calendar_message')}
+                  rows={2}
+                  value={text}
+                  onChange={e => setText(e.target.value)}
+                />
+              </div>
+            )}
+            {error && (
+              <p role='alert' className={styles.error}>
+                {error}
+              </p>
+            )}
+            {/* lets Enter in a text input submit the form */}
+            <button type='submit' hidden />
+          </form>
+        </DialogContent>
+      </DialogBody>
+      <DialogFooter>
+        <FooterActions align='end'>
+          <FooterActionButton onClick={onClose}>
+            {tx('cancel')}
+          </FooterActionButton>
+          <FooterActionButton
+            styling='primary'
+            disabled={sending}
+            onClick={send}
+          >
+            {withMessage
+              ? tx('menu_send')
+              : tx(initial ? 'save' : 'calendar_attach')}
+          </FooterActionButton>
+        </FooterActions>
+      </DialogFooter>
+    </Dialog>
+  )
+}
+
+/** Time line of a card: "10:00 – 11:00", "All day", or a date range. */
+function cardTime(
+  ev: Occurrence,
+  tx: ReturnType<typeof useTranslationFunction>
+) {
+  if (ev.allDay) {
+    const last = moment(ev.e).subtract(1, 'day')
+    return last.isSame(ev.s, 'day')
+      ? tx('calendar_all_day')
+      : `${moment(ev.s).format('ll')} – ${last.format('ll')}`
+  }
+  const sameDay = moment(ev.e).isSame(ev.s, 'day')
+  return `${moment(ev.s).format('LT')} – ${moment(ev.e).format(
+    sameDay ? 'LT' : 'ddd LT'
+  )}`
+}
+
+/**
+ * An event as a card: a date block (weekday, day, month), title, time with the
+ * repeat frequency, location. Chat bubbles and draft preview.
+ */
+export function CalendarEventCard({
+  event,
+  onClick,
+  tabIndex,
+}: {
+  event: T.CalendarEvent
+  onClick?: () => void
+  tabIndex?: -1 | 0
+}) {
+  const tx = useTranslationFunction()
+  const ev = toOccurrence(event)
+  const freq = ev.rrule?.match(/FREQ=(DAILY|WEEKLY|MONTHLY|YEARLY)/)?.[1] as
+    | keyof typeof REPEAT
+    | undefined
+  const Tag = onClick ? 'button' : 'div'
+  return (
+    <Tag
+      type={onClick ? 'button' : undefined}
+      className={classNames(styles.card, ev.cancelled && styles.cardCancelled)}
+      onClick={onClick}
+      tabIndex={tabIndex}
+    >
+      <span className={styles.dateBlock} aria-hidden>
+        <span className={styles.dateWeekday}>{moment(ev.s).format('ddd')}</span>
+        <span className={styles.dateDay}>{moment(ev.s).format('D')}</span>
+        <span className={styles.dateMonth}>{moment(ev.s).format('MMM')}</span>
+      </span>
+      <span className={styles.cardText}>
+        <span className={styles.cardTitle}>{ev.summary || '…'}</span>
+        {/* the date block is decorative; screen readers get the date here */}
+        <span className={styles.srOnly}>{moment(ev.s).format('dddd, LL')}</span>
+        {ev.cancelled ? (
+          <span className={styles.cancelledLabel}>
+            {tx('calendar_cancelled_short')}
+          </span>
+        ) : (
+          <>
+            <span className={styles.cardLine}>
+              <FormIcon
+                className={styles.lineIcon}
+                d='M12 7v5l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0'
+              />
+              <span>{cardTime(ev, tx)}</span>
+              {freq && (
+                <span className={styles.repeatChip}>{tx(REPEAT[freq])}</span>
+              )}
+            </span>
+            {ev.location && (
+              <span className={styles.cardLine}>
+                <FormIcon
+                  className={styles.lineIcon}
+                  d='M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z M12 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5'
+                />
+                <span className={styles.cardLocation}>{ev.location}</span>
+              </span>
+            )}
+          </>
+        )}
+      </span>
+    </Tag>
+  )
+}
+
+/**
+ * The content of a `Calendar` message bubble: the card (opens the event details) and the
+ * RSVP row, which answers with a reaction (see `RSVP`).
+ */
+export function CalendarMessageContent({
+  message,
+  tabindexForInteractiveContents,
+}: {
+  message: T.Message
+  tabindexForInteractiveContents: -1 | 0
+}) {
+  const tx = useTranslationFunction()
+  const { openDialog } = useDialog()
+  const event = message.calendarEvent
+  if (!event) {
+    return null
+  }
+  const reactions = message.reactions?.reactions ?? []
+  const mine = RSVP.find(r =>
+    reactions.some(x => x.emoji === r.emoji && x.isFromSelf)
+  )?.emoji
+  return (
+    <div className={styles.messageEvent}>
+      <CalendarEventCard
+        event={event}
+        tabIndex={tabindexForInteractiveContents}
+        onClick={() => openDialog(EventDetails, { event: toOccurrence(event) })}
+      />
+      {!event.cancelled && (
+        <div
+          role='group'
+          aria-label={tx('calendar_rsvp')}
+          className={styles.rsvp}
+        >
+          {RSVP.map(r => {
+            const count = reactions.find(x => x.emoji === r.emoji)?.count ?? 0
+            const on = mine === r.emoji
+            return (
+              <button
+                key={r.emoji}
+                type='button'
+                aria-pressed={on}
+                tabIndex={tabindexForInteractiveContents}
+                className={classNames(styles.rsvpButton, on && styles.rsvpOn)}
+                onClick={() =>
+                  BackendRemote.rpc
+                    .sendReaction(
+                      selectedAccountId(),
+                      message.id,
+                      on ? [] : [r.emoji]
+                    )
+                    .catch(log.error)
+                }
+              >
+                <span aria-hidden>{r.emoji}</span>
+                {tx(r.label)}
+                {count > 0 && <span className={styles.rsvpCount}>{count}</span>}
+              </button>
+            )
+          })}
+        </div>
+      )}
+    </div>
+  )
+}
