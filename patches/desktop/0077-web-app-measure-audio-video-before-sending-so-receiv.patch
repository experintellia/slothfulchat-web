+/**
+ * Fills in the size and duration of an audio or video attachment, which core cannot
+ * measure itself (no codecs, and its wasm has no DOM). Without them the message goes out
+ * with no `Chat-Duration` header, so every receiver's download-on-demand placeholder shows
+ * "–:––" for a voice message that we, the sender, could have measured in milliseconds.
+ *
+ * Sits on `sendMessage` rather than on the draft because the composer does not send its
+ * draft — it builds a fresh `MessageData` from the draft state, so anything stored on the
+ * draft is dropped. Here it covers every send path: composer, stickers, multi-file and
+ * drag-and-drop alike.
+ *
+ * Images are deliberately not handled: core reads their dimensions itself when it prepares
+ * the attachment, after any re-encoding, so measuring them here would only be a slower way
+ * to get the same numbers — or a wrong one.
+ */
+async function withMediaMetadata(data: MessageData): Promise<MessageData> {
+  const file = data.file
+  if (file == null || data.duration != null) {
+    return data
+  }
+  // The viewtype is not a reliable filter: pasted and dropped media is sent as `File` and
+  // only corrected to `Audio`/`Video` by core, from this very suffix, at send time.
+  const mime = mimeTypes.lookup(data.filename || file)
+  if (typeof mime !== 'string' || !/^(audio|video)\//.test(mime)) {
+    return data
+  }
+  return { ...data, ...(await mediaMetadata(runtime.transformBlobURL(file))) }
 }
 
