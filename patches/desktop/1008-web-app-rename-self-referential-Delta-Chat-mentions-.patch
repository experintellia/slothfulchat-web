From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Wed, 8 Jul 2026 23:09:20 +0000
Subject: [PATCH] web-app: rename self-referential Delta Chat mentions to
 SlothfulChat in all locales

Renames the app's self-references in every locale, English included: the
conversion script substitutes the literal "Delta Chat" string for
SlothfulChat within 8 self-referential keys, for every language, so it keeps
working after future translations:pull. Languages that transliterate the
name into their own script instead of using the Latin string aren't
covered by this and still need a real translation.
---
 .../build-shared-convert-translations.mjs     | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/bin/translations/build-shared-convert-translations.mjs b/bin/translations/build-shared-convert-translations.mjs
index e8156f62cf3071f410f9a4af1854cb4ef401e5dc..51359645423e1c123b420b21ee9e440c19687ae2 100755
--- a/bin/translations/build-shared-convert-translations.mjs
+++ b/bin/translations/build-shared-convert-translations.mjs
@@ -15,6 +15,36 @@ function removeJunk(input) {
     .replace(new RegExp('\\\\', 'g'), '')
 }
 
+// Keys where "Delta Chat" refers to this app itself (name, welcome, about,
+// background/location permission rationales) rather than upstream credits,
+// delta.chat links, or donation/stats text. Every .xml, en.xml included,
+// still says "Delta Chat" here; this substitutes it at conversion time so it
+// applies to all ~50 locales (and any future ones) without hand-patching any
+// .xml. This is a literal match, so it
+// misses two shapes: languages that transliterate the name into their own
+// script (e.g. fa, ckb, my), and any translation that spells "Delta Chat"
+// with different spacing (e.g. a non-breaking space) — both still read
+// "Delta Chat" and need an actual translator, not a substitution rule.
+const SELF_REFERENTIAL_KEYS = new Set([
+  'app_name',
+  'welcome_desktop',
+  'global_menu_help_about_desktop',
+  'disabled_in_dc',
+  'location_rationale',
+  'pref_background_notifications_rationale',
+  'perm_enable_bg_reminder_title',
+  'perm_enable_bg_already_done',
+])
+
+/**
+ * @param {string} name
+ * @param {string} text
+ */
+function renameSelfReferences(name, text) {
+  if (!SELF_REFERENTIAL_KEYS.has(name)) return text
+  return text.split('Delta Chat').join('SlothfulChat')
+}
+
 async function xmlToJson(filename) {
   const xml = (await readFile(filename, 'utf-8')).toString()
 
@@ -47,6 +77,7 @@ async function xmlToJson(filename) {
     let text = string._text
     if (typeof text === 'string') {
       text = removeJunk(text)
+      text = renameSelfReferences(name, text)
     }
     res[name] = {
       message: text,
