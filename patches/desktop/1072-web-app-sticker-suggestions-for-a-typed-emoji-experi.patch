index 0000000000000000000000000000000000000000..eee6e0c2ef0609a7e70a8327fcc5290d497a7c3d
--- /dev/null
+++ b/packages/frontend/src/components/composer/singleEmoji.ts
@@ -0,0 +1,23 @@
+/// <reference lib="es2022.intl" />
+// ponytail: RegExp() + the lib reference only so the mocha/ts-node test run
+// (ES5 default target) type-checks this file; the app itself targets ES2022.
+const isEmoji = new RegExp(
+  '\\p{Extended_Pictographic}|\\p{Regional_Indicator}',
+  'u'
+)
+
+/** Drop U+FE0F so "❤️" and "❤" (and sticker emoji lists) compare equal. */
+export const normalizeEmoji = (s: string) => s.replace(/\uFE0F/g, '')
+
+/**
+ * The normalized emoji if `text`, trimmed, is exactly one emoji (one grapheme
+ * cluster, so ZWJ sequences, skin tones and flags count as one), else null.
+ */
+export function singleEmoji(text: string): string | null {
+  const t = text.trim()
+  // cheap bail-out before segmenting: no emoji is longer than ~35 code units
+  if (t === '' || t.length > 40) return null
+  const first = new Intl.Segmenter().segment(t).containing(0)
+  if (first?.segment !== t || !isEmoji.test(t)) return null
+  return normalizeEmoji(t)
+}
