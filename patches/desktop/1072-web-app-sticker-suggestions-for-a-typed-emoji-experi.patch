diff --git a/packages/frontend/src/components/composer/StickerSuggestions.tsx b/packages/frontend/src/components/composer/StickerSuggestions.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9f599efb08cb194bfea6e92d3fa4391aef6ce617
--- /dev/null
+++ b/packages/frontend/src/components/composer/StickerSuggestions.tsx
@@ -0,0 +1,171 @@
+import React, {
+  forwardRef,
+  useEffect,
+  useImperativeHandle,
+  useReducer,
+  useState,
+} from 'react'
+import classNames from 'classnames'
+
+import { rpcStickers, type StickerObject } from '../../backend/stickerPacks'
+import { StickerThumb } from '../StickerPacks'
+import { normalizeEmoji } from './singleEmoji'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+import { getLogger } from '@deltachat-desktop/shared/logger'
+
+const log = getLogger('renderer/composer/StickerSuggestions')
+
+// Last fetched packs per account: shown instantly, refreshed on every mount /
+// emoji, so picker or manager edits show up next time (getStickerPacks is cheap).
+const packsCache = new Map<number, StickerObject[]>()
+
+export type StickerSuggestionsHandle = {
+  /** A key pressed in the message input; true when the strip used it. */
+  handleKey: (e: React.KeyboardEvent<HTMLTextAreaElement>) => boolean
+  /** whether a sticker is selected (Escape then only deselects) */
+  hasSelection: () => boolean
+}
+
+const MODIFIERS = ['Shift', 'Control', 'Alt', 'Meta', 'AltGraph', 'CapsLock']
+
+/**
+ * Strip of the pack stickers tagged with `emoji` (already normalized), above
+ * the composer input. Mounted only while the draft is exactly that emoji.
+ *
+ * Keyboard (focus stays in the input, like the :emoji: completion menu):
+ * nothing is selected at first, so Enter still sends the emoji as text. ↑
+ * selects the first sticker; then ←/→ (wrapping) and Home/End move, Enter or
+ * Tab sends it, ↓ or Escape go back to the input, and any other key
+ * deselects and types as usual.
+ */
+export const StickerSuggestions = forwardRef<
+  StickerSuggestionsHandle,
+  {
+    accountId: number
+    emoji: string
+    onPick: (path: string) => void
+    /** the message input, which points screen readers at the selection */
+    input: () => HTMLTextAreaElement | null | undefined
+  }
+>(function StickerSuggestions({ accountId, emoji, onPick, input }, ref) {
+  const tx = useTranslationFunction()
+  // the selection belongs to one emoji and set of stickers; a new one starts
+  // unselected without an extra render
+  const [selection, setSelection] = useState<{ key: string; i: number } | null>(
+    null
+  )
+  const [, rerender] = useReducer((x: number) => x + 1, 0)
+
+  useEffect(() => {
+    let live = true
+    rpcStickers
+      .getStickerPacks(accountId)
+      .then(packs => {
+        packsCache.set(
+          accountId,
+          packs.flatMap(p => p.stickers)
+        )
+        if (live) rerender()
+      })
+      .catch(err => log.error('getStickerPacks failed', err))
+    return () => {
+      live = false
+    }
+  }, [accountId, emoji])
+
+  // one button per image even when it sits in several packs
+  const matches = [
+    ...new Map(
+      (packsCache.get(accountId) ?? [])
+        .filter(s => s.emojis.some(e => normalizeEmoji(e) === emoji))
+        .map(s => [s.path, s])
+    ).values(),
+  ]
+  const selectionKey = emoji + '\n' + matches.map(s => s.path).join('\n')
+  const active = selection?.key === selectionKey ? selection.i : null
+  const setSelected = (i: number | null) =>
+    setSelection(i === null ? null : { key: selectionKey, i })
+
+  // aria-activedescendant: the input keeps focus, the reader hears the sticker
+  useEffect(() => {
+    const el = input()
+    if (!el || active === null) return
+    el.setAttribute('aria-activedescendant', `sticker-suggestion-${active}`)
+    document
+      .getElementById(`sticker-suggestion-${active}`)
+      ?.scrollIntoView({ block: 'nearest', inline: 'nearest' })
+    return () => el.removeAttribute('aria-activedescendant')
+  }, [active, input])
+
+  useImperativeHandle(ref, () => ({
+    hasSelection: () => active !== null,
+    handleKey(e) {
+      const n = matches.length
+      if (n === 0 || e.nativeEvent.isComposing) return false
+      const plain = !e.ctrlKey && !e.metaKey && !e.altKey && !e.shiftKey
+      const take = (next: number | null) => {
+        e.preventDefault()
+        e.stopPropagation()
+        setSelected(next)
+        return true
+      }
+      if (active === null) {
+        return e.key === 'ArrowUp' && plain ? take(0) : false
+      }
+      if (plain) {
+        switch (e.key) {
+          case 'ArrowLeft':
+            return take((active - 1 + n) % n)
+          case 'ArrowRight':
+            return take((active + 1) % n)
+          case 'Home':
+            return take(0)
+          case 'End':
+            return take(n - 1)
+          case 'ArrowDown':
+          case 'Escape':
+            return take(null)
+          case 'ArrowUp':
+            return take(active) // already in the strip; don't edit the last message
+          case 'Enter':
+          case 'Tab':
+            take(null)
+            onPick(matches[active].path)
+            return true
+        }
+      }
+      // anything else (typing, Shift+Tab, shortcuts) leaves the strip as is
+      if (!MODIFIERS.includes(e.key)) setSelected(null)
+      return false
+    },
+  }))
+
+  if (matches.length === 0) return null
+
+  return (
+    <div
+      className='completion-menu sticker-suggestions'
+      role='listbox'
+      aria-label={tx('sticker_packs_suggestions')}
+      data-testid='sticker-suggestions'
+    >
+      {matches.map((s, i) => (
+        <button
+          key={s.path}
+          id={`sticker-suggestion-${i}`}
+          type='button'
+          role='option'
+          aria-selected={i === active}
+          className={classNames({ selected: i === active })}
+          aria-label={`${tx('sticker')} ${s.emojis.join(' ')}`}
+          // keep focus in the textarea on mouse/touch; click still fires,
+          // and Tab + Enter/Space still reach the button
+          onMouseDown={e => e.preventDefault()}
+          onClick={() => onPick(s.path)}
+        >
+          <StickerThumb path={s.path} size={64} />
+        </button>
+      ))}
+    </div>
+  )
+})
