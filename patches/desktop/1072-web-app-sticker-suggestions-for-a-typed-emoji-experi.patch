diff --git a/packages/frontend/src/tests/singleEmoji.test.ts b/packages/frontend/src/tests/singleEmoji.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96f7e716387d115cb14ecdc76b7e80f75af8108f
--- /dev/null
+++ b/packages/frontend/src/tests/singleEmoji.test.ts
@@ -0,0 +1,31 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import { singleEmoji } from '../components/composer/singleEmoji.js'
+
+describe('singleEmoji', () => {
+  it('accepts exactly one emoji, trimmed, FE0F-insensitive', () => {
+    expect(singleEmoji('🐱')).to.equal('🐱')
+    expect(singleEmoji('  🐱\n')).to.equal('🐱')
+    expect(singleEmoji('❤️')).to.equal('❤')
+    expect(singleEmoji('❤')).to.equal('❤')
+    expect(singleEmoji('👍🏽')).to.equal('👍🏽')
+    expect(singleEmoji('👨‍👩‍👧')).to.equal('👨‍👩‍👧')
+    expect(singleEmoji('🇩🇪')).to.equal('🇩🇪')
+  })
+  it('rejects text, several emojis and non-emoji symbols', () => {
+    for (const s of [
+      '',
+      '  ',
+      'a',
+      'hello 🐱',
+      '🐱x',
+      '🐱🐶',
+      '🐱 🐱',
+      '1',
+      '#',
+      '©x',
+    ])
+      expect(singleEmoji(s), s).to.equal(null)
+  })
+})
