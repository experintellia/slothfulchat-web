diff --git a/packages/frontend/src/components/composer/StickerSuggestions.tsx b/packages/frontend/src/components/composer/StickerSuggestions.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4d26512dd46efd1b57a37596de5315e01b941921
--- /dev/null
+++ b/packages/frontend/src/components/composer/StickerSuggestions.tsx
@@ -0,0 +1,80 @@
+import React, { useEffect, useReducer } from 'react'
+
+import { rpcStickers, type StickerObject } from '../../backend/stickerPacks'
+import { StickerThumb } from '../StickerPacks'
+import { normalizeEmoji } from './singleEmoji'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+import { getLogger } from '@deltachat-desktop/shared/logger'
+
+const log = getLogger('renderer/composer/StickerSuggestions')
+
+// Last fetched packs per account: shown instantly, refreshed on every mount /
+// emoji, so picker or manager edits show up next time (getStickerPacks is cheap).
+const packsCache = new Map<number, StickerObject[]>()
+
+/**
+ * Strip of the pack stickers tagged with `emoji` (already normalized), above
+ * the composer input. Mounted only while the draft is exactly that emoji.
+ */
+export function StickerSuggestions({
+  accountId,
+  emoji,
+  onPick,
+}: {
+  accountId: number
+  emoji: string
+  onPick: (path: string) => void
+}) {
+  const tx = useTranslationFunction()
+  const [, rerender] = useReducer((x: number) => x + 1, 0)
+
+  useEffect(() => {
+    let live = true
+    rpcStickers
+      .getStickerPacks(accountId)
+      .then(packs => {
+        packsCache.set(
+          accountId,
+          packs.flatMap(p => p.stickers)
+        )
+        if (live) rerender()
+      })
+      .catch(err => log.error('getStickerPacks failed', err))
+    return () => {
+      live = false
+    }
+  }, [accountId, emoji])
+
+  // one button per image even when it sits in several packs
+  const matches = [
+    ...new Map(
+      (packsCache.get(accountId) ?? [])
+        .filter(s => s.emojis.some(e => normalizeEmoji(e) === emoji))
+        .map(s => [s.path, s])
+    ).values(),
+  ]
+  if (matches.length === 0) return null
+
+  return (
+    <div
+      className='completion-menu sticker-suggestions'
+      role='group'
+      aria-label={tx('sticker_packs_suggestions')}
+      data-testid='sticker-suggestions'
+    >
+      {matches.map(s => (
+        <button
+          key={s.path}
+          type='button'
+          aria-label={`${tx('sticker')} ${s.emojis.join(' ')}`}
+          // keep focus in the textarea on mouse/touch; click still fires,
+          // and Tab + Enter/Space still reach the button
+          onMouseDown={e => e.preventDefault()}
+          onClick={() => onPick(s.path)}
+        >
+          <StickerThumb path={s.path} size={64} />
+        </button>
+      ))}
+    </div>
+  )
+}
diff --git a/packages/frontend/src/components/composer/singleEmoji.ts b/packages/frontend/src/components/composer/singleEmoji.ts
