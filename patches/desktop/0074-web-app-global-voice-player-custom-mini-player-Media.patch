+  opacity: 0.8;
+}
+// Small-screen (single-column) surface: a slim strip pinned right under the
+// navbar, so the player stays visible inside a chat, where the chat-list
+// column — and with it `.root` — is `display: none` (#137).
+//
+// Total height 38px (row + hairline, no border: the hairline is the bottom
+// edge). MainScreen's `[data-testid='voice-message-strip'] ~ …` rule reserves
+// exactly that much below both navbars, so the strip covers reserved space
+// only — never content. Keep the two in sync.
+.strip {
+  position: absolute;
+  top: var(--navBarHeight);
+  inset-inline: 0;
+  // Above the message list (whose z-indexes are local scopes topping out at
+  // 1), below the user-feedback toast (100) and dialogs.
+  z-index: 2;
+
+  display: flex;
+  flex-direction: column;
+
+  // The app's content surface, NOT the navbar's — the strip must read as its
+  // own element below the navbar (Telegram's pattern: colored navbar, surface
