+// The media-session actions we own; cleared together when playback stops.
+const MEDIA_SESSION_ACTIONS: MediaSessionAction[] = [
+  'play',
+  'pause',
+  'seekbackward',
+  'seekforward',
+  'seekto',
+  'nexttrack',
+]
+
+/**
+ * Wire `navigator.mediaSession` to the global singleton while `active`. Clears
+ * metadata + handlers when `active` goes false / on unmount / setting off.
+ */
+function useMediaSession(
+  active: boolean,
+  audioEl: HTMLAudioElement,
+  meta: { title: string; artist: string; artwork: { src: string }[] },
+  onPlayNext: (() => void) | null
+): void {
+  const title = meta.title
+  const artist = meta.artist
+  const artworkSrc = meta.artwork[0]?.src ?? ''
+  // `null` when there's no queued message: don't register a nexttrack handler.
+  const nextEnabled = onPlayNext != null
+  // Effect Event: the nexttrack handler reads the latest `onPlayNext` without
+  // re-running the effect (its identity changes as currMessage changes).
+  const onNext = useEffectEvent(() => onPlayNext?.())
+
+  useEffect(() => {
+    if (!('mediaSession' in navigator)) {
+      return
+    }
+    const ms = navigator.mediaSession
+
+    const clearHandlers = () => {
+      for (const a of MEDIA_SESSION_ACTIONS) {
+        try {
+          ms.setActionHandler(a, null)
+        } catch {
+          // Some browsers throw for actions they don't support.
+        }
+      }
+    }
+
+    // Side-effect-free when idle: with both the bar and the strip mounted
+    // (breakpoint crossing mid-playback), the newly-idle instance's setup runs
+    // AFTER the newly-active one's — clearing here would wipe the fresh
+    // registration. The previously-active run's cleanup (below) already
+    // clears, and all cleanups run before any setup.
+    if (!active) {
+      return
+    }
+
+    ms.metadata = new MediaMetadata({
+      title,
+      artist,
+      artwork: artworkSrc ? [{ src: artworkSrc }] : [],
+    })
+
+    const SEEK = 10
+    const setTime = (t: number) => {
+      audioEl.currentTime = t
+      // Bypass the 1Hz throttle so the OS scrubber reflects the seek at once
+      // instead of showing the pre-seek position for up to a second.
+      // (`lastPos`/`updatePos` close over the effect scope, initialised by the
+      // time any media-session handler can fire.)
+      lastPos = 0
+      updatePos()
+    }
+    const handlers: Partial<
+      Record<MediaSessionAction, MediaSessionActionHandler>
+    > = {
+      play: () => {
+        audioEl.play()
+      },
+      pause: () => {
+        audioEl.pause()
+      },
+      seekbackward: d =>
+        setTime(
+          clampSeek(
+            audioEl.currentTime,
+            -(d.seekOffset ?? SEEK),
+            audioEl.duration
+          )
+        ),
+      seekforward: d =>
+        setTime(
+          clampSeek(audioEl.currentTime, d.seekOffset ?? SEEK, audioEl.duration)
+        ),
+      seekto: d => {
+        if (d.seekTime != null) {
+          setTime(d.seekTime)
+        }
+      },
+      nexttrack: nextEnabled ? () => onNext() : undefined,
+    }
+    for (const a of MEDIA_SESSION_ACTIONS) {
+      try {
+        ms.setActionHandler(a, handlers[a] ?? null)
+      } catch {
+        // Unsupported action in this browser — skip it.
+      }
+    }
+
+    // positionState, throttled to ~1Hz. setPositionState needs a finite
+    // duration with position in [0, duration] and throws otherwise.
+    let lastPos = 0
+    const updatePos = () => {
+      const now = Date.now()
+      if (now - lastPos < 1000) {
+        return
+      }
+      const dur = audioEl.duration
+      if (!Number.isFinite(dur) || dur <= 0) {
+        return
+      }
+      lastPos = now
+      try {
+        ms.setPositionState({
+          duration: dur,
+          position: Math.min(Math.max(audioEl.currentTime, 0), dur),
+          playbackRate: audioEl.playbackRate || 1,
+        })
+      } catch {
+        // setPositionState can still throw (e.g. an infinite duration slips
+        // past the guard on some engines) — position is best-effort.
+      }
+    }
+    updatePos()
+    const posEvents = ['timeupdate', 'ratechange', 'durationchange'] as const
+    posEvents.forEach(e => audioEl.addEventListener(e, updatePos))
+
+    return () => {
+      posEvents.forEach(e => audioEl.removeEventListener(e, updatePos))
+      ms.metadata = null
+      clearHandlers()
+    }
+  }, [active, audioEl, title, artist, artworkSrc, nextEnabled])
+}
