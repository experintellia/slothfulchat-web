@@ -0,0 +1,178 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import {
+  formatAudioTime,
+  nextPlaybackRate,
+} from '../components/AudioPlayer/utils.js'
+import { makePositionStore } from '../components/AudioPlayer/positionStore.js'
+import {
+  mediaSessionMetadata,
+  clampSeek,
+  voicePlayerSurface,
+} from '../components/GlobalVoiceMessagePlayer/mediaSession.js'
+
+describe('AudioPlayer / formatAudioTime', () => {
+  it('formats seconds as m:ss', () => {
+    expect(formatAudioTime(0)).to.equal('0:00')
+    expect(formatAudioTime(5)).to.equal('0:05')
+    expect(formatAudioTime(65)).to.equal('1:05')
+    expect(formatAudioTime(600)).to.equal('10:00')
+  })
+
+  it('guards NaN, Infinity and negatives as 0:00', () => {
+    expect(formatAudioTime(NaN)).to.equal('0:00')
+    expect(formatAudioTime(Infinity)).to.equal('0:00')
+    expect(formatAudioTime(-5)).to.equal('0:00')
+  })
+})
+
+describe('AudioPlayer / nextPlaybackRate', () => {
+  it('cycles 1 -> 1.5 -> 2 -> 1', () => {
+    expect(nextPlaybackRate(1)).to.equal(1.5)
+    expect(nextPlaybackRate(1.5)).to.equal(2)
+    expect(nextPlaybackRate(2)).to.equal(1)
+  })
+
+  it('falls back to 1 for an unknown rate', () => {
+    expect(nextPlaybackRate(1.25)).to.equal(1)
+    expect(nextPlaybackRate(0)).to.equal(1)
+  })
+})
+
+describe('AudioPlayer / positionStore', () => {
+  // In-memory Storage shim + controllable clock so cap/prune is deterministic.
+  const make = (clock?: () => number) => {
+    let raw = '{}'
+    return makePositionStore(
+      { getItem: () => raw, setItem: (_k: string, v: string) => (raw = v) },
+      clock
+    )
+  }
+
+  it('round-trips a position and clears it', () => {
+    const s = make()
+    expect(s.getPosition('a')).to.equal(null)
+    s.setPosition('a', 12.5)
+    expect(s.getPosition('a')).to.equal(12.5)
+    s.clearPosition('a')
+    expect(s.getPosition('a')).to.equal(null)
+  })
+
+  it('caps at 300 entries, dropping the oldest by insertion time', () => {
+    let t = 0
+    const s = make(() => t++)
+    for (let i = 0; i < 305; i++) {
+      s.setPosition('src' + i, 1)
+    }
+    // 305 inserts over cap 300 → the 5 oldest are gone, the newest 300 remain.
+    expect(s.getPosition('src0')).to.equal(null)
+    expect(s.getPosition('src4')).to.equal(null)
+    expect(s.getPosition('src5')).to.equal(1)
+    expect(s.getPosition('src304')).to.equal(1)
+  })
+
+  it('survives corrupt storage as an empty store', () => {
+    const s = makePositionStore({
+      getItem: () => '{not json',
+      setItem: () => {},
+    })
+    expect(s.getPosition('a')).to.equal(null)
+  })
+
+  it('never persists positions for ephemeral blob: URLs (recorder preview)', () => {
+    const s = make()
+    s.setPosition('blob:http://x/abc', 42)
+    expect(s.getPosition('blob:http://x/abc')).to.equal(null)
+    // real (transformed) message srcs are unaffected
+    s.setPosition('/blobs/db/a.mp3', 7)
+    expect(s.getPosition('/blobs/db/a.mp3')).to.equal(7)
+  })
+
+  it('survives valid-but-wrong-typed JSON (null / number / array)', () => {
+    // JSON.parse succeeds for these, but they aren't the object shape; read()
+    // must coerce to {} so no accessor throws (and the store self-heals).
+    for (const raw of ['null', '5', '[1,2]']) {
+      const s = makePositionStore({ getItem: () => raw, setItem: () => {} })
+      expect(s.getPosition('a')).to.equal(null)
+      expect(() => s.setPosition('a', 3)).to.not.throw()
+      expect(() => s.clearPosition('a')).to.not.throw()
+    }
+  })
+})
+
+describe('GlobalVoiceMessagePlayer / mediaSessionMetadata', () => {
+  const details = {
+    senderName: 'Alice',
+    chatName: 'Team',
+    avatarUrl: 'blob:abc',
+  }
+
+  it('suppressed: generic title, no artist/artwork (privacy default)', () => {
+    const m = mediaSessionMetadata(true, 'Voice Message', details)
+    expect(m.title).to.equal('Voice Message')
+    expect(m.artist).to.equal('')
+    expect(m.artwork).to.deep.equal([])
+  })
+
+  it('detailed: sender as title, chat as artist, avatar as artwork', () => {
+    const m = mediaSessionMetadata(false, 'Voice Message', details)
+    expect(m.title).to.equal('Alice')
+    expect(m.artist).to.equal('Team')
+    expect(m.artwork).to.deep.equal([{ src: 'blob:abc' }])
+  })
+
+  it('detailed with no avatar: empty artwork (guarded)', () => {
+    const m = mediaSessionMetadata(false, 'Voice Message', {
+      senderName: 'Alice',
+      chatName: 'Team',
+    })
+    expect(m.artwork).to.deep.equal([])
+  })
+
+  it('detailed but details unavailable: falls back to generic title', () => {
+    const m = mediaSessionMetadata(false, 'Voice Message', {
+      senderName: '',
+      chatName: '',
+    })
+    expect(m.title).to.equal('Voice Message')
+    expect(m.artwork).to.deep.equal([])
+  })
+})
+
+describe('GlobalVoiceMessagePlayer / voicePlayerSurface', () => {
+  it('renders nothing when nothing is playing', () => {
+    expect(voicePlayerSurface(true, true, false)).to.equal('none')
+    expect(voicePlayerSurface(false, false, false)).to.equal('none')
+  })
+
+  it('setting off: the native element, on every viewport', () => {
+    expect(voicePlayerSurface(false, false, true)).to.equal('native')
+    expect(voicePlayerSurface(true, false, true)).to.equal('native')
+  })
+
+  it('small screen + setting on: the under-navbar strip', () => {
+    expect(voicePlayerSurface(true, true, true)).to.equal('strip')
+  })
+
+  it('wide screen + setting on: the chat-list column bar', () => {
+    expect(voicePlayerSurface(false, true, true)).to.equal('bar')
+  })
+})
+
+describe('GlobalVoiceMessagePlayer / clampSeek', () => {
+  it('seeks within bounds', () => {
+    expect(clampSeek(10, 10, 60)).to.equal(20)
+    expect(clampSeek(30, -10, 60)).to.equal(20)
+  })
+
+  it('clamps to [0, duration]', () => {
+    expect(clampSeek(5, -10, 60)).to.equal(0)
+    expect(clampSeek(55, 10, 60)).to.equal(60)
+  })
+
+  it('non-finite duration only clamps the lower bound', () => {
+    expect(clampSeek(5, 10, Infinity)).to.equal(15)
+    expect(clampSeek(5, -10, Infinity)).to.equal(0)
+  })
+})
