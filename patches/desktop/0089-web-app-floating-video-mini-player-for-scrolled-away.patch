diff --git a/packages/frontend/src/components/VideoMiniPlayer/index.tsx b/packages/frontend/src/components/VideoMiniPlayer/index.tsx
new file mode 100644
index 0000000..5780e6d
--- /dev/null
+++ b/packages/frontend/src/components/VideoMiniPlayer/index.tsx
@@ -0,0 +1,238 @@
+import React, {
+  createContext,
+  useCallback,
+  useMemo,
+  useRef,
+  useState,
+} from 'react'
+
+import styles from './styles.module.scss'
+import VideoPlayer, { readJSON, writeJSON } from '../attachment/VideoPlayer'
+import Icon, { type IconName } from '../Icon'
+import { Tooltip } from '@videojs/react'
+import useMessage from '../../hooks/chat/useMessage'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+
+export type MiniVideo = {
+  accountId: number
+  chatId: number
+  msgId: number
+  src: string
+  /** position to resume from, seconds */
+  time: number
+  /** sent dimensions, 0 when unknown */
+  width: number
+  height: number
+}
+
+/**
+ * A chat video that scrolls out of view or whose bubble unmounts (chat
+ * switch) while playing keeps playing here, in a floating window over the
+ * app, until its bubble is visible again and takes it back.
+ */
+export const VideoMiniPlayerContext = createContext<{
+  setCurrent: (video: MiniVideo | null) => void
+  /** close the window if it shows this message; its playback state, or null */
+  takeBack: (
+    accountId: number,
+    msgId: number
+  ) => { time: number; playing: boolean } | null
+}>({ setCurrent: () => {}, takeBack: () => null })
+
+export function VideoMiniPlayerProvider({
+  children,
+}: React.PropsWithChildren<{}>) {
+  const [current, setCurrent] = useState<MiniVideo | null>(null)
+  const boxRef = useRef<HTMLDivElement>(null)
+  // reads the live window (data-msg + its <video>), so no stale state
+  const takeBack = useCallback((accountId: number, msgId: number) => {
+    const box = boxRef.current
+    const video = box?.querySelector('video')
+    if (!video || box?.dataset.msg !== `${accountId}:${msgId}`) return null
+    setCurrent(null)
+    return { time: video.currentTime, playing: !video.paused && !video.ended }
+  }, [])
+  const value = useMemo(() => ({ setCurrent, takeBack }), [takeBack])
+  return (
+    <VideoMiniPlayerContext.Provider value={value}>
+      {children}
+      {current && (
+        <VideoMiniPlayer
+          // per handoff: handing the same video over again resumes at the new spot
+          key={`${current.accountId}:${current.msgId}:${current.time}`}
+          video={current}
+          rootRef={boxRef}
+          onClose={() => setCurrent(null)}
+        />
+      )}
+    </VideoMiniPlayerContext.Provider>
+  )
+}
+
+const POS_KEY = 'slothful.videoMiniPlayerPos'
+
+function readPos(): { x: number; y: number } | null {
+  const p = readJSON(POS_KEY)
+  return Number.isFinite(p?.x) && Number.isFinite(p?.y) ? p : null
+}
+
+const clamp = (v: number, max: number) => Math.max(0, Math.min(v, max))
+/** keep at least a grabbable corner of the window on screen */
+const onScreen = (p: { x: number; y: number }) => ({
+  x: clamp(p.x, window.innerWidth - 120),
+  y: clamp(p.y, window.innerHeight - 80),
+})
+
+function VideoMiniPlayer({
+  video,
+  rootRef,
+  onClose,
+}: {
+  video: MiniVideo
+  rootRef: React.RefObject<HTMLDivElement | null>
+  onClose: () => void
+}) {
+  const tx = useTranslationFunction()
+  const { jumpToMessage } = useMessage()
+  // null = default corner (CSS), else top-left in px
+  const [pos, setPos] = useState(readPos)
+  const grab = useRef({ dx: 0, dy: 0 })
+
+  const close = () => {
+    // don't drop keyboard focus onto <body> with the window
+    if (rootRef.current?.contains(document.activeElement)) {
+      document
+        .querySelector<HTMLElement>('.create-or-edit-message-input')
+        ?.focus()
+    }
+    onClose()
+  }
+
+  // ponytail: an unresolved cross-account jump hides the button instead
+  // (useMessage's jumpToMessage can't switch accounts), see issue #276.
+  const canJump = video.accountId === window.__selectedAccountId
+  const aspect =
+    video.width > 0 && video.height > 0 ? video.width / video.height : 16 / 9
+
+  return (
+    <div
+      ref={rootRef}
+      className={styles.root}
+      role='region'
+      aria-label={tx('video')}
+      data-msg={`${video.accountId}:${video.msgId}`}
+      style={{
+        // portrait videos get a narrower window instead of a thin strip
+        width: `min(360px, 60vw, calc(50vh * ${aspect}))`,
+        ...(pos && {
+          left: onScreen(pos).x,
+          top: onScreen(pos).y,
+          insetInlineEnd: 'auto',
+        }),
+      }}
+    >
+      <VideoPlayer
+        className={styles.player}
+        style={{ aspectRatio: aspect }}
+        src={video.src}
+        startAt={video.time}
+        autoPlay
+        onEnded={close}
+      >
+        {/* inside the player, so it fades with its controls and hovering it
+            counts as player activity (#277) */}
+        <div
+          className={styles.topBar}
+          // Video.js skips its tap gestures (click = pause) on these, so a
+          // drag or a click on the bar doesn't pause the video
+          data-interactive
+          onPointerDown={e => {
+            const root = rootRef.current
+            if (
+              e.button !== 0 ||
+              root == null ||
+              (e.target as Element).closest('button')
+            ) {
+              return
+            }
+            const box = root.getBoundingClientRect()
+            grab.current = { dx: e.clientX - box.left, dy: e.clientY - box.top }
+            e.currentTarget.setPointerCapture(e.pointerId)
+          }}
+          onPointerMove={e => {
+            if (!e.currentTarget.hasPointerCapture(e.pointerId)) return
+            setPos(
+              onScreen({
+                x: e.clientX - grab.current.dx,
+                y: e.clientY - grab.current.dy,
+              })
+            )
+          }}
+          // also fires on pointerup and pointercancel
+          onLostPointerCapture={() => writeJSON(POS_KEY, pos)}
+        >
+          <div className={styles.buttons}>
+            <BarButton icon='cross' label={tx('close')} onClick={close} />
+            {canJump && (
+              <BarButton
+                icon='chat_bubble'
+                label={tx('show_in_chat')}
+                // once visible, the bubble takes the video back (takeBack)
+                onClick={() =>
+                  jumpToMessage({
+                    accountId: video.accountId,
+                    msgId: video.msgId,
+                    msgChatId: video.chatId,
+                    focus: true,
+                    scrollIntoViewArg: { block: 'center' },
+                  })
+                }
+              />
+            )}
+          </div>
+        </div>
+      </VideoPlayer>
+    </div>
+  )
+}
+
+/**
+ * A button that looks and behaves like the skin's own (cast, PiP, fullscreen):
+ * Video.js's public Tooltip parts with the skin's button/tooltip classes.
+ * ponytail: those class names are the skin's, not a documented API; a skin
+ * update that renames them only costs the look, not function.
+ */
+function BarButton({
+  icon,
+  label,
+  onClick,
+}: {
+  icon: IconName
+  label: string
+  onClick: () => void
+}) {
+  return (
+    <Tooltip.Root side='bottom'>
+      <Tooltip.Trigger
+        render={
+          <button
+            type='button'
+            className='media-button'
+            aria-label={label}
+            onClick={onClick}
+          />
+        }
+      >
+        <Icon
+          className='media-button-icon'
+          icon={icon}
+          size={18}
+          coloring='currentColor'
+        />
+      </Tooltip.Trigger>
+      <Tooltip.Popup className='media-popup media-popup-safe-area media-popup-transition media-popup-surface media-tooltip'>
+        <Tooltip.Label>{label}</Tooltip.Label>
+      </Tooltip.Popup>
+    </Tooltip.Root>
+  )
+}
