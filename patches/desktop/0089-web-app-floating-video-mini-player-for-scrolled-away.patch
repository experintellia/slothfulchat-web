+++ b/packages/frontend/src/components/VideoMiniPlayer/styles.module.scss
@@ -0,0 +1,64 @@
+.root {
+  position: fixed;
+  // top corner, clear of the composer; inline-end mirrors in RTL
+  top: 64px;
+  inset-inline-end: 16px;
+  z-index: 50;
+  max-height: calc(100vh - 80px);
+  border-radius: 12px;
+  overflow: hidden;
+  background: black;
+  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
+}
+
+.player {
+  display: block;
+  width: 100%;
+  --media-video-border-radius: 0;
+  --media-frame-border: transparent;
+}
+
+// Drag strip across the top (marked data-interactive in the markup, so the
+// skin's tap-to-pause ignores it) holding our buttons in a group styled like
+// the skin's own top-right one; both hide with the controls.
+.topBar {
+  position: absolute;
+  inset-block-start: 0;
+  inset-inline: 0;
+  z-index: 20;
+  display: flex;
+  padding: calc(var(--media-spacing) * 2);
+  cursor: grab;
+  touch-action: none;
+
+  &:active {
+    cursor: grabbing;
+  }
+}
+
+// ponytail: mirrors the skin's compact top-right group using its custom
+// properties (--media-popover, --media-hidden-*); a skin update may change them.
+.buttons {
+  display: flex;
+  align-items: center;
+  gap: 1px;
+  padding: calc(var(--media-spacing) * 0.5);
+  border-radius: var(--media-controls-radius);
+  background-color: var(--media-popover);
+  color: var(--media-popover-foreground);
+  box-shadow:
+    0 0 0 1px var(--media-surface-border, var(--media-border)),
+    var(--media-shadow-surface);
+  backdrop-filter: var(--media-backdrop-filter-surface);
+  cursor: auto;
+  transition-property: filter, opacity, scale, translate;
+  transition-duration: var(--media-duration-controls);
+  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
+
+  :global(.media-skin):not([data-controls-visible]) &:not(:focus-within) {
+    pointer-events: none;
+    translate: 0 calc(var(--media-hidden-offset) * -1);
+    scale: var(--media-hidden-scale);
+    opacity: 0;
+  }
+}
