+/**
+ * SlothfulChat's own welcome message: what this fork does differently (runs in
+ * the browser, back up your data, prototyping ground, self-host/fork it).
+ *
+ * Not part of updateDeviceChat(): that one is skipped for freshly created
+ * accounts, and it runs before configure(), which is when core adds its own
+ * welcome message — ours has to land after it. Called from changeScreen()
+ * instead, on every route into the main screen (all of which mean the account
+ * is configured); the label makes core drop every repeat, so the re-runs on
+ * each account switch are free.
+ */
+export async function addSlothfulWelcomeMessage(accountId: number) {
+  const tx = window.static_translate
+  // The contact-the-developer paragraph points at the New Chat entry from the
+  // community suggestions, which an operator can switch off instance-wide —
+  // don't send users looking for something that isn't in their build.
+  const text = [
+    tx('slothful_welcome_message'),
+    ...(instanceHidesPublicSuggestions()
+      ? []
+      : [tx('slothful_welcome_contact_developer')]),
+    tx('slothful_welcome_selfhost'),
+  ].join('\n\n')
+  await BackendRemote.rpc.addDeviceMessage(accountId, 'slothful-welcome', {
+    text,
+    html: null,
+    viewtype: null,
+    file: null,
+    filename: null,
+    location: null,
+    overrideSenderName: null,
+    quotedMessageId: null,
+    quotedText: null,
+  })
+}
+
