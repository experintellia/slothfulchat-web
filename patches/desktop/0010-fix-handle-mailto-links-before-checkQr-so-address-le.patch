From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Wed, 28 Oct 2026 02:48:43 +0000
Subject: [PATCH] fix: handle mailto: links before checkQr, so address-less
 ones work

processQr asked core's checkQr first and only then checked for mailto:.
Core parses mailto: only with an address, so a link like
`mailto:?body=/command` (bots, e.g. StickersBot, put these in their HTML
messages to prefill a command) failed with "QR code could not be decoded"
and never reached useOpenMailtoLink, which already handles a missing
address by asking which chat to draft the body in. Check for mailto:
first.

Patch-Range: upstream-fix
---
 packages/frontend/src/hooks/useProcessQr.ts | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/packages/frontend/src/hooks/useProcessQr.ts b/packages/frontend/src/hooks/useProcessQr.ts
index 56ab3e586898fb80cf3b44ff0407eb22d2b30735..ec79cc9d8989b128e2b58380522b4274ae95214c 100644
--- a/packages/frontend/src/hooks/useProcessQr.ts
+++ b/packages/frontend/src/hooks/useProcessQr.ts
@@ -207,6 +207,15 @@ export default function useProcessQR() {
       scanContext: SCAN_CONTEXT_TYPE,
       callback?: () => void
     ): Promise<void> => {
+      // Scanned string is actually a link to an email address. Handled
+      // before checkQr: core only accepts a mailto: with an address, so a
+      // `mailto:?body=…` (bots use them to prefill a command) failed as
+      // "QR code could not be decoded" before reaching this.
+      if (url.toLowerCase().startsWith('mailto:')) {
+        await openMailtoLink(accountId, url)
+        return callback?.()
+      }
+
       // Check if given string is a valid DeltaChat URI-Scheme and return
       // parsed object, otherwise show an error to the user
       let qr: T.Qr
@@ -250,12 +259,6 @@ export default function useProcessQR() {
         return callback?.()
       }
 
-      // Scanned string is actually a link to an email address
-      if (url.toLowerCase().startsWith('mailto:')) {
-        await openMailtoLink(accountId, url)
-        return callback?.()
-      }
-
       // Some actions can only be executed when the user already has an account
       // and is logged in
       const isLoggedIn = await BackendRemote.rpc.isConfigured(accountId)
