@@ -113,6 +113,50 @@
       }
     }
 
+    .send-button-wrap {
+      position: relative;
+    }
+    // Why the send button is blocked. Shown on hover/focus and after a send
+    // attempt (.open); hoverable itself, so its button can be reached.
+    .send-blocked-tip {
+      position: absolute;
