@@ -389,6 +389,35 @@ const Composer = forwardRef<
       ? composerSendMessage
       : messageEditing.doSendEditRequest
 
+  // "Check spelling before sending": while the grammar checker still underlines
+  // something, a send attempt only opens a tip that says why. Sending anyway:
+  // Ctrl/Cmd+click, the tip's button, or the send key a second time.
+  // ponytail: counts what is underlined right now, so text typed and sent
+  // within the checker's debounce goes out unchecked; wait for the pending
+  // check here if that turns out to matter.
+  const [draftIssues, setDraftIssues] = useState(0)
+  const [editIssues, setEditIssues] = useState(0)
+  const [sendBlockedTip, setSendBlockedTip] = useState(false)
+  const grammarIssues =
+    languageTool && settingsStore?.desktopSettings.grammarCheckBlocksSend
+      ? messageEditing.isEditingModeActive
+        ? editIssues
+        : draftIssues
+      : 0
+  const sendBlocked = grammarIssues > 0 && sendButtonAction != null
+  const trySend = (send: () => void, force: boolean) => {
+    if (sendBlocked && !force) {
+      setSendBlockedTip(true)
+    } else {
+      setSendBlockedTip(false)
+      send()
+    }
+  }
+  useEffect(
+    () => setSendBlockedTip(false),
+    [draftState.text, messageEditing.newText]
+  )
+
   useKeyBindingAction(KeybindAction.Composer_SelectReplyToUp, () => {
     if (messageEditing.isEditingModeActive) {
       return
@@ -939,11 +968,12 @@ const Composer = forwardRef<
                   true
                 }
                 languageTool={languageTool}
+                onGrammarIssueCount={setDraftIssues}
                 botCommands={botCommands}
                 loadingDraft={draftIsLoading}
                 sendMessageOrEditRequest={
-                  (!messageEditing.isEditingModeActive
-                    ? composerSendMessage
+                  (!messageEditing.isEditingModeActive && composerSendMessage
+                    ? () => trySend(composerSendMessage, sendBlockedTip)
                     : null) ??
                   (threadQuoteMissing
                     ? // The bar above says why; nothing to log.
@@ -971,9 +1001,13 @@ const Composer = forwardRef<
                   true
                 }
                 languageTool={languageTool}
+                onGrammarIssueCount={setEditIssues}
                 loadingDraft={false}
-                sendMessageOrEditRequest={
-                  messageEditing.doSendEditRequest ?? (() => {})
