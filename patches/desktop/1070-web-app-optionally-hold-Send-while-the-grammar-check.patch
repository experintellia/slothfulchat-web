+      bottom: 100%;
+      z-index: 10;
+      box-sizing: border-box;
+      width: max-content;
+      max-width: min(300px, 80vw);
+      padding: 8px 12px;
+      visibility: hidden;
+
+      background-color: var(--bgPrimary);
+      color: var(--textPrimary);
+      border: 1px solid var(--separatorColor);
+      border-radius: 10px;
+      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
+      font-size: 14px;
+      line-height: 1.4;
+
+      &.open {
+        visibility: visible;
+      }
+      button {
+        display: block;
+        margin-top: 6px;
+        padding: 0;
+        border: none;
+        background: none;
+        color: var(--colorPrimary);
+        font: inherit;
+        font-weight: bold;
+        cursor: pointer;
+      }
+    }
+    .send-button-wrap:hover .send-blocked-tip,
+    .send-button-wrap:focus-within .send-blocked-tip {
+      visibility: visible;
+    }
+
     .send-button {
       width: 32px;
       height: 32px;
@@ -130,8 +174,10 @@
         outline-offset: 2px;
       }
       // E.g. in reply-thread mode until a thread message is quoted; the bar
-      // above the input says why.
-      &:disabled {
+      // above the input says why. aria-disabled: unaddressed grammar issues,
+      // .send-blocked-tip says why.
+      &:disabled,
+      &[aria-disabled='true'] {
         opacity: 0.4;
         cursor: default;
       }
