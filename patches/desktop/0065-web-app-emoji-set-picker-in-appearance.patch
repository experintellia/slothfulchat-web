+++ b/packages/frontend/src/components/EmojiPicker/index.tsx
@@ -52,7 +52,14 @@ export default function EmojiPicker({
     if (!shadowRoot) return
     const style = document.createElement('style')
     style.textContent =
-      '.category > .sticky { background-color: var(--bgPrimary) !important; }'
+      '.category > .sticky { background-color: var(--bgPrimary) !important; }' +
+      // emoji-mart hardcodes an inline font-family on native emoji, so the
+      // picker ignores the app font. Make it follow the selected emoji set:
+      // --emojifonts (set by the web-app runtime) inherits into the shadow
+      // root, and the Sloth* @font-face families are document-global. The
+      // inline style is overridden with !important; [style*="EmojiMart"]
+      // targets exactly emoji-mart's native-emoji spans.
+      '\nspan[style*="EmojiMart"] { font-family: var(--emojifonts) !important; }'
     shadowRoot.appendChild(style)
     return () => {
       shadowRoot.removeChild(style)
