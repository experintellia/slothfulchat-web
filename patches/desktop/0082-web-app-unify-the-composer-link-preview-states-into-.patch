+
+// Loading: the same skeleton card, now shimmering — the placeholder is
+// "filling in" rather than being replaced by a spinner bar.
+.ghostCardLoading {
+  border-style: solid;
+
+  .skelLine,
+  .ghostThumb {
+    background-image: linear-gradient(
+      100deg,
+      transparent 30%,
+      rgba(255, 255, 255, 0.75) 50%,
+      transparent 70%
+    );
+    background-size: 200% 100%;
+    animation: shimmer 1.3s linear infinite;
+  }
