 .../src/components/AudioPlayer/peaks.ts       |  6 +-
 .../src/components/AudioPlayer/utils.ts       | 28 +++++++--
 .../frontend/src/tests/audioPlayer.test.ts    | 43 ++++++++++++-
 4 files changed, 112 insertions(+), 27 deletions(-)

diff --git a/packages/frontend/src/components/AudioPlayer/Waveform.tsx b/packages/frontend/src/components/AudioPlayer/Waveform.tsx
index 15aa4be..17f15a2 100644
--- a/packages/frontend/src/components/AudioPlayer/Waveform.tsx
+++ b/packages/frontend/src/components/AudioPlayer/Waveform.tsx
@@ -3,15 +3,21 @@ import React, { useEffect, useRef } from 'react'
 // Shared canvas bar renderer for both the voice-message waveform and the live
 // recorder meter (they use the exact same routine — don't duplicate it).
 //
-// Draws `peaks` (values ~0..1) as centered vertical bars. Bars before
-// `progress` (0..1 of the width) are the accent colour (--colorPrimary); the
-// rest are currentColor at ~35% opacity. Colours are read from the canvas's
-// computed style so it tracks the theme. Handles devicePixelRatio.
+// Draws `peaks` (values ~0..1) as centered, rounded 3px bars with 2px gaps;
+// the bar count follows the canvas width (peaks are averaged down when there
+// are more than fit), so bars look the same in any bubble size. Silence still
+// draws a 3px dot. The played part (0..`progress` of the width) is the accent
+// colour (--colorPrimary), clipped mid-bar so progress moves smoothly instead
+// of a whole bar at a time; the rest is currentColor at ~35% opacity. Colours
+// are read from the canvas's computed style so it tracks the theme. Handles
+// devicePixelRatio.
 //
 // ponytail: no ResizeObserver — the canvas uses its live clientWidth on every
 // draw, and draws are driven by the player's currentTime/duration state (or the
 // recorder's per-frame level), so it's correct whenever it actually paints; a
 // window resize of a never-touched bar just isn't worth an observer.
+const BAR_W = 3
+const BAR_GAP = 2
 export function drawBars(
   canvas: HTMLCanvasElement,
   peaks: Float32Array | ArrayLike<number>,
@@ -33,25 +39,49 @@ export function drawBars(
   ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
   ctx.clearRect(0, 0, cssW, cssH)
 
+  const src = peaks.length
+  if (src === 0) {
+    return
+  }
   const style = getComputedStyle(canvas)
   const played = style.getPropertyValue('--colorPrimary').trim() || style.color
   const unplayed = style.color
 
-  const n = peaks.length
-  if (n === 0) {
-    return
-  }
-  const barW = cssW / n
-  const gap = Math.min(1, barW * 0.25)
-  const playedBars = progress * n
+  const n = Math.max(
+    1,
+    Math.min(src, Math.floor((cssW + BAR_GAP) / (BAR_W + BAR_GAP)))
+  )
+  const step = cssW / n
+  const barW = Math.min(BAR_W, step)
+  const bars = new Path2D()
   for (let i = 0; i < n; i++) {
-    const h = Math.max(1, peaks[i] * cssH)
-    const isPlayed = i < playedBars
-    ctx.globalAlpha = isPlayed ? 1 : 0.35
-    ctx.fillStyle = isPlayed ? played : unplayed
-    ctx.fillRect(i * barW, (cssH - h) / 2, Math.max(1, barW - gap), h)
+    // Average the source peaks that land in this bar.
+    const a = Math.floor((i * src) / n)
+    const b = Math.max(a + 1, Math.floor(((i + 1) * src) / n))
+    let sum = 0
+    for (let j = a; j < b; j++) {
+      sum += peaks[j]
+    }
+    const h = Math.min(cssH, Math.max(barW, (sum / (b - a)) * cssH))
+    bars.roundRect(i * step, (cssH - h) / 2, barW, h, barW / 2)
   }
+  const x = Math.max(0, Math.min(1, progress)) * cssW
+  ctx.globalAlpha = 0.35
+  ctx.fillStyle = unplayed
+  ctx.save()
+  ctx.beginPath()
+  ctx.rect(x, 0, cssW - x, cssH)
+  ctx.clip()
+  ctx.fill(bars)
+  ctx.restore()
   ctx.globalAlpha = 1
+  ctx.fillStyle = played
+  ctx.save()
+  ctx.beginPath()
+  ctx.rect(0, 0, x, cssH)
+  ctx.clip()
+  ctx.fill(bars)
+  ctx.restore()
 }
 
 /** Canvas that redraws `peaks` at `progress` whenever either changes. */
