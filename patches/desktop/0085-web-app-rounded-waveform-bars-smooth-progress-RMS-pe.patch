-    expect(p[1]).to.be.closeTo(0.9, 1e-6)
+    expect(p[1]).to.be.closeTo(1, 1e-6)
     expect(Array.from(p).filter(v => v !== 0).length).to.equal(1)
   })
 
-  it('handles empty input and n <= 0', () => {
+  it('handles empty input, silence and n <= 0', () => {
     expect(Array.from(bucketPeaks(new Float32Array(0), 4))).to.deep.equal([
       0, 0, 0, 0,
     ])
+    expect(Array.from(bucketPeaks(new Float32Array(64), 4))).to.deep.equal([
+      0, 0, 0, 0,
+    ])
     expect(bucketPeaks(new Float32Array(4).fill(1), 0).length).to.equal(0)
   })
+
+  it('scales a quiet recording up to full height', () => {
+    const data = new Float32Array(800)
+    for (let i = 0; i < data.length; i++) data[i] = 0.02 * Math.sin(i)
+    expect(Math.max(...bucketPeaks(data, 8))).to.be.greaterThan(0.95)
+  })
+
+  it('keeps background noise low around a lone short sound', () => {
+    const data = new Float32Array(6400)
+    for (let i = 0; i < data.length; i++) data[i] = 0.01 * Math.sin(i) // noise
+    for (let i = 100; i < 200; i++) data[i] = 0.5 * Math.sin(i) // 1 of 64 voiced
+    const p = bucketPeaks(data, 64)
+    expect(p[1]).to.be.closeTo(1, 1e-6)
+    expect(p[30]).to.be.lessThan(0.15)
+  })
+
+  it('still shows a lone short sound (<5% of buckets voiced)', () => {
+    const data = new Float32Array(6400)
+    data[100] = 0.5 // 1 of 64 buckets voiced → p95 is 0
+    expect(bucketPeaks(data, 64)[1]).to.be.closeTo(1, 1e-6)
+  })
+
+  // The point of RMS: clipped (AGC'd) speech must not pin every bar to full
+  // height the way max-abs did (18 of these 32 buckets).
+  it('keeps bar variety on clipped loud speech', () => {
+    const data = new Float32Array(8000)
+    for (let i = 0; i < data.length; i++) {
+      const env = Math.max(0, Math.sin(i / 300)) // syllables with pauses
+      data[i] = Math.max(-1, Math.min(1, (i % 2 ? 1 : -1) * env * 3))
+    }
+    const p = Array.from(bucketPeaks(data, 32))
+    expect(p.filter(v => v >= 0.95).length).to.be.at.most(12)
+    expect(Math.max(...p)).to.equal(1)
+  })
 })
