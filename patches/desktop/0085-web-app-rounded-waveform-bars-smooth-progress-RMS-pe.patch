--- a/packages/frontend/src/components/AudioPlayer/peaks.ts
+++ b/packages/frontend/src/components/AudioPlayer/peaks.ts
@@ -3,10 +3,10 @@
 // player silently keeps the A1 bar. Playback never waits on this.
 //
 // Pipeline: in-session cache → fetch(src) → arrayBuffer → decodeAudioData →
-// max-abs bucketing of channel 0 → Float32Array.
+// RMS bucketing of channel 0, normalized per recording → Float32Array.
 //
 // decodeAudioData already runs the expensive decode off-thread internally;
-// the 64-bucket loop left on the main thread is a single linear pass.
+// the 128-bucket loop left on the main thread is a single linear pass.
 // ponytail: no worker for it. If sc:waveform:bucket measures show it janking
 // long messages, move bucketPeaks into a Worker (git history has one).
 
@@ -15,7 +15,7 @@ import { bucketPeaks } from './utils'
 
 const log = getLogger('AudioPlayer/peaks')
 
-const N_PEAKS = 64
+const N_PEAKS = 128
 const TIME_BUDGET_MS = 4000
 const CACHE_MAX = 100
 
diff --git a/packages/frontend/src/components/AudioPlayer/utils.ts b/packages/frontend/src/components/AudioPlayer/utils.ts
index 0aae0ee..23c52c6 100644
--- a/packages/frontend/src/components/AudioPlayer/utils.ts
+++ b/packages/frontend/src/components/AudioPlayer/utils.ts
@@ -24,8 +24,11 @@ export function nextPlaybackRate(rate: number): number {
 }
 
 /**
- * Reduce a mono PCM channel to `n` peaks (max absolute sample per bucket).
- * Values are in [0, 1]-ish.
+ * Reduce a mono PCM channel to `n` bar heights in [0, 1]: RMS per bucket,
+ * normalized to the recording's own 95th percentile. Max-abs (the old
+ * approach) pins every bar to full height on AGC'd phone mics, which touch
+ * full scale in nearly every bucket; RMS follows perceived loudness, and the
+ * per-recording normalization keeps quiet messages from looking empty.
  */
 export function bucketPeaks(data: Float32Array, n: number): Float32Array {
   const peaks = new Float32Array(Math.max(n, 0))
@@ -33,11 +36,26 @@ export function bucketPeaks(data: Float32Array, n: number): Float32Array {
   for (let i = 0; i < n; i++) {
     const start = Math.floor(i * bucketSize)
     const end = Math.min(data.length, Math.floor((i + 1) * bucketSize))
-    let max = 0
+    let sq = 0
     for (let j = start; j < end; j++) {
-      max = Math.max(max, Math.abs(data[j] ?? 0))
+      const v = data[j] ?? 0
+      sq += v * v
+    }
+    peaks[i] = end > start ? Math.sqrt(sq / (end - start)) : 0
+  }
+  // Reference = p95, but at least a quarter of the max: when speech fills <5%
+  // of the buckets, p95 is the background noise level and would draw the
+  // noise full height.
+  // ponytail: linear, no curve or floor. Long messages average seconds of
+  // speech per bar and look fairly even; stretch the range (floor just under
+  // the quietest 5%) if real recordings look too flat.
+  const sorted = Float32Array.from(peaks).sort()
+  const max = sorted[n - 1] ?? 0
+  const ref = Math.max(sorted[Math.floor(n * 0.95)] ?? 0, max * 0.25)
+  if (ref > 0) {
+    for (let i = 0; i < n; i++) {
+      peaks[i] = Math.min(1, (peaks[i] ?? 0) / ref)
     }
-    peaks[i] = max
   }
   return peaks
 }
