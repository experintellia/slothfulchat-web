   changeScreen(screen: Screens) {
     log.debug('Changing screen to:', screen)
+    // Every route into the main screen means the account is configured, and
+    // this is the only choke point they share: instant onboarding jumps here
+    // itself once configure() succeeded, without going through selectAccount()
+    // — hooking that one instead would hold the message back until the next
