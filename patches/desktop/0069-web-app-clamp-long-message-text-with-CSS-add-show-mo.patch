+// ponytail: these are core's former truncation limits (38 lines x 100 chars),
+// ported here only as the "is this text long enough to clamp" heuristic.
+// LONG_TEXT_LINES must stay above the -webkit-line-clamp value in
+// _message.scss (.text.clamped, currently 24), otherwise a text could trip
+// this check and show a toggle that reveals nothing new once expanded.
+const LONG_TEXT_CHARS = 3800
+const LONG_TEXT_LINES = 38
+
+function isLongText(text: string | null): boolean {
+  if (!text) return false
+  return (
+    text.length > LONG_TEXT_CHARS || text.split('\n').length > LONG_TEXT_LINES
+  )
+}
