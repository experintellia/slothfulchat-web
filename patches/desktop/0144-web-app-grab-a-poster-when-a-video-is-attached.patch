+/**
+ * Stores a poster next to a video draft's attachment, so that sending it as a large
+ * attachment yields a pre-message placeholder with a preview (core cannot decode video
+ * frames itself, see `PostMsgMetadata::thumbnail`).
+ *
+ * Best-effort throughout: without a poster the placeholder just stays blank, which is what
+ * it looks like today.
+ *
+ * ponytail: covers the draft, which is every single-file attach (picker, paste, drop). A
+ * multi-file selection sends straight from `confirmSendMultipleFiles` without a draft, and
+ * the blob name only exists after the send has started — those videos get no poster. Fix by
+ * teaching that path to draft-and-send if it ever matters.
+ */
+async function addVideoPosterToDraft(draft: T.Message): Promise<void> {
+  // The composer stores pasted and dropped files as `File`; core only corrects the viewtype
+  // to `Video` when the message is sent, so go by the mime it guessed from the suffix.
+  const isVideo =
+    draft.viewType === 'Video' || draft.fileMime?.startsWith('video/') === true
+  if (!isVideo || !draft.file || runtime.writeBlobPreview == null) {
+    return
+  }
+  const poster = await videoPoster(runtime.transformBlobURL(draft.file))
+  if (poster == null) {
+    return
+  }
+  try {
+    await runtime.writeBlobPreview(draft.file, poster)
+  } catch (error) {
+    log.warn('could not store the video poster:', error)
+  }
+}
+
