From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Thu, 20 Aug 2026 13:45:35 +0000
Subject: [PATCH 85/88] web-app: only offer the copy context-menu entry when
 there is something to copy

The context menu's copy entry ("Copy Text"/"Copy Selection"/"Copy Email")
was gated on `text !== ''`. But the caller passes `text: text || undefined`,
so a message without a caption arrives as `undefined`, not `''`, and the
guard was true for every message. A caption-less image therefore always
offered "Copy Text", whose action (`text && writeClipboardText(text)`) does
nothing at all.

Gate on the truthiness of what the entry would actually copy instead: a
live selection, a clicked email address, or the copyable text. For a
not-yet-downloaded message the copyable text is `placeholderCaption(text)`,
because core appends a "[Image - 3 MiB]" tag that the action strips; so a
caption-less placeholder image hides the entry too, instead of offering a
"Copy Text" that copies `''`. A caption-less image still offers "Copy
Selection" when text is selected -- e.g. inside a quoted message.

Also tidy `textSelected` to `Boolean(selectedText)`: `getSelectedText()`
returns `string | undefined`, never `null`, so the old `!== null` half was
dead code.
---
 .../src/components/message/Message.tsx        | 20 ++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/packages/frontend/src/components/message/Message.tsx b/packages/frontend/src/components/message/Message.tsx
index 9ebcadb..ac2645c 100644
--- a/packages/frontend/src/components/message/Message.tsx
+++ b/packages/frontend/src/components/message/Message.tsx
@@ -301,7 +301,7 @@ function buildContextMenu(
     clickTarget?.getAttribute('x-target-url') || clickTarget?.href || ''
   // grab selected text before clicking, otherwise the selection might be already gone
   const selectedText = getSelectedText()
-  const textSelected: boolean = selectedText !== null && selectedText !== ''
+  const textSelected: boolean = Boolean(selectedText)
 
   const isSavedMessage = message.savedMessageId !== null
 
@@ -312,13 +312,14 @@ function buildContextMenu(
    * - OR Copy email to clipboard
    * - Fallback: OR Copy message text to copy
    */
+  // On a placeholder, copy what's on screen: the caption without the
+  // appended "[Label - size]" tag the styled card already displays.
+  const copyText =
+    message.downloadState !== 'Done' ? placeholderCaption(text) : text
+
   let copy_item: ContextMenuItem | false = {
     label: tx('menu_copy_text_to_clipboard'),
     action: () => {
-      // On a placeholder, copy what's on screen: the caption without the
-      // appended "[Label - size]" tag the styled card already displays.
-      const copyText =
-        message.downloadState !== 'Done' ? placeholderCaption(text) : text
       copyText && runtime.writeClipboardText(copyText)
     },
   }
@@ -437,8 +438,13 @@ function buildContextMenu(
         label: tx('menu_copy_link_to_clipboard'),
         action: () => runtime.writeClipboardText(link),
       },
-    // copy item (selection or all text)
-    text !== '' && copy_item,
+    // copy item (selection, email, or all text). `text` is `undefined` (not
+    // `''`) when the message has no caption, and a not-yet-downloaded
+    // caption-less message only has the "[Image - size]" tag, which
+    // `copyText` strips to `''`; so gate on what would actually be copied.
+    // A caption-less image can still have a selection worth copying, e.g.
+    // from a quoted message.
+    Boolean(textSelected || email || copyText) && copy_item,
     // Copy image
     showCopyImage && {
       label: tx('menu_copy_image_to_clipboard'),
