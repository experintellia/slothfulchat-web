+  useEffect(() => {
+    ;(window as any).__slothfulOpenLinkSafely = (url: string) => {
+      void openNonMailtoLinkSafely(url)
+    }
+    ;(window as any).__slothfulProcessQr = (qrAccountId: number, url: string) => {
+      processQr(qrAccountId, url, SCAN_CONTEXT_TYPE.DEFAULT)
+    }
+    return () => {
+      delete (window as any).__slothfulOpenLinkSafely
+      delete (window as any).__slothfulProcessQr
+    }
+  }, [openNonMailtoLinkSafely, processQr])
 
