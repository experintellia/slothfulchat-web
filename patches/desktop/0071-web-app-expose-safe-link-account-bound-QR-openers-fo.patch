@@ -2,6 +2,7 @@ import React, { useEffect, useRef } from 'react'
 
 import useMessage from '../hooks/chat/useMessage'
 import useProcessQr from '../hooks/useProcessQr'
+import { useOpenNonMailtoLinkSafely } from '../hooks/useOpenLinkSafely'
 import { clearNotificationsForChat } from '../system-integration/notifications'
 import { runtime } from '@deltachat-desktop/runtime-interface'
 
@@ -33,6 +34,31 @@ export default function RuntimeAdapter({
 
   const { closeDialog, openDialog, closeAllDialogs } = useDialog()
   const openSendToDialogId = useRef<string | undefined>(undefined)
+  const openNonMailtoLinkSafely = useOpenNonMailtoLinkSafely()
+
+  // web-app (SlothfulChat): the HTML-email viewer renders sender HTML in a
+  // script-less sandbox, so a link clicked inside it can't reach React. It
+  // relays such links to the runtime, which calls these globals. Both are
+  // no-ops upstream/electron never touch.
+  //  - http(s) links -> the safe-link path (tracking-param stripping), same as
+  //    a pasted or in-chat link. Account-agnostic.
+  //  - app links (mailto/openpgp4fpr/dcaccount/dclogin/i.delta.chat invites) ->
