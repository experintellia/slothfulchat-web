+// Pure helpers for the global voice-message player: `navigator.mediaSession`
+// metadata/seeking, and which player surface renders. Kept free of
+// browser/React APIs so they're unit-testable; the hook in
+// GlobalVoiceMessagePlayer.tsx turns these into MediaMetadata /
 // setPositionState / action-handler calls.
 
+/**
+ * Which player surface renders, from the layout, the experimental setting and
+ * whether anything is playing. Exactly one at a time — the strip *replaces*
+ * the bar on the single-column layout, it never doubles it.
+ *
+ * - `'none'` — nothing playing.
+ * - `'native'` — setting off: the re-parented `<audio>` element, at the bottom
+ *   of the chat-list column (unchanged on every viewport).
+ * - `'strip'` — single-column (small-screen) layout: that column is hidden
+ *   while a chat is open, taking the bar with it (#137), so the player moves
+ *   to a slim strip under the navbar instead.
+ * - `'bar'` — the custom mini-player at the bottom of the chat-list column.
+ */
+export function voicePlayerSurface(
+  smallScreen: boolean,
+  customControls: boolean,
+  hasSrc: boolean
+): 'none' | 'native' | 'strip' | 'bar' {
+  if (!hasSrc) {
+    return 'none'
+  }
+  if (!customControls) {
+    return 'native'
+  }
+  return smallScreen ? 'strip' : 'bar'
+}
