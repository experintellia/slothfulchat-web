+/**
+ * The small-screen surface: one row (play/pause, label, speed, close) over a
+ * 2px progress hairline, pinned under the navbar.
+ *
+ * Its own component so the ~4Hz `timeupdate` re-renders stay here instead of
+ * re-rendering the whole player (and its fetch hooks).
+ */
+function VoiceMessageStrip({
+  audioRef,
+  label,
+  onClose,
+}: {
+  audioRef: React.RefObject<HTMLAudioElement | null>
+  /** Jump-to-message label, or `null` when there's no message to jump to. */
+  label: { text: string; onClick: () => void } | null
+  onClose: () => void
+}) {
+  const tx = useTranslationFunction()
+  const ctx = useContext(MediaPlayerMutexContext)
+  const { paused, progress } = useAudioElementState(audioRef)
+
+  return (
+    <section
+      className={styles.strip}
+      aria-label={tx('audio')}
+      data-testid='voice-message-strip'
+    >
+      <div className={styles.stripRow}>
+        <IconButton
+          icon={paused ? 'play' : 'pause'}
+          coloring='currentColor'
+          size={18}
+          aria-label={paused ? tx('menu_play') : tx('menu_pause')}
+          onClick={() => {
+            const el = audioRef.current
+            if (el == null) {
+              return
+            }
+            // This IS the singleton: no position restore needed (unlike a cold
+            // bubble element), its currentTime is the live one.
+            if (el.paused) {
+              el.play()
+            } else {
+              el.pause()
+            }
+          }}
+        />
+        {label != null ? (
+          <button
+            type='button'
+            className={styles.stripLabel}
+            title={tx('jump_to_message')}
+            onClick={label.onClick}
+          >
+            {label.text}
+          </button>
+        ) : (
+          <span className={styles.stripSpacer} />
+        )}
+        <button
+          type='button'
+          className={styles.speedPill}
+          aria-label={tx('a11y_playback_speed', `${ctx.playbackRate}×`)}
+          onClick={() =>
+            ctx.setPlaybackRate(nextPlaybackRate(ctx.playbackRate))
+          }
+        >
+          {ctx.playbackRate}×
+        </button>
+        <IconButton
+          icon='cross'
+          coloring='currentColor'
+          size={18}
+          aria-label={tx('close')}
+          onClick={onClose}
+        />
+      </div>
+      {/*
+        Position readout only — the bubble's waveform and the OS media session
+        own seeking, so there is deliberately no pointer target here (a 2px
+        strip would be a poor one anyway). Decorative: the same position is
+        already announced by the bubble's seek slider.
+      */}
+      <div className={styles.hairline} aria-hidden={true}>
+        <div
+          className={styles.hairlineFill}
+          style={{ width: `${progress * 100}%` }}
+        />
+      </div>
+    </section>
+  )
+}
