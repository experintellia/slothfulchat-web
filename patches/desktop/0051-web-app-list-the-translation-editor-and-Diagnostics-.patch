From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Thu, 16 Jul 2026 02:54:51 +0000
Subject: [PATCH 51/90] web-app: list the translation editor and Diagnostics
 shortcuts in the keyboard shortcuts cheat sheet

Ctrl/Cmd+Shift+L opens the in-app translation editor and Ctrl/Cmd+Shift+D the
Diagnostics panel; both are implemented fork-side in web-app (runtime.ts,
diagnostics.ts). Listing them in the shortcuts dialog makes them
discoverable. Plain English titles: there are no catalogue strings for
these fork-only tools.
---
 .../frontend/src/components/KeyboardShortcutHint.tsx | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/packages/frontend/src/components/KeyboardShortcutHint.tsx b/packages/frontend/src/components/KeyboardShortcutHint.tsx
index 7da2c37..0d4a1ed 100644
--- a/packages/frontend/src/components/KeyboardShortcutHint.tsx
+++ b/packages/frontend/src/components/KeyboardShortcutHint.tsx
@@ -202,6 +202,18 @@ export function getKeybindings(
         title: tx('force_refresh_network'),
         keyBindings: [['F5']],
       },
+      {
+        // SlothfulChat: the in-app translation editor (runtime.ts), available in
+        // every build. No catalogue string for this dev/translator tool.
+        title: 'Translation editor',
+        keyBindings: [[ctrl, 'Shift', 'L']],
+      },
+      {
+        // SlothfulChat: the Diagnostics panel (diagnostics.ts), also reachable
+        // from the log dialog. No catalogue string for it either.
+        title: 'Diagnostics',
+        keyBindings: [[ctrl, 'Shift', 'D']],
+      },
     ].map(Shortcut),
     {
       title: tx('message_input_shortcut_section'),
