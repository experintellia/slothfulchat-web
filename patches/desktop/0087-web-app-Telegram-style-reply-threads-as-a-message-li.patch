+/**
+ * Reply-badge counts for the messages in `msgIds`, fetched in one batch, and
+ * again (throttled) after anything changes in the chat: a reply to any of
+ * them may have arrived or been deleted. Nothing is fetched when `msgIds` is
+ * empty (thread mode passes no IDs: badges are not shown there).
+ */
+function useReplyCounts(
+  accountId: number,
+  chatId: number,
+  msgIds: number[]
+): Record<number, number> {
+  const key = msgIds.join(',')
+  const [counts, setCounts] = useState<Record<number, number>>({})
+  const fetchCounts = useMemo(
+    () =>
+      asyncThrottle(async (ids: number[]) => {
+        try {
+          setCounts(await rpcWithReplies.getMessageReplyCounts(accountId, ids))
+        } catch (error) {
+          log.warn('getMessageReplyCounts failed', error)
+        }
+      }, 250),
+    [accountId]
+  )
+  useEffect(() => {
+    if (key === '') {
+      return
+    }
+    const ids = key.split(',').map(Number)
+    fetchCounts(ids)
+    const onChatEvent = ({ chatId: eventChatId }: { chatId: number }) => {
+      if (eventChatId === chatId || eventChatId === 0) {
+        fetchCounts(ids)
+      }
+    }
+    const cleanup = [
+      onDCEvent(accountId, 'MsgsChanged', onChatEvent),
+      onDCEvent(accountId, 'IncomingMsg', onChatEvent),
+    ]
+    return () => cleanup.forEach(off => off())
+  }, [accountId, chatId, key, fetchCounts])
+  return counts
+}
 
