+import type { ReplyThreadEntry } from '../utils/replyThreadLayout'
+
+// getMessageReplyCounts/getMessageReplyThread come from the fork's regenerated
+// local jsonrpc bindings; the published @deltachat/jsonrpc-client pinned in
+// this workspace's catalog predates them, so they're typed locally here to keep
+// tsc green (same pattern as useMessage.ts's MessageData widening).
+export const rpcWithReplies = BackendRemote.rpc as typeof BackendRemote.rpc & {
+  /** All replies below each message; messages without replies are omitted. */
+  getMessageReplyCounts(
+    accountId: number,
+    msgIds: number[]
+  ): Promise<Record<number, number>>
+  /** The thread's messages, chronologically; empty if the message is gone. */
+  getMessageReplyThread(
+    accountId: number,
+    msgId: number
+  ): Promise<ReplyThreadEntry[]>
+}
