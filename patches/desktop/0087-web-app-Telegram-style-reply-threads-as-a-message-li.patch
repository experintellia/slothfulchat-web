@@ -0,0 +1,41 @@
+import { expect } from 'chai'
+import { describe, it } from 'mocha'
+
+import { layoutThread } from '../utils/replyThreadLayout.js'
+
+// Chronological, as core returns it: 1 is the root, 2 and 4 reply to it,
+// 3 replies to 2, 5 replies to 3.
+const entries = [
+  { msgId: 1, parentId: null },
+  { msgId: 2, parentId: 1 },
+  { msgId: 3, parentId: 2 },
+  { msgId: 4, parentId: 1 },
+  { msgId: 5, parentId: 3 },
+]
+
+describe('layoutThread', () => {
+  it('keeps the chronological order in the list layout', () => {
+    expect(layoutThread(entries, 'list')).to.deep.equal({
+      order: [1, 2, 3, 4, 5],
+      depth: {},
+    })
+  })
+
+  it('puts replies below their parent in the tree layout', () => {
+    expect(layoutThread(entries, 'tree')).to.deep.equal({
+      order: [1, 2, 3, 5, 4],
+      depth: { 1: 0, 2: 1, 3: 2, 5: 3, 4: 1 },
+    })
+  })
+
+  it('still shows entries not reachable from the root', () => {
+    const { order } = layoutThread(
+      [
+        { msgId: 1, parentId: null },
+        { msgId: 7, parentId: 8 },
+      ],
+      'tree'
+    )
+    expect(order).to.deep.equal([1, 7])
+  })
+})
