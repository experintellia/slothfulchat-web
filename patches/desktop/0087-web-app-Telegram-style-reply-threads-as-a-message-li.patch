+/** The first line of the thread's first message, for the thread's navbar. */
+async function fetchThreadRootText(accountId: number, msgId: number) {
+  const entries = await rpcWithReplies.getMessageReplyThread(accountId, msgId)
+  const rootId = entries.find(entry => entry.parentId === null)?.msgId
+  if (rootId === undefined) {
+    return ''
+  }
+  const root = await BackendRemote.rpc.getMessage(accountId, rootId)
+  return (root.text || root.fileName || '').split('\n')[0]
+}
+
+/**
+ * The navbar in thread mode: the chat's avatar and name over the start of
+ * the thread's first message, then the list/tree toggle and the button
+ * back to the whole chat.
+ */
+function ThreadNav({ chat, thread }: { chat: T.FullChat; thread: ThreadView }) {
+  const tx = useTranslationFunction()
+  const accountId = selectedAccountId()
+  const { closeThread, setThreadLayout } = useChat()
+  const rootTextFetch = useRpcFetch(fetchThreadRootText, [
+    accountId,
+    thread.msgId,
+  ])
+  const rootText = rootTextFetch.lingeringResult?.ok
+    ? rootTextFetch.lingeringResult.value
+    : ''
+  const isTree = thread.layout === 'tree'
+  const toggleLabel = tx(isTree ? 'thread_show_as_list' : 'thread_show_as_tree')
+
+  return (
+    <>
+      <div className={styles.chatNavbarHeadingWrapper} data-tauri-drag-region>
+        <div className='navbar-heading' data-no-drag-region>
+          <Avatar
+            displayName={chat.name}
+            color={chat.color}
+            avatarPath={chat.profileImage || undefined}
+            small
+            wasSeenRecently={chat.wasSeenRecently}
+            // Decorative, like in `ChatHeading`: the name is right below.
+            aria-hidden={true}
+          />
+          <div style={{ marginInlineStart: '7px', overflow: 'hidden' }}>
+            <div className='navbar-chat-name'>
+              <h2 id='chat-section-heading' className='truncated'>
+                {chat.name}
+                <span className='visually-hidden'>
+                  <br />
+                  {tx('reply_thread')}
+                </span>
+              </h2>
+            </div>
+            <div className='navbar-chat-subtitle truncated'>{rootText}</div>
+          </div>
+        </div>
+      </div>
+      <div className='views' data-no-drag-region>
+        <Button
+          onClick={() => setThreadLayout(isTree ? 'list' : 'tree')}
+          aria-label={toggleLabel}
+          title={toggleLabel}
+          className='navbar-button'
+          styling='borderless'
+        >
+          <Icon
+            coloring='navbar'
+            icon={isTree ? 'view_list' : 'account_tree'}
+            size={18}
+          />
+        </Button>
+        <Button
+          onClick={() => closeThread()}
+          aria-label={tx('thread_close')}
+          title={tx('thread_close')}
+          className='navbar-button'
+          styling='borderless'
+        >
+          <Icon coloring='navbar' icon='cross' size={18} />
+        </Button>
+      </div>
+    </>
+  )
+}
