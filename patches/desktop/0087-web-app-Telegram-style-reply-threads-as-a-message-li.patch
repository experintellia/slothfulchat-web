index 0000000..02054ef
--- /dev/null
+++ b/packages/frontend/src/utils/replyThreadLayout.ts
@@ -0,0 +1,50 @@
+/** One message of a reply thread; `parentId` is null for the thread's root. */
+export type ReplyThreadEntry = { msgId: number; parentId: number | null }
+
+/**
+ * How the message list shows a thread: `list` is chronological like the
+ * normal chat, `tree` puts every reply below the message it answers, like a
+ * comment section.
+ */
+export type ThreadLayout = 'list' | 'tree'
+
+/** Thread mode of the message list: which thread, laid out how. */
+export type ThreadView = { msgId: number; layout: ThreadLayout }
+
+/**
+ * Display order of a thread, and in the tree layout each message's depth
+ * below the root. Core returns `entries` chronologically, so siblings stay
+ * chronological in the tree too.
+ */
+export function layoutThread(
+  entries: ReplyThreadEntry[],
+  layout: ThreadLayout
+): { order: number[]; depth: Record<number, number> } {
+  if (layout === 'list') {
+    return { order: entries.map(e => e.msgId), depth: {} }
+  }
+  const children = new Map<number | null, number[]>()
+  for (const { msgId, parentId } of entries) {
+    children.set(parentId, [...(children.get(parentId) ?? []), msgId])
+  }
+  const order: number[] = []
+  const depth: Record<number, number> = {}
+  const visit = (id: number, d: number) => {
+    if (id in depth) {
+      return // core returns a tree; this only guarantees we can't loop
+    }
+    depth[id] = d
+    order.push(id)
+    for (const child of children.get(id) ?? []) {
+      visit(child, d + 1)
+    }
+  }
+  for (const root of children.get(null) ?? []) {
+    visit(root, 0)
+  }
+  // Anything not reachable from the root still shows up rather than vanish.
+  for (const { msgId } of entries) {
+    visit(msgId, 0)
+  }
+  return { order, depth }
+}
