-  // a fake track, and the size. No filename — the real player shows none.
+  // Audio / Voice: mimic whichever player the message will turn into, so the
+  // card doesn't reshape itself on download. Both variants put the download
+  // circle in the play slot and show the duration and the size; no filename,
+  // neither player shows one.
   if (viewType === 'Audio' || viewType === 'Voice') {
+    const downloadControl =
+      message.downloadState === 'InProgress' ? (
+        <ProgressCircle percent={downloadPercent} label={tx('downloading')} />
+      ) : (
+        <CircleDownloadButton
+          messageId={message.id}
+          accountId={accountId}
+          tabIndex={tabindexForInteractiveContents}
+        />
+      )
     return (
       <div
         className={'message-attachment-audio download-on-demand' + contentBelow}
       >
-        <div className='fake-audio-player'>
-          {message.downloadState === 'InProgress' ? (
-            <ProgressCircle
-              percent={downloadPercent}
-              label={tx('downloading')}
-            />
-          ) : (
-            <CircleDownloadButton
-              messageId={message.id}
-              accountId={accountId}
-              tabIndex={tabindexForInteractiveContents}
