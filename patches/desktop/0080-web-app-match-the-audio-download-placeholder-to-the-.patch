diff --git a/packages/frontend/scss/message/_message-download-placeholder.scss b/packages/frontend/scss/message/_message-download-placeholder.scss
index fb2417d..5773c9e 100644
--- a/packages/frontend/scss/message/_message-download-placeholder.scss
+++ b/packages/frontend/scss/message/_message-download-placeholder.scss
@@ -99,6 +99,39 @@
     }
   }
 
+  // Custom-player variant (experimentalAudioPlayerControls): all the geometry
+  // comes from AudioPlayer's own module classes, so only the stand-in waveform
+  // and the size text need rules here. No panel background — the real custom
+  // controls sit bare on the bubble.
+  .fake-custom-player {
+    .fake-waveform {
+      flex: 1;
+      min-width: 40px;
+      // The real .seekWrap is a column flex item, so its height comes from its
+      // content (the 32px range input) — not from its own `height`. Match that
+      // height here or the row collapses and the time/size line rides up.
+      height: 32px;
+      // Flat and dotted: there is no audio to analyse until the message is
+      // downloaded, and a dashed hairline reads as an inert stand-in rather
+      // than a waveform with nothing in it. Fainter than the unplayed bars'
+      // 0.35 for the same reason.
+      opacity: 0.25;
+      background-image: repeating-linear-gradient(
+        to right,
+        currentColor 0 1.5px,
+        transparent 1.5px 4px
+      );
+      background-repeat: no-repeat;
+      background-size: 100% 6px;
+      background-position: center;
+    }
+
+    .size {
+      font-size: 11px;
+      color: var(--messageAttachmentFileInfo);
+    }
+  }
+
   // Grey fallback box shown when there is no thumbnail (any placement).
   .download-on-demand-empty {
     background-color: var(--messageAttachmentIconBg);
@@ -155,6 +188,7 @@
 
   // In-row ring/button sizing for the audio pill and file card.
   .fake-audio-player,
+  .fake-custom-player,
   &.message-attachment-generic {
     .download-progress-circle {
       flex-shrink: 0;
