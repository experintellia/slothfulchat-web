+/**
+ * Core waits ten minutes for a post-message no relay has yet before failing
+ * it, because the sender may still be uploading a large attachment; slower
+ * uploads can take longer than that. So a failure on a message that arrived
+ * recently says it may still come. An older one was most likely deleted from
+ * the relay (chatmail relays clear messages out after a while) or never
+ * arrived, which a retry cannot fix, so it says what will: sending it again.
+ * The UI cannot see why a download failed, and the retry button stays either
+ * way for the rarer causes a retry does fix.
+ */
+const FRESH_FAILURE_SECS = 60 * 60
+
+export function DownloadFailedLabel({ message }: { message: T.Message }) {
+  const tx = useTranslationFunction()
+  const fresh =
+    Date.now() / 1000 - message.receivedTimestamp < FRESH_FAILURE_SECS
+  // Your own message from another device has no one to ask.
+  const key = fresh
+    ? 'download_may_still_arrive'
+    : message.fromId === C.DC_CONTACT_ID_SELF
+      ? 'download_not_on_relay_send_again'
+      : 'download_not_on_relay_ask_sender'
+  return <span className='failed'>{tx(key)}</span>
+}
