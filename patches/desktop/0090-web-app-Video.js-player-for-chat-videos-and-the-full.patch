diff --git a/packages/frontend/src/components/attachment/VideoPlayer.tsx b/packages/frontend/src/components/attachment/VideoPlayer.tsx
new file mode 100644
index 0000000..c9ead8a
--- /dev/null
+++ b/packages/frontend/src/components/attachment/VideoPlayer.tsx
@@ -0,0 +1,198 @@
+import React, { useEffect, useMemo, useState } from 'react'
+import { I18nContext, createTranslator } from '@videojs/react/i18n'
+import {
+  Video,
+  VideoPlayer as VjsPlayer,
+  VideoSkin,
+} from '@videojs/react/video'
+import '@videojs/react/video/skin.css'
+
+import { audioEl } from '../../contexts/MediaPlayerMutexContext'
+import useTranslationFunction from '../../hooks/useTranslationFunction'
+
+const VOLUME_KEY = 'slothful.videoVolume'
+
+// One medium plays at a time: a chat video starting pauses the voice-message
+// singleton and every other chat video; a voice message starting pauses videos.
+// Scoped to `data-chat-video` so call/preview <video>s are left alone.
+function pauseChatVideos(except?: EventTarget | null) {
+  document
+    .querySelectorAll<HTMLVideoElement>('video[data-chat-video]')
+    .forEach(v => v !== except && v.pause())
+}
+document.addEventListener(
+  'play',
+  ev => {
+    if (
+      ev.target instanceof HTMLVideoElement &&
+      ev.target.hasAttribute('data-chat-video')
+    ) {
+      audioEl.pause()
+      pauseChatVideos(ev.target)
+    }
+  },
+  true
+)
+audioEl.addEventListener('play', () => pauseChatVideos())
+
+// Labels follow the app language. Not Video.js's I18nProvider (it would bundle
+// all ~50 packs); the web-app serves them in videojs-locales/ and we import only
+// the active one. Our own strings fill in where no pack exists.
+const OWN_STRINGS = {
+  'buttons.mute': 'mute',
+  'volume.muted': 'muted',
+  'common.ok': 'ok',
+  'menu.off': 'off',
+  'menu.back': 'back',
+  'menu.settings': 'menu_settings',
+  'menu.audio': 'audio',
+} as const
+
+type Strings = Record<string, string>
+const packs = new Map<string, Promise<Strings>>()
+
+function flatten(obj: object, prefix = '', out: Strings = {}): Strings {
+  for (const [k, v] of Object.entries(obj)) {
+    if (typeof v === 'string') out[prefix + k] = v
+    else if (v && typeof v === 'object') flatten(v, `${prefix}${k}.`, out)
+  }
+  return out
+}
+
+/** Pack files to try for an app locale, most specific first. */
+function packTags(locale: string): string[] {
+  const [lang, region] = locale.split(/[-_]/)
+  // our `pt` is European Portuguese, Video.js's `pt` re-exports pt-BR
+  if (lang === 'pt' && !region) return ['pt-PT']
+  // Video.js's `sr` is Latin script, our Serbian strings are Cyrillic
+  if (lang === 'sr' || lang === 'en') return []
+  return region ? [`${lang}-${region.toUpperCase()}`, lang] : [lang]
+}
+
+// ponytail: a failed pack load (offline before the SW precache filled) stays
+// English for the session; the browser's module map caches failed imports, so
+// retrying wouldn't refetch anyway.
+async function fetchPack(locale: string): Promise<Strings> {
+  for (const tag of packTags(locale)) {
+    // full URL: relative to the app (subpath deployments), not to bundle.js
+    const url = new URL(`videojs-locales/${tag}.js`, document.baseURI).href
+    try {
+      return flatten((await import(/* runtime, not bundled */ url)).default)
+    } catch {
+      // no such pack: try the next tag
+    }
+  }
+  return {}
+}
+
+function loadPack(locale: string): Promise<Strings> {
+  let pack = packs.get(locale)
+  if (!pack) {
+    pack = fetchPack(locale)
+    packs.set(locale, pack)
+  }
+  return pack
+}
+
+function useVideoJsI18n() {
+  const tx = useTranslationFunction()
+  const locale = window.localeData?.locale ?? 'en'
+  const [pack, setPack] = useState<Strings>({})
+  useEffect(() => {
+    let live = true
+    loadPack(locale).then(p => live && setPack(p))
+    return () => {
+      live = false
+    }
+  }, [locale])
+  return useMemo(() => {
+    const strings: Strings = {}
+    for (const [key, ours] of Object.entries(OWN_STRINGS)) {
+      strings[key] = tx(ours)
+    }
+    Object.assign(strings, pack)
+    const tag = locale.replace('_', '-')
+    return {
+      translator: createTranslator(strings, tag),
+      locale: tag,
+      localeFromProp: true,
+    }
+  }, [pack, tx, locale])
+}
+
+function restore(el: HTMLVideoElement, startAt: number | undefined) {
+  try {
+    const saved = JSON.parse(localStorage.getItem(VOLUME_KEY) ?? 'null')
+    if (Number.isFinite(saved?.volume)) {
+      el.volume = saved.volume
+      el.muted = saved.muted === true
+    }
+  } catch {
+    // storage blocked: default volume
+  }
+  if (startAt) {
+    el.currentTime = startAt
+  }
+}
+
+function save(el: HTMLVideoElement) {
+  try {
+    localStorage.setItem(
+      VOLUME_KEY,
+      JSON.stringify({ volume: el.volume, muted: el.muted })
+    )
+  } catch {
+    // storage blocked: skip
+  }
+}
+
+/**
+ * Video.js player used for chat videos (message bubble, fullscreen viewer,
+ * mini player). Keyboard shortcuts (space/k, j/l, arrows, m, f, i, 0-9, <>),
+ * auto-hiding controls and the error dialog come with the packaged skin; they
+ * act while focus is inside the player.
+ */
+export default function VideoPlayer({
+  src,
+  className,
+  style,
+  autoPlay,
+  startAt,
+  onEnded,
+  autoFocus,
+}: {
+  src: string
+  className?: string
+  style?: React.CSSProperties
+  autoPlay?: boolean
+  /** seconds to seek to once metadata is loaded */
+  startAt?: number
+  onEnded?: () => void
+  /** focus the player once loaded so its keyboard shortcuts work right away */
+  autoFocus?: boolean
+}) {
+  const i18n = useVideoJsI18n()
+  return (
+    <I18nContext.Provider value={i18n}>
+      <VjsPlayer>
+        <VideoSkin className={className} style={style}>
+          <Video
+            src={src}
+            data-chat-video
+            preload='metadata'
+            playsInline
+            autoPlay={autoPlay}
+            onLoadedMetadata={e => {
+              restore(e.currentTarget, startAt)
+              if (autoFocus) {
+                e.currentTarget.closest<HTMLElement>('.media-skin')?.focus()
+              }
+            }}
+            onVolumeChange={e => save(e.currentTarget)}
+            onEnded={onEnded}
+          />
+        </VideoSkin>
+      </VjsPlayer>
+    </I18nContext.Provider>
+  )
+}
