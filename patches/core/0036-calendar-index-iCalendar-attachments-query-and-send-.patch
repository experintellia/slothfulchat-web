+#[test]
+fn test_updates_cancellations_and_overrides() {
+    let invite = "BEGIN:VEVENT
+UID:meet
+SEQUENCE:0
+DTSTART:20261005T080000Z
+DTEND:20261005T090000Z
+RRULE:FREQ=DAILY;COUNT=3
+SUMMARY:Old title
+END:VEVENT
+";
+    let update = "BEGIN:VEVENT
+UID:meet
+SEQUENCE:1
+DTSTART:20261005T080000Z
+DTEND:20261005T090000Z
+RRULE:FREQ=DAILY;COUNT=3
+SUMMARY:New title
+END:VEVENT
+BEGIN:VEVENT
+UID:meet
+RECURRENCE-ID:20261006T080000Z
+SEQUENCE:1
+DTSTART:20261006T120000Z
+DTEND:20261006T130000Z
+SUMMARY:Moved
+END:VEVENT
+";
+    let cancel = "METHOD:CANCEL
+BEGIN:VEVENT
+UID:meet
+RECURRENCE-ID:20261007T080000Z
+SEQUENCE:2
+DTSTART:20261007T080000Z
+END:VEVENT
+";
+    let mut rows = Vec::new();
+    for (i, body) in [invite, update, cancel].into_iter().enumerate() {
+        for r in parse_ics(&ics(body)) {
+            rows.push((MsgId::new(10 + i as u32), ChatId::new(10), r));
+        }
+    }
+    let ev = expand(rows, ts("2026-10-01T00:00:00Z"), ts("2026-10-31T00:00:00Z"));
+    let got: Vec<(&str, i64, bool)> = ev
+        .iter()
+        .map(|e| (e.summary.as_str(), e.start, e.cancelled))
+        .collect();
+    assert_eq!(
+        got,
+        [
+            ("New title", ts("2026-10-05T08:00:00Z"), false),
+            ("Moved", ts("2026-10-06T12:00:00Z"), false),
+            ("", ts("2026-10-07T08:00:00Z"), true),
+        ]
+    );
+}
