+#[test]
+fn test_all_day_floating_and_duration() {
+    let rows = parse_ics(&ics("BEGIN:VEVENT
+UID:holiday
+DTSTART;VALUE=DATE:20261003
+END:VEVENT
+BEGIN:VEVENT
+UID:floating
+DTSTART:20261003T150000
+DURATION:P1DT2H
+END:VEVENT
+"));
+    assert_eq!(rows[0].start, ts("2026-10-03T00:00:00Z"));
+    assert_eq!(rows[0].end, ts("2026-10-04T00:00:00Z"));
+    assert!(rows[0].all_day && rows[0].floating);
+    assert_eq!(rows[1].end - rows[1].start, 26 * 3600);
+    assert!(!rows[1].all_day && rows[1].floating);
+    assert_eq!(parse_duration("-PT15M"), Some(-900));
+    assert_eq!(parse_duration("P1W"), Some(7 * 86400));
+    assert_eq!(parse_duration("nonsense"), None);
+}
