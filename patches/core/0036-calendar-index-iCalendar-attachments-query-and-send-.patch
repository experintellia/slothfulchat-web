+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_send_receive_query() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let chat_id = alice.create_chat_id(bob).await;
+
+    let event = NewCalendarEvent {
+        summary: "Party".to_string(),
+        start: ts("2026-12-31T20:00:00Z"),
+        end: ts("2027-01-01T02:00:00Z"),
+        ..Default::default()
+    };
+    let msg_id = send_event(alice, chat_id, &event, Some("Come!".to_string())).await?;
+    let (from, to) = (ts("2026-12-01T00:00:00Z"), ts("2027-01-01T00:00:00Z"));
+    let ev = get_events(alice, None, from, to).await?;
+    assert_eq!(ev.len(), 1);
+    assert_eq!((ev[0].msg_id, ev[0].chat_id), (msg_id, chat_id));
+    assert_eq!(get_chats(alice).await?, [(chat_id, 1)]);
+    assert!(get_events(alice, None, to, to + 86400 * 30).await?.len() == 1); // still running
+    assert!(get_events(alice, None, 0, from).await?.is_empty());
+
+    // Indexed on receive, with the message text kept.
+    let received = bob.recv_msg(&alice.pop_sent_msg().await).await;
+    assert_eq!(received.get_text(), "Come!");
+    assert!(
+        bob.sql
+            .exists(
+                "SELECT COUNT(*) FROM calendar_indexed WHERE msg_id=?",
+                (received.id,)
+            )
+            .await?
+    );
+    let ev = get_events(bob, Some(received.chat_id), from, to).await?;
+    assert_eq!(ev[0].summary, "Party");
+
+    // Deleting the message removes the event; housekeeping prunes the index.
+    crate::message::delete_msgs(bob, &[received.id]).await?;
+    assert!(get_events(bob, None, from, to).await?.is_empty());
+    prune(bob).await?;
+    assert!(
+        !bob.sql
+            .exists("SELECT COUNT(*) FROM calendar_indexed", ())
+            .await?
+    );
+
+    // Messages from before the index existed get indexed on the next query.
+    alice.sql.execute("DELETE FROM calendar_events", ()).await?;
+    alice
+        .sql
+        .execute("DELETE FROM calendar_indexed", ())
+        .await?;
+    assert_eq!(get_events(alice, None, from, to).await?.len(), 1);
+    Ok(())
+}
