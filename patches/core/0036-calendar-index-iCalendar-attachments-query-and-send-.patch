+/// Parses an iCalendar DURATION (`P1W`, `-PT15M`, `P1DT2H`) into seconds.
+fn parse_duration(s: &str) -> Option<i64> {
+    let (sign, s) = match s.trim().strip_prefix('-') {
+        Some(rest) => (-1, rest),
+        None => (1, s.trim().trim_start_matches('+')),
+    };
+    let mut total = 0i64;
+    let mut num = String::new();
+    for c in s.strip_prefix('P')?.chars() {
+        match c {
+            '0'..='9' => num.push(c),
+            'T' => {}
+            _ => {
+                let n: i64 = num.parse().ok()?;
+                num.clear();
+                total += n * match c {
+                    'W' => 7 * 86400,
+                    'D' => 86400,
+                    'H' => 3600,
+                    'M' => 60,
+                    'S' => 1,
+                    _ => return None,
+                };
+            }
+        }
+    }
+    Some(sign * total)
+}
+
+/// Undoes iCalendar TEXT escaping (RFC 5545 3.3.11).
+fn unescape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut chars = s.chars();
+    while let Some(c) = chars.next() {
+        if c == '\\' {
+            match chars.next() {
+                Some('n' | 'N') => out.push('\n'),
+                Some(other) => out.push(other),
+                None => {}
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
