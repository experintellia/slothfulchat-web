+#[test]
+fn test_tzid_rrule_exdate_across_dst() {
+    // Weekly 10:00 Berlin, 4 times, starting before the DST end (25 Oct 2026), one exception.
+    let rows = rows_of(&ics("BEGIN:VEVENT
+UID:weekly@test
+DTSTART;TZID=Europe/Berlin:20261014T100000
+DTEND;TZID=Europe/Berlin:20261014T110000
+RRULE:FREQ=WEEKLY;COUNT=4
+EXDATE;TZID=Europe/Berlin:20261021T100000
+SUMMARY:Standup\\, weekly
+END:VEVENT
+"));
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].2.summary, "Standup, weekly");
+    assert_eq!(rows[0].2.until, ts("2026-11-04T11:00:00+01:00"));
+
+    let ev = expand(rows, ts("2026-10-01T00:00:00Z"), ts("2026-12-01T00:00:00Z"));
+    let starts: Vec<i64> = ev.iter().map(|e| e.start).collect();
+    assert_eq!(
+        starts,
+        [
+            ts("2026-10-14T10:00:00+02:00"),
+            ts("2026-10-28T10:00:00+01:00"), // wall clock stays 10:00 after DST
+            ts("2026-11-04T10:00:00+01:00"),
+        ]
+    );
+    assert!(
+        ev.iter()
+            .all(|e| e.end - e.start == 3600 && e.recurring && !e.floating)
+    );
+
+    // Only the occurrences inside the range.
+    let ev = expand(
+        rows_of(&ics("BEGIN:VEVENT
+UID:weekly@test
+DTSTART;TZID=Europe/Berlin:20261014T100000
+DURATION:PT1H
+RRULE:FREQ=WEEKLY
+END:VEVENT
+")),
+        ts("2026-10-27T00:00:00Z"),
+        ts("2026-11-03T00:00:00Z"),
+    );
+    assert_eq!(ev.len(), 1);
+    assert_eq!(ev[0].start, ts("2026-10-28T10:00:00+01:00"));
+}
