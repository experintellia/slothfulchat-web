+++ b/src/calendar.rs
@@ -0,0 +1,709 @@
+//! # Calendar index.
+//!
+//! iCalendar attachments (`.ics` files and the `text/calendar` part of email invitations, which
+//! the MIME parser turns into a [`Viewtype::File`]) are parsed once and indexed in the
+//! `calendar_events` table, so the UI can query a date range without reading every blob, and a
+//! future reminder feature has the events available natively.
+//!
+//! The table is derived data: it can be dropped and rebuilt from the messages at any time.
+//! That's why it is created with `CREATE TABLE IF NOT EXISTS` on every open instead of a
+//! numbered migration, which would collide with upstream's next migration number.
+
+use std::collections::{HashMap, HashSet};
+use std::str::FromStr;
+
+use anyhow::{Context as _, Result};
+use chrono::{DateTime, NaiveDate, NaiveDateTime, TimeZone, Utc};
+use icalendar::rrule::{RRule, RRuleSet, Tz, Unvalidated};
+use icalendar::{Calendar, CalendarDateTime, Component, DatePerhapsTime, EventLike};
+
+use crate::chat::{self, ChatId};
+use crate::constants::{DC_CHAT_ID_LAST_SPECIAL, DC_CHAT_ID_TRASH};
+use crate::context::Context;
+use crate::log::{LogExt, warn};
+use crate::message::{Message, MsgId, Viewtype};
+use crate::tools::{create_id, time};
+
+pub(crate) const SCHEMA: &str = "
+CREATE TABLE IF NOT EXISTS calendar_events (
+  msg_id INTEGER NOT NULL,
+  uid TEXT NOT NULL,
+  recurrence_id INTEGER NOT NULL DEFAULT 0, -- 0 = the series itself, else the start it overrides
+  sequence INTEGER NOT NULL DEFAULT 0,
+  cancelled INTEGER NOT NULL DEFAULT 0,
+  start INTEGER NOT NULL,
+  end INTEGER NOT NULL,   -- end of the first occurrence
+  until INTEGER NOT NULL, -- end of the last occurrence, i64::MAX for endless series
+  all_day INTEGER NOT NULL DEFAULT 0,
+  floating INTEGER NOT NULL DEFAULT 0, -- start/end are wall-clock times encoded as UTC
+  summary TEXT NOT NULL DEFAULT '',
+  location TEXT NOT NULL DEFAULT '',
+  description TEXT NOT NULL DEFAULT '',
+  rrule TEXT -- serialized RRuleSet, NULL if not recurring
+);
+CREATE INDEX IF NOT EXISTS calendar_events_range ON calendar_events (start, until);
+CREATE INDEX IF NOT EXISTS calendar_events_uid ON calendar_events (uid);
+CREATE INDEX IF NOT EXISTS calendar_events_msg_id ON calendar_events (msg_id);
+CREATE TABLE IF NOT EXISTS calendar_indexed (msg_id INTEGER PRIMARY KEY);
+";
+
+/// SQL condition (on `msgs`) preselecting messages that may carry an iCalendar file.
+/// [`is_calendar_msg`] makes the exact decision.
+const MAYBE_CALENDAR: &str = "type=60 AND download_state=0 \
+    AND (param LIKE '%m=text/calendar%' OR param LIKE '%.ics%')";
+
+/// Floating and all-day events are wall-clock times stored as UTC, so they can be up to this
+/// far off in either direction from the real instant; range queries are widened by it.
+const FLOATING_SLACK: i64 = 14 * 3600;
+
+/// Upper bound for expanding a series, both for finding its last occurrence and per query.
+const MAX_OCCURRENCES: u16 = 5000;
+
+/// One occurrence of a calendar event.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CalendarEvent {
+    /// Message carrying the iCalendar file.
+    pub msg_id: MsgId,
+    /// Chat of that message.
+    pub chat_id: ChatId,
+    /// `UID` of the event, shared by all its occurrences and updates.
+    pub uid: String,
+    /// Title.
+    pub summary: String,
+    /// Location, may be empty.
+    pub location: String,
+    /// Description, may be empty.
+    pub description: String,
+    /// Start as unix timestamp.
+    /// For `floating` events this is the wall-clock time as if it was UTC.
+    pub start: i64,
+    /// End (exclusive), same encoding as `start`.
+    pub end: i64,
+    /// All-day event: `start`/`end` are midnights (UTC encoded), `end` is exclusive.
+    pub all_day: bool,
+    /// `start`/`end` are wall-clock times encoded as UTC rather than instants.
+    pub floating: bool,
+    /// The event (or this occurrence) was cancelled by the organizer.
+    pub cancelled: bool,
+    /// The event is part of a recurring series.
+    pub recurring: bool,
+}
+
+/// What a new event is created from.
+#[derive(Debug, Clone, Default)]
+pub struct NewCalendarEvent {
+    /// Title.
+    pub summary: String,
+    /// Location, may be empty.
+    pub location: String,
+    /// Description, may be empty.
+    pub description: String,
+    /// Start as unix timestamp; for all-day events the UTC midnight of the first day.
+    pub start: i64,
+    /// End as unix timestamp; for all-day events the UTC midnight after the last day.
+    pub end: i64,
+    /// All-day event.
+    pub all_day: bool,
+    /// IANA time zone the event is anchored to (keeps the wall-clock time of recurring events
+    /// stable over DST changes). `None` writes UTC times.
+    pub timezone: Option<String>,
+    /// `RRULE` value, e.g. `FREQ=WEEKLY`.
+    pub rrule: Option<String>,
+}
+
+/// A parsed `VEVENT`, as stored in `calendar_events`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Row {
+    uid: String,
+    recurrence_id: i64,
+    sequence: i64,
+    cancelled: bool,
+    start: i64,
+    end: i64,
+    until: i64,
+    all_day: bool,
+    floating: bool,
+    summary: String,
+    location: String,
+    description: String,
+    rrule: Option<String>,
+}
+
+fn is_calendar_msg(msg: &Message) -> bool {
+    msg.get_viewtype() == Viewtype::File
+        && msg.download_state == crate::download::DownloadState::Done
+        && (msg
+            .get_filemime()
+            .is_some_and(|m| m.eq_ignore_ascii_case("text/calendar"))
+            || msg
+                .get_filename()
+                .is_some_and(|n| n.to_lowercase().ends_with(".ics")))
+}
+
+/// (Re)indexes the given messages if they carry an iCalendar file. Cheap for other messages.
+pub(crate) async fn index_msgs(context: &Context, msg_ids: &[MsgId]) -> Result<()> {
+    for msg_id in msg_ids {
+        if context
+            .sql
+            .exists(
+                &format!("SELECT COUNT(*) FROM msgs WHERE id=? AND {MAYBE_CALENDAR}"),
+                (msg_id,),
+            )
+            .await?
+        {
+            index_msg(context, *msg_id).await?;
+        }
+    }
+    Ok(())
+}
+
+async fn index_msg(context: &Context, msg_id: MsgId) -> Result<()> {
+    let msg = Message::load_from_db(context, msg_id).await?;
+    let mut rows = Vec::new();
+    if is_calendar_msg(&msg) {
+        if let Some(path) = msg.get_file(context) {
+            match tokio::fs::read(&path).await {
+                Ok(bytes) => rows = parse_ics(&String::from_utf8_lossy(&bytes)),
+                Err(err) => warn!(
+                    context,
+                    "calendar: cannot read {}: {err:#}.",
+                    path.display()
+                ),
+            }
+        }
+    }
+    context
+        .sql
+        .transaction(move |t| {
+            t.execute("DELETE FROM calendar_events WHERE msg_id=?", (msg_id,))?;
+            for r in rows {
+                t.execute(
+                    "INSERT INTO calendar_events (msg_id, uid, recurrence_id, sequence, cancelled,
+                       start, end, until, all_day, floating, summary, location, description, rrule)
+                     VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
+                    (
+                        msg_id,
+                        r.uid,
+                        r.recurrence_id,
+                        r.sequence,
+                        r.cancelled,
+                        r.start,
+                        r.end,
+                        r.until,
+                        r.all_day,
+                        r.floating,
+                        r.summary,
+                        r.location,
+                        r.description,
+                        r.rrule,
+                    ),
+                )?;
+            }
+            t.execute(
+                "INSERT OR IGNORE INTO calendar_indexed (msg_id) VALUES (?)",
+                (msg_id,),
+            )?;
+            Ok(())
+        })
+        .await
+}
+
+/// Indexes calendar messages that are not indexed yet: messages from before this index existed
+/// and attachments that finished downloading after they were received.
+///
+/// ponytail: runs a full `msgs` scan per calendar query; move it to housekeeping (and index at
+/// download completion) once reminders need the index without the calendar being opened.
+async fn reconcile(context: &Context) -> Result<()> {
+    let ids: Vec<MsgId> = context
+        .sql
+        .query_map_vec(
+            &format!(
+                "SELECT id FROM msgs WHERE chat_id>? AND {MAYBE_CALENDAR}
+                 AND id NOT IN (SELECT msg_id FROM calendar_indexed)"
+            ),
+            (DC_CHAT_ID_LAST_SPECIAL,),
+            |row| Ok(row.get::<_, MsgId>(0)?),
+        )
+        .await?;
+    for id in ids {
+        index_msg(context, id).await.log_err(context).ok();
+    }
+    Ok(())
+}
+
+/// Removes index entries of deleted messages. Called from housekeeping.
+pub(crate) async fn prune(context: &Context) -> Result<()> {
+    for table in ["calendar_events", "calendar_indexed"] {
+        context
+            .sql
+            .execute(
+                &format!(
+                    "DELETE FROM {table} WHERE msg_id NOT IN (SELECT id FROM msgs WHERE chat_id!=?)"
+                ),
+                (DC_CHAT_ID_TRASH,),
+            )
+            .await?;
+    }
+    Ok(())
+}
+
+/// Returns the occurrences of calendar events overlapping `[from, to)`, sorted by start.
+///
+/// If one event (`UID`) arrived several times, e.g. as an invitation and later updates, only the
+/// version with the highest `SEQUENCE` (then the newest message) is returned.
+/// `chat_id` limits the result to one chat.
+pub async fn get_events(
+    context: &Context,
+    chat_id: Option<ChatId>,
+    from: i64,
+    to: i64,
+) -> Result<Vec<CalendarEvent>> {
+    reconcile(context).await?;
+    let chat_filter = chat_id.map_or(0, |c| c.to_u32());
+    // All versions of every event that has some row in the (widened) range.
+    let rows: Vec<(MsgId, ChatId, Row)> = context
+        .sql
+        .query_map_vec(
+            "SELECT e.msg_id, m.chat_id, e.uid, e.recurrence_id, e.sequence, e.cancelled,
+                    e.start, e.end, e.until, e.all_day, e.floating,
+                    e.summary, e.location, e.description, e.rrule
+             FROM calendar_events e JOIN msgs m ON m.id=e.msg_id
+             WHERE m.chat_id>?1 AND (?2=0 OR m.chat_id=?2) AND e.uid IN (
+               SELECT e2.uid FROM calendar_events e2 JOIN msgs m2 ON m2.id=e2.msg_id
+               WHERE m2.chat_id>?1 AND (?2=0 OR m2.chat_id=?2)
+                 AND e2.start<?3 AND e2.until>?4)",
+            (
+                DC_CHAT_ID_LAST_SPECIAL,
+                chat_filter,
+                to.saturating_add(FLOATING_SLACK),
+                from.saturating_sub(FLOATING_SLACK),
+            ),
+            |row| {
+                Ok((
+                    row.get(0)?,
+                    row.get(1)?,
+                    Row {
+                        uid: row.get(2)?,
+                        recurrence_id: row.get(3)?,
+                        sequence: row.get(4)?,
+                        cancelled: row.get(5)?,
+                        start: row.get(6)?,
+                        end: row.get(7)?,
+                        until: row.get(8)?,
+                        all_day: row.get(9)?,
+                        floating: row.get(10)?,
+                        summary: row.get(11)?,
+                        location: row.get(12)?,
+                        description: row.get(13)?,
+                        rrule: row.get(14)?,
+                    },
+                ))
+            },
+        )
+        .await?;
+    Ok(expand(rows, from, to))
+}
+
+/// Picks the current version of each event and expands recurring ones within `[from, to)`.
+fn expand(rows: Vec<(MsgId, ChatId, Row)>, from: i64, to: i64) -> Vec<CalendarEvent> {
+    let mut latest: HashMap<(String, i64), (MsgId, ChatId, Row)> = HashMap::new();
+    for (msg_id, chat_id, row) in rows {
+        let key = (row.uid.clone(), row.recurrence_id);
+        let newer = latest
+            .get(&key)
+            .is_none_or(|(m, _, r)| (row.sequence, msg_id) > (r.sequence, *m));
+        if newer {
+            latest.insert(key, (msg_id, chat_id, row));
+        }
+    }
+    // Occurrences replaced by a RECURRENCE-ID override are not generated from the series.
+    let overridden: HashSet<(String, i64)> = latest
+        .keys()
+        .filter(|(_, rid)| *rid != 0)
+        .cloned()
+        .collect();
+
+    let mut events = Vec::new();
+    for (msg_id, chat_id, r) in latest.into_values() {
+        let duration = r.end - r.start;
+        let slack = if r.floating { FLOATING_SLACK } else { 0 };
+        let starts = match r.rrule.as_deref().and_then(|s| RRuleSet::from_str(s).ok()) {
+            Some(set) => set
+                .after(utc(from.saturating_sub(duration + slack)))
+                .before(utc(to.saturating_add(slack)))
+                .all(MAX_OCCURRENCES)
+                .dates
+                .iter()
+                .map(|d| d.timestamp())
+                .filter(|s| !overridden.contains(&(r.uid.clone(), *s)))
+                .collect(),
+            None => vec![r.start],
+        };
+        for start in starts {
+            if start < to.saturating_add(slack) && start + duration > from.saturating_sub(slack) {
+                events.push(CalendarEvent {
+                    msg_id,
+                    chat_id,
+                    uid: r.uid.clone(),
+                    summary: r.summary.clone(),
+                    location: r.location.clone(),
+                    description: r.description.clone(),
+                    start,
+                    end: start + duration,
+                    all_day: r.all_day,
+                    floating: r.floating,
+                    cancelled: r.cancelled,
+                    recurring: r.rrule.is_some() || r.recurrence_id != 0,
+                });
+            }
+        }
+    }
+    events.sort_by(|a, b| (a.start, &a.uid).cmp(&(b.start, &b.uid)));
+    events
+}
+
+/// Returns the chats having calendar events, with the number of distinct events in each.
+pub async fn get_chats(context: &Context) -> Result<Vec<(ChatId, usize)>> {
+    reconcile(context).await?;
+    context
+        .sql
+        .query_map_vec(
+            "SELECT m.chat_id, COUNT(DISTINCT e.uid) FROM calendar_events e
+             JOIN msgs m ON m.id=e.msg_id WHERE m.chat_id>? GROUP BY m.chat_id",
+            (DC_CHAT_ID_LAST_SPECIAL,),
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .await
+}
+
+/// Sends `event` as an `.ics` attachment to `chat_id`, with `text` as message text.
+pub async fn send_event(
+    context: &Context,
+    chat_id: ChatId,
+    event: &NewCalendarEvent,
+    text: Option<String>,
+) -> Result<MsgId> {
+    let ics = build_ics(event, &format!("{}@slothfulchat", create_id()), time())?;
+    let mut msg = Message::new(Viewtype::File);
+    msg.set_text(text.unwrap_or_default());
+    msg.set_file_from_bytes(context, "event.ics", ics.as_bytes(), Some("text/calendar"))?;
+    let msg_id = chat::send_msg(context, chat_id, &mut msg).await?;
+    index_msg(context, msg_id).await?;
+    Ok(msg_id)
+}
+
+fn build_ics(e: &NewCalendarEvent, uid: &str, now: i64) -> Result<String> {
+    anyhow::ensure!(e.end >= e.start, "event ends before it starts");
+    let date_time = |ts: i64| -> Result<DatePerhapsTime> {
+        let dt = DateTime::from_timestamp(ts, 0).context("timestamp out of range")?;
+        Ok(if e.all_day {
+            DatePerhapsTime::Date(dt.date_naive())
+        } else if let Some(tz) = e
+            .timezone
+            .as_deref()
+            .and_then(|t| t.parse::<chrono_tz::Tz>().ok())
+        {
+            CalendarDateTime::WithTimezone {
+                date_time: dt.with_timezone(&tz).naive_local(),
+                tzid: tz.name().to_string(),
+            }
+            .into()
+        } else {
+            CalendarDateTime::Utc(dt).into()
+        })
+    };
+    let mut ev = icalendar::Event::new();
+    ev.uid(uid)
+        .timestamp(DateTime::from_timestamp(now, 0).context("bad now")?)
+        .summary(&e.summary)
+        .starts(date_time(e.start)?)
+        .ends(date_time(e.end)?);
+    if !e.location.is_empty() {
+        ev.location(&e.location);
+    }
+    if !e.description.is_empty() {
+        ev.description(&e.description);
+    }
+    if let Some(rrule) = e.rrule.as_deref().filter(|r| !r.is_empty()) {
+        // Validated here so we never send a rule other clients choke on.
+        RRule::<Unvalidated>::from_str(rrule).context("invalid RRULE")?;
+        ev.add_property("RRULE", rrule);
+    }
+    let mut cal = Calendar::new();
+    cal.append_property(("METHOD", "PUBLISH")).push(ev.done());
+    Ok(cal.done().to_string())
+}
+
+/// Parses all `VEVENT`s of an iCalendar file. Unparseable events are skipped.
+fn parse_ics(text: &str) -> Vec<Row> {
+    let Ok(cal) = Calendar::from_str(text) else {
+        return Vec::new();
+    };
+    let method_cancel = cal
+        .property_value("METHOD")
+        .is_some_and(|m| m.eq_ignore_ascii_case("CANCEL"));
+    // (TZID, TZOFFSETTO of its STANDARD part) of each VTIMEZONE.
+    let timezones: Vec<(String, String)> = cal
+        .components
+        .iter()
+        .filter_map(|c| match c {
+            icalendar::CalendarComponent::Other(o) if o.component_kind() == "VTIMEZONE" => Some((
+                o.property_value("TZID")?.to_string(),
+                o.components()
+                    .iter()
+                    .find(|c| c.component_kind() == "STANDARD")?
+                    .property_value("TZOFFSETTO")?
+                    .to_string(),
+            )),
+            _ => None,
+        })
+        .collect();
+    cal.events()
+        .filter_map(|ev| parse_event(ev, method_cancel, &timezones))
+        .collect()
+}
+
+fn parse_event(
+    ev: &icalendar::Event,
+    method_cancel: bool,
+    timezones: &[(String, String)],
+) -> Option<Row> {
+    let uid = ev.get_uid()?.to_string();
+    let prop_dt = |key: &str| {
+        let p = ev.properties().get(key)?;
+        let tzid = p.params().get("TZID").map(|t| t.value());
+        parse_dt(p.value(), tzid, timezones)
+    };
+    let (start, all_day, floating) = prop_dt("DTSTART")?;
+    let end = match prop_dt("DTEND") {
+        Some((end, ..)) => end.timestamp(),
+        None => match ev.property_value("DURATION").and_then(parse_duration) {
+            Some(d) => start.timestamp() + d,
+            None if all_day => start.timestamp() + 86400,
+            None => start.timestamp(),
+        },
+    }
+    .max(start.timestamp());
+    let duration = end - start.timestamp();
+
+    let rrule = ev.property_value("RRULE").and_then(|rule| {
+        let exdates = ev
+            .multi_properties()
+            .get("EXDATE")
+            .into_iter()
+            .flatten()
+            .chain(ev.properties().get("EXDATE"))
+            .flat_map(|p| {
+                let tzid = p.params().get("TZID").map(|t| t.value());
+                p.value()
+                    .split(',')
+                    // In UTC: rrule's Display writes any EXDATE as wall-clock digits plus 'Z'.
+                    .filter_map(|v| {
+                        parse_dt(v, tzid, timezones).map(|d| d.0.with_timezone(&Tz::UTC))
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .collect();
+        RRule::<Unvalidated>::from_str(rule)
+            .ok()?
+            .build(start)
+            .ok()
+            .map(|set| set.set_exdates(exdates))
+    });
+    let until = match &rrule {
+        Some(set) => {
+            let r = set.clone().all(MAX_OCCURRENCES);
+            match r.dates.last() {
+                Some(last) if !r.limited => last.timestamp() + duration,
+                Some(_) => i64::MAX,
+                None => end,
+            }
+        }
+        None => end,
+    };
+
+    let text = |key: &str| ev.property_value(key).map(unescape).unwrap_or_default();
+    Some(Row {
+        uid,
+        recurrence_id: prop_dt("RECURRENCE-ID").map_or(0, |d| d.0.timestamp()),
+        sequence: ev.get_sequence().unwrap_or(0).into(),
+        cancelled: method_cancel
+            || ev
+                .property_value("STATUS")
+                .is_some_and(|s| s.eq_ignore_ascii_case("CANCELLED")),
+        start: start.timestamp(),
+        end,
+        until,
+        all_day,
+        floating,
+        summary: text("SUMMARY"),
+        location: text("LOCATION"),
+        description: text("DESCRIPTION"),
+        rrule: rrule.map(|s| s.to_string()),
+    })
+}
+
+fn utc(ts: i64) -> DateTime<Tz> {
+    // Clamped to ±30000 years so any client-supplied range is representable.
+    const LIMIT: i64 = 30_000 * 366 * 86400;
+    Tz::UTC.from_utc_datetime(
+        &DateTime::from_timestamp(ts.clamp(-LIMIT, LIMIT), 0)
+            .unwrap_or_default()
+            .naive_utc(),
+    )
+}
+
+/// Parses an iCalendar DATE or DATE-TIME. Returns the instant (in the event's time zone, so
+/// recurrences keep their wall-clock time over DST changes), whether it is a DATE and whether
+/// it is floating (wall-clock time encoded as UTC).
+fn parse_dt(
+    value: &str,
+    tzid: Option<&str>,
+    timezones: &[(String, String)],
+) -> Option<(DateTime<Tz>, bool, bool)> {
+    let value = value.trim();
+    if let Ok(date) = NaiveDate::parse_from_str(value, "%Y%m%d") {
+        return Some((
+            Tz::UTC.from_utc_datetime(&date.and_hms_opt(0, 0, 0)?),
+            true,
+            true,
+        ));
+    }
+    if let Some(v) = value.strip_suffix('Z') {
+        let naive = NaiveDateTime::parse_from_str(v, "%Y%m%dT%H%M%S").ok()?;
+        return Some((Tz::UTC.from_utc_datetime(&naive), false, false));
+    }
+    let naive = NaiveDateTime::parse_from_str(value, "%Y%m%dT%H%M%S").ok()?;
+    match tzid.and_then(|t| resolve_tz(t, timezones)) {
+        Some(tz) => Some((tz.from_local_datetime(&naive).earliest()?, false, false)),
+        None => Some((Tz::UTC.from_utc_datetime(&naive), false, true)),
+    }
+}
+
+/// Maps a `TZID` to a time zone: IANA names directly, the Windows names Outlook/Exchange use
+/// via a table, anything else via the fixed standard offset of the file's `VTIMEZONE`.
+fn resolve_tz(tzid: &str, timezones: &[(String, String)]) -> Option<Tz> {
+    // Some producers prefix the TZID with a path, e.g. "/mozilla.org/20050126_1/Europe/Berlin".
+    let name = tzid.trim_matches('"');
+    let iana = name
+        .parse::<chrono_tz::Tz>()
+        .ok()
+        .or_else(|| {
+            let (_, tail) = name.split_once('/')?;
+            let parts: Vec<&str> = tail.split('/').collect();
+            (0..parts.len()).find_map(|i| parts[i..].join("/").parse::<chrono_tz::Tz>().ok())
+        })
+        .or_else(|| {
+            WINDOWS_ZONES
+                .iter()
+                .find(|(win, _)| win.eq_ignore_ascii_case(name))
+                .and_then(|(_, iana)| iana.parse().ok())
+        });
+    if let Some(tz) = iana {
+        return Some(tz.into());
+    }
+    // ponytail: fixed offset, so events in unknown zones are an hour off during DST and
+    // half-hour offsets fall back to UTC; add VTIMEZONE transition rules if that shows up.
+    let (_, offset) = timezones.iter().find(|(id, _)| id == tzid)?;
+    let (sign, digits) = offset.split_at(1);
+    let hours: i32 = digits.get(..2)?.parse().ok()?;
+    if digits.get(2..4) != Some("00") {
+        return None;
+    }
+    // Etc/GMT zones have inverted signs: Etc/GMT-1 is UTC+1.
+    let name = match (sign, hours) {
+        (_, 0) => "Etc/UTC".to_string(),
+        ("+", h) => format!("Etc/GMT-{h}"),
+        (_, h) => format!("Etc/GMT+{h}"),
+    };
+    name.parse::<chrono_tz::Tz>().ok().map(Into::into)
+}
