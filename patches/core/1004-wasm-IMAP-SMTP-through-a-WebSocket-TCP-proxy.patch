+/// wasm: tokio-wasm-shim's `TcpStream` is the WebSocket-proxy tunnel.
+#[cfg(target_arch = "wasm32")]
+impl SessionStream for TcpStream {
+    fn set_read_timeout(&mut self, _timeout: Option<Duration>) {
+        // ponytail: no per-read timeouts on the tunneled stream; callers'
+        // tokio::time::timeout (wasmtimer on wasm) covers the hang case.
+    }
+
+    fn peer_addr(&self) -> Result<SocketAddr> {
+        Ok(TcpStream::peer_addr(self)?)
+    }
+}
 impl SessionStream for Pin<Box<TimeoutStream<TcpStream>>> {
     fn set_read_timeout(&mut self, timeout: Option<Duration>) {
         self.as_mut().set_read_timeout_pinned(timeout);
