+//! Payload codecs and the worker-side dispatcher for offloaded PGP operations.
+//!
+//! On wasm, heavy PGP work is handed to a JS-side worker pool via
+//! `tokio::offload` (see the tokio facade). Call sites encode their arguments
+//! with the `encode_*` functions below; the worker (another instance of this
+//! crate compiled to wasm) runs [`handle_op`] and returns the reply bytes.
+//! Both sides live in this module so the wire format cannot diverge.
+//!
+//! Wire format: ops start with 0-2 raw flag/meta bytes, followed by
+//! length-prefixed fields (`[u32 LE length][bytes]`). Keys travel in core's
+//! sqlite serialization ([`DcKey::to_bytes`] / [`DcKey::from_slice`]).
+//! The crypto bodies reuse core's own functions, nothing is reimplemented.
+
+use std::io::Cursor;
+
+use anyhow::{Context as _, Result, bail, ensure};
+use deltachat_contact_tools::EmailAddress;
+use pgp::composed::{FullSignaturePacket, Message, PlainSessionKey, TheRing};
+use pgp::crypto::sym::SymmetricKeyAlgorithm;
+use pgp::packet::{LiteralData, PacketTrait as _};
+
+use crate::key::{DcKey, SignedPublicKey, SignedSecretKey};
+use crate::pgp::{SeipdVersion, create_keypair, pk_encrypt_sync, symm_encrypt_message};
+
+/// Appends a `[u32 LE length][bytes]` field to `out`.
+pub fn push_field(out: &mut Vec<u8>, field: &[u8]) {
+    let len = u32::try_from(field.len()).expect("offload field fits in u32");
+    out.extend_from_slice(&len.to_le_bytes());
+    out.extend_from_slice(field);
+}
+
+/// Takes the next `[u32 LE length][bytes]` field off the front of `p`.
+pub fn next_field<'a>(p: &mut &'a [u8]) -> Result<&'a [u8]> {
+    let (len, rest) = p
+        .split_first_chunk::<4>()
+        .context("truncated field length")?;
+    let len = u32::from_le_bytes(*len) as usize;
+    ensure!(rest.len() >= len, "truncated field");
+    let (field, rest) = rest.split_at(len);
+    *p = rest;
+    Ok(field)
+}
+
+/// Encodes a `pk_encrypt` payload:
+/// `[flags 1B: bit0 compress, bit1 seipd_v2][seckey][plain][pubkey]*`.
+pub fn encode_pk_encrypt(
+    private_key_for_signing: &SignedSecretKey,
+    plain: &[u8],
+    public_keys_for_encryption: &[SignedPublicKey],
+    compress: bool,
+    seipd_version: &SeipdVersion,
+) -> Vec<u8> {
+    let mut flags = 0u8;
+    if compress {
+        flags |= 1;
+    }
+    if matches!(seipd_version, SeipdVersion::V2) {
+        flags |= 2;
+    }
+    let mut out = vec![flags];
+    push_field(&mut out, &DcKey::to_bytes(private_key_for_signing));
+    push_field(&mut out, plain);
+    for key in public_keys_for_encryption {
+        push_field(&mut out, &DcKey::to_bytes(key));
+    }
+    out
+}
+
+/// Encodes a `symm_encrypt` payload:
+/// `[flags 1B: bit0 compress, bit1 has_sign_key][shared_secret][plain][sign_key iff bit1]`.
+pub fn encode_symm_encrypt(
+    shared_secret: &str,
+    plain: &[u8],
+    sign_key: Option<&SignedSecretKey>,
+    compress: bool,
+) -> Vec<u8> {
+    let mut flags = 0u8;
+    if compress {
+        flags |= 1;
+    }
+    if sign_key.is_some() {
+        flags |= 2;
+    }
+    let mut out = vec![flags];
+    push_field(&mut out, shared_secret.as_bytes());
+    push_field(&mut out, plain);
+    if let Some(key) = sign_key {
+        push_field(&mut out, &DcKey::to_bytes(key));
+    }
+    out
+}
+
+/// Encodes a `decrypt_keys` payload: `[ctext armored][seckey]*`.
+pub fn encode_decrypt_keys(ctext: &[u8], secret_keys: &[SignedSecretKey]) -> Vec<u8> {
+    let mut out = Vec::new();
+    push_field(&mut out, ctext);
+    for key in secret_keys {
+        push_field(&mut out, &DcKey::to_bytes(key));
+    }
+    out
+}
+
+/// Encodes a `decrypt_psk` payload:
+/// `[version_tag 1B (3/5/6)][sym_alg 1B (tag 3 only)][session key][ctext armored]`.
+pub fn encode_decrypt_psk(psk: &PlainSessionKey, ctext: &[u8]) -> Vec<u8> {
+    let (tag, alg, key): (u8, u8, &[u8]) = match psk {
+        PlainSessionKey::V3_4 { sym_alg, key } => (3, (*sym_alg).into(), key.as_ref()),
+        PlainSessionKey::V5 { key } => (5, 0, key.as_ref()),
+        PlainSessionKey::V6 { key } => (6, 0, key.as_ref()),
+    };
+    let mut out = vec![tag, alg];
+    push_field(&mut out, key);
+    push_field(&mut out, ctext);
+    out
+}
+
+/// Dispatches an offloaded PGP operation. Runs inside the worker.
+pub fn handle_op(op: &str, payload: &[u8]) -> Result<Vec<u8>> {
+    match op {
+        "keygen" => {
+            let addr = EmailAddress::new(str::from_utf8(payload)?)?;
+            let secret = create_keypair(addr)?;
+            Ok(DcKey::to_bytes(&secret))
+        }
+        "pk_encrypt" => {
+            let (&flags, mut p) = payload.split_first().context("empty pk_encrypt payload")?;
+            let seckey = SignedSecretKey::from_slice(next_field(&mut p)?)?;
+            let plain = next_field(&mut p)?.to_vec();
+            let mut pubkeys = Vec::new();
+            while !p.is_empty() {
+                pubkeys.push(SignedPublicKey::from_slice(next_field(&mut p)?)?);
+            }
+            let seipd_version = match flags & 2 != 0 {
+                true => SeipdVersion::V2,
+                false => SeipdVersion::V1,
+            };
+            let armored = pk_encrypt_sync(plain, pubkeys, seckey, flags & 1 != 0, seipd_version)?;
+            Ok(armored.into_bytes())
+        }
+        "symm_encrypt" => {
+            let (&flags, mut p) = payload
+                .split_first()
+                .context("empty symm_encrypt payload")?;
+            let shared_secret = str::from_utf8(next_field(&mut p)?)?.to_string();
+            let plain = next_field(&mut p)?.to_vec();
+            let sign_key = match flags & 2 != 0 {
+                true => Some(SignedSecretKey::from_slice(next_field(&mut p)?)?),
+                false => None,
+            };
+            let armored = symm_encrypt_message(plain, sign_key, shared_secret, flags & 1 != 0)?;
+            Ok(armored.into_bytes())
+        }
+        "decrypt_keys" => {
+            let mut p = payload;
+            let ctext = next_field(&mut p)?;
+            let mut secret_keys = Vec::new();
+            while !p.is_empty() {
+                secret_keys.push(SignedSecretKey::from_slice(next_field(&mut p)?)?);
+            }
+            let secret_keys: Vec<&SignedSecretKey> = secret_keys.iter().collect();
+            let ring = TheRing {
+                secret_keys,
+                decrypt_options: crate::decrypt::decrypt_options(),
+                ..Default::default()
+            };
+            decrypt_reencode(ctext, ring)
+        }
+        "decrypt_psk" => {
+            let (meta, mut p) = payload
+                .split_first_chunk::<2>()
+                .context("truncated decrypt_psk payload")?;
+            let [tag, sym_alg] = *meta;
+            let key = next_field(&mut p)?.to_vec();
+            let ctext = next_field(&mut p)?;
+            let psk = match tag {
+                3 => PlainSessionKey::V3_4 {
+                    sym_alg: SymmetricKeyAlgorithm::from(sym_alg),
+                    key: key.into(),
+                },
+                5 => PlainSessionKey::V5 { key: key.into() },
+                6 => PlainSessionKey::V6 { key: key.into() },
+                v => bail!("unknown session key version tag {v}"),
+            };
+            let ring = TheRing {
+                session_keys: vec![psk],
+                decrypt_options: crate::decrypt::decrypt_options(),
+                ..Default::default()
+            };
+            decrypt_reencode(ctext, ring)
+        }
+        _ => bail!("unknown offload op {op:?}"),
+    }
+}
+
+/// Parses the armored ciphertext, decrypts it (same calls, and the same
+/// shared options, as the inline closures in `crate::decrypt::decrypt`) and
+/// re-encodes the plain message so it can cross the JS boundary as bytes.
+fn decrypt_reencode(ctext: &[u8], ring: TheRing<'_>) -> Result<Vec<u8>> {
+    let (msg, _headers) = Message::from_armor(Cursor::new(ctext.to_vec()))?;
+    reencode_plain(crate::decrypt::decrypt_ring(msg, ring)?)
+}
+
+/// Re-encodes a decrypted [`Message`] at the packet level; rPGP has no
+/// serializer for `Message`, which is a streaming reader.
+///
+/// Reading the data to the end finalizes the running signature hashes, then
+/// the literal packet is rebuilt from the data (preserving the file name; the
+/// literal header is not covered by OpenPGP signatures) and written between
+/// the one-pass-signature/signature packets in their original structure, so
+/// that core-side `Message::from_bytes` + `verify` sees identical hashes.
+fn reencode_plain(mut plain: Message<'_>) -> Result<Vec<u8>> {
+    let file_name = plain
+        .literal_data_header()
+        .map(|h| h.file_name().clone())
+        .unwrap_or_default();
+    // Reads the message to the end, finalizing signature hashes.
+    let data = plain.as_data_vec()?;
+    let literal = LiteralData::from_bytes(file_name, data.into())?;
+
+    let mut out = Vec::new();
+    match &plain {
+        Message::Literal { .. } => {
+            literal.to_writer_with_header(&mut out)?;
+        }
+        // ponytail: only the outermost signature layer is re-encoded. Nested
+        // `Signed` sources (a signed-inside-signed plaintext) lose their inner
+        // signatures — harmless while consumers only read index 0 of the outer
+        // reader (mimeparser's `signature(0)`, `verify` = `verify_nested(0)`);
+        // if anything ever calls `verify_nested()` deeper, recurse here.
+        Message::Signed { reader, .. } => {
+            let sigs = reader
+                .signatures()
+                .context("signatures not finalized after reading message")?;
+            // Prefix packets (one-pass-signature and old-style signature
+            // packets) in their original parse order, ...
+            for sig in sigs {
+                match sig {
+                    FullSignaturePacket::Ops { ops, .. } => ops.to_writer_with_header(&mut out)?,
+                    FullSignaturePacket::Signature { signature } => {
+                        signature.to_writer_with_header(&mut out)?
+                    }
+                }
+            }
+            // ... then the literal data, ...
+            literal.to_writer_with_header(&mut out)?;
+            // ... then the trailing signatures of the one-pass signatures in
+            // reverse (innermost one-pass signature closed first).
+            for sig in sigs.iter().rev() {
+                if let FullSignaturePacket::Ops { signature, .. } = sig {
+                    signature.to_writer_with_header(&mut out)?;
+                }
+            }
+        }
+        // ponytail: inline decryption tolerated other shapes as garbage bytes;
+        // mimeparser treats this error the same way (warn + not decryptable).
+        _ => bail!("unsupported decrypted message shape for offload"),
+    }
+    Ok(out)
+}
+
