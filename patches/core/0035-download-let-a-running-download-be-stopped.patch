+    /// An aborted download is dequeued, offers the download button again and
+    /// stops the running chunk loop before its next fetch.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_abort_download() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let (t, msg_id) = real_msg_id(&mut tcm).await?;
+        let mid = Message::load_from_db(&t, msg_id)
+            .await?
+            .rfc724_mid()
+            .to_string();
+        msg_id
+            .update_download_state(&t, DownloadState::Available)
+            .await?;
+        msg_id.download_full(&t).await?;
+        assert!(download_contains(&t, &mid).await?);
+
+        msg_id.abort_download(&t).await?;
+        assert!(!download_contains(&t, &mid).await?);
+        let state = Message::load_from_db(&t, msg_id).await?.download_state();
+        assert_eq!(state, DownloadState::Available);
+
+        let mut staging = open_staging(&t, 1).await;
+        let fetcher = FakeFetcher::new(fake_message(1000));
+        let calls = fetcher.calls_handle();
+        let outcome = chunked_fetch_loop(
+            &t,
+            &mut staging,
+            None,
+            Some(msg_id),
+            Some(&mid),
+            tools::time_now(),
+            fetcher,
+        )
+        .await?;
+        assert!(matches!(outcome, ChunkOutcome::Yielded));
+        assert!(calls.lock().unwrap().is_empty());
+
+        // Aborting what is not downloading is a no-op.
+        msg_id
+            .update_download_state(&t, DownloadState::Done)
+            .await?;
+        msg_id.abort_download(&t).await?;
+        let state = Message::load_from_db(&t, msg_id).await?.download_state();
+        assert_eq!(state, DownloadState::Done);
+
+        // A queued auto-download stays `Available` with its row present
+        // (msg_id 0, see imap.rs) and must run, not be taken for aborted.
+        msg_id
+            .update_download_state(&t, DownloadState::Available)
+            .await?;
+        t.sql
+            .execute(
+                "INSERT INTO download (rfc724_mid, msg_id) VALUES (?,0)",
+                (&mid,),
+            )
+            .await?;
+        let data = fake_message(1000);
+        let mut staging = open_staging(&t, 2).await;
+        let outcome = chunked_fetch_loop(
+            &t,
+            &mut staging,
+            None,
+            Some(msg_id),
+            Some(&mid),
+            tools::time_now(),
+            FakeFetcher::new(data.clone()),
+        )
+        .await?;
+        assert!(matches!(outcome, ChunkOutcome::Complete(body) if body == data));
+        Ok(())
+    }
