+/// Returns the number of contact requests, see `DC_CHAT_ID_REQUESTS_LINK`.
+pub async fn get_request_cnt(context: &Context) -> Result<usize> {
+    context
+        .sql
+        .count(
+            "SELECT COUNT(*) FROM chats WHERE id>9 AND blocked=?;",
+            (Blocked::Request,),
+        )
+        .await
