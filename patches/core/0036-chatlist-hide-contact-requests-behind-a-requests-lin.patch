+/// Returns the number of unarchived contact requests, see `DC_CHAT_ID_REQUESTS_LINK`.
+/// Archived requests stay in the archive, like any archived chat.
+pub async fn get_request_cnt(context: &Context) -> Result<usize> {
+    context
+        .sql
+        .count(
+            "SELECT COUNT(*) FROM chats WHERE id>9 AND blocked=? AND archived!=?;",
+            (Blocked::Request, ChatVisibility::Archived),
+        )
+        .await
