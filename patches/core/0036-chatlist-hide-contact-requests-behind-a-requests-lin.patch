+    /// A non-contact cloning a group again and again only grows the requests link.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_requests_link_cloned_groups() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let alice = &tcm.alice().await;
+        let bob = &tcm.bob().await;
+        let own = create_group(bob, "own").await?;
+
+        let mut requests = vec![];
+        for name in ["clone 1", "clone 2", "clone 3"] {
+            let chat_id = alice.create_group_with_members(name, &[bob]).await;
+            let msg = bob.recv_msg(&alice.send_text(chat_id, "hi").await).await;
+            requests.push(msg.chat_id);
+        }
+
+        let chats = Chatlist::try_load(bob, DC_GCL_NO_REQUESTS, None, None).await?;
+        assert_eq!(
+            chats.iter().map(|(id, _)| *id).collect::<Vec<_>>(),
+            [DC_CHAT_ID_REQUESTS_LINK, own]
+        );
+        assert_eq!(get_request_cnt(bob).await?, 3);
+        assert_eq!(
+            Chatlist::try_load(bob, 0, Some("is:request"), None)
+                .await?
+                .len(),
+            3
+        );
+        let chats = Chatlist::try_load(bob, 0, Some("clone 2 is:request"), None).await?;
+        assert_eq!(chats.len(), 1);
+        assert_eq!(chats.get_chat_id(0)?, requests[1]);
+
+        // The unread filter alone keeps requests behind the link; search text finds them.
+        let chats = Chatlist::try_load(bob, DC_GCL_NO_REQUESTS, Some("is:unread"), None).await?;
+        assert_eq!(chats.len(), 0);
+        let chats = Chatlist::try_load(bob, DC_GCL_NO_REQUESTS, Some("clone"), None).await?;
+        assert_eq!(chats.len(), 3);
+
+        marknoticed_chat(bob, requests[0]).await?;
+        let chats = Chatlist::try_load(bob, 0, Some("is:unread is:request"), None).await?;
+        assert_eq!(chats.len(), 2);
+        assert!(chats.get_index_for_id(requests[0]).is_none());
+
+        requests[0].accept(bob).await?;
+        requests[1].block(bob).await?;
+        assert_eq!(get_request_cnt(bob).await?, 1);
+        let chats = Chatlist::try_load(bob, DC_GCL_NO_REQUESTS, None, None).await?;
+        assert_eq!(chats.get_chat_id(0)?, DC_CHAT_ID_REQUESTS_LINK);
+        assert!(chats.get_index_for_id(requests[0]).is_some());
+        assert!(chats.get_index_for_id(requests[1]).is_none());
+
+        requests[2].accept(bob).await?;
+        assert_eq!(get_request_cnt(bob).await?, 0);
+        let chats = Chatlist::try_load(bob, DC_GCL_NO_REQUESTS, None, None).await?;
+        assert!(chats.get_index_for_id(DC_CHAT_ID_REQUESTS_LINK).is_none());
+        assert_eq!(chats.len(), 3);
+        Ok(())
+    }
