+/// Long message text is stored in full: it is not turned into an HTML message, it survives a
+/// database round trip, the chatlist only gets a bounded preview of it, and it stays editable.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_long_text_is_stored_in_full() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+
+    // Well over 38 lines and over DC_DESIRED_TEXT_LEN chars.
+    let long_txt = "this text with 42 chars is just repeated.\n".repeat(200);
+    assert!(long_txt.len() > constants::DC_DESIRED_TEXT_LEN);
+    let sent = alice
+        .send_text(alice.create_chat(bob).await.id, &long_txt)
+        .await;
+
+    // Bob gets the full text as text, not as an HTML message, and it round-trips through the db.
+    let rcvd = bob.recv_msg(&sent).await;
+    assert!(!rcvd.has_html());
+    assert_eq!(rcvd.get_text(), long_txt.trim_end());
+    let reloaded = Message::load_from_db(bob, rcvd.id).await?;
+    assert_eq!(reloaded.get_text(), long_txt.trim_end());
+
+    // The chatlist row is a preview, not the whole message.
+    let chatlist = Chatlist::try_load(bob, 0, None, None).await?;
+    let summary = chatlist.get_summary(bob, 0, None).await?;
+    assert!(summary.text.chars().count() <= constants::DC_DESIRED_TEXT_LEN + DC_ELLIPSIS.len());
+    assert!(summary.truncated_text(500).chars().count() <= 500 + DC_ELLIPSIS.len());
+
+    // Alice's own copy is still editable; this used to fail with "Cannot edit HTML messages".
+    let alice_msg = sent.load_from_db().await;
+    assert_eq!(alice_msg.get_text(), long_txt);
+    send_edit_request(alice, alice_msg.id, "short now".to_string()).await?;
+    assert_eq!(
+        Message::load_from_db(alice, alice_msg.id).await?.get_text(),
+        "short now"
+    );
+
+    Ok(())
+}
+
