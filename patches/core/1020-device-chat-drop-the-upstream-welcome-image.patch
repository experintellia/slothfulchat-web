From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Tue, 4 Aug 2026 22:04:50 +0000
Subject: [PATCH] device-chat: drop the upstream welcome image
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The image core adds to the device chat before the welcome text is Delta
Chat branding, and this is a fork that already renames every
self-referential mention — so a fresh account opened with someone else's
logo. Drop the image message until we have our own.

The "core-welcome-image" label is untouched, so dropping our own file in
here later still works exactly as before. Also drops the include_bytes!
of the jpg from the wasm bundle.
---
 src/message/message_tests.rs | 14 +++++++++++++-
 src/stock_str.rs             | 12 +++---------
 2 files changed, 16 insertions(+), 10 deletions(-)

diff --git a/src/message/message_tests.rs b/src/message/message_tests.rs
index 85e096d3bbcbc03df700d0d38c87289e95932a8a..35b1650f9b5163916e599ec8ee0dbb4cb81a5681 100644
--- a/src/message/message_tests.rs
+++ b/src/message/message_tests.rs
@@ -30,8 +30,20 @@ async fn test_get_width_height() {
     let t = TestContext::new_alice().await;
 
     // test that get_width() and get_height() are returning some dimensions for images;
-    // (as the device-chat contains a welcome-images, we check that)
+    // the device chat has no welcome image in this fork, so add one there
     t.update_device_chats().await.ok();
+    let mut image = Message::new(Viewtype::Image);
+    image
+        .set_file_from_bytes(
+            &t,
+            "welcome-image.jpg",
+            include_bytes!("../../assets/welcome-image.jpg"),
+            None,
+        )
+        .unwrap();
+    chat::add_device_msg(&t, None, Some(&mut image))
+        .await
+        .unwrap();
     let device_chat_id = ChatId::get_for_contact(&t, ContactId::DEVICE)
         .await
         .unwrap();
diff --git a/src/stock_str.rs b/src/stock_str.rs
index cd93315f234974823ab8c5800214082b44ead3bc..f6bcb27d5070f0070108a04b84f0e82c4c025231 100644
--- a/src/stock_str.rs
+++ b/src/stock_str.rs
@@ -9,13 +9,11 @@
 use strum_macros::EnumProperty;
 
 use crate::accounts::Accounts;
-use crate::blob::BlobObject;
 use crate::chat::{self, Chat, ChatId};
 use crate::config::Config;
 use crate::contact::{Contact, ContactId};
 use crate::context::Context;
 use crate::message::{Message, Viewtype};
-use crate::param::Param;
 
 /// Storage for string translations.
 #[derive(Debug, Clone)]
@@ -1267,13 +1265,9 @@ pub(crate) async fn update_device_chats(&self) -> Result<()> {
 
         // add welcome-messages. by the label, this is done only once,
         // if the user has deleted the message or the chat, it is not added again.
-        let image = include_bytes!("../assets/welcome-image.jpg");
-        let blob = BlobObject::create_and_deduplicate_from_bytes(self, image, "welcome.jpg")?;
-        let mut msg = Message::new(Viewtype::Image);
-        msg.param.set(Param::File, blob.as_name());
-        msg.param.set(Param::Filename, "welcome-image.jpg");
-        chat::add_device_msg(self, Some("core-welcome-image"), Some(&mut msg)).await?;
-
+        // The upstream welcome image is Delta Chat branding and this is a fork,
+        // so it stays out until we have our own; the "core-welcome-image" label
+        // is untouched, so dropping our own file in here later still works.
         let mut msg = Message::new_text(welcome_message(self));
         chat::add_device_msg(self, Some("core-welcome"), Some(&mut msg)).await?;
         Ok(())
