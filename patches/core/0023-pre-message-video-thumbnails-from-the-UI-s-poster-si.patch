+    /// Video with a `<blob>-preview.jpg` sidecar: the poster becomes the thumbnail.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_build_from_video_msg_with_preview() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let alice = &tcm.alice().await;
+
+        let mut video_msg = Message::new(Viewtype::Video);
+        video_msg.set_file_from_bytes(alice, "clip.mp4", &vec![0u8; 1_000_000], None)?;
+        // What the UI writes next to the blob after grabbing a frame.
+        let blob = video_msg.get_file(alice).expect("video has a file");
+        tokio::fs::write(video_preview_path(blob), create_test_image(1080, 1920)?).await?;
+
+        let post_msg_metadata = PostMsgMetadata::from_msg(alice, &video_msg)
+            .await?
+            .expect("video has a file");
+        let thumbnail = post_msg_metadata.thumbnail.expect("poster becomes thumbnail");
+        decode_thumbnail(&thumbnail);
+        Ok(())
+    }
+
