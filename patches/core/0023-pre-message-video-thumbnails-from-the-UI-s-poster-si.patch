diff --git a/src/blob.rs b/src/blob.rs
index 5cf5c2e..cd0e145 100644
--- a/src/blob.rs
+++ b/src/blob.rs
@@ -725,6 +725,20 @@ fn encode_img(
     Ok(())
 }
 
+/// Suffix of the poster a UI may write next to a video blob, as `<blobname>-preview.jpg`.
+///
+/// Core cannot decode video frames, so a video preview can only come from the UI. Housekeeping
+/// keeps a sidecar with this suffix alive for as long as its parent blob is in use, which is why
+/// the poster needs no `Param` of its own and is GCed together with the video.
+pub(crate) const VIDEO_PREVIEW_SUFFIX: &str = "-preview.jpg";
+
+/// Path of the sidecar poster belonging to the video blob at `path`.
+pub(crate) fn video_preview_path(path: PathBuf) -> PathBuf {
+    let mut path = path.into_os_string();
+    path.push(VIDEO_PREVIEW_SUFFIX);
+    path.into()
+}
