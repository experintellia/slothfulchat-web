From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Sat, 17 Jan 2026 16:26:58 +0100
Subject: [PATCH] don't emit changed on joining broadcast

Patch-Range: upstream-fix
---
 src/securejoin/bob.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/securejoin/bob.rs b/src/securejoin/bob.rs
index bd4388105abda11d47104100350c3a2160006bb0..7e83ee1145484bf585722817ec5012fb877d8b3e 100644
--- a/src/securejoin/bob.rs
+++ b/src/securejoin/bob.rs
@@ -283,7 +283,8 @@ pub(super) async fn handle_auth_required_or_pubkey(
             .await?;
 
         match invite {
-            QrInvite::Contact { .. } | QrInvite::Broadcast { .. } => {
+            QrInvite::Broadcast { .. } => {}
+            QrInvite::Contact { .. } => {
                 // This is to tell UI that Chat.can_send has changed
                 context.emit_event(EventType::ChatModified(chat_id));
             }
