+/// SQL condition: the message aliased `m` is a deliberate reply — it carries a
+/// quote (`Param::Quote`, key 'q') and is not forwarded (`Param::Forwarded`,
+/// key 'a'). `mime_in_reply_to` alone does not mark a reply — it is set on
+/// *every* outgoing message for email threading (see `prepare_msg_raw`).
+///
+/// `param` is `key=value` lines, and a newline *inside* a value is stored
+/// doubled, so a real key line starts the string or follows a single `\n`
+/// that comes after a non-newline character. Matching a bare `\nq=` would
+/// also hit quoted text with a line starting `q=` or `a=`.
+// ponytail: GLOB can't count newline parity, so a value that itself *ends*
+// in `\n` right before the q/a line still hides that line. No field stored
+// before 'a' or 'q' carries such text in practice; if one ever does, filter
+// candidate rows in Rust with `Params::from_str` instead.
+fn is_reply_sql(m: &str) -> String {
+    format!(
+        "({m}.param GLOB 'q=*' OR {m}.param GLOB '*[^\n]\nq=*')
+         AND NOT ({m}.param GLOB 'a=*' OR {m}.param GLOB '*[^\n]\na=*')"
+    )
+}
+
+/// SQL condition: message `c` is a reply to message `p` — the one link used
+/// for counts, for walking up to a thread's root and for walking down from
+/// it, so all three always agree.
+///
+/// `mime_in_reply_to` holds the raw In-Reply-To header (`<mid>`) for incoming
+/// messages but the bare mid for outgoing ones, so both forms match. The
+/// `trim` equality lets the upward step find `p` through the `rfc724_mid`
+/// index; the `IN` keeps the link exactly as strict as the downward step,
+/// which finds `c` through the `mime_in_reply_to` index. `p.rfc724_mid!=''`
+/// keeps messages without a Message-ID from matching every empty header.
+/// The unary `+` keeps SQLite off the `chat_id` index, and the queries
+/// below join with `CROSS JOIN`, which pins SQLite's join order to the
+/// written one: from the known message to its neighbour through one of the
+/// two Message-ID indexes. Left to itself the planner turns joins around or
+/// scans all of `msgs` depending on table statistics — 100x slower on a long
+/// chain or a large database.
+/// Threads stay within one chat, so "reply privately" answers are not part
+/// of them; hidden messages (drafts) never are.
+fn reply_link_sql(c: &str, p: &str) -> String {
+    format!(
+        "{p}.rfc724_mid!='' AND {p}.rfc724_mid=trim({c}.mime_in_reply_to, '<>')
+         AND {c}.mime_in_reply_to IN ({p}.rfc724_mid, '<'||{p}.rfc724_mid||'>')
+         AND +{c}.chat_id=+{p}.chat_id AND +{c}.hidden=0
+         AND {reply}",
+        reply = is_reply_sql(c)
+    )
+}
+
+/// Returns, for each of the given messages that has replies, the number of
+/// all replies below it — direct replies and, recursively, replies to those.
+///
+/// Messages without replies are left out of the map. One query for any number
+/// of messages, so a message list can ask for everything it shows at once.
+pub async fn get_reply_counts(
+    context: &Context,
+    msg_ids: &[MsgId],
+) -> Result<BTreeMap<MsgId, usize>> {
+    if msg_ids.is_empty() {
+        return Ok(BTreeMap::new());
+    }
+    // Plain integers, so formatting them into the query is safe (as in sync.rs).
+    let ids = msg_ids
+        .iter()
+        .map(|id| id.to_u32().to_string())
+        .collect::<Vec<_>>()
+        .join(",");
+    // One walk down from all given messages at once, collecting each reply
+    // link once (`UNION` deduplicates, which also ends reference cycles), so
+    // the cost is the size of the union of their subtrees. Walking each
+    // message's subtree separately in SQL cost (messages × subtree): over a
+    // second for a page near the top of a long reply chain.
+    let links: Vec<(MsgId, Option<MsgId>)> = context
+        .sql
+        .query_map_vec(
+            &format!(
+                "WITH RECURSIVE below(id, parent) AS (
+                     SELECT id, NULL FROM msgs WHERE id IN ({ids}) AND chat_id!=?1
+                     UNION
+                     SELECT c.id, p.id FROM below b
+                       CROSS JOIN msgs p ON p.id=b.id
+                       CROSS JOIN msgs c ON {link}
+                 )
+                 SELECT id, parent FROM below",
+                link = reply_link_sql("c", "p")
+            ),
+            (DC_CHAT_ID_TRASH,),
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .await?;
+    let mut children: BTreeMap<MsgId, Vec<MsgId>> = BTreeMap::new();
+    for (id, parent) in links {
+        if let Some(parent) = parent {
+            children.entry(parent).or_default().push(id);
+        }
+    }
+    // In memory, a walk per message is cheap; the visited set counts a reply
+    // reachable on two paths once and stops at cycles.
+    let mut counts = BTreeMap::new();
+    for &origin in msg_ids {
+        let mut seen = BTreeSet::from([origin]);
+        let mut stack = vec![origin];
+        while let Some(id) = stack.pop() {
+            for &child in children.get(&id).into_iter().flatten() {
+                if seen.insert(child) {
+                    stack.push(child);
+                }
+            }
+        }
+        // `seen` holds the origin itself plus its replies.
+        let replies = seen.len().saturating_sub(1);
+        if replies > 0 {
+            counts.insert(origin, replies);
+        }
+    }
+    Ok(counts)
+}
+
+/// Returns the reply thread the given message belongs to: its root and all
+/// replies below the root (any depth and branching), as `(message, parent)`
+/// pairs sorted by (timestamp, id). The root's parent is `None`; every other
+/// parent is a message of the returned thread, so a UI can lay the pairs out
+/// as a tree.
+///
+/// The root is the topmost message reached by walking up the reply link from
+/// the given message; if the walk up ends in a cycle (which takes colliding
+/// Message-IDs), the oldest message the walk reached. Where a message has
+/// more than one parent (same cause), the oldest one counts, which keeps a
+/// reply from hanging below its own descendant. Returns an empty list if the
+/// message does not exist or is deleted.
+pub async fn get_reply_thread(
+    context: &Context,
+    msg_id: MsgId,
+) -> Result<Vec<(MsgId, Option<MsgId>)>> {
+    let link = reply_link_sql("c", "p");
+    context
+        .sql
+        .query_map_vec(
+            // Both recursions use `UNION`, so reference cycles terminate.
+            &format!(
+                "WITH RECURSIVE
+                 up(id) AS (
+                     SELECT ?1
+                     UNION
+                     SELECT p.id FROM up
+                       CROSS JOIN msgs c ON c.id=up.id
+                       CROSS JOIN msgs p ON {link}
+                 ),
+                 root(id) AS (
+                     SELECT r.id FROM up CROSS JOIN msgs r ON r.id=up.id
+                     WHERE r.chat_id!=?2
+                     ORDER BY EXISTS (
+                         SELECT 1 FROM msgs c CROSS JOIN msgs p ON {link} WHERE c.id=r.id
+                     ), r.timestamp, r.id
+                     LIMIT 1
+                 ),
+                 down(id, parent) AS (
+                     SELECT id, NULL FROM root
+                     UNION
+                     SELECT c.id, p.id FROM down d
+                       CROSS JOIN msgs p ON p.id=d.id
+                       CROSS JOIN msgs c ON {link}
+                 )
+                 -- Bare `d.parent` comes from the row with the MIN(): the
+                 -- oldest parent, and NULL (-1) for the root, which the
+                 -- seed row gives no parent.
+                 SELECT m.id, d.parent, MIN(COALESCE(pm.timestamp, -1))
+                 FROM down d
+                 CROSS JOIN msgs m ON m.id=d.id
+                 LEFT JOIN msgs pm ON pm.id=d.parent
+                 GROUP BY m.id
+                 ORDER BY m.timestamp, m.id"
+            ),
+            (msg_id, DC_CHAT_ID_TRASH),
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .await
+}
+
