diff --git a/src/sql/migrations.rs b/src/sql/migrations.rs
index 1ba18ce..e4ff13b 100644
--- a/src/sql/migrations.rs
+++ b/src/sql/migrations.rs
@@ -2456,6 +2456,18 @@ pub async fn run(context: &Context, sql: &Sql) -> Result<bool> {
         .await?;
     }
 
+    // slothfulchat: index for reverse In-Reply-To lookups (reply counts and
+    // reply threads). Deliberately not a numbered migration: the fork must not
+    // claim a version number upstream will use next — a database already at
+    // that number would silently skip upstream's real migration. `IF NOT
+    // EXISTS` makes this a no-op after the first run, and the `slothfulchat_`
+    // prefix keeps the name clear of upstream's indexes.
+    sql.execute(
+        "CREATE INDEX IF NOT EXISTS slothfulchat_msgs_index_in_reply_to ON msgs (mime_in_reply_to)",
+        (),
+    )
+    .await?;
+
     let new_version = sql
         .get_raw_config_int(VERSION_CFG)
         .await?
