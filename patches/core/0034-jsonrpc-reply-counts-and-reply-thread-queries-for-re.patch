+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_reply_count_and_thread() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let alice_chat = alice.create_chat(bob).await;
+    bob.create_chat(alice).await;
+
+    // A: root message from Alice.
+    let sent_a = alice.send_text(alice_chat.id, "A").await;
+    let a = sent_a.sender_msg_id;
+
+    // B: Bob replies to A; on Alice's side this arrives via receive_imf,
+    // so `mime_in_reply_to` holds the bracketed raw In-Reply-To header.
+    let a_bob = bob.recv_msg(&sent_a).await;
+    let mut b_bob = Message::new_text("B".to_string());
+    b_bob.set_quote(bob, Some(&a_bob)).await?;
+    chat::send_msg(bob, a_bob.chat_id, &mut b_bob).await?;
+    let b = alice.recv_msg(&bob.pop_sent_msg().await).await;
+    let raw_in_reply_to: String = alice
+        .sql
+        .query_get_value("SELECT mime_in_reply_to FROM msgs WHERE id=?", (b.id,))
+        .await?
+        .unwrap();
+    assert!(raw_in_reply_to.starts_with('<')); // bracketed form is what we test here
+
+    // C: Alice replies to B (outgoing reply stores the bare mid).
+    let mut c = Message::new_text("C".to_string());
+    c.set_quote(alice, Some(&b)).await?;
+    chat::send_msg(alice, alice_chat.id, &mut c).await?;
+
+    // D: unrelated message.
+    let d = alice.send_text(alice_chat.id, "D").await.sender_msg_id;
+
+    let counts = get_reply_counts(alice, &[a, b.id, c.id, d]).await?;
+    assert_eq!(counts, BTreeMap::from([(a, 2), (b.id, 1)]));
+
+    let thread = vec![(a, None), (b.id, Some(a)), (c.id, Some(b.id))];
+    for &(msg_id, _) in &thread {
+        assert_eq!(get_reply_thread(alice, msg_id).await?, thread);
+    }
+    assert_eq!(get_reply_thread(alice, d).await?, vec![(d, None)]);
+
+    // E: a second reply to A makes the thread branch.
+    let e = reply(alice, alice_chat.id, a, "E").await?;
+    assert_eq!(
+        get_reply_counts(alice, &[a, b.id]).await?,
+        BTreeMap::from([(a, 3), (b.id, 1)])
+    );
+    assert_eq!(
+        get_reply_thread(alice, c.id).await?,
+        vec![(a, None), (b.id, Some(a)), (c.id, Some(b.id)), (e, Some(a))]
+    );
+
+    // A deleted message has no thread.
+    delete_msgs(alice, &[d]).await?;
+    assert_eq!(get_reply_thread(alice, d).await?, vec![]);
+
+    Ok(())
+}
+
+/// Sends a text message from `t` that quote-replies to `parent`.
+async fn reply(t: &TestContext, chat_id: ChatId, parent: MsgId, text: &str) -> Result<MsgId> {
+    let mut msg = Message::new_text(text.to_string());
+    msg.set_quote(t, Some(&Message::load_from_db(t, parent).await?))
+        .await?;
+    chat::send_msg(t, chat_id, &mut msg).await
+}
+
+/// Quoted text with a line starting `a=` or `q=` must not pass for the
+/// message's own Forwarded/Quote param: it is stored as a continuation line.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_reply_thread_multiline_quote() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let chat_id = alice.create_chat(bob).await.id;
+
+    let x = alice.send_text(chat_id, "x\na=1\nq=2").await.sender_msg_id;
+    let y = reply(alice, chat_id, x, "Y").await?;
+    let z = reply(alice, chat_id, y, "Z").await?;
+    let y_param: String = alice
+        .sql
+        .query_get_value("SELECT param FROM msgs WHERE id=?", (y,))
+        .await?
+        .unwrap();
+    assert!(y_param.contains("\n\na=1")); // the case under test is really stored
+
+    assert_eq!(
+        get_reply_counts(alice, &[x, y]).await?,
+        BTreeMap::from([(x, 2), (y, 1)])
+    );
+    let thread = vec![(x, None), (y, Some(x)), (z, Some(y))];
+    for &(msg_id, _) in &thread {
+        assert_eq!(get_reply_thread(alice, msg_id).await?, thread);
+    }
+    Ok(())
+}
+
+/// A reply chain longer than any fixed walk-up cap still resolves to its
+/// first message, and a reply cycle terminates.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_reply_thread_long_chain_and_cycle() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let chat_id = alice.create_chat(bob).await.id;
+
+    let first = alice.send_text(chat_id, "0").await.sender_msg_id;
+    let mut chain = vec![first];
+    for i in 1..=120 {
+        chain.push(reply(alice, chat_id, *chain.last().unwrap(), &i.to_string()).await?);
+    }
+    let thread = get_reply_thread(alice, *chain.last().unwrap()).await?;
+    assert_eq!(thread.len(), chain.len());
+    assert_eq!(thread[0], (first, None));
+    assert_eq!(
+        get_reply_counts(alice, &[first]).await?,
+        BTreeMap::from([(first, 120)])
+    );
+
+    // Make the first message a reply to the last one: a cycle.
+    let last_mid: String = alice
+        .sql
+        .query_get_value("SELECT rfc724_mid FROM msgs WHERE id=?", (chain[120],))
+        .await?
+        .unwrap();
+    alice
+        .sql
+        .execute(
+            "UPDATE msgs SET mime_in_reply_to=?, param='q=120\n'||param WHERE id=?",
+            (last_mid, first),
+        )
+        .await?;
+    let thread = get_reply_thread(alice, chain[60]).await?;
+    assert_eq!(thread.len(), chain.len());
+    assert_eq!(thread[0], (first, None)); // oldest message of the cycle is the root
+    // Every parent is older than its reply: none hangs below its own descendant.
+    for (i, (_, parent)) in thread.iter().enumerate().skip(1) {
+        assert!(thread[..i].iter().any(|(id, _)| Some(*id) == *parent));
+    }
+    assert_eq!(
+        get_reply_counts(alice, &[chain[60]]).await?,
+        BTreeMap::from([(chain[60], 120)])
+    );
+    Ok(())
+}
+
