From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slothfulchat <patches@slothfulchat.invalid>
Date: Mon, 16 Nov 2026 10:06:26 +0100
Subject: [PATCH] wasm: open account databases with the worker storage key

---
 src/accounts.rs | 22 ++++++++++++++++------
 src/imex.rs     |  9 +++++++++
 2 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/src/accounts.rs b/src/accounts.rs
index 0a8e9f7378fc8bf57759ddeb741427a0b714356d..6df24537143dd08028dbdaf9de1726235f8e8244 100644
--- a/src/accounts.rs
+++ b/src/accounts.rs
@@ -56,6 +56,20 @@ pub struct Accounts {
     background_fetch_interrupt_sender: Arc<parking_lot::Mutex<Option<Sender<()>>>>,
 }
 
+async fn open_account_db(ctx: &Context) -> Result<()> {
+    #[cfg(target_arch = "wasm32")]
+    if let Some(key) = tokio::fs::storage_db_key() {
+        ensure!(
+            ctx.open(key.to_string()).await?,
+            "encrypted account could not be opened"
+        );
+        return Ok(());
+    }
+    // A password-protected native account can still be unlocked by its caller.
+    ctx.open(String::new()).await?;
+    Ok(())
+}
+
 impl Accounts {
     /// Loads or creates an accounts folder at the given `dir`.
     pub async fn new(dir: PathBuf, writable: bool) -> Result<Self> {
@@ -168,9 +182,7 @@ pub async fn add_account(&mut self) -> Result<u32> {
             .with_push_subscriber(self.push_subscriber.clone())
             .build()
             .await?;
-        // Try to open without a passphrase,
-        // but do not return an error if account is passphare-protected.
-        ctx.open("".to_string()).await?;
+        open_account_db(&ctx).await?;
 
         self.accounts.insert(account_config.id, ctx);
         self.emit_event(EventType::AccountsChanged);
@@ -796,9 +808,7 @@ pub async fn load_accounts(
                 .build()
                 .await
                 .with_context(|| format!("failed to create context from file {dbfile:?}"))?;
-            // Try to open without a passphrase,
-            // but do not return an error if account is passphare-protected.
-            ctx.open("".to_string()).await?;
+            open_account_db(&ctx).await?;
 
             accounts.insert(account_config.id, ctx);
         }
diff --git a/src/imex.rs b/src/imex.rs
index 531539dda278128c90d53d57c38611330fc249af..30d1e72a2fe4b12c272dd10a46835cf3eaed05bf 100644
--- a/src/imex.rs
+++ b/src/imex.rs
@@ -200,6 +200,11 @@ async fn import_backup(
     backup_to_import: &Path,
     passphrase: String,
 ) -> Result<()> {
+    #[cfg(target_arch = "wasm32")]
+    ensure!(
+        tokio::fs::storage_db_key().is_none(),
+        "backup import is unavailable with encrypted storage"
+    );
     let backup_file = File::open(backup_to_import).await?;
     let file_size = backup_file.metadata().await?.len();
     info!(
@@ -828,6 +833,10 @@ async fn export_database(
         passphrase.is_empty(),
         "encrypted backup export is not supported on wasm"
     );
+    ensure!(
+        tokio::fs::storage_db_key().is_none(),
+        "backup export is unavailable with encrypted storage"
+    );
     let timestamp = timestamp.try_into().context("32-bit UNIX time overflow")?;
     let dest_str = dest
         .to_str()
