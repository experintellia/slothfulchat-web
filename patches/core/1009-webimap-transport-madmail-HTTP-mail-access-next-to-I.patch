+/// Performs a single HTTP request via `fetch()`.
+///
+/// Returns the status code and the response body instead of failing
+/// on non-2xx responses. See `tokio::net::fetch` for `timeout` and
+/// `follow_redirects` semantics.
+pub(crate) async fn request(
+    _context: &Context,
+    method: &str,
+    url: &str,
+    headers: &[(&str, &str)],
+    body: Option<String>,
+    timeout: Duration,
+    follow_redirects: bool,
+) -> Result<(u16, Response)> {
+    let resp = fetch(method, url, headers, body, timeout, follow_redirects).await?;
+    let content_type = resp.content_type.and_then(|v| v.parse::<Mime>().ok());
+    let mimetype = content_type.as_ref().map(|m| m.essence_str().to_string());
+    let encoding = content_type
+        .as_ref()
+        .and_then(|m| m.get_param(mime::CHARSET))
+        .map(|c| c.as_str().to_string());
+    Ok((
+        resp.status,
+        Response {
+            blob: resp.body,
+            mimetype,
+            encoding,
+        },
+    ))
+}
