+    /// Best-effort small preview JPEG (base64) for image-like, video and webxdc messages.
+    ///
+    /// A preview is never worth failing a send over, so every failure path warns and
+    /// yields `None`. Audio/File get no thumbnail.
+    async fn thumbnail(context: &Context, message: &Message) -> Option<String> {
+        let bytes = match message.viewtype {
+            Viewtype::Image | Viewtype::Gif | Viewtype::Sticker => {
+                let path = message.get_file(context)?;
+                // read_file is wasm-safe and warns on failure itself.
+                crate::tools::read_file(context, &path).await.ok()?
+            }
+            Viewtype::Video => {
+                // Core cannot decode video frames, so the poster is the `<blob>-preview.jpg`
+                // sidecar the UI writes next to the attachment. Housekeeping already keeps
+                // that name alive for as long as the video blob is in use (see `sql.rs`), so
+                // it needs no param of its own and is GCed together with the video.
+                let path = video_preview_path(message.get_file(context)?);
+                if !crate::tools::path_exists(&path) {
+                    // Videos from clients that write no sidecar are the normal case here.
+                    return None;
+                }
+                crate::tools::read_file(context, &path).await.ok()?
+            }
+            Viewtype::Webxdc => {
+                let info = message.get_webxdc_info(context).await.ok()?;
+                match message.get_webxdc_blob(context, &info.icon).await {
+                    Ok(bytes) => bytes,
+                    Err(err) => {
+                        warn!(context, "Thumbnail: failed to read webxdc icon: {err:#}.");
+                        return None;
+                    }
+                }
+            }
+            _ => return None,
+        };
+        match crate::blob::thumbnail_base64(context, &bytes) {
+            Ok(thumbnail) => thumbnail,
+            Err(err) => {
+                warn!(context, "Thumbnail: failed to encode preview: {err:#}.");
+                None
+            }
+        }
+    }
