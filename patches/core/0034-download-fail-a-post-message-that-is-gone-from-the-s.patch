+/// Where a post-message can be fetched from: `(uid, folder, transport_id)`.
+///
+/// The lookup spans every transport, preferring `transport_id`'s own row: a
+/// message that only exists on another transport is that transport's job, and
+/// must not be mistaken for one that is gone. Relays expire messages on their
+/// own schedules, so "not on this relay anymore" and "nowhere anymore" are
+/// different answers, and only the latter is `None`.
+async fn imap_location(
+    context: &Context,
+    rfc724_mid: &str,
+    transport_id: u32,
+) -> Result<Option<(u32, String, u32)>> {
+    context
+        .sql
+        .query_row_optional(
+            "SELECT uid, folder, transport_id FROM imap
+             WHERE rfc724_mid=? AND target!=''
+               AND transport_id IN (SELECT id FROM transports)
+             ORDER BY transport_id=? DESC LIMIT 1",
+            (&rfc724_mid, transport_id),
+            |row| {
+                let server_uid: u32 = row.get(0)?;
+                let server_folder: String = row.get(1)?;
+                let msg_transport_id: u32 = row.get(2)?;
+                Ok((server_uid, server_folder, msg_transport_id))
+            },
+        )
+        .await
+}
+
+/// Forgets a location the server proved it no longer serves — the probe found
+/// no such UID, or found it flagged `\Deleted` — and fails the message if that
+/// was the last place it could come from.
+///
+/// A relay that does not have the message anymore is the only proof we get
+/// that a post-message is gone rather than late: `available_post_msgs` cannot
+/// tell us, because `download_known_post_messages_without_pre_message` drops
+/// every entry whose pre-message is already here, which is every message the
+/// user can tap. Without this the stale row sends each fetch cycle back to the
+/// same relay, the probe fails the same way, and the bubble says
+/// "downloading" forever.
+///
+/// Another relay still holding a copy keeps the message queued: the next
+/// cycle's [`imap_location`] lookup finds that copy and downloads it from
+/// scratch (staging files are per transport, so nothing half-fetched from the
+/// first relay is mixed in). Only when no relay is left is the message set to
+/// `Failure` and dequeued, which puts the retry button back.
+///
+/// The probe runs before the chunked/whole-message split, so servers without
+/// partial FETCH get the same treatment; any other fetch error is not proof
+/// and only retries.
+async fn forget_imap_location(
+    context: &Context,
+    transport_id: u32,
+    folder: &str,
+    uidvalidity: u32,
+    uid: u32,
+    rfc724_mid: &str,
+) -> Result<()> {
+    context
+        .sql
+        .execute(
+            "DELETE FROM imap
+             WHERE transport_id=? AND folder=? AND uidvalidity=? AND uid=?",
+            (transport_id, folder, uidvalidity, uid),
+        )
+        .await?;
+    if imap_location(context, rfc724_mid, transport_id).await?.is_none() {
+        set_state_to_failure(context, rfc724_mid).await?;
+        delete_from_downloads(context, rfc724_mid).await?;
+    } else {
+        // Hand it to the relay that still has it now, not at its next IDLE
+        // wake-up, which can be minutes away.
+        context.scheduler.interrupt_inbox().await;
+    }
+    Ok(())
+}
+
+/// How long after its pre-message arrived a post-message that no relay has
+/// yet may still be on its way. The sender uploads the post-message after the
+/// pre-message, which for a large attachment on a slow link takes minutes.
+/// Inbox loops wake at least every IDLE timeout (5 minutes), so a post-message
+/// that never comes fails within about 15 minutes.
+const POST_MSG_GRACE_SECS: i64 = 10 * 60;
+
+/// Handles a queued post-message that no relay has a location for.
+///
+/// That is either one that has not arrived yet or one that is gone, and
+/// nothing tells them apart, so a fresh one is given time to arrive (it stays
+/// queued and `InProgress`) and an older one is failed and dequeued — waiting
+/// on the wrong one is a spinner that never ends. A relay that *proved* the
+/// message gone is handled by [`forget_imap_location`] without a grace.
+async fn fail_unlocatable_post_msg(context: &Context, rfc724_mid: &str) -> Result<()> {
+    if let Some(msg_id) = rfc724_mid_exists(context, rfc724_mid).await? {
+        let received = Message::load_from_db(context, msg_id)
+            .await?
+            .get_received_timestamp();
+        if tools::time() - received < POST_MSG_GRACE_SECS {
+            return Ok(());
+        }
+    }
+    set_state_to_failure(context, rfc724_mid).await?;
+    delete_from_downloads(context, rfc724_mid).await?;
+    Ok(())
+}
+
+/// Ends the queued downloads no relay has a location for, after their grace.
+///
+/// Called from the webimap loop: webimap fetches every message in full as it
+/// arrives and never serves the `download` queue, so without this a download
+/// tapped for a post-message that never reaches the relay spins forever.
+pub(crate) async fn expire_unlocatable_downloads(context: &Context) -> Result<()> {
+    let rfc724_mids = context
+        .sql
+        .query_map_vec("SELECT rfc724_mid FROM download", (), |row| {
+            let rfc724_mid: String = row.get(0)?;
+            Ok(rfc724_mid)
+        })
+        .await?;
+    for rfc724_mid in &rfc724_mids {
+        if imap_location(context, rfc724_mid, 0).await?.is_none() {
+            fail_unlocatable_post_msg(context, rfc724_mid).await?;
+        }
+    }
+    Ok(())
+}
