+    /// Records a message as sitting at `uid` in `transport_id`'s INBOX.
+    async fn add_imap_row(
+        t: &TestContext,
+        transport_id: u32,
+        rfc724_mid: &str,
+        uid: u32,
+    ) -> Result<()> {
+        t.sql
+            .execute(
+                "INSERT INTO imap (transport_id, rfc724_mid, folder, uid, uidvalidity, target)
+                 VALUES (?,?,'INBOX',?,1,'INBOX')",
+                (transport_id, rfc724_mid, uid),
+            )
+            .await?;
+        Ok(())
+    }
+
+    async fn download_contains(t: &TestContext, rfc724_mid: &str) -> Result<bool> {
+        Ok(t.sql
+            .query_get_value::<String>(
+                "SELECT rfc724_mid FROM download WHERE rfc724_mid=?",
+                (rfc724_mid,),
+            )
+            .await?
+            .is_some())
+    }
