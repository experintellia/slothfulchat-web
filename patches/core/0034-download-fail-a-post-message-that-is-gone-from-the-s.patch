             return Ok(());
         }
         if let Ok(Some(FetchMsgResult::Done)) = res {
+            // A fetch can end without moving the message on: receive_imf
+            // rejecting or trashing it, or a FETCH response without a body.
+            // The queue entry goes either way, so anything still in progress
+            // is failed here, once for every path, rather than left spinning.
+            set_state_to_failure(context, rfc724_mid).await?;
             delete_from_downloads(context, rfc724_mid).await?;
             delete_from_available_post_msgs(context, rfc724_mid).await?;
