+    /// A message another transport still holds must not look "gone": relays
+    /// expire messages on their own schedules, and only a message no transport
+    /// has a location for may be failed.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_imap_location_spans_transports() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let t = tcm.alice().await;
+        let mid = "post-msg@example.org";
+        let at = |uid: u32, transport_id: u32| Some((uid, "INBOX".to_string(), transport_id));
+
+        // Nowhere: the only case the caller may treat as failed.
+        assert!(imap_location(&t, mid, 1).await?.is_none());
+
+        // Only on the other relay: hands the download to that transport
+        // instead of failing it here.
+        add_imap_row(&t, 2, mid, 200).await?;
+        assert_eq!(imap_location(&t, mid, 1).await?, at(200, 2));
+
+        // On both: fetch from the transport whose loop is asking.
+        add_imap_row(&t, 1, mid, 100).await?;
+        assert_eq!(imap_location(&t, mid, 1).await?, at(100, 1));
+        assert_eq!(imap_location(&t, mid, 2).await?, at(200, 2));
+
+        // Our own row marked for deletion is not a location anymore, the other
+        // relay's row still is.
+        t.sql
+            .execute("UPDATE imap SET target='' WHERE transport_id=1", ())
+            .await?;
+        assert_eq!(imap_location(&t, mid, 1).await?, at(200, 2));
+
+        Ok(())
+    }
+
+    /// A relay proving it lost the message drops out; the message stays queued
+    /// for a relay that still has it, and fails — with no flag involved, since
+    /// `available_post_msgs` never survives for a message with a pre-message —
+    /// once the last one is gone.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_forget_imap_location() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let (t, msg_id) = real_msg_id(&mut tcm).await?;
+        let mid = "post-msg@example.org";
+        t.sql
+            .execute("UPDATE msgs SET rfc724_mid=? WHERE id=?", (mid, msg_id))
+            .await?;
+        msg_id
+            .update_download_state(&t, DownloadState::InProgress)
+            .await?;
+        t.sql
+            .execute(
+                "INSERT INTO download (rfc724_mid, msg_id) VALUES (?,?)",
+                (mid, msg_id),
+            )
+            .await?;
+        add_imap_row(&t, 1, mid, 100).await?;
+        add_imap_row(&t, 2, mid, 200).await?;
+        let state = async || -> Result<DownloadState> {
+            Ok(Message::load_from_db(&t, msg_id).await?.download_state())
+        };
+
+        // Relay 1 lost it, relay 2 still has it: keep it queued for relay 2.
+        forget_imap_location(&t, 1, "INBOX", 1, 100, mid).await?;
+        assert_eq!(imap_location(&t, mid, 1).await?.map(|l| l.2), Some(2));
+        assert_eq!(state().await?, DownloadState::InProgress);
+        assert!(download_contains(&t, mid).await?);
+
+        // The last relay lost it too: fail it, so the retry button shows.
+        forget_imap_location(&t, 2, "INBOX", 1, 200, mid).await?;
+        assert!(imap_location(&t, mid, 1).await?.is_none());
+        assert_eq!(state().await?, DownloadState::Failure);
+        assert!(!download_contains(&t, mid).await?);
+
+        Ok(())
+    }
