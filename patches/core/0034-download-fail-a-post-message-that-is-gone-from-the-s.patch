+/// Where a post-message can be fetched from: `(uid, folder, transport_id)`.
+///
+/// The lookup spans every transport, preferring `transport_id`'s own row: a
+/// message that only exists on another transport is that transport's job, and
+/// must not be mistaken for one that is gone. Relays expire messages on their
+/// own schedules, so "not on this relay anymore" and "nowhere anymore" are
+/// different answers, and only the latter is `None`.
+async fn imap_location(
+    context: &Context,
+    rfc724_mid: &str,
+    transport_id: u32,
+) -> Result<Option<(u32, String, u32)>> {
+    context
+        .sql
+        .query_row_optional(
+            "SELECT uid, folder, transport_id FROM imap
+             WHERE rfc724_mid=? AND target!=''
+             ORDER BY transport_id=? DESC LIMIT 1",
+            (&rfc724_mid, transport_id),
+            |row| {
+                let server_uid: u32 = row.get(0)?;
+                let server_folder: String = row.get(1)?;
+                let msg_transport_id: u32 = row.get(2)?;
+                Ok((server_uid, server_folder, msg_transport_id))
+            },
+        )
+        .await
+}
+
+/// Forgets a location the server proved it no longer serves: the re-probe
+/// found no such UID, so this row can only send the next attempt back to a
+/// relay that does not have the message.
+///
+/// Dropping it means a retry looks the message up afresh — reaching another
+/// relay's copy once messages are received on several — and when the last
+/// location is gone [`post_msg_location_unknown`] fails the message for good.
+/// Only the chunked path can prove this; the whole-message fallback cannot
+/// tell "gone" from "fetch failed", and leaves its row alone.
+async fn forget_imap_location(
+    context: &Context,
+    transport_id: u32,
+    folder: &str,
+    uidvalidity: u32,
+    uid: u32,
+) -> Result<()> {
+    context
+        .sql
+        .execute(
+            "DELETE FROM imap
+             WHERE transport_id=? AND folder=? AND uidvalidity=? AND uid=?",
+            (transport_id, folder, uidvalidity, uid),
+        )
+        .await?;
+    Ok(())
+}
+
+/// Handles a post-message whose IMAP location we do not know, on any transport
+/// (see [`imap_location`]).
+///
+/// If it was recorded as available, it was on the server and is gone now — a
+/// chatmail relay deletes messages, a UID gets expunged. That location never
+/// comes back, so the message is failed here and taken out of the download
+/// queue; otherwise every fetch cycle would retry it and the UI would show
+/// "downloading" forever. Pressing download again re-queues it, and if the
+/// message does reappear on the server, prefetch queues it by itself.
+///
+/// A post-message that has merely not arrived yet was never recorded as
+/// available; it keeps waiting in the queue as before.
+async fn post_msg_location_unknown(context: &Context, rfc724_mid: &str) -> Result<()> {
+    if available_post_msgs_contains_rfc724_mid(context, rfc724_mid).await? {
+        set_state_to_failure(context, rfc724_mid).await?;
+        delete_from_downloads(context, rfc724_mid).await?;
+    }
+    delete_from_available_post_msgs(context, rfc724_mid).await?;
+    Ok(())
+}
+
 async fn available_post_msgs_contains_rfc724_mid(
     context: &Context,
     rfc724_mid: &str,
@@ -914,6 +983,115 @@ async fn test_update_download_state() -> Result<()> {
         Ok(())
     }
 
+    /// Records a message as sitting at `uid` in `transport_id`'s INBOX.
+    async fn add_imap_row(
+        t: &TestContext,
+        transport_id: u32,
+        rfc724_mid: &str,
+        uid: u32,
+    ) -> Result<()> {
+        t.sql
+            .execute(
+                "INSERT INTO imap (transport_id, rfc724_mid, folder, uid, uidvalidity, target)
+                 VALUES (?,?,'INBOX',?,1,'INBOX')",
+                (transport_id, rfc724_mid, uid),
+            )
+            .await?;
+        Ok(())
+    }
+
+    async fn download_contains(t: &TestContext, rfc724_mid: &str) -> Result<bool> {
+        Ok(t.sql
+            .query_get_value::<String>(
+                "SELECT rfc724_mid FROM download WHERE rfc724_mid=?",
+                (rfc724_mid,),
+            )
+            .await?
+            .is_some())
+    }
+
+    /// A message another transport still holds must not look "gone": relays
+    /// expire messages on their own schedules, and only a message no transport
+    /// has a location for may be failed.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_imap_location_spans_transports() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let t = tcm.alice().await;
+        let mid = "post-msg@example.org";
+        let at = |uid: u32, transport_id: u32| Some((uid, "INBOX".to_string(), transport_id));
+
+        // Nowhere: the only case the caller may treat as failed.
+        assert!(imap_location(&t, mid, 1).await?.is_none());
+
+        // Only on the other relay: hands the download to that transport
+        // instead of failing it here.
+        add_imap_row(&t, 2, mid, 200).await?;
+        assert_eq!(imap_location(&t, mid, 1).await?, at(200, 2));
+
+        // On both: fetch from the transport whose loop is asking.
+        add_imap_row(&t, 1, mid, 100).await?;
+        assert_eq!(imap_location(&t, mid, 1).await?, at(100, 1));
+        assert_eq!(imap_location(&t, mid, 2).await?, at(200, 2));
+
+        // Our own row marked for deletion is not a location anymore, the other
+        // relay's row still is.
+        t.sql
+            .execute("UPDATE imap SET target='' WHERE transport_id=1", ())
+            .await?;
+        assert_eq!(imap_location(&t, mid, 1).await?, at(200, 2));
+
+        // A relay that proved it does not serve the message anymore drops out
+        // of the lookup, so a retry does not ask it again — and the last
+        // location leaving is what makes the message failable.
+        forget_imap_location(&t, 2, "INBOX", 1, 200).await?;
+        assert!(imap_location(&t, mid, 1).await?.is_none());
+
+        Ok(())
+    }
+
+    /// A post-message that is gone from the server must fail instead of being
+    /// retried forever, but one that has not arrived yet must keep waiting.
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn test_post_msg_location_unknown() -> Result<()> {
+        let mut tcm = TestContextManager::new();
+        let (t, msg_id) = real_msg_id(&mut tcm).await?;
+        let mid = "post-msg@example.org";
+        t.sql
+            .execute("UPDATE msgs SET rfc724_mid=? WHERE id=?", (mid, msg_id))
+            .await?;
+        msg_id
+            .update_download_state(&t, DownloadState::InProgress)
+            .await?;
+        t.sql
+            .execute(
+                "INSERT INTO download (rfc724_mid, msg_id) VALUES (?,?)",
+                (mid, msg_id),
+            )
+            .await?;
+
+        // Never seen on the server: it may still arrive, so it stays queued.
+        post_msg_location_unknown(&t, mid).await?;
+        assert_eq!(
+            Message::load_from_db(&t, msg_id).await?.download_state(),
+            DownloadState::InProgress
+        );
+        assert!(download_contains(&t, mid).await?);
+
+        // Was on the server, gone now: fail it and stop retrying.
+        t.sql
+            .execute("INSERT INTO available_post_msgs VALUES (?)", (mid,))
+            .await?;
+        post_msg_location_unknown(&t, mid).await?;
+        assert_eq!(
+            Message::load_from_db(&t, msg_id).await?.download_state(),
+            DownloadState::Failure
+        );
+        assert!(!download_contains(&t, mid).await?);
+        assert!(!available_post_msgs_contains_rfc724_mid(&t, mid).await?);
+
+        Ok(())
+    }
+
