+//! In-memory staging for encrypted restores and local storage upgrades.
+
+use std::collections::{HashMap, HashSet};
+use std::ffi::OsStr;
+use std::path::{Path, PathBuf};
+
+use anyhow::{Context as _, Result, ensure, format_err};
+use tokio::fs::{self, File};
+
+use super::{backup_stream_size, export_backup_stream, import_backup_stream_inner};
+use crate::blob::{BlobDirContents, VIDEO_PREVIEW_SUFFIX, file_hash};
+use crate::context::Context;
+use crate::param::{Param, Params};
+use crate::sql;
+use crate::tools::TempPathGuard;
+
+pub(super) fn workspace() -> TempPathGuard {
+    TempPathGuard::new(Path::new(fs::STORAGE_TRANSFER_DIR).join(uuid::Uuid::new_v4().to_string()))
+}
+
+fn opaque_name(name: &str, names: &HashMap<String, String>, partials: &HashSet<String>) -> String {
+    // Interrupted downloads have names derived from their IMAP identity.
+    if partials.contains(name) {
+        return name.to_owned();
+    }
+    for suffix in [".waveform", VIDEO_PREVIEW_SUFFIX] {
+        if let Some(base) = name.strip_suffix(suffix)
+            && let Some(replacement) = names.get(base)
+        {
+            return format!("{replacement}{suffix}");
+        }
+    }
+    names[name].clone()
+}
+
+pub(super) async fn finish_restore(context: &Context, blobs: &mut [PathBuf]) -> Result<()> {
+    let recode_avatar = context.sql.run_schema_migrations(context).await?;
+    publish_blobs(context, blobs).await?;
+    if recode_avatar {
+        context.sql.recode_migrated_avatar(context).await?;
+    }
+    Ok(())
+}
+
+async fn publish_blobs(context: &Context, blobs: &mut [PathBuf]) -> Result<()> {
+    let names: HashMap<_, _> = blobs
+        .iter()
+        .map(|path| {
+            let name = path.file_name().and_then(OsStr::to_str).context("Invalid blob name")?;
+            Ok((name.to_owned(), uuid::Uuid::new_v4().to_string()))
+        })
+        .collect::<Result<_>>()?;
+
+    let names = context
+        .sql
+        .transaction(move |tx| {
+            let partials = sql::pending_download_files(tx)?;
+            let names: HashMap<_, _> = names
+                .keys()
+                .map(|name| (name.clone(), opaque_name(name, &names, &partials)))
+                .collect();
+
+            for (table, keys) in [
+                ("msgs", &[Param::File, Param::Arg][..]),
+                ("chats", &[Param::ProfileImage][..]),
+                ("contacts", &[Param::ProfileImage][..]),
+            ] {
+                let ids = tx
+                    .prepare(&format!(
+                        "SELECT id FROM {table} WHERE instr(param, '$BLOBDIR/') > 0"
+                    ))?
+                    .query_map([], |row| row.get::<_, i64>(0))?
+                    .collect::<rusqlite::Result<Vec<_>>>()?;
+                let mut select = tx.prepare(&format!("SELECT param FROM {table} WHERE id=?"))?;
+                let mut update = tx.prepare(&format!("UPDATE {table} SET param=? WHERE id=?"))?;
+                for id in ids {
+                    let value: String = select.query_row([id], |row| row.get(0))?;
+                    let mut params: Params = value.parse()?;
+                    let mut changed = false;
+                    for key in keys {
+                        if let Some(name) = params.get(*key).and_then(|s| s.strip_prefix("$BLOBDIR/"))
+                            && let Some(replacement) = names.get(name)
+                            && name != replacement
+                        {
+                            if *key == Param::File && !params.exists(Param::Filename) {
+                                let filename = name.to_owned();
+                                params.set(Param::Filename, filename);
+                            }
+                            params.set(*key, format!("$BLOBDIR/{replacement}"));
+                            changed = true;
+                        }
+                    }
+                    if changed {
+                        update.execute((params.to_string(), id))?;
+                    }
+                }
+            }
+            for (table, column) in [("config", "value"), ("http_cache", "blobname")] {
+                let mut select = tx.prepare(&format!(
+                    "SELECT rowid, {column} FROM {table} WHERE {column} LIKE '$BLOBDIR/%'"
+                ))?;
+                let rows = select
+                    .query_map([], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, String>(1)?)))?
+                    .collect::<rusqlite::Result<Vec<_>>>()?;
+                let mut update = tx.prepare(&format!("UPDATE {table} SET {column}=? WHERE rowid=?"))?;
+                for (id, value) in rows {
+                    if let Some(old) = value.strip_prefix("$BLOBDIR/")
+                        && let Some(new) = names.get(old)
+                        && old != new
+                    {
+                        update.execute((format!("$BLOBDIR/{new}"), id))?;
+                    }
+                }
+            }
+            Ok(names)
+        })
+        .await?;
+    context.sql.config_cache.write().await.clear();
+
+    for path in blobs {
+        let name = path.file_name().and_then(OsStr::to_str).context("Invalid blob name")?;
+        let dest = context.get_blobdir().join(&names[name]);
+        ensure!(!fs::try_exists(&dest).await?, "Restored blob already exists");
+        fs::rename(&path, &dest).await?;
+        // The caller removes published files if a later operation fails.
+        *path = dest;
+    }
+    Ok(())
+}
+
+/// Copies an unencrypted account into a memory-only archive for storage upgrade.
+pub async fn export_storage_upgrade(context: &Context, destination: &Path) -> Result<()> {
+    ensure!(
+        fs::storage_db_key().is_none(),
+        "Upgrade source must be unencrypted"
+    );
+    ensure!(
+        destination.parent() == Some(Path::new(fs::STORAGE_TRANSFER_DIR)),
+        "Upgrade archive must remain in memory"
+    );
+    ensure!(
+        !context.scheduler.is_running().await,
+        "Stop account IO before upgrading storage"
+    );
+    let workspace = workspace();
+    fs::create_dir_all(&*workspace).await?;
+    let archive_db = workspace.join("dc.db");
+    let memory_db = format!("/storage-upgrade-{}.db", uuid::Uuid::new_v4());
+    let uri = format!("file:{memory_db}?vfs=memvfs&key=");
+    let result = context
+        .sql
+        .call_write(|conn| {
+            conn.execute("VACUUM INTO ?", [uri])?;
+            Ok(())
+        })
+        .await;
+    let bytes = fs::sqlite_mem_vfs_take(&memory_db);
+    result?;
+    fs::write(&archive_db, bytes.map_err(|e| format_err!("{e}"))?).await?;
+    let blobs = BlobDirContents::new(context).await?;
+    let size = backup_stream_size(&archive_db, &blobs).await?;
+    export_backup_stream(context, &archive_db, blobs, File::create(destination).await?, size).await
+}
+
+/// Imports a local storage upgrade, preserving the device state of the source account.
+pub async fn import_storage_upgrade(context: &Context, source: &Path) -> Result<()> {
+    ensure!(
+        fs::storage_db_key().is_some(),
+        "Upgrade destination requires encrypted storage"
+    );
+    ensure!(
+        !context.is_configured().await?,
+        "Upgrade destination is already configured"
+    );
+    ensure!(
+        !context.scheduler.is_running().await,
+        "Upgrade destination is running"
+    );
+    let archive = File::open(source).await?;
+    let size = archive.metadata().await?.len();
+    import_backup_stream_inner(context, archive, size, String::new(), true)
+        .await
+        .0
+}
+
+/// Checks the restored database and returns a digest to compare after reopening.
+pub async fn verify_storage_upgrade(context: &Context) -> Result<String> {
+    let (address, message_count, key_count): (String, i64, i64) = context.sql
+        .call(true, |conn| {
+            let check: String = conn.query_row("PRAGMA quick_check", [], |row| row.get(0))?;
+            ensure!(check == "ok", "Restored database failed integrity check: {check}");
+            Ok(conn.query_row(
+                "SELECT coalesce((SELECT value FROM config WHERE keyname='configured_addr'), ''),
+                        (SELECT count(*) FROM msgs),
+                        (SELECT count(*) FROM keypairs)",
+                [],
+                |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+            )?)
+        })
+        .await?;
+
+    let mut files = fs::read_dir(context.get_blobdir()).await?;
+    let mut checksums = Vec::new();
+    while let Some(entry) = files.next_entry().await? {
+        if entry.file_type().await?.is_file() {
+            let name = entry.file_name().into_string().map_err(|_| format_err!("Invalid blob name"))?;
+            let hash = file_hash(&entry.path())?;
+            checksums.push((name, hash));
+        }
+    }
+    checksums.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+    let mut digest = blake3::Hasher::new();
+    digest.update(&message_count.to_le_bytes());
+    digest.update(&key_count.to_le_bytes());
+    digest.update(address.as_bytes());
+    digest.update(&[0]);
+    for (name, hash) in checksums {
+        digest.update(name.as_bytes());
+        digest.update(&[0]);
+        digest.update(hash.as_bytes());
+    }
+    Ok(digest.finalize().to_hex().to_string())
+}
