+    // One entry per distinct sticker, the newest message.
+    assert_eq!(get_unsaved_sticker_msgs(&t, 10).await?, [second]);
+
+    let pack = create_pack(&t, "p").await?;
+    add_sticker_from_msg(&t, pack, first).await?;
+    assert!(get_unsaved_sticker_msgs(&t, 10).await?.is_empty());
+    Ok(())
+}
