+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_move_and_copy() -> Result<()> {
+    let t = TestContext::new_alice().await;
+    let a = create_pack(&t, "a").await?;
+    let b = create_pack(&t, "b").await?;
+    let sticker = add_sticker_from_msg(&t, a, send_sticker(&t).await?).await?;
+
+    let copy = copy_sticker(&t, sticker, b).await?;
+    assert_ne!(copy, sticker);
+    let counts = |p: Vec<StickerPack>| p.iter().map(|p| p.stickers.len()).collect::<Vec<_>>();
+    assert_eq!(counts(get_packs(&t).await?), [1, 1]);
+
+    // b already has it, so moving a's copy there just drops a's.
+    move_sticker(&t, sticker, b).await?;
+    assert_eq!(counts(get_packs(&t).await?), [0, 1]);
+
+    move_sticker(&t, copy, a).await?;
+    assert_eq!(counts(get_packs(&t).await?), [1, 0]);
+    Ok(())
+}
