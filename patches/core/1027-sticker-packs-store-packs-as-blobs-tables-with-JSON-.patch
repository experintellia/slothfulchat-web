+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_sticker_emojis() -> Result<()> {
+    let t = TestContext::new_alice().await;
+    let a = create_pack(&t, "a").await?;
+    let b = create_pack(&t, "b").await?;
+    let sticker = add_sticker_from_msg(&t, a, send_sticker(&t).await?).await?;
+    let emojis = |p: &[StickerPack], i: usize| p[i].stickers[0].emojis.clone();
+
+    let input: Vec<String> = [" 🐱 ", "", "😺", "🐱", &"x".repeat(33)]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+    set_sticker_emojis(&t, sticker, &input).await?;
+    assert_eq!(emojis(&get_packs(&t).await?, 0), ["🐱", "😺"]);
+
+    // Keyed by image: a copy shares them, a move keeps them.
+    copy_sticker(&t, sticker, b).await?;
+    assert_eq!(emojis(&get_packs(&t).await?, 1), ["🐱", "😺"]);
+    move_sticker(&t, sticker, b).await?;
+    assert_eq!(emojis(&get_packs(&t).await?, 1), ["🐱", "😺"]);
+
+    let many: Vec<String> = (0..20).map(|i| i.to_string()).collect();
+    let id = get_packs(&t).await?[1].stickers[0].id;
+    set_sticker_emojis(&t, id, &many).await?;
+    assert_eq!(emojis(&get_packs(&t).await?, 1).len(), MAX_EMOJIS);
+    set_sticker_emojis(&t, id, &[]).await?;
+    assert!(emojis(&get_packs(&t).await?, 1).is_empty());
+
+    // Another profile gets them with the pack.
+    set_sticker_emojis(&t, id, &["🐶".to_string()]).await?;
+    let to = TestContext::new().await;
+    let new = copy_pack_from(&to, &t, b).await?;
+    let packs = get_packs(&to).await?;
+    let copied = packs.iter().find(|p| p.id == new).unwrap();
+    assert_eq!(copied.stickers[0].emojis, ["🐶"]);
+    Ok(())
+}
