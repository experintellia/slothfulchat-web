+/// A pack folder with a file that can't be imported stays on disk, and
+/// concurrent or repeated migrations import nothing twice.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_migrate_sticker_folder_keeps_failures() -> Result<()> {
+    let t = TestContext::new().await;
+    let folder = t.get_dbfile().parent().unwrap().join("stickers");
+    tokio::fs::create_dir_all(folder.join("Fun")).await?;
+    tokio::fs::write(folder.join("Fun/1.gif"), GIF).await?;
+    tokio::fs::write(folder.join("Fun/2.png"), GIF).await?; // magic mismatch
+    let big = vec![0u8; MAX_STICKER_BYTES as usize + 1];
+    tokio::fs::write(folder.join("Fun/3.gif"), &big).await?;
+    tokio::fs::create_dir_all(folder.join("Ok")).await?;
+    tokio::fs::write(folder.join("Ok/1.gif"), GIF).await?;
+
+    let (a, b) = tokio::join!(get_packs(&t), get_packs(&t));
+    let (a, b) = (a?, b?);
+    assert_eq!(a, b);
+    let summary = |p: &[StickerPack]| {
+        p.iter()
+            .map(|p| (p.name.clone(), p.stickers.len()))
+            .collect::<Vec<_>>()
+    };
+    let expected = [("Fun".to_string(), 1), ("Ok".to_string(), 1)];
+    assert_eq!(summary(&a), expected);
+    assert!(folder.join("Fun/2.png").exists());
+    assert!(folder.join("Fun/3.gif").exists());
+    assert!(!folder.join("Ok").exists());
+
+    // Retrying adds nothing new.
+    assert_eq!(summary(&get_packs(&t).await?), expected);
+    assert!(folder.join("Fun/2.png").exists());
+    Ok(())
+}
