+//! # Sticker packs (slothfulchat fork)
+//!
+//! Upstream keeps saved stickers as plain files in `<account>/stickers/<pack>/`,
+//! outside the blobdir, so they are missing from backups and second-device
+//! transfers. Here a pack is a row in `slothfulchat_sticker_packs`, and each
+//! sticker is a row in `slothfulchat_stickers` that names an ordinary,
+//! deduplicated blob. Saving a received sticker therefore costs no bytes,
+//! sending one needs no copy, and packs travel with the database.
+//!
+//! The blobs are kept alive by one extra query in
+//! [`crate::sql::remove_unused_files`]; `sql_tests::test_housekeeping_keeps_sticker_pack_blobs`
+//! fails if a rebase drops it.
+//!
+//! FORK-ONLY: if upstream ever implements sticker packs, migrate these tables to
+//! upstream's storage instead of keeping both.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use anyhow::{Context as _, Result, bail, ensure};
+
+use crate::blob::BlobObject;
+use crate::constants::DC_CHAT_ID_LAST_SPECIAL;
+use crate::context::Context;
+use crate::log::warn;
+use crate::message::{Message, MsgId, Viewtype};
+use crate::param::{Param, Params};
+
+/// File types a sticker may have; the same list upstream's folder listing accepted.
+const STICKER_EXTENSIONS: [&str; 4] = ["png", "webp", "gif", "tgs"];
+
+/// Largest sticker file accepted. Signal stickers are a few hundred KiB, `.tgs`
+/// at most 64 KiB; the headroom is for GIFs.
+const MAX_STICKER_BYTES: u64 = 5 * 1024 * 1024;
+
+/// Most emojis kept per sticker, and longest one in bytes (a family emoji with
+/// skin tones is ~25 bytes); anything beyond is user input to drop.
+const MAX_EMOJIS: usize = 16;
+const MAX_EMOJI_BYTES: usize = 32;
+
+/// A sticker in a pack.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Sticker {
+    /// Row id, used to move, copy or remove it.
+    pub id: u32,
+    /// Absolute path of the blob.
+    pub path: String,
+    /// Emojis the sticker stands for, in the order they were set.
+    pub emojis: Vec<String>,
+}
+
+/// A sticker pack with its stickers, in the order they were added.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct StickerPack {
+    /// Row id.
+    pub id: u32,
+    /// Unique name, shown as the pack's title.
+    pub name: String,
+    /// The stickers, oldest first.
+    pub stickers: Vec<Sticker>,
+}
+
+/// Lowercase extension of `name` if it is one a sticker may have.
+fn sticker_extension(name: &str) -> Option<String> {
+    let ext = Path::new(name).extension()?.to_str()?.to_ascii_lowercase();
+    STICKER_EXTENSIONS.contains(&ext.as_str()).then_some(ext)
+}
+
+/// Whether `head` (the first bytes of a file) matches what `ext` promises.
+/// The extension alone decides how the UI renders a sticker, so a file must not
+/// be able to lie about it.
+fn magic_matches(ext: &str, head: &[u8]) -> bool {
+    match ext {
+        "png" => head.starts_with(b"\x89PNG"),
+        "gif" => head.starts_with(b"GIF8"),
+        "webp" => head.starts_with(b"RIFF") && head.get(8..12) == Some(b"WEBP"),
+        "tgs" => head.starts_with(b"\x1f\x8b"),
+        _ => false,
+    }
+}
+
+/// Lists all packs, sorted by name. Packs from the old `stickers/` folder are
+/// moved in on first use.
+pub async fn get_packs(context: &Context) -> Result<Vec<StickerPack>> {
+    migrate_sticker_folder(context).await?;
+    let rows: Vec<(u32, String, Option<u32>, Option<String>)> = context
+        .sql
+        .query_map_vec(
+            "SELECT p.id, p.name, s.id, s.blobname
+               FROM slothfulchat_sticker_packs p
+               LEFT JOIN slothfulchat_stickers s ON s.pack_id=p.id
+              ORDER BY p.name COLLATE NOCASE, p.id, s.id",
+            (),
+            |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?, row.get(3)?)),
+        )
+        .await?;
+    let mut emojis: HashMap<String, Vec<String>> = HashMap::new();
+    context
+        .sql
+        .query_map(
+            "SELECT blobname, emoji FROM slothfulchat_sticker_emojis ORDER BY rowid",
+            (),
+            |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),
+            |rows| {
+                for row in rows {
+                    let (blobname, emoji) = row?;
+                    emojis.entry(blobname).or_default().push(emoji);
+                }
+                Ok(())
+            },
+        )
+        .await?;
+    let mut packs: Vec<StickerPack> = Vec::new();
+    for (pack_id, name, sticker_id, blobname) in rows {
+        if packs.last().is_none_or(|p| p.id != pack_id) {
+            packs.push(StickerPack {
+                id: pack_id,
+                name,
+                stickers: Vec::new(),
+            });
+        }
+        if let (Some(id), Some(blobname), Some(pack)) = (sticker_id, blobname, packs.last_mut()) {
+            let path = BlobObject::from_name(context, &blobname)?.to_abs_path();
+            pack.stickers.push(Sticker {
+                id,
+                path: path.to_str().context("non-UTF-8 blob path")?.to_string(),
+                emojis: emojis.get(&blobname).cloned().unwrap_or_default(),
+            });
+        }
+    }
+    Ok(packs)
+}
+
+/// Creates a pack. If `name` is taken, " (2)", " (3)", … is appended.
+pub async fn create_pack(context: &Context, name: &str) -> Result<u32> {
+    let name = name.trim();
+    ensure!(!name.is_empty(), "empty sticker pack name");
+    for n in 1u32.. {
+        let candidate = if n == 1 {
+            name.to_string()
+        } else {
+            format!("{name} ({n})")
+        };
+        let inserted = context
+            .sql
+            .execute(
+                "INSERT OR IGNORE INTO slothfulchat_sticker_packs (name) VALUES (?)",
+                (&candidate,),
+            )
+            .await?;
+        if inserted == 1 {
+            return pack_id_by_name(context, &candidate)
+                .await?
+                .context("pack vanished after insert");
+        }
+    }
+    unreachable!()
+}
+
+async fn pack_id_by_name(context: &Context, name: &str) -> Result<Option<u32>> {
+    context
+        .sql
+        .query_get_value(
+            "SELECT id FROM slothfulchat_sticker_packs WHERE name=?",
+            (name,),
+        )
+        .await
+}
+
+/// Renames a pack. Fails if another pack already has that name.
+pub async fn rename_pack(context: &Context, pack_id: u32, name: &str) -> Result<()> {
+    let name = name.trim();
+    ensure!(!name.is_empty(), "empty sticker pack name");
+    if let Some(other) = pack_id_by_name(context, name).await?
+        && other != pack_id
+    {
+        bail!("a sticker pack named {name:?} already exists");
+    }
+    let changed = context
+        .sql
+        .execute(
+            "UPDATE slothfulchat_sticker_packs SET name=? WHERE id=?",
+            (name, pack_id),
+        )
+        .await?;
+    ensure!(changed == 1, "no sticker pack {pack_id}");
+    Ok(())
+}
+
+/// Deletes a pack and its stickers. The blobs go with the next housekeeping
+/// unless a message or another pack still uses them.
+pub async fn delete_pack(context: &Context, pack_id: u32) -> Result<()> {
+    context
+        .sql
+        .transaction(|t| {
+            t.execute(
+                "DELETE FROM slothfulchat_stickers WHERE pack_id=?",
+                (pack_id,),
+            )?;
+            t.execute(
+                "DELETE FROM slothfulchat_sticker_packs WHERE id=?",
+                (pack_id,),
+            )?;
+            Ok(())
+        })
+        .await
+}
+
+/// Adds the file at `path` to a pack, copying it into the blobdir.
+/// `name` gives the extension, which must be a sticker type the content matches.
+/// Adding a sticker the pack already has is a no-op; returns the sticker's id.
+pub async fn add_sticker_from_file(
+    context: &Context,
+    pack_id: u32,
+    path: &Path,
+    name: &str,
+) -> Result<u32> {
+    let ext = sticker_extension(name).with_context(|| format!("{name:?} is not a sticker"))?;
+    // `create_and_deduplicate` *moves* a file that is already in the blobdir,
+    // which would take it away from the message using it.
+    ensure!(
+        !path.starts_with(context.get_blobdir()),
+        "blobdir files are added with add_sticker_from_msg"
+    );
+    let size = tokio::fs::metadata(path).await?.len();
+    ensure!(size <= MAX_STICKER_BYTES, "sticker too big ({size} bytes)");
+    let mut head = Vec::with_capacity(12);
+    {
+        use tokio::io::AsyncReadExt;
+        let f = tokio::fs::File::open(path).await?;
+        f.take(12).read_to_end(&mut head).await?;
+    }
+    ensure!(
+        magic_matches(&ext, &head),
+        "{name:?} is not a valid {ext} file"
+    );
+    let blob = BlobObject::create_and_deduplicate(context, path, Path::new(&format!("x.{ext}")))?;
+    insert_sticker(context, pack_id, blob.as_name()).await
+}
+
+/// Adds the sticker of message `msg_id` to a pack. The pack shares the
+/// message's blob, so this copies nothing.
+pub async fn add_sticker_from_msg(context: &Context, pack_id: u32, msg_id: MsgId) -> Result<u32> {
+    let msg = Message::load_from_db(context, msg_id).await?;
+    ensure!(
+        msg.get_viewtype() == Viewtype::Sticker,
+        "message {msg_id} is not a sticker"
+    );
+    let blobname = msg.param.get(Param::File).context("sticker has no file")?;
+    // A received sticker's blob is named by content like any other, but the
+    // extension comes from the sender: make sure it is a sticker type. Size and
+    // content are not checked (add_sticker_from_file does that).
+    let blob = BlobObject::from_name(context, blobname)?;
+    let ext = blob.suffix().and_then(sticker_extension_of_suffix);
+    ensure!(
+        ext.is_some(),
+        "sticker {msg_id} has an unsupported file type"
+    );
+    insert_sticker(context, pack_id, blob.as_name()).await
+}
+
+fn sticker_extension_of_suffix(suffix: &str) -> Option<String> {
+    sticker_extension(&format!("x.{suffix}"))
+}
+
+async fn insert_sticker(context: &Context, pack_id: u32, blobname: &str) -> Result<u32> {
+    context
+        .sql
+        .transaction(|t| {
+            let exists: bool = t.query_row(
+                "SELECT COUNT(*) FROM slothfulchat_sticker_packs WHERE id=?",
+                (pack_id,),
+                |row| row.get(0),
+            )?;
+            ensure!(exists, "no sticker pack {pack_id}");
+            t.execute(
+                "INSERT OR IGNORE INTO slothfulchat_stickers (pack_id, blobname) VALUES (?, ?)",
+                (pack_id, blobname),
+            )?;
+            let id = t.query_row(
+                "SELECT id FROM slothfulchat_stickers WHERE pack_id=? AND blobname=?",
+                (pack_id, blobname),
+                |row| row.get(0),
+            )?;
+            Ok(id)
+        })
+        .await
+}
+
+/// Moves a sticker to another pack. If that pack already has it, the moved
+/// one is simply dropped.
+pub async fn move_sticker(context: &Context, sticker_id: u32, to_pack_id: u32) -> Result<()> {
+    let blobname = sticker_blobname(context, sticker_id).await?;
+    insert_sticker(context, to_pack_id, &blobname).await?;
+    let new_id = sticker_id_in_pack(context, to_pack_id, &blobname).await?;
+    if new_id != sticker_id {
+        remove_sticker(context, sticker_id).await?;
+    }
+    Ok(())
+}
+
+/// Copies a sticker into another pack; returns the copy's id.
+pub async fn copy_sticker(context: &Context, sticker_id: u32, to_pack_id: u32) -> Result<u32> {
+    let blobname = sticker_blobname(context, sticker_id).await?;
+    insert_sticker(context, to_pack_id, &blobname).await
+}
+
+/// Removes a sticker from its pack.
+pub async fn remove_sticker(context: &Context, sticker_id: u32) -> Result<()> {
+    context
+        .sql
+        .execute(
+            "DELETE FROM slothfulchat_stickers WHERE id=?",
+            (sticker_id,),
+        )
+        .await?;
+    Ok(())
+}
+
+/// Replaces the emojis of a sticker. They belong to its image, so every pack
+/// entry of the same image shares them and they follow moves and copies.
+/// Entries are trimmed; empty, duplicate and over-long ones are dropped, and
+/// at most [`MAX_EMOJIS`] are kept.
+// ponytail: rows outlive the last sticker of their image and come back if it is
+// saved again; a few bytes each, add a housekeeping DELETE if that ever matters.
+pub async fn set_sticker_emojis(
+    context: &Context,
+    sticker_id: u32,
+    emojis: &[String],
+) -> Result<()> {
+    let blobname = sticker_blobname(context, sticker_id).await?;
+    let mut clean: Vec<&str> = Vec::new();
+    for e in emojis.iter().map(|e| e.trim()) {
+        if !e.is_empty() && e.len() <= MAX_EMOJI_BYTES && !clean.contains(&e) {
+            clean.push(e);
+        }
+    }
+    clean.truncate(MAX_EMOJIS);
+    context
+        .sql
+        .transaction(move |t| {
+            t.execute(
+                "DELETE FROM slothfulchat_sticker_emojis WHERE blobname=?",
+                (&blobname,),
+            )?;
+            for e in clean {
+                t.execute(
+                    "INSERT INTO slothfulchat_sticker_emojis (blobname, emoji) VALUES (?, ?)",
+                    (&blobname, e),
+                )?;
+            }
+            Ok(())
+        })
+        .await
+}
+
+async fn sticker_blobname(context: &Context, sticker_id: u32) -> Result<String> {
+    context
+        .sql
+        .query_get_value(
+            "SELECT blobname FROM slothfulchat_stickers WHERE id=?",
+            (sticker_id,),
+        )
+        .await?
+        .with_context(|| format!("no sticker {sticker_id}"))
+}
+
+async fn sticker_id_in_pack(context: &Context, pack_id: u32, blobname: &str) -> Result<u32> {
+    context
+        .sql
+        .query_get_value(
+            "SELECT id FROM slothfulchat_stickers WHERE pack_id=? AND blobname=?",
+            (pack_id, blobname),
+        )
+        .await?
+        .context("sticker not in pack")
+}
+
+/// Copies pack `pack_id` of profile `from` into `to` as a new pack with the
+/// same name (suffixed if taken there). Returns the new pack's id in `to`.
+pub async fn copy_pack_from(context: &Context, from: &Context, pack_id: u32) -> Result<u32> {
+    let pack = get_packs(from)
+        .await?
+        .into_iter()
+        .find(|p| p.id == pack_id)
+        .with_context(|| format!("no sticker pack {pack_id}"))?;
+    let new_id = create_pack(context, &pack.name).await?;
+    for sticker in &pack.stickers {
+        // A sticker saved from a message was never size- or content-checked,
+        // so this can refuse it; one bad sticker must not cut the copy short.
+        let id =
+            match add_sticker_from_file(context, new_id, Path::new(&sticker.path), &sticker.path)
+                .await
+            {
+                Ok(id) => id,
+                Err(err) => {
+                    warn!(
+                        context,
+                        "Copying sticker pack: skipping {}: {err:#}.", sticker.path
+                    );
+                    continue;
+                }
+            };
+        if !sticker.emojis.is_empty() {
+            set_sticker_emojis(context, id, &sticker.emojis).await?;
+        }
+    }
+    Ok(new_id)
+}
+
+/// Sticker messages, newest first, whose sticker is in no pack yet; one
+/// message per distinct sticker, at most `limit`.
+pub async fn get_unsaved_sticker_msgs(context: &Context, limit: usize) -> Result<Vec<MsgId>> {
+    // ponytail: scans the newest 1000 sticker messages; older ones never show up,
+    // fine for a "recently seen" strip.
+    let rows: Vec<(MsgId, String)> = context
+        .sql
+        .query_map_vec(
+            "SELECT id, param FROM msgs
+              WHERE chat_id>? AND type=? AND hidden=0
+              ORDER BY timestamp DESC, id DESC
+              LIMIT 1000",
+            (DC_CHAT_ID_LAST_SPECIAL, Viewtype::Sticker),
+            |row| Ok((row.get(0)?, row.get(1)?)),
+        )
+        .await?;
+    let saved: std::collections::HashSet<String> = context
+        .sql
+        .query_map_collect(
+            "SELECT DISTINCT blobname FROM slothfulchat_stickers",
+            (),
+            |row| Ok(row.get(0)?),
+        )
+        .await?;
+    let mut seen = std::collections::HashSet::new();
+    let mut result = Vec::new();
+    for (id, param) in rows {
+        let param: Params = param.parse().unwrap_or_default();
+        let Some(file) = param.get(Param::File) else {
+            continue; // not downloaded yet
+        };
+        let Ok(blob) = BlobObject::from_name(context, file) else {
+            continue;
+        };
+        if blob
+            .suffix()
+            .and_then(sticker_extension_of_suffix)
+            .is_none()
+            || saved.contains(blob.as_name())
+            || !seen.insert(blob.as_name().to_string())
+            || !crate::tools::path_exists(blob.to_abs_path())
+        {
+            continue;
+        }
+        result.push(id);
+        if result.len() >= limit {
+            break;
+        }
+    }
+    Ok(result)
+}
+
+/// Moves packs from upstream's `<account>/stickers/<pack>/` folders into the
+/// tables. A pack folder is deleted once all its stickers are in; one with a
+/// file that failed (too big, wrong content, write error) stays on disk and is
+/// retried next time, which only adds what is still missing. Other files are
+/// dropped with their folder: upstream would not have listed them either.
+async fn migrate_sticker_folder(context: &Context) -> Result<()> {
+    // The UI calls get_packs several times at once; without this, two calls
+    // would both import the same folder.
+    // ponytail: one lock for all profiles; migrating is a read_dir of a missing
+    // folder after the first time, so they hardly ever wait on each other.
+    static MIGRATING: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
+    let _guard = MIGRATING.lock().await;
+    let Some(folder) = context.get_dbfile().parent().map(|p| p.join("stickers")) else {
+        return Ok(());
+    };
+    let Ok(mut packs) = tokio::fs::read_dir(&folder).await else {
+        return Ok(()); // nothing to migrate
+    };
+    let mut kept = false;
+    while let Some(entry) = packs.next_entry().await? {
+        if !entry.file_type().await?.is_dir() {
+            continue;
+        }
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let pack_id = match pack_id_by_name(context, &name).await? {
+            Some(id) => id,
+            None => create_pack(context, &name).await?,
+        };
+        let mut failed = false;
+        let mut files = tokio::fs::read_dir(entry.path()).await?;
+        while let Some(file) = files.next_entry().await? {
+            let file_name = file.file_name().to_string_lossy().into_owned();
+            if file.file_type().await?.is_file()
+                && sticker_extension(&file_name).is_some()
+                && let Err(err) =
+                    add_sticker_from_file(context, pack_id, &file.path(), &file_name).await
+            {
+                warn!(
+                    context,
+                    "Sticker migration: keeping {name}/{file_name}: {err:#}."
+                );
+                failed = true;
+            }
+        }
+        if failed {
+            kept = true;
+        } else {
+            tokio::fs::remove_dir_all(entry.path()).await?;
+        }
+    }
+    if !kept {
+        tokio::fs::remove_dir_all(&folder).await?;
+    }
+    Ok(())
+}
