+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_copy_pack_between_profiles() -> Result<()> {
+    let from = TestContext::new().await;
+    let to = TestContext::new().await;
+    let pack = create_pack(&from, "Shared").await?;
+    let gif = write_tmp(&from, "a.gif", GIF).await?;
+    add_sticker_from_file(&from, pack, &gif, "a.gif").await?;
+    create_pack(&to, "Shared").await?;
+
+    let new = copy_pack_from(&to, &from, pack).await?;
+    let packs = get_packs(&to).await?;
+    let copied = packs.iter().find(|p| p.id == new).unwrap();
+    assert_eq!(copied.name, "Shared (2)");
+    assert_eq!(copied.stickers.len(), 1);
+    assert!(Path::new(&copied.stickers[0].path).starts_with(to.get_blobdir()));
+
+    // A saved sticker add_sticker_from_file refuses (here: not really a PNG)
+    // is skipped, the rest is copied.
+    let bad = BlobObject::create_and_deduplicate_from_bytes(&from, b"not a png", "x.png")?;
+    insert_sticker(&from, pack, bad.as_name()).await?;
+    let new = copy_pack_from(&to, &from, pack).await?;
+    let packs = get_packs(&to).await?;
+    assert_eq!(
+        packs.iter().find(|p| p.id == new).unwrap().stickers.len(),
+        1
+    );
+    Ok(())
+}
