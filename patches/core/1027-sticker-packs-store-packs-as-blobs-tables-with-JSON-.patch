+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_add_from_file_checks_content() -> Result<()> {
+    let t = TestContext::new().await;
+    let pack = create_pack(&t, "p").await?;
+
+    let fake = write_tmp(&t, "fake.png", b"GIF89a not a png").await?;
+    assert!(
+        add_sticker_from_file(&t, pack, &fake, "fake.png")
+            .await
+            .is_err()
+    );
+    let exe = write_tmp(&t, "x.exe", GIF).await?;
+    assert!(
+        add_sticker_from_file(&t, pack, &exe, "x.exe")
+            .await
+            .is_err()
+    );
+
+    let gif = write_tmp(&t, "a.gif", GIF).await?;
+    let id = add_sticker_from_file(&t, pack, &gif, "a.GIF").await?;
+    // The same content again is the same sticker.
+    let again = write_tmp(&t, "b.gif", GIF).await?;
+    assert_eq!(add_sticker_from_file(&t, pack, &again, "b.gif").await?, id);
+
+    let packs = get_packs(&t).await?;
+    assert_eq!(packs[0].stickers.len(), 1);
+    assert!(packs[0].stickers[0].path.ends_with(".gif"));
+    assert!(Path::new(&packs[0].stickers[0].path).starts_with(t.get_blobdir()));
+    Ok(())
+}
