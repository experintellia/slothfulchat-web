+/// Packs saved by upstream's folder layout move into the tables on first use.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_migrate_sticker_folder() -> Result<()> {
+    let t = TestContext::new().await;
+    let folder = t.get_dbfile().parent().unwrap().join("stickers");
+    tokio::fs::create_dir_all(folder.join("Saved")).await?;
+    tokio::fs::write(folder.join("Saved/1.gif"), GIF).await?;
+    tokio::fs::write(folder.join("Saved/notes.txt"), b"x").await?;
+
+    let packs = get_packs(&t).await?;
+    assert_eq!(packs.len(), 1);
+    assert_eq!(packs[0].name, "Saved");
+    assert_eq!(packs[0].stickers.len(), 1);
+    assert!(!folder.exists(), "old sticker folder left behind");
+    Ok(())
+}
