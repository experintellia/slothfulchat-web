+/// slothfulchat: a sticker saved to a pack must outlive the message it came from,
+/// and go once no pack has it. This is the tripwire for the fork-only
+/// `slothfulchat_stickers` query in `remove_unused_files`: if an upstream rebase
+/// rewrites housekeeping and drops it, saved stickers would silently vanish.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_housekeeping_keeps_sticker_pack_blobs() -> Result<()> {
+    let t = TestContext::new_alice().await;
+    let mut msg = Message::new(Viewtype::Sticker);
+    msg.set_file_from_bytes(
+        &t,
+        "s.gif",
+        include_bytes!("../../test-data/image/image100x50.gif"),
+        None,
+    )?;
+    let chat = t.get_self_chat().await;
+    let msg_id = t.send_msg(chat.id, &mut msg).await.sender_msg_id;
+    let blob = Message::load_from_db(&t, msg_id)
+        .await?
+        .get_file(&t)
+        .context("sticker has a file")?;
+    let pack = crate::sticker_packs::create_pack(&t, "Saved").await?;
+    crate::sticker_packs::add_sticker_from_msg(&t, pack, msg_id).await?;
+
+    crate::message::delete_msgs(&t, &[msg_id]).await?;
+    SystemTime::shift(Duration::from_secs(65 * 60));
+    remove_unused_files(&t).await?;
+    assert!(
+        blob.exists(),
+        "housekeeping deleted a sticker saved in a pack"
+    );
+
+    crate::sticker_packs::delete_pack(&t, pack).await?;
+    SystemTime::shift(Duration::from_secs(65 * 60));
+    remove_unused_files(&t).await?;
+    assert!(!blob.exists(), "sticker blob outlived its pack");
+    Ok(())
+}
