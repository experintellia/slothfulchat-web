+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_pack_names() -> Result<()> {
+    let t = TestContext::new().await;
+    let a = create_pack(&t, "Cats").await?;
+    let b = create_pack(&t, " Cats ").await?;
+    let c = create_pack(&t, "Cats").await?;
+    let names: Vec<_> = get_packs(&t).await?.into_iter().map(|p| p.name).collect();
+    assert_eq!(names, ["Cats", "Cats (2)", "Cats (3)"]);
+    assert!(create_pack(&t, "  ").await.is_err());
+
+    assert!(
+        rename_pack(&t, b, "Cats").await.is_err(),
+        "rename onto a taken name"
+    );
+    rename_pack(&t, b, "Dogs").await?;
+    rename_pack(&t, a, "Cats").await?; // to its own name is fine
+    delete_pack(&t, c).await?;
+    let names: Vec<_> = get_packs(&t).await?.into_iter().map(|p| p.name).collect();
+    assert_eq!(names, ["Cats", "Dogs"]);
+    Ok(())
+}
