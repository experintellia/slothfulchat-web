+    /// Hashed per-app user id; for self this is `selfAddr`.
+    fn get_webxdc_user_id(&self, fingerprint_hex: &str) -> String {
+        let data = format!("{}-{}", fingerprint_hex, self.rfc724_mid);
+        let hash = Sha256::digest(data.as_bytes());
+        format!("{hash:x}")
+    }
+
     async fn get_webxdc_self_addr(&self, context: &Context) -> Result<String> {
         let fingerprint = self_fingerprint(context).await?;
-        let data = format!("{}-{}", fingerprint, self.rfc724_mid);
-        let hash = Sha256::digest(data.as_bytes());
-        Ok(format!("{hash:x}"))
+        Ok(self.get_webxdc_user_id(fingerprint))
+    }
+
+    /// Chat members with a key, plus self, paired with their per-app user id.
+    /// Contains the contact, so never hand this to the app;
+    /// use [`Self::get_webxdc_memberlist`] for that.
+    async fn get_internal_webxdc_memberlist(
+        &self,
+        context: &Context,
+    ) -> Result<Vec<(Contact, String)>> {
+        let mut contacts = chat::get_chat_contacts(context, self.get_chat_id()).await?;
+        // 1:1 chats don't list self, and a member removed from a group still needs itself.
+        if !contacts.contains(&ContactId::SELF) {
+            contacts.push(ContactId::SELF);
+        }
+        let mut memberlist = Vec::with_capacity(contacts.len());
+        for contact_id in contacts {
+            let contact = Contact::get_by_id(context, contact_id).await?;
+            if let Some(fingerprint) = contact.fingerprint() {
+                memberlist.push((contact, self.get_webxdc_user_id(&fingerprint.hex())));
+            } else if contact_id == ContactId::SELF {
+                memberlist.push((contact, self.get_webxdc_self_addr(context).await?));
+            }
+        }
+        Ok(memberlist)
+    }
+
+    /// Returns the webxdc member list as (per-app user id, display name) tuples:
+    /// chat members with a known key, plus self. The user ids are the same as `selfAddr`
+    /// on the respective member's device, and avatars are served as
+    /// `__webxdc__/avatar/<user id>.jpg` by [`Self::get_webxdc_blob`].
+    pub async fn get_webxdc_memberlist(&self, context: &Context) -> Result<Vec<(String, String)>> {
+        // TODO: this exposes nicknames the user set locally for a contact,
+        // which the app could send to the group. Use only the authname instead?
+        Ok(self
+            .get_internal_webxdc_memberlist(context)
+            .await?
+            .into_iter()
+            .map(|(contact, id)| (id, contact.get_display_name_without_email()))
+            .collect())
     }
 
