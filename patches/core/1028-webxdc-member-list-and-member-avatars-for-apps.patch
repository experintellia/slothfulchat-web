+    /// Returns the webxdc member list as (per-app user id, display name) tuples:
+    /// chat members with a known key, plus self (whose id is `selfAddr`).
+    /// `get_webxdc_blob` serves their avatars as `__webxdc__/avatar/<user id>.jpg`.
+    async fn get_webxdc_memberlist(
+        &self,
+        account_id: u32,
+        instance_msg_id: u32,
+    ) -> Result<Vec<(String, String)>> {
+        let ctx = self.get_context(account_id).await?;
