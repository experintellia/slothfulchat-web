+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_reply_count_and_thread() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let alice_chat = alice.create_chat(bob).await;
+    bob.create_chat(alice).await;
+
+    // A: root message from Alice.
+    let sent_a = alice.send_text(alice_chat.id, "A").await;
+    let a = sent_a.sender_msg_id;
+
+    // B: Bob replies to A; on Alice's side this arrives via receive_imf,
+    // so `mime_in_reply_to` holds the bracketed raw In-Reply-To header.
+    let a_bob = bob.recv_msg(&sent_a).await;
+    let mut b_bob = Message::new_text("B".to_string());
+    b_bob.set_quote(bob, Some(&a_bob)).await?;
+    chat::send_msg(bob, a_bob.chat_id, &mut b_bob).await?;
+    let b = alice.recv_msg(&bob.pop_sent_msg().await).await;
+    let raw_in_reply_to: String = alice
+        .sql
+        .query_get_value("SELECT mime_in_reply_to FROM msgs WHERE id=?", (b.id,))
+        .await?
+        .unwrap();
+    assert!(raw_in_reply_to.starts_with('<')); // bracketed form is what we test here
+
+    // C: Alice replies to B (outgoing reply stores the bare mid).
+    let mut c = Message::new_text("C".to_string());
+    c.set_quote(alice, Some(&b)).await?;
+    chat::send_msg(alice, alice_chat.id, &mut c).await?;
+
+    // D: unrelated message.
+    let d = alice.send_text(alice_chat.id, "D").await.sender_msg_id;
+
+    assert_eq!(get_reply_count(alice, a).await?, 1);
+    assert_eq!(get_reply_count(alice, b.id).await?, 1);
+    assert_eq!(get_reply_count(alice, c.id).await?, 0);
+    assert_eq!(get_reply_count(alice, d).await?, 0);
+
+    let thread = vec![a, b.id, c.id];
+    for &msg_id in &thread {
+        assert_eq!(get_reply_thread(alice, msg_id).await?, thread);
+    }
+    assert_eq!(get_reply_thread(alice, d).await?, vec![d]);
+
+    Ok(())
+}
