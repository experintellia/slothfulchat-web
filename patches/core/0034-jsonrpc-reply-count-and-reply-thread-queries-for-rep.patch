+    /// Returns the number of direct replies to a message.
+    ///
+    /// Only deliberate, non-hidden replies (messages quoting this one) in the same
+    /// chat are counted; answers created via "reply privately" in another chat are
+    /// not part of the thread.
+    /// For a Telegram-style thread view this is the number to show on the "N replies" button.
+    async fn get_message_reply_count(&self, account_id: u32, message_id: u32) -> Result<usize> {
+        let ctx = self.get_context(account_id).await?;
+        get_reply_count(&ctx, MsgId::new(message_id)).await
+    }
+
+    /// Returns all messages of the reply thread the given message belongs to,
+    /// sorted by timestamp.
+    ///
+    /// The thread root is resolved by walking the chain of quoted messages upwards
+    /// (staying within the message's chat), then the root and all nested replies
+    /// to it — any depth and branching — are returned, the root included.
+    /// Intended for a Telegram-style thread view.
+    async fn get_message_reply_thread(
+        &self,
+        account_id: u32,
+        message_id: u32,
+    ) -> Result<Vec<u32>> {
+        let ctx = self.get_context(account_id).await?;
+        let ids = get_reply_thread(&ctx, MsgId::new(message_id)).await?;
+        Ok(ids.iter().map(|id| id.to_u32()).collect())
+    }
