+/// SQL condition matching messages that are deliberate replies: they carry a
+/// quote (`Param::Quote`, key 'q') and are not forwarded (`Param::Forwarded`,
+/// key 'a'). `mime_in_reply_to` alone does not mark a reply — it is set on
+/// *every* outgoing message for email threading (see `prepare_msg_raw`).
+const IS_REPLY_CONDITION: &str = "(param GLOB '*\nq=*' OR param GLOB 'q=*')
+     AND NOT (param GLOB '*\na=*' OR param GLOB 'a=*')";
+
+/// Returns the number of direct replies to the given message.
+///
+/// Only deliberate, non-hidden replies (messages quoting this one) in the same
+/// chat are counted; "reply privately" answers living in another chat are not
+/// part of the thread.
+pub async fn get_reply_count(context: &Context, msg_id: MsgId) -> Result<usize> {
+    let msg = Message::load_from_db(context, msg_id).await?;
+    if msg.rfc724_mid.is_empty() {
+        return Ok(0);
+    }
+    context
+        .sql
+        .count(
+            // `mime_in_reply_to` holds the raw In-Reply-To header (`<mid>`) for
+            // incoming messages, but the bare mid for outgoing ones — match both.
+            &format!(
+                "SELECT COUNT(*) FROM msgs
+                 WHERE mime_in_reply_to IN (?1, '<'||?1||'>')
+                   AND chat_id=?2 AND hidden=0
+                   AND {IS_REPLY_CONDITION}"
+            ),
+            (&msg.rfc724_mid, msg.chat_id),
+        )
+        .await
+}
+
+/// Returns all messages of the reply thread the given message belongs to,
+/// sorted by (timestamp, id).
+///
+/// The thread root is found by walking up the chain of quoted messages within
+/// the message's chat, then the root and all nested deliberate replies to it
+/// (any depth and branching) are collected. Replies in other chats
+/// ("reply privately") and hidden messages are excluded.
+pub async fn get_reply_thread(context: &Context, msg_id: MsgId) -> Result<Vec<MsgId>> {
+    let mut root = Message::load_from_db(context, msg_id).await?;
+    let chat_id = root.chat_id;
+    // ponytail: 100-hop cap guards against In-Reply-To cycles in the upward walk.
+    for _ in 0..100 {
+        // `quoted_message()` (not `parent()`): only deliberate replies continue
+        // the thread upwards, `mime_in_reply_to` alone is just email threading.
+        match root.quoted_message(context).await? {
+            Some(parent) if parent.chat_id == chat_id => root = parent,
+            _ => break,
+        }
+    }
+    context
+        .sql
+        .query_map_vec(
+            // `mime_in_reply_to` holds `<mid>` for incoming, bare mid for
+            // outgoing messages — match both. `t.mid!=''` keeps messages
+            // without a Message-ID from matching everything with an empty
+            // `mime_in_reply_to`. `UNION` (not `UNION ALL`) makes the
+            // recursion terminate even on reference cycles.
+            &format!(
+                "WITH RECURSIVE thread(id, mid) AS (
+                     SELECT id, rfc724_mid FROM msgs WHERE id=?1
+                     UNION
+                     SELECT m.id, m.rfc724_mid FROM msgs m JOIN thread t
+                       ON t.mid!='' AND m.mime_in_reply_to IN (t.mid, '<'||t.mid||'>')
+                     WHERE m.chat_id=?2 AND m.hidden=0
+                       AND {IS_REPLY_CONDITION}
+                 )
+                 SELECT id FROM msgs
+                 WHERE id IN (SELECT id FROM thread)
+                 ORDER BY timestamp, id"
+            ),
+            (root.id, chat_id),
+            |row| Ok(row.get(0)?),
+        )
+        .await
+}
