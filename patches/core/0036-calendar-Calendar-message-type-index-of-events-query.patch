index 0000000..052a219
--- /dev/null
+++ b/deltachat-jsonrpc/src/api/types/calendar.rs
@@ -0,0 +1,88 @@
+use deltachat::calendar::{CalendarEvent, NewCalendarEvent};
+use serde::{Deserialize, Serialize};
+use typescript_type_def::TypeDef;
+
+/// One occurrence of an event from an iCalendar attachment.
+#[derive(Serialize, TypeDef, schemars::JsonSchema)]
+#[serde(rename = "CalendarEvent", rename_all = "camelCase")]
+pub struct JsonrpcCalendarEvent {
+    pub msg_id: u32,
+    pub chat_id: u32,
+    pub uid: String,
+    pub summary: String,
+    pub location: String,
+    pub description: String,
+    /// Unix timestamp. For `floating` events the wall-clock time encoded as UTC.
+    pub start: i64,
+    /// Unix timestamp (exclusive), same encoding as `start`.
+    pub end: i64,
+    /// `start`/`end` are UTC-encoded midnights, `end` exclusive.
+    pub all_day: bool,
+    /// `start`/`end` are wall-clock times encoded as UTC, display them with UTC getters.
+    pub floating: bool,
+    pub cancelled: bool,
+    pub recurring: bool,
+    /// `RRULE` value of the series, e.g. `FREQ=WEEKLY;...`, if it has one.
+    pub rrule: Option<String>,
+}
+
+impl From<CalendarEvent> for JsonrpcCalendarEvent {
+    fn from(e: CalendarEvent) -> Self {
+        Self {
+            msg_id: e.msg_id.to_u32(),
+            chat_id: e.chat_id.to_u32(),
+            uid: e.uid,
+            summary: e.summary,
+            location: e.location,
+            description: e.description,
+            start: e.start,
+            end: e.end,
+            all_day: e.all_day,
+            floating: e.floating,
+            cancelled: e.cancelled,
+            recurring: e.recurring,
+            rrule: e.rrule,
+        }
+    }
+}
+
+/// Number of distinct events in a chat.
+#[derive(Serialize, TypeDef, schemars::JsonSchema)]
+#[serde(rename = "CalendarChat", rename_all = "camelCase")]
+pub struct JsonrpcCalendarChat {
+    pub chat_id: u32,
+    pub count: u32,
+}
+
+/// A new event to send as `.ics` attachment.
+#[derive(Deserialize, TypeDef, schemars::JsonSchema)]
+#[serde(rename = "NewCalendarEvent", rename_all = "camelCase")]
+pub struct JsonrpcNewCalendarEvent {
+    pub summary: String,
+    pub location: Option<String>,
+    pub description: Option<String>,
+    /// Unix timestamp; for all-day events the UTC midnight of the first day.
+    pub start: i64,
+    /// Unix timestamp; for all-day events the UTC midnight after the last day.
+    pub end: i64,
+    pub all_day: bool,
+    /// IANA time zone, e.g. from `Intl.DateTimeFormat().resolvedOptions().timeZone`.
+    pub timezone: Option<String>,
+    /// `RRULE` value, e.g. `FREQ=WEEKLY`.
+    pub rrule: Option<String>,
+}
+
+impl From<JsonrpcNewCalendarEvent> for NewCalendarEvent {
+    fn from(e: JsonrpcNewCalendarEvent) -> Self {
+        Self {
+            summary: e.summary,
+            location: e.location.unwrap_or_default(),
+            description: e.description.unwrap_or_default(),
+            start: e.start,
+            end: e.end,
+            all_day: e.all_day,
+            timezone: e.timezone,
+            rrule: e.rrule,
+        }
+    }
+}
