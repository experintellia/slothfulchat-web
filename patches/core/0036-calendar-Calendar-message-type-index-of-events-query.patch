+#[test]
+fn test_build_ics_round_trip() {
+    let event = NewCalendarEvent {
+        summary: "Lunch, with; friends".to_string(),
+        location: "Café".to_string(),
+        description: "line 1\nline 2".to_string(),
+        start: ts("2026-03-27T12:00:00Z"),
+        end: ts("2026-03-27T13:00:00Z"),
+        all_day: false,
+        timezone: Some("Europe/Berlin".to_string()),
+        rrule: Some("FREQ=WEEKLY;COUNT=2".to_string()),
+    };
+    let text = build_ics(&event, "uid-1@test", ts("2026-03-01T00:00:00Z")).unwrap();
+    assert!(
+        text.contains("TZID=Europe/Berlin:20260327T130000"),
+        "{text}"
+    );
+    let rows = parse_ics(&text);
+    assert_eq!(rows.len(), 1);
+    let r = &rows[0];
+    assert_eq!(
+        (
+            r.uid.as_str(),
+            r.summary.as_str(),
+            r.location.as_str(),
+            r.description.as_str()
+        ),
+        (
+            "uid-1@test",
+            "Lunch, with; friends",
+            "Café",
+            "line 1\nline 2"
+        )
+    );
+    // Second occurrence is after DST start (29 Mar), wall clock stays 13:00 Berlin.
+    assert_eq!(r.until, ts("2026-04-03T14:00:00+02:00"));
+
+    let all_day = NewCalendarEvent {
+        summary: "Trip".to_string(),
+        start: ts("2026-07-01T00:00:00Z"),
+        end: ts("2026-07-04T00:00:00Z"),
+        all_day: true,
+        ..Default::default()
+    };
+    let rows = parse_ics(&build_ics(&all_day, "uid-2@test", 0).unwrap());
+    assert_eq!((rows[0].start, rows[0].end), (all_day.start, all_day.end));
+    assert!(rows[0].all_day);
+
+    let bad = NewCalendarEvent {
+        rrule: Some("FREQ=SOMETIMES".to_string()),
+        ..all_day
+    };
+    assert!(build_ics(&bad, "uid-3@test", 0).is_err());
+}
