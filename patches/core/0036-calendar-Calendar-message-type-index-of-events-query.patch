+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_calendar_viewtype_send_receive_query() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let chat_id = alice.create_chat_id(bob).await;
+
+    let msg_id = send_event(alice, chat_id, "Party").await?;
+    let msg = Message::load_from_db(alice, msg_id).await?;
+    assert_eq!(msg.viewtype, Viewtype::Calendar);
+    assert!(
+        msg.get_summary(alice, None)
+            .await?
+            .text
+            .starts_with("📅 Party")
+    );
+    assert!(in_index(alice, msg_id).await?, "indexed on send");
+    let ev = get_events(alice, None, ts(DEC.0), ts(DEC.1)).await?;
+    assert_eq!((ev[0].msg_id, ev[0].chat_id), (msg_id, chat_id));
+    assert_eq!(get_chats(alice).await?, [(chat_id, 1)]);
+    assert!(get_events(alice, None, 0, ts(DEC.0)).await?.is_empty());
+    assert_eq!(msg_events(alice, &msg).await[0].summary, "Party");
+
+    // Received as Calendar, indexed on receive, text kept.
+    let received = bob.recv_msg(&alice.pop_sent_msg().await).await;
+    assert_eq!(received.viewtype, Viewtype::Calendar);
+    assert_eq!(received.get_text(), "Come!");
+    assert_eq!(received.param.get(Param::Summary1), Some("Party"));
+    assert!(in_index(bob, received.id).await?);
+    // ...except while the chat is a contact request.
+    assert!(summaries(bob).await?.is_empty());
+    received.chat_id.accept(bob).await?;
+    assert_eq!(summaries(bob).await?, ["Party"]);
+
+    // A .ics without events stays a plain file.
+    let mut bad = Message::new(Viewtype::File);
+    bad.set_file_from_bytes(alice, "bad.ics", b"not a calendar", None)?;
+    let bad_id = chat::send_msg(alice, chat_id, &mut bad).await?;
+    assert_eq!(
+        Message::load_from_db(alice, bad_id).await?.viewtype,
+        Viewtype::File
+    );
+    alice.pop_sent_msg().await;
+
+    // Drafts are Calendar messages too, but not in the calendar.
+    let mut draft = Message::new(Viewtype::File);
+    let ics = make_ics(&NewCalendarEvent {
+        summary: "Draft".to_string(),
+        start: ts("2026-12-24T00:00:00Z"),
+        end: ts("2026-12-25T00:00:00Z"),
+        all_day: true,
+        rrule: Some("FREQ=YEARLY".to_string()),
+        ..Default::default()
+    })?;
+    draft.set_file_from_bytes(alice, "draft.ics", ics.as_bytes(), None)?;
+    chat_id.set_draft(alice, Some(&mut draft)).await?;
+    let draft = chat_id.get_draft(alice).await?.unwrap();
+    assert_eq!(draft.viewtype, Viewtype::Calendar);
+    let draft_event = &msg_events(alice, &draft).await[0];
+    assert_eq!(draft_event.summary, "Draft");
+    // The rule comes back, so the UI can edit the draft's event.
+    assert!(
+        draft_event
+            .rrule
+            .as_deref()
+            .unwrap()
+            .starts_with("FREQ=YEARLY")
+    );
+    assert_eq!(summaries(alice).await?, ["Party"]);
+
+    // A plain .ics File from before the viewtype (and the index) is retyped when indexed.
+    alice
+        .sql
+        .execute(
+            "UPDATE msgs SET type=? WHERE id=?",
+            (Viewtype::File, msg_id),
+        )
+        .await?;
+    alice
+        .sql
+        .execute("DELETE FROM slothfulchat_calendar_indexed", ())
+        .await?;
+    alice
+        .sql
+        .execute("DELETE FROM slothfulchat_calendar_events", ())
+        .await?;
+    assert_eq!(summaries(alice).await?, ["Party"]);
+    // An attachment that stops being a calendar drops out.
+    assert!(
+        in_index(alice, bad_id).await?,
+        "looked at on send, no events"
+    );
+    alice
+        .sql
+        .execute(
+            "UPDATE msgs SET type=? WHERE id=?",
+            (Viewtype::Image, bad_id),
+        )
+        .await?;
+    assert!(gone(alice, bad_id).await?, "no longer a calendar file");
+    let msg = Message::load_from_db(alice, msg_id).await?;
+    assert_eq!(msg.viewtype, Viewtype::Calendar);
+    Ok(())
+}
