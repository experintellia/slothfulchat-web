+
+fn ics(body: &str) -> String {
+    format!("BEGIN:VCALENDAR\r\nVERSION:2.0\r\n{body}END:VCALENDAR\r\n")
+        .replace('\n', "\r\n")
+        .replace("\r\r", "\r")
+}
+
+fn rows_of(text: &str) -> Vec<(MsgId, ChatId, Row)> {
+    parse_ics(text)
+        .into_iter()
+        .map(|r| (MsgId::new(10), ChatId::new(10), r))
+        .collect()
+}
