+/// Sends `summary` (all day, Dec 31) as an `.ics` File, which core makes a Calendar message.
+async fn send_event(t: &TestContext, chat_id: ChatId, summary: &str) -> Result<MsgId> {
+    let ics = make_ics(&NewCalendarEvent {
+        summary: summary.to_string(),
+        start: ts("2026-12-31T00:00:00Z"),
+        end: ts("2027-01-01T00:00:00Z"),
+        all_day: true,
+        ..Default::default()
+    })?;
+    let mut msg = Message::new(Viewtype::File);
+    msg.set_text("Come!".to_string());
+    msg.set_file_from_bytes(t, "event.ics", ics.as_bytes(), None)?;
+    chat::send_msg(t, chat_id, &mut msg).await
+}
+
+const DEC: (&str, &str) = ("2026-12-01T00:00:00Z", "2027-01-31T00:00:00Z");
+
+async fn summaries(t: &TestContext) -> Result<Vec<String>> {
+    let events = get_events(t, None, ts(DEC.0), ts(DEC.1)).await?;
+    Ok(events.into_iter().map(|e| e.summary).collect())
+}
+
+/// Whether the index holds anything for `msg_id` right now.
+async fn in_index(t: &TestContext, msg_id: MsgId) -> Result<bool> {
+    Ok(t.sql
+        .exists(
+            "SELECT COUNT(*) FROM slothfulchat_calendar_events WHERE msg_id=?1
+             UNION ALL SELECT COUNT(*) FROM slothfulchat_calendar_indexed WHERE msg_id=?1
+             ORDER BY 1 DESC LIMIT 1",
+            (msg_id,),
+        )
+        .await?)
+}
+
+/// Whether `msg_id` is out of the index after the next read.
+async fn gone(t: &TestContext, msg_id: MsgId) -> Result<bool> {
+    reconcile(t).await?;
+    Ok(!in_index(t, msg_id).await?)
+}
