+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn test_every_kind_of_deletion_drops_events() -> Result<()> {
+    let mut tcm = TestContextManager::new();
+    let alice = &tcm.alice().await;
+    let bob = &tcm.bob().await;
+    let chat_id = alice.create_chat_id(bob).await;
+    bob.create_chat_id(alice).await;
+
+    // Delete for me.
+    let id = send_event(alice, chat_id, "for me").await?;
+    alice.pop_sent_msg().await;
+    crate::message::delete_msgs(alice, &[id]).await?;
+    assert!(gone(alice, id).await?, "delete for me");
+
+    // Delete for everyone, on both sides.
+    let id = send_event(alice, chat_id, "for all").await?;
+    let bob_msg = bob.recv_msg(&alice.pop_sent_msg().await).await;
+    assert!(in_index(bob, bob_msg.id).await?);
+    crate::message::delete_msgs_ex(alice, &[id], true).await?;
+    assert!(gone(alice, id).await?, "delete for everyone, sender");
+    bob.recv_msg_trash(&alice.pop_sent_msg().await).await;
+    assert!(
+        gone(bob, bob_msg.id).await?,
+        "delete for everyone, receiver"
+    );
+
+    // Disappearing message expired.
+    let id = send_event(alice, chat_id, "ephemeral").await?;
+    alice.pop_sent_msg().await;
+    alice
+        .sql
+        .execute("UPDATE msgs SET ephemeral_timestamp=1 WHERE id=?", (id,))
+        .await?;
+    crate::ephemeral::delete_expired_messages(alice, time()).await?;
+    assert!(gone(alice, id).await?, "ephemeral timer");
+
+    // "Delete messages from device" after some time.
+    let id = send_event(alice, chat_id, "old").await?;
+    alice.pop_sent_msg().await;
+    alice
+        .set_config(crate::config::Config::DeleteDeviceAfter, Some("3600"))
+        .await?;
+    crate::ephemeral::delete_expired_messages(alice, time() + 7200).await?;
+    alice
+        .set_config(crate::config::Config::DeleteDeviceAfter, None)
+        .await?;
+    assert!(gone(alice, id).await?, "delete_device_after");
+
+    // Whole chat deleted (moves messages to trash with INSERT OR REPLACE).
+    let id = send_event(alice, chat_id, "chat").await?;
+    alice.pop_sent_msg().await;
+    assert!(in_index(alice, id).await?);
+    chat_id.delete(alice).await?;
+    assert!(gone(alice, id).await?, "chat deletion");
+
+    assert!(summaries(alice).await?.is_empty());
+    assert!(
+        !alice
+            .sql
+            .exists("SELECT COUNT(*) FROM slothfulchat_calendar_events", ())
+            .await?
+    );
+    Ok(())
+}
