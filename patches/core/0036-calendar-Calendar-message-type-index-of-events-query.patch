+    // ---------------------------------------------
+    //                   calendar
+    // ---------------------------------------------
+
+    /// Returns the occurrences of events from iCalendar attachments overlapping
+    /// the unix-timestamp range `[from, to)`, sorted by start.
+    /// Only the latest version (`SEQUENCE`) of each event `UID` is returned.
+    ///
+    /// `chat_id` limits the result to one chat; `None` or `0` returns events of all chats.
+    async fn get_calendar_events(
+        &self,
+        account_id: u32,
+        chat_id: Option<u32>,
+        from: i64,
+        to: i64,
+    ) -> Result<Vec<JsonrpcCalendarEvent>> {
+        let ctx = self.get_context(account_id).await?;
+        let chat_id = chat_id.filter(|id| *id != 0).map(ChatId::new);
+        let events = deltachat::calendar::get_events(&ctx, chat_id, from, to).await?;
+        Ok(events.into_iter().map(Into::into).collect())
+    }
+
+    /// Returns the chats that have calendar events, with the number of distinct events in each.
+    async fn get_calendar_chats(&self, account_id: u32) -> Result<Vec<JsonrpcCalendarChat>> {
+        let ctx = self.get_context(account_id).await?;
+        let chats = deltachat::calendar::get_chats(&ctx).await?;
+        Ok(chats
+            .into_iter()
+            .map(|(chat_id, count)| JsonrpcCalendarChat {
+                chat_id: chat_id.to_u32(),
+                count: count.try_into().unwrap_or(u32::MAX),
+            })
+            .collect())
+    }
+
+    /// Returns all events in the iCalendar file of a `Calendar` message (first occurrence
+    /// of each, unexpanded). Also works for drafts.
+    async fn get_calendar_msg_events(
+        &self,
+        account_id: u32,
+        msg_id: u32,
+    ) -> Result<Vec<JsonrpcCalendarEvent>> {
+        let ctx = self.get_context(account_id).await?;
+        let msg = Message::load_from_db(&ctx, MsgId::new(msg_id)).await?;
+        let events = deltachat::calendar::msg_events(&ctx, &msg).await;
+        Ok(events.into_iter().map(Into::into).collect())
+    }
+
+    /// Returns `event` as iCalendar file content. Write it to a `.ics` file and send or
+    /// draft it with viewtype `Calendar`, like `make_vcard`.
+    async fn make_calendar_ics(&self, event: JsonrpcNewCalendarEvent) -> Result<String> {
+        deltachat::calendar::make_ics(&event.into())
+    }
+
