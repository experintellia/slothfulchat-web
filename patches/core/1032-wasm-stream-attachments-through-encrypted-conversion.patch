+/// Copies the source SQLite database without staging a plaintext snapshot on disk.
+pub async fn snapshot_storage_database(context: &Context) -> Result<Vec<u8>> {
+    ensure!(fs::storage_db_key().is_none(), "Upgrade source must be unencrypted");
+    ensure!(!context.scheduler.is_running().await, "Stop account IO before upgrading storage");
+    ensure!(context.get_migration_error().is_none(), "Open the source account normally before upgrading");
+    let memory_db = format!("/storage-upgrade-{}.db", uuid::Uuid::new_v4());
+    let uri = format!("file:{memory_db}?vfs=memvfs&key=");
+    let result = context.sql.call_write(|conn| {
+        conn.execute("VACUUM INTO ?", [uri])?;
+        Ok(())
+    }).await;
+    let bytes = fs::sqlite_mem_vfs_take(&memory_db);
+    result?;
+    bytes.map_err(|err| format_err!("{err}"))
+}
