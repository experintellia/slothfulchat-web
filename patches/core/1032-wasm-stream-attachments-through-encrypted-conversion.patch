+/// Imports a browser-selected backup directly from its reader.
+#[cfg(target_arch = "wasm32")]
+pub async fn restore_backup_from_reader<R: AsyncRead + Unpin>(
+    context: &Context,
+    reader: R,
+    size: u64,
+    passphrase: String,
+) -> Result<()> {
+    ensure!(size != 0, "Backup is empty");
+    let cancel = context.alloc_ongoing().await?;
+    let result = match context.scheduler.pause(context).await {
+        Ok(_guard) => {
+            context.emit_event(EventType::ImexProgress(1));
+            import_backup_stream(context, reader, size, passphrase)
+                .race(async {
+                    cancel.recv().await.ok();
+                    Err(format_err!("canceled"))
+                })
+                .await
+        }
+        Err(err) => Err(err),
+    };
+    context.free_ongoing().await;
+    context.emit_event(EventType::ImexProgress(if result.is_ok() { 1000 } else { 0 }));
+    result
+}
