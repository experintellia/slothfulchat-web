+pub(super) async fn restore_archive<R: AsyncRead + Unpin>(
+    context: &Context,
+    reader: R,
+    size: u64,
+    passphrase: String,
+) -> Result<()> {
+    ensure!(size != 0, "Backup is empty");
+    ensure!(passphrase.is_empty(), "encrypted backups are not supported on wasm");
+    let mut conversion = Conversion::new()?;
+    let mut archive = Archive::new(ProgressReader::new(reader, context.clone(), size));
+    let mut entries = archive.entries()?;
+    while let Some(mut entry) = entries.try_next().await? {
+        let path = entry.path()?;
+        ensure!(
+            !path.components().any(|part| matches!(part, Component::ParentDir | Component::Prefix(_))),
+            "Invalid path in backup"
+        );
+        let entry_type = entry.header().entry_type();
+        if entry_type.is_dir() {
+            continue;
+        }
+        ensure!(
+            entry_type.is_file() || entry_type.is_gnu_sparse() || entry_type.is_contiguous(),
+            "Unsupported entry type in backup"
+        );
+        let mut components = path.components().filter(|part| matches!(part, Component::Normal(_)));
+        let database = components.next().is_some_and(|part| part.as_os_str() == DBFILE_BACKUP_NAME)
+            && components.next().is_none();
+        let name = path.file_name().and_then(|name| name.to_str()).context("Invalid attachment name")?.to_owned();
+        let len = fs::checked_import_length(entry.header().size()?)?;
+        let mut bytes = Vec::new();
+        bytes.try_reserve_exact(len)?;
+        entry.read_to_end(&mut bytes).await?;
+        ensure!(bytes.len() == len, "Incomplete backup entry");
+        if database {
+            conversion.set_database(&bytes)?;
+        } else {
+            conversion.add_attachment(name, &bytes)?;
+        }
+    }
+    conversion.finish(context, passphrase, false).await
+}
