{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // Reject TS syntax that only "erases" on paper (parameter properties,
    // enums, namespaces) — src/*.test.ts run under Node's strip-only type
    // stripping with no transform step, and instance-config.mjs imports
    // src/events.ts the same way at build time. Same rationale as
    // packages/calls/tsconfig.base.json.
    "erasableSyntaxOnly": true,
    // packages/calls is source-consumed (see the "paths" note below) and its
    // engine/ui/bridge modules import each other with explicit ".ts"/".tsx"
    // specifiers (required by Node's type-stripping test runner). When
    // runtime.ts imports @slothfulchat/calls/bridge, tsc follows those source
    // imports, so it must accept the extension here too. Safe under noEmit;
    // esbuild honors the extensions regardless.
    "allowImportingTsExtensions": true,
    // packages/calls/ui is React (docs/calls.md: the call UI is "our own React
    // tree mounted by the runtime", unrelated to upstream desktop's own React
    // build). No JSX in src/ yet (M0: runtime.ts still stubs the call hooks),
    // but the option must be here before M1 adds any.
    "jsx": "react-jsx",
    // core-wasm ships no .d.ts (esbuild build); packages/calls ships no dist
    // at all (private, source-consumed only) — resolve both from source.
    // esbuild honors these paths too, so the bundle also builds from source.
    "paths": {
      "@slothfulchat/core-wasm": ["../core-wasm/src/index.ts"],
      "@slothfulchat/calls/engine": ["../calls/engine/index.ts"],
      "@slothfulchat/calls/ui": ["../calls/ui/index.tsx"],
      "@slothfulchat/calls/bridge": ["../calls/bridge/index.ts"]
    }
  },
  "include": ["src"],
  // The *.test.ts files import node:test / node:assert, and this package
  // deliberately has no @types/node — that absence is what keeps `process`,
  // `Buffer` and friends from being reachable in browser code. Typechecking
  // them here would mean adding those globals to every src file to gain them.
  // They still run under `node --test`, which type-strips them, so a syntax
  // error surfaces there exactly as it did while they were .test.mjs.
  "exclude": ["src/**/*.test.ts"]
}
